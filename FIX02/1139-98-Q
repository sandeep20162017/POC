<script>
        window.onComboBoxModelDataBound = function (e) {
          const mode = $("#formMode").val();
           if (mode !== "Add") return;

           const combo = $("#VehModel").data("kendoComboBox");

           if (combo) {
               combo.enable(true);     // Kendo-level enable
               combo.readonly(false);  // Kendo-level readonly
           }

           // Remove any CSS-based disabling
           combo.wrapper.removeClass("k-state-disabled");
           combo.input.removeAttr("readonly").removeAttr("disabled");
      };


    window.onComboBoxModelChange = function (e) {
        var combo = e.sender;
        if (combo.selectedIndex === -1) {
            combo.value(null);
            combo.input.val("");
            combo.trigger("change");
            $("#validationMessage").text("Invalid selection!").css("color", "red");
        } else {
            $("#validationMessage").text("");
        }
    }


    window.getComboBoxModelParams = function () {
        var input = $(".k-combobox input.k-input:focus");
        return {
            columnName: input.attr("name")?.replace("_input", "").split('.').pop(),
            searchText: input.val() || ""
        };
    }

</script>

