<script>
document.addEventListener("DOMContentLoaded", function () {

    const banner = document.getElementById("display-scale-warning");
    if (!banner) return;

    const MAX_VIEWPORT_HEIGHT = 700;   // taller than this and the estimate popup gets cut off
    const MIN_VIEWPORT_HEIGHT = 450;
    const MIN_VIEWPORT_WIDTH  = 1100;
    const STORAGE_KEY = "displayWarningDismissed";

    // Remember the dismissal for this browser session (safe if storage is blocked)
    let dismissed = false;
    try { dismissed = sessionStorage.getItem(STORAGE_KEY) === "1"; } catch (e) {}

    function dismiss() {
        dismissed = true;
        try { sessionStorage.setItem(STORAGE_KEY, "1"); } catch (e) {}
        banner.style.display = "none";
    }

    function checkDisplaySettings() {
        if (dismissed) return;

        const h = window.innerHeight;
        const w = window.innerWidth;
        const scalePct = Math.round((window.devicePixelRatio || 1) * 100);
        let message = "";

        if (h > MAX_VIEWPORT_HEIGHT) {
            message = `Your display scale is ${scalePct}%, which is too low for this application. ` +
                      `Set Windows display scaling to 150% (Settings > System > Display > Scale), ` +
                      `or zoom the browser to 150% (Ctrl +). Otherwise parts of some popups may be cut off.`;
        } else if (h < MIN_VIEWPORT_HEIGHT || w < MIN_VIEWPORT_WIDTH) {
            message = `Your display scale (${scalePct}%) is too high for this window size. ` +
                      `Reduce the zoom (Ctrl -) or maximize the browser window.`;
        }

        if (!message) {
            banner.style.display = "none";
            return;
        }

        banner.innerHTML = "";
        banner.style.display = "flex";
        banner.style.justifyContent = "center";
        banner.style.alignItems = "center";
        banner.style.gap = "12px";

        const text = document.createElement("span");
        text.textContent = message;

        const closeBtn = document.createElement("button");
        closeBtn.type = "button";
        closeBtn.setAttribute("aria-label", "Dismiss warning");
        closeBtn.textContent = "\u00D7";   // x
        closeBtn.style.cssText =
            "background:none;border:none;font-size:20px;line-height:1;cursor:pointer;padding:0 6px;";
        closeBtn.addEventListener("click", dismiss);

        banner.appendChild(text);
        banner.appendChild(closeBtn);
    }

    checkDisplaySettings();
    window.addEventListener("resize", checkDisplaySettings);
});
</script>
