public IActionResult UpdateLabourDetail(
    [DataSourceRequest] DataSourceRequest request,
    LabourDetailsRebuiltPartsViewModel model,
    [FromQuery] string id,
    [FromQuery] string gridType)
{
    if (model != null)
    {
        try
        {
            {
                model.HrsReqd = $"{model.LabourHrs}:{model.LabourMins:D2}";
                var enteredBy = ViewBag.UserName?.ToString().ToUpper() ?? "SYSTEM";
                var dateModified = DateTime.Now;

                // Wrench time = required minutes / NON_PRODUCTIVE_ADJUSTMENT, saved as H:MM in AdjHrs
                var npa = _dbConnection.QueryFirstOrDefault<decimal?>(
                    @"SELECT TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS
                                                       WHERE Parameter = 'NON_PRODUCTIVE_ADJUSTMENT'), '1'), ',', '.') AS DECIMAL(18,6))") ?? 1m;
                if (npa <= 0) npa = 1m;

                int reqMinutes = model.LabourHrs * 60 + model.LabourMins;
                int wrenchMinutes = (int)Math.Round(reqMinutes / npa, MidpointRounding.AwayFromZero);
                string wrenchTime = $"{wrenchMinutes / 60}:{wrenchMinutes % 60:D2}";   // 2:00 / 1.2 -> "1:40"

                string query = @"
            UPDATE SBCES.EMPLOYEELABOUR 
            SET 
                LABOURDEFN = @LabourDefn,
                COSTCENTRE = @CostCentre,
                TASK = @Task,
                USAGE = @Usage,
                HRSREQD = @HrsReqd,
                ADJHRS = @AdjHrs,
                LASTMODIFIEDBY = @LastModifiedBy,
                [DateRevised] = @DateRevised,
                REBUILTPARTNUM = @LinkNumber 
            WHERE [LinkNumber] = @LinkId AND Id = @Id";

                var parameters = new
                {
                    model.LabourDefn,
                    model.CostCentre,
                    model.Task,
                    model.Usage,
                    model.HrsReqd,
                    AdjHrs = wrenchTime,
                    model.LinkNumber,
                    DateRevised = DateTime.Now,
                    LastModifiedBy = ViewBag.UserName,
                    LinkId = id,
                    model.Id
                };

                _dbConnection.Execute(query, parameters);
            }
