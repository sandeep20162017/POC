IDENTITY_COLUMNS = {
    # Add here only when the Oracle table has a column that maps 1:1 to the
    # SQL Server IDENTITY column, e.g. "NscPartsUsed": "Oid".
    # Do NOT add tables whose identity column is auto-generated (no Oracle
    # counterpart) - the DB will assign it during insert.
