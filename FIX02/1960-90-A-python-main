"""
Shared helpers for CES Oracle -> SQL Server refresh.
Oracle is READ ONLY. All DML is issued against SQL Server only.
Identity columns are preserved via SET IDENTITY_INSERT ON.
"""
import json
import logging
import os
import re
from datetime import datetime
from pathlib import Path

import pyodbc
import oracledb

BASE_DIR = Path(__file__).resolve().parent
CONFIG_FILE = BASE_DIR / "ces_refresh_config.json"

with CONFIG_FILE.open("r", encoding="utf-8") as f:
    CONFIG = json.load(f)

ORACLE_DSN = CONFIG["oracle"]["dsn"]
ORACLE_USER = CONFIG["oracle"]["user"]
ORACLE_PASSWORD = CONFIG["oracle"]["password"]
SQL_CFG = CONFIG["sqlserver"]
SQL_SCHEMA = "SBCES"


def make_logger(name, log_dir=None):
    log_dir = Path(log_dir or BASE_DIR / CONFIG["settings"].get("log_directory", "logs"))
    log_dir.mkdir(parents=True, exist_ok=True)
    log_file = log_dir / f"{name}_refresh.log"

    logger = logging.getLogger(name)
    logger.setLevel(logging.INFO)
    logger.handlers.clear()
    fh = logging.FileHandler(log_file, mode="a", encoding="utf-8")
    sh = logging.StreamHandler()
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s")
    fh.setFormatter(fmt)
    sh.setFormatter(fmt)
    logger.addHandler(fh)
    logger.addHandler(sh)
    return logger


def get_oracle_conn():
    return oracledb.connect(user=ORACLE_USER, password=ORACLE_PASSWORD, dsn=ORACLE_DSN)


def get_sql_conn(logger):
    configured_driver = str(SQL_CFG.get("driver", "auto")).strip()
    if configured_driver.lower() == "auto":
        installed = pyodbc.drivers()
        candidates = [d for d in installed if "SQL Server" in d and "Native Client" not in d]
        if not candidates:
            raise RuntimeError(
                "No Microsoft SQL Server ODBC driver is installed. "
                f"Installed ODBC drivers: {installed}"
            )
        def rank(n):
            m = re.search(r"(\d+)", n)
            return int(m.group(1)) if m else 0
        driver = sorted(candidates, key=rank, reverse=True)[0]
        logger.info("SQL ODBC DRIVER | auto-selected=%s", driver)
    else:
        driver = configured_driver
        if driver not in pyodbc.drivers():
            raise RuntimeError(
                f"Configured SQL Server ODBC driver '{driver}' is not installed. "
                f"Installed ODBC drivers: {pyodbc.drivers()}"
            )

    conn_str = (
        "DRIVER={" + driver + "};"
        "SERVER=" + str(SQL_CFG["server"]) + ";"
        "DATABASE=" + str(SQL_CFG["database"]) + ";"
        "UID=" + str(SQL_CFG["user"]) + ";"
        "PWD=" + str(SQL_CFG["password"]) + ";"
        "TrustServerCertificate=" + (
            "Yes" if SQL_CFG.get("trust_server_certificate", True) else "No"
        ) + ";"
    )
    logger.info(
        "SQL CONNECTION | server=%s | database=%s | driver=%s",
        SQL_CFG["server"], SQL_CFG["database"], driver,
    )
    return pyodbc.connect(conn_str, timeout=60)


def refresh_table(
    *,
    logger,
    oracle_table,
    sql_table,
    oracle_columns,
    sql_columns,
    identity_column=None,
    mode=None,
):
    """
    Refresh a single table.

    identity_column: name of the SQL Server IDENTITY column to preserve.
                     If provided, SET IDENTITY_INSERT ON/OFF wraps the INSERT
                     and the column is automatically appended to the column lists.
    mode: FULL / INSERT / DELETE. Defaults to CES_REFRESH_MODE env or config.
    """
    mode = (mode or os.environ.get(
        "CES_REFRESH_MODE",
        CONFIG["settings"].get("default_mode", "FULL"),
    )).upper()

    # If preserving identity, append identity column to both lists.
    ora_cols = list(oracle_columns)
    sql_cols = list(sql_columns)
    if identity_column:
        if identity_column not in sql_cols:
            sql_cols.append(identity_column)
            # identity column must map from an Oracle column of the same ordinal.
            # If identity_column not already in ora_cols, the caller must have
            # provided it as the first element of oracle_columns.
            if identity_column not in ora_cols:
                raise ValueError(
                    f"identity_column='{identity_column}' must also exist in "
                    f"oracle_columns for {oracle_table}"
                )

    started = datetime.now()
    logger.info("=" * 100)
    logger.info("START REFRESH | Oracle=%s | SQL=SBCES.%s | MODE=%s",
                oracle_table, sql_table, mode)

    o_conn = None
    s_conn = None

    def o_count(conn):
        cur = conn.cursor()
        try:
            cur.execute(f"SELECT COUNT(*) FROM {oracle_table}")
            return int(cur.fetchone()[0])
        finally:
            cur.close()

    def o_fetch(conn):
        sql = "SELECT " + ", ".join(ora_cols) + f" FROM {oracle_table}"
        cur = conn.cursor()
        try:
            cur.execute(sql)
            return cur.fetchall()
        finally:
            cur.close()

    def s_count(conn):
        cur = conn.cursor()
        try:
            cur.execute(f"SELECT COUNT(*) FROM [{SQL_SCHEMA}].[{sql_table}]")
            return int(cur.fetchone()[0])
        finally:
            cur.close()

    def s_delete(conn):
        cur = conn.cursor()
        try:
            cur.execute(f"DELETE FROM [{SQL_SCHEMA}].[{sql_table}]")
            logger.info("SQL DELETE | SBCES.%s | rows=%s", sql_table, cur.rowcount)
        finally:
            cur.close()

    def s_insert(conn, rows):
        col_list = ", ".join(sql_cols)
        ph = ", ".join("?" for _ in sql_cols)
        sql = f"INSERT INTO [{SQL_SCHEMA}].[{sql_table}] ({col_list}) VALUES ({ph})"
        cur = conn.cursor()
        inserted = 0
        failed = 0
        id_on = False
        try:
            if identity_column:
                cur.execute(f"SET IDENTITY_INSERT [{SQL_SCHEMA}].[{sql_table}] ON")
                id_on = True
            cur.fast_executemany = True
            try:
                cur.executemany(sql, rows)
                inserted = len(rows)
                logger.info("BULK INSERT | rows=%s", inserted)
            except Exception as bulk_exc:
                conn.rollback()
                if id_on:
                    try:
                        cur.execute(f"SET IDENTITY_INSERT [{SQL_SCHEMA}].[{sql_table}] ON")
                    except Exception:
                        pass
                logger.warning("BULK INSERT FAILED | retrying row-by-row | error=%s", bulk_exc)
                cur.fast_executemany = False
                for idx, row in enumerate(rows, 1):
                    try:
                        cur.execute(sql, row)
                        inserted += 1
                    except Exception as exc:
                        failed += 1
                        logger.error("ROW FAILED | row=%s | error=%s | data=%r",
                                     idx, exc, row)
            return inserted, failed
        finally:
            if id_on:
                try:
                    cur.execute(f"SET IDENTITY_INSERT [{SQL_SCHEMA}].[{sql_table}] OFF")
                except Exception:
                    pass
            cur.close()

    try:
        o_conn = get_oracle_conn()
        s_conn = get_sql_conn(logger)
        ocount = o_count(o_conn)
        logger.info("ORACLE COUNT | %s = %s", oracle_table, ocount)

        if mode == "DELETE":
            s_delete(s_conn)
            s_conn.commit()
            logger.info("SQL COUNT AFTER DELETE | %s", s_count(s_conn))

        elif mode in ("INSERT", "FULL"):
            rows = o_fetch(o_conn)
            logger.info("FETCHED FROM ORACLE | %s rows", len(rows))
            if len(rows) != ocount:
                logger.error("ORACLE FETCH COUNT MISMATCH | COUNT=%s | FETCHED=%s",
                             ocount, len(rows))
                s_conn.rollback()
            else:
                if mode == "FULL":
                    s_delete(s_conn)
                inserted, failed = s_insert(s_conn, rows)
                if failed == 0 and inserted == len(rows):
                    s_conn.commit()
                    logger.info(
                        "RESULT | Oracle=%s | Inserted=%s | Failed=%s | SQL=%s",
                        ocount, inserted, failed, s_count(s_conn),
                    )
                    logger.info("STATUS | SUCCESS | COUNTS MATCH")
                else:
                    s_conn.rollback()
                    logger.error(
                        "STATUS | FAILED | TRANSACTION ROLLED BACK | Inserted=%s | Failed=%s",
                        inserted, failed,
                    )
        else:
            logger.error("INVALID CES_REFRESH_MODE=%s | expected FULL, INSERT, or DELETE", mode)

    except Exception as exc:
        if s_conn is not None:
            try:
                s_conn.rollback()
            except Exception:
                pass
        logger.exception("FATAL ERROR | %s", exc)
    finally:
        for c in (o_conn, s_conn):
            if c is not None:
                try:
                    c.close()
                except Exception:
                    pass
        logger.info("END REFRESH | elapsed=%s", datetime.now() - started)
        logger.info("=" * 100)
