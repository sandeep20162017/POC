def main():
    mode = os.environ.get(
        "CES_REFRESH_MODE",
        CONFIG["settings"].get("default_mode", "FULL"),
    ).upper()

    # Config-declared order wins if present; otherwise dict order.
    config_order = CONFIG["settings"].get("tables") or list(TABLES.keys())
    ordered = [t for t in config_order if t in TABLES]

    # sanity: make sure no table definitions are orphaned
    missing = [t for t in TABLES if t not in ordered]
    if missing:
        print(f"WARNING: tables in TABLES but not in config order: {missing}")

    logger = make_logger("CES_REFRESH_ALL")
    started = datetime.now()
    logger.info("#" * 100)
    logger.info("CES REFRESH ALL | MODE=%s | TABLES=%d", mode, len(ordered))
    logger.info("#" * 100)

    # ---------- DELETE phase: reverse order (children first) ----------
    if mode in ("FULL", "DELETE"):
        logger.info("-" * 100)
        logger.info("DELETE PHASE (children -> parents)")
        logger.info("-" * 100)
        for name in reversed(ordered):
            cfg = TABLES[name]
            logger.info("DELETE START | %s", name)
            refresh_table(
                logger=logger,
                oracle_table=cfg["oracle_table"],
                sql_table=cfg["sql_table"],
                oracle_columns=cfg["oracle_columns"],
                sql_columns=cfg["sql_columns"],
                identity_column=None,
                mode="DELETE",
            )

    # ---------- INSERT phase: forward order (parents first) ----------
    if mode in ("FULL", "INSERT"):
        logger.info("-" * 100)
        logger.info("INSERT PHASE (parents -> children)")
        logger.info("-" * 100)
        for name in ordered:
            cfg = TABLES[name]
            logger.info("INSERT START | %s", name)
            refresh_table(
                logger=logger,
                oracle_table=cfg["oracle_table"],
                sql_table=cfg["sql_table"],
                oracle_columns=cfg["oracle_columns"],
                sql_columns=cfg["sql_columns"],
                identity_column=IDENTITY_COLUMNS.get(cfg["sql_table"]),
                mode="INSERT",
            )

    logger.info("#" * 100)
    logger.info("CES REFRESH ALL COMPLETE | elapsed=%s", datetime.now() - started)
    logger.info("#" * 100)


if __name__ == "__main__":
    sys.exit(main())
