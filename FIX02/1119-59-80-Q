SELECT w.wo_id, w.job_id, w.job_type, w.wo_mode, w.job_title, w.vehicle_id,
       w.quantity_req, w.quantity, o.order_type_desc, w.order_id, w.code_id,
       w.vehicle_type, w.date_issue, w.wo_comment, w.priority,
       p.date_start, p.location_id, l.cc, l.cc_desc
FROM   workorders w, wo_ops p, locations l, order_types o
WHERE  w.wo_id        = p.wo_id
AND    w.order_type   = o.order_type(+)
AND    p.location_id  = l.location_id
AND    p.f_arrive     = 'Y'
AND    w.date_done IS NULL
AND  ( (:P_REPORT_TYPE = 'Open SIO Workorders' AND INSTR('24', w.order_type) > 0)
       OR :P_REPORT_TYPE = 'Open Workorders' )
AND  ( p.location_id = :P_LOCATION_ID OR :P_LOCATION_ID IS NULL )
ORDER BY p.wo_id ASC, w.order_type ASC
