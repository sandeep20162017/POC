CREATE OR REPLACE PROCEDURE       "UPDATE_PRICES" (rb_num in varchar)
IS

V_LINK_CODE VARCHAR(30);
V_PRICE number (20,10);
vo_total_cost number (20,10);
vo_ret_val number (20,2);

-- Takes in a rebuilt part number and returns a list of rebuilt part numbers
-- attached to the inputted rebuilt part number
CURSOR C_RB_LIST_To_Prop (rb_num2 IN varchar)
IS
SELECT distinct UPPER(SC_PARTS_USED.link_code) AS link_code
        FROM
            SC_PARTS_USED
        WHERE
            SC_PARTS_USED.rebuilt_part = 'Y' AND
            SC_PARTS_USED.link_type = 'RB' AND
            upper(SC_PARTS_USED.mms_rebuilt_code) = upper(rb_num2);

BEGIN

-- Makes sure the rebuilt part number sent to the procedure exists in the
--RB_MASTERLIST table.
SELECT count(*) into V_PRICE from RB_MASTERLIST where upper(rebuilt_stock_num) = upper(rb_num);
if V_PRICE = 1 then

--Calculates the total price of the inputted rebuilt part number (rb_num)
--and saves it in the variable vo_total_cost
--V_PRICE := ces_inquiry.retrieve_rbp_total_cost(upper(rb_num),'RB',vo_total_cost);

--update the cost of the rebuilt part with the new total saved in vo_total_cost
update RB_MASTERLIST set estimated_cost = vo_total_cost where upper(rebuilt_stock_num) = upper(rb_num);


v_price :=ces_update.propagate_rbp_changes(vo_total_cost,upper(rb_num),vo_ret_val);

--checks to see how many rebuilt parts are attached to the rebuilt part number
-- inputted(rb_num) into this procedure
SELECT count(*) INTO V_PRICE FROM SC_PARTS_USED WHERE
            SC_PARTS_USED.rebuilt_part = 'Y' AND
            SC_PARTS_USED.link_type = 'RB' AND
            upper(SC_PARTS_USED.mms_rebuilt_code) = upper(rb_num);
--commit;



--if this current rebuilt part (rb_num) in this procedure resides
--in any other rebuilt parts update the prices of those rebuilt parts as well.
if V_PRICE > 0 then

open C_RB_LIST_To_Prop(upper(rb_num));
LOOP

    FETCH C_RB_LIST_To_Prop
    INTO V_LINK_CODE;
    EXIT WHEN C_RB_LIST_To_Prop%NOTFOUND;

    UPDATE_PRICES (V_LINK_CODE);

END LOOP;
CLOSE C_RB_LIST_To_Prop;
end if;

end if;

RETURN;

EXCEPTION

    WHEN OTHERS THEN
     raise_application_error(sqlcode, sqlerrm);
    dbms_output.put_line(substr(TO_CHAR(SQLCODE) || ': '||SQLERRM,1,255));

    rollback;
END; -- Procedure;
 
