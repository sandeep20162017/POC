CREATE OR REPLACE FUNCTION hhmm_to_decimal
    (vi_time IN VARCHAR2) RETURN number IS
varResult varchar2(100);
varHours number;
varMinutes number;
position number;
BEGIN
    -- Current function takes one parameter vi_DecimalMinutes
    -- and returns time in next format "HH:MM". For example
    -- vi_DecimalMinutes = 77. In this case function will return "1:17"

    position := INSTR(vi_time,':',1,1);

    varHours := substr (vi_time,1,(position -1));
    varMinutes := substr (vi_time,(position + 1));
    --varHours := floor(vi_DecimalMinutes/60);
    varMinutes := round((varMinutes / 60),6);
/*
    IF (length(varMinutes) < 2) THEN
        varResult := varHours || ':0' || varMinutes;
    ELSE
        varResult := varHours || ':' || varMinutes;
    END IF;
*/

    varResult := varHours + varMinutes;
    RETURN varResult;
END HHMM_TO_DECIMAL;
 
