CREATE OR REPLACE FUNCTION hhmm_to_minutes
    (vi_DecimalTime IN NUMBER) RETURN VARCHAR2 IS
varResult varchar2(100);
varHours number;
varMinutes number;
BEGIN
    -- Current function takes one parameter vi_DecimalMinutes
    -- and returns time in next format "HH:MM". For example
    -- vi_DecimalMinutes = 77. In this case function will return "1:17"

    varHours := floor(vi_DecimalTime/100);
    varMinutes := (vi_DecimalTime - varHours) * 60;
    varHours := floor(vi_DecimalTime/100) * 60;

    varResult := round((varHours + varMinutes),0);

    RETURN varResult;
END ;
 
