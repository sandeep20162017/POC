🎯 3. Full Python script — connect to Oracle + SQL Server
This script uses:

Oracle OLE DB provider: MSDAORA.1

SQL Server OLE DB / ODBC connection

It prints success messages for both connections.

python
import pyodbc
import win32com.client

# ---------------------------------------------------------
# ORACLE CONNECTION (OLE DB MSDAORA)
# ---------------------------------------------------------
try:
    oracle_conn_str = (
        "Provider=MSDAORA.1;"
        "User ID=CES;"
        "Password=ces;"
        "Data Source=ces_tst;"
        "Persist Security Info=False;"
    )

    oracle_conn = win32com.client.Dispatch("ADODB.Connection")
    oracle_conn.Open(oracle_conn_str)

    print("Connected to Oracle 12c successfully.")
except Exception as e:
    print("Oracle connection failed:", e)


# ---------------------------------------------------------
# SQL SERVER CONNECTION (ODBC)
# ---------------------------------------------------------
try:
    sql_conn_str = (
        "DRIVER={ODBC Driver 17 for SQL Server};"
        "SERVER=AppCESDB_DEV;"
        "DATABASE=CES;"
        "UID=CESUser;"
        "PWD=CESUser#Dev;"
        "TrustServerCertificate=Yes;"
    )

    sql_conn = pyodbc.connect(sql_conn_str)
    print("Connected to SQL Server successfully.")
except Exception as e:
    print("SQL Server connection failed:", e)
