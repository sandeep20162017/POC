------------------------------------------------------------
-- 4. DROP UNIQUE & PRIMARY KEY CONSTRAINTS
------------------------------------------------------------
SET @sql = N'';

SELECT @sql = @sql + '
ALTER TABLE [' + @SchemaName + '].[' + OBJECT_NAME(parent_object_id) + '] 
DROP CONSTRAINT [' + name + '];'
FROM sys.key_constraints
WHERE schema_id = SCHEMA_ID(@SchemaName);

PRINT @sql;
EXEC(@sql);


------------------------------------------------------------
-- 5. DROP ALL OBJECTS IN THE SCHEMA
------------------------------------------------------------
SET @sql = N'';

SELECT @sql = @sql + '
DROP ' +
    CASE type
        WHEN 'U' THEN 'TABLE'
        WHEN 'V' THEN 'VIEW'
        WHEN 'P' THEN 'PROCEDURE'
        WHEN 'FN' THEN 'FUNCTION'
        WHEN 'IF' THEN 'FUNCTION'
        WHEN 'TF' THEN 'FUNCTION'
        WHEN 'TR' THEN 'TRIGGER'
        WHEN 'SQ' THEN 'SEQUENCE'
        ELSE type
    END +
    ' [' + @SchemaName + '].[' + name + '];'
FROM sys.objects
WHERE schema_id = SCHEMA_ID(@SchemaName)
ORDER BY type DESC;

PRINT @sql;
EXEC(@sql);


------------------------------------------------------------
-- 6. DROP THE SCHEMA
------------------------------------------------------------
DECLARE @DropSchema NVARCHAR(MAX) = 'DROP SCHEMA [' + @SchemaName + '];';
PRINT @DropSchema;
EXEC(@DropSchema);
