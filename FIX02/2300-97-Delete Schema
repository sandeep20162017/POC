DECLARE @SchemaName SYSNAME = 'BCES';


------------------------------------------------------------
-- 1. DROP FOREIGN KEYS
------------------------------------------------------------
DECLARE @sql NVARCHAR(MAX) = N'';

SELECT @sql = @sql + '
ALTER TABLE [' + @SchemaName + '].[' + OBJECT_NAME(parent_object_id) + '] 
DROP CONSTRAINT [' + name + '];'
FROM sys.foreign_keys
WHERE schema_id = SCHEMA_ID(@SchemaName);

PRINT @sql;
EXEC(@sql);


------------------------------------------------------------
-- 2. DROP CHECK CONSTRAINTS
------------------------------------------------------------
SET @sql = N'';

SELECT @sql = @sql + '
ALTER TABLE [' + @SchemaName + '].[' + OBJECT_NAME(parent_object_id) + '] 
DROP CONSTRAINT [' + name + '];'
FROM sys.check_constraints
WHERE schema_id = SCHEMA_ID(@SchemaName);

PRINT @sql;
