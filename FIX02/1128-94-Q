<script type="text/javascript">
    // Configuration
    var partNum = '@ViewBag.PartNum';
    var gridType = '@(string.IsNullOrEmpty((string)ViewBag.GridType) ? "MakeVsBuyGrid" : (string)ViewBag.GridType)';
    var totalCostDataUrl = '@Url.Action("GetTotalCostInEstimates", "TotalCost")' +
                           '?id=' + encodeURIComponent(partNum) +
                           '&gridType=' + encodeURIComponent(gridType);
    var viewReportUrl = '@Url.Action("ViewReport", "TotalCost")';

    // Document ready
    $(document).ready(function() {
        console.log("MakeVsBuy TotalCostTab initialized");
        fetchTotalCostData();

        $("#retryButton").on('click', function() {
            $("#noDataMessage").hide();
            $("#loadingIndicator").show();
            $("#costSummaryContent").hide();
            fetchTotalCostData();
        });

        // Initialize menu
        initializeMenu();
    });

    // ===== MENU INITIALIZATION =====
    function initializeMenu() {
        var dropdown = document.getElementById('reportMenuDropdown');
        var actionsButton = document.getElementById('reportActions');

        if (!actionsButton || !dropdown) {
            console.error('Menu elements not found');
            return;
        }

        // Toggle dropdown on button click
        actionsButton.addEventListener('click', function(e) {
            e.stopPropagation();
            dropdown.classList.toggle('show');

            // Position the dropdown
            var rect = actionsButton.getBoundingClientRect();
            dropdown.style.top = (rect.bottom + 4) + 'px';
            dropdown.style.right = '20px';
        });

        // Close on outside click
        document.addEventListener('click', function(e) {
            if (!dropdown.contains(e.target) && e.target !== actionsButton) {
                dropdown.classList.remove('show');
            }
        });

        // Handle menu item clicks
        dropdown.querySelectorAll('.menu-item').forEach(function(item) {
            item.addEventListener('click', function() {
                var action = this.dataset.action;
                dropdown.classList.remove('show');
                handleMenuAction(action);
            });
        });
    }

    // Maps any menu action to 'full' | 'labour' | 'materials'
    // (the Vehicle version's key lookups never matched, so titles/filenames always fell back to the default)
    function normalizeReportType(action) {
        var a = (action || '').toLowerCase();
        if (a.indexOf('labour') !== -1) return 'labour';
        if (a.indexOf('material') !== -1) return 'materials';
        return 'full';
    }

    // ===== MENU ACTION HANDLER =====
    function handleMenuAction(action) {
        console.log('Menu action:', action);

        switch(action) {
            // View Actions
            case 'viewFullReport':
            case 'viewLabourDetails':
            case 'viewMaterialsEstimate':
                openReportView(action.replace('view', '').toLowerCase());
                break;

            // Copy Actions
            case 'copyFullReport':
            case 'copyLabourDetails':
            case 'copyMaterialsEstimate':
                copyReportToClipboard(normalizeReportType(action));
                break;

            // PDF Actions
            case 'saveFullReportPdf':
            case 'saveLabourDetailsPdf':
            case 'saveMaterialsEstimatePdf':
                saveReportAsPdf(normalizeReportType(action));
                break;

            default:
                console.warn('Unknown action:', action);
        }
    }

    // ===== OPEN REPORT VIEW =====
    function openReportView(reportType) {
        var url = viewReportUrl + '?reportType=' + encodeURIComponent(reportType) +
                  '&id=' + encodeURIComponent(partNum) +
                  '&gridType=' + encodeURIComponent(gridType);
        console.log('Opening URL:', url);
        window.open(url, '_blank');
    }

    // ===== SAVE AS PDF =====
    function saveReportAsPdf(reportType) {
        var container = document.getElementById('reportContainer');
        if (!container) {
            alert('Unable to find the estimate report.');
            return;
        }

        if (typeof kendo === 'undefined' || !kendo.drawing) {
            alert('Kendo UI is not available. Please ensure Kendo UI is loaded.');
            return;
        }

        var wrapper = createExportWrapper(container, reportType);
        if (!wrapper) return;

        kendo.drawing.drawDOM(wrapper, {
            paperSize: 'Letter',
            landscape: true,
            margin: { top: '0.35in', bottom: '0.35in', left: '0.35in', right: '0.35in' },
            scale: 0.78,
            multiPage: true
        }).then(function(group) {
            return kendo.drawing.exportPDF(group, {
                paperSize: 'Letter',
                landscape: true,
                margin: { top: '0.35in', bottom: '0.35in', left: '0.35in', right: '0.35in' }
            });
        }).done(function(dataUri) {
            if (wrapper.parentNode) document.body.removeChild(wrapper);
            var fileName = getReportFileName(reportType) + '.pdf';
            kendo.saveAs({ dataURI: dataUri, fileName: fileName });
            console.log('PDF saved:', fileName);
        }).fail(function(err) {
            if (wrapper.parentNode) document.body.removeChild(wrapper);
            console.error('PDF export error:', err);
            alert('Error generating PDF: ' + (err && err.message ? err.message : 'Unknown error.'));
        });
    }

    // ===== COPY TO CLIPBOARD =====
    function copyReportToClipboard(reportType) {
        var container = document.getElementById('reportContainer');
        if (!container) {
            alert('Unable to find the estimate report.');
            return;
        }

        if (typeof kendo === 'undefined' || !kendo.drawing) {
            alert('Kendo UI is not available. Please ensure Kendo UI is loaded.');
            return;
        }

        if (!navigator.clipboard) {
            alert('Clipboard API is not available.');
            return;
        }

        var wrapper = createExportWrapper(container, reportType);
        if (!wrapper) return;

        kendo.drawing.drawDOM(wrapper, {
            paperSize: 'auto',
            margin: '1cm',
            scale: 1
        }).then(function(group) {
            return kendo.drawing.exportImage(group);
        }).done(function(data) {
            if (wrapper.parentNode) document.body.removeChild(wrapper);

            fetch(data)
                .then(function(res) { return res.blob(); })
                .then(function(blob) {
                    navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
                    var typeNames = {
                        'full': 'Full Make vs Buy Estimate Report',
                        'labour': 'Labour Details Report',
                        'materials': 'Materials Estimate Report'
                    };
                    alert((typeNames[reportType] || 'Report') + ' copied to clipboard.');
                })
                .catch(function(err) {
                    console.error('Clipboard error:', err);
                    alert('Error copying to clipboard: ' + err.message);
                });
        }).fail(function(err) {
            if (wrapper.parentNode) document.body.removeChild(wrapper);
            console.error('Export image error:', err);
            alert('Error generating image: ' + (err && err.message ? err.message : 'Unknown error.'));
        });
    }

    // ===== HELPER: Create Export Wrapper =====
    function createExportWrapper(container, reportType) {
        var wrapper = document.createElement('div');
        wrapper.id = 'exportWrapper_' + Date.now();
        wrapper.style.cssText = [
            'padding: 20px',
            'background: white',
            'font-family: "Segoe UI", Arial, sans-serif',
            'position: absolute',
            'left: -100000px',
            'top: 0',
            'width: 1100px',
            'z-index: 9999'
        ].join('; ');

        var clone = container.cloneNode(true);

        // Update title based on report type
        var titles = {
            'full': 'FULL MAKE VS BUY ESTIMATE REPORT',
            'labour': 'LABOUR DETAILS REPORT',
            'materials': 'MATERIALS ESTIMATE REPORT'
        };
        var titleEl = clone.querySelector('h1');
        if (titleEl) {
            titleEl.textContent = titles[reportType] || titles.full;
        }

        wrapper.appendChild(clone);
        document.body.appendChild(wrapper);

        // Remove UI elements
        var noPrintElements = wrapper.querySelectorAll('.no-print, button, .k-button, .report-toolbar, .report-menu-dropdown');
        noPrintElements.forEach(function(el) {
            el.style.display = 'none';
        });

        // Ensure sections are visible
        var sections = wrapper.querySelectorAll('.detail-section, .side-by-side, .totals-row, .grand-total-section');
        sections.forEach(function(el) {
            el.style.display = '';
            el.style.visibility = 'visible';
        });

        void wrapper.offsetWidth;
        void wrapper.offsetHeight;

        return wrapper;
    }

    // ===== HELPER: Get Report File Name =====
    function getReportFileName(reportType) {
        var typeMap = {
            'full': 'FullMakeVsBuyEstimate',
            'labour': 'LabourDetails',
            'materials': 'MaterialsEstimate'
        };
        var typeName = typeMap[reportType] || 'MakeVsBuyEstimate';
        var estimateNum = (document.getElementById('estimateNumber')?.textContent || 'Estimate').trim().replace(/[^a-z0-9_.-]/gi, '_');
        return typeName + '_' + estimateNum;
    }

    // ===== DATA FETCHING =====
    function fetchTotalCostData() {
        console.log("Fetching data from:", totalCostDataUrl);

        $.ajax({
            url: totalCostDataUrl,
            type: 'GET',
            dataType: 'json',
            timeout: 30000,
            success: function(response) {
                console.log("Response received:", response);
                if (response && response.Data && response.Data.length > 0) {
                    var costData = response.Data[0];
                    console.log("Cost data:", costData);
                    populateAllSections(costData);
                    $("#loadingIndicator").hide();
                    $("#costSummaryContent").show();
                    $("#noDataMessage").hide();
                } else {
                    console.log("No data in response");
                    showNoDataMessage();
                }
            },
            error: function(xhr, status, error) {
                console.error("Error fetching cost data:", status, error);
                showNoDataMessage();
            }
        });
    }

    // ===== HELPER FUNCTIONS =====
    function getVal(value) {
        if (value === null || value === undefined) return 0;
        var num = parseFloat(value);
        return isNaN(num) ? 0 : num;
    }

    function formatMoney(val) {
        return '$' + val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // For string fields that may be "N/A" / empty (Make vs Buy cost columns)
    function moneyOrDash(value) {
        if (value === null || value === undefined || value === '' || value === 'N/A') return '-';
        var num = parseFloat(String(value).replace(/[^0-9.\-]/g, ''));
        return isNaN(num) ? String(value) : formatMoney(num);
    }

    function textOrDash(value) {
        if (value === null || value === undefined) return '-';
        var s = String(value).trim();
        return (s === '' || s === 'N/A') ? '-' : s;
    }

    function setText(id, value) {
        $(id).text(formatMoney(value));
    }

    function setNumber(id, value) {
        var num = getVal(value);
        $(id).text(num.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }));
    }

    function formatDateTime(value) {
        if (value === null || value === undefined || value === '') return '-';
        var date = new Date(value);
        if (isNaN(date.getTime())) return String(value);
        return date.toLocaleString(undefined, {
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit'
        });
    }

    function setNumberDecimal(id, value) {
        var num = getVal(value);
        $(id).text(num.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }

    // ===== POPULATE ALL SECTIONS =====
    function populateAllSections(costData) {
        // Make vs Buy Details
        $('#mbDescription').text(textOrDash(costData.Description));
        $('#mbNumber').text(textOrDash(costData.MbNumber));
        $('#mbVendorPartNum').text(textOrDash(costData.VendorPartNum));
        $('#mbBuyCode').text(textOrDash(costData.BuyCode));
        $('#mbRebuildCode').text(textOrDash(costData.RebuildCode));
        $('#mbAnnualUsage').text(textOrDash(costData.AnnualUsage));
        $('#mbRecommendation').text(textOrDash(costData.Recommendation));
        $('#mbInternalCost').text(moneyOrDash(costData.InternalCost));
        $('#mbRemanCost').text(moneyOrDash(costData.RemanCost));
        $('#mbExternalCost').text(moneyOrDash(costData.ExternalCost));
        $('#mbBuyNewCost').text(moneyOrDash(costData.BuyNewCost));
        $('#mbJobNumber').text(textOrDash(costData.JobNumber));
        $('#mbDateOpened').text(formatDateTime(costData.DateOpened));

        // Vehicle series: one or many, shown as plain comma-separated text
        var series = costData.VehicleSeriesList || [];
        if (!Array.isArray(series)) series = [series];
        $('#mbVehicleSeries').text(series.length > 0 ? series.join(', ') : textOrDash(costData.VehicleSeries));

        // Material Summary
        var totalParts = (costData.TotalStockPartsCount || 0) + (costData.TotalNonStockPartsCount || 0) + (costData.TotalRebuiltPartsCount || 0);
        $('#materialCountBadge').text(totalParts + ' parts');
        setNumber('#stockPartsCount', costData.TotalStockPartsCount);
        setNumber('#nonStockPartsCount', costData.TotalNonStockPartsCount);
        setNumber('#rebuiltPartsCount', costData.TotalRebuiltPartsCount);
        setText('#stockCost', costData.SCPartsMaterialCost);
        setText('#totalNonStockCost', costData.NSCSCPartsMaterialCost);
        setText('#totalRebuiltCost', costData.RBPartsMaterialCost);

        // Material Lines
        populateMaterialLines(costData.MaterialLines || []);

        // Labour Hours
        setNumberDecimal('#totalHours', costData.TotalLabourHours);
        setNumberDecimal('#totalEffectiveHours', costData.TotalEffectiveHours);
        setNumberDecimal('#totalAdjustedHours', costData.TotalAdjustedHours);

        // Labour Tasks
        populateTaskSummary(costData.LabourTasks || []);

        // Cost Side by Side
        var scParts = getVal(costData.SCPartsMaterialCost);
        var nscParts = getVal(costData.NSCSCPartsMaterialCost);
        var rbParts = getVal(costData.RBPartsMaterialCost);
        var partsTotalNoTax = getVal(costData.MaterialTotalCostNoTax);
        var materialTax = getVal(costData.MaterialTotalTaxAmount);
        var materialWithTax = getVal(costData.MaterialTotalWithTax);

        var labourFringe = getVal(costData.LabourFringe);
        var labourBenefits = getVal(costData.LabourBenefits);
        var blendedFringeCost = getVal(costData.BlendedFringeBenefitCost);
        var labourOverhead = getVal(costData.LabourOverhead);
        var totalLabour = getVal(costData.FinalLabourCost);
        var totalWithTax = materialWithTax + totalLabour;

        setText("#scPartsDisplay", scParts);
        setText("#nscPartsDisplay", nscParts);
        setText("#rbCostDisplay", rbParts);
        setText("#partsTotalDisplay", partsTotalNoTax);
        setText("#materialTaxDisplay", materialTax);
        setText("#materialWithTaxDisplay", materialWithTax);

        setText("#labourFringeDisplay", labourFringe);
        setText("#labourBenefitsDisplay", labourBenefits);
        setText("#blendedFringeCostDisplay", blendedFringeCost);
        setText("#labourOverheadDisplay", labourOverhead);
        setText("#totalLabourCostDisplay", totalLabour);

        setText("#totalMaterialBoxDisplay", materialWithTax);
        setText("#totalLabourBoxDisplay", totalLabour);
        setText("#totalWithTaxDisplay", totalWithTax);
    }

    // ===== POPULATE MATERIAL LINES =====
    function populateMaterialLines(lines) {
        var tbody = $('#materialLinesBody');
        var badge = $('#materialLinesBadge');
        var totalItems = lines.length;
        badge.text(totalItems + ' items');

        if (totalItems === 0) {
            tbody.html('<tr><td colspan="8" style="text-align:center; color:#6c757d; padding:20px;">No material items found</td></tr>');
            return;
        }

        var html = '';
        var typeTotals = { Stock: 0, Rebuilt: 0, 'Non-Stock': 0 };
        var grandTotal = 0;

        lines.forEach(function(item) {
            var type = item.Type || 'Stock';
            var typeClass = type.toLowerCase().replace('-', '');
            var badgeClass = typeClass === 'nonstock' ? 'nonstock' : typeClass;
            var totalCost = getVal(item.TotalCost);

            if (typeTotals[type] !== undefined) {
                typeTotals[type] += totalCost;
            }
            grandTotal += totalCost;

            html += '<tr class="type-' + typeClass + '">' +
                '<td><span class="type-badge ' + badgeClass + '">' + type + '</span></td>' +
                '<td>' + (item.StockCode || '-') + '</td>' +
                '<td>' + (item.CC || '-') + '</td>' +
                '<td>' + (item.Description || 'N/A') + '</td>' +
                '<td style="text-align:right;">' + getVal(item.Quantity).toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + formatMoney(getVal(item.UnitCost)) + '</td>' +
                '<td style="text-align:right;">' + getVal(item.PercentUsage).toFixed(1) + '%</td>' +
                '<td style="text-align:right; font-weight:600;">' + formatMoney(totalCost) + '</td>' +
                '</tr>';
        });

        var typeOrder = ['Stock', 'Rebuilt', 'Non-Stock'];
        typeOrder.forEach(function(type) {
            if (typeTotals[type] > 0) {
                html += '<tr class="subtotal-row">' +
                    '<td colspan="7" style="text-align:right; font-weight:600;">Subtotal - ' + type + '</td>' +
                    '<td style="text-align:right; font-weight:600;">' + formatMoney(typeTotals[type]) + '</td>' +
                    '</tr>';
            }
        });

        html += '<tr class="total-row">' +
            '<td colspan="7" style="text-align:right; font-weight:800; font-size:1.05em;">GRAND TOTAL</td>' +
            '<td style="text-align:right; font-weight:800; font-size:1.05em;">' + formatMoney(grandTotal) + '</td>' +
            '</tr>';

        tbody.html(html);
    }

    // ===== POPULATE TASK SUMMARY =====
    function populateTaskSummary(tasks) {
        var tbody = $('#taskSummaryBody');
        var badge = $('#taskCountBadge');
        badge.text(tasks.length + ' tasks');

        if (tasks.length === 0) {
            tbody.html('<tr><td colspan="9" style="text-align:center; color:#6c757d; padding:20px;">No labour tasks found</td></tr>');
            return;
        }

        var html = '';
        var totalHours = 0, totalEffective = 0, totalAdjusted = 0, totalCost = 0;

        tasks.forEach(function(task) {
            var hours = getVal(task.Hours);
            var effective = getVal(task.EffectiveHours);
            var adjusted = getVal(task.AdjustedHours);
            var cost = getVal(task.TotalCost);
            var count = getVal(task.Count);

            totalHours += hours;
            totalEffective += effective;
            totalAdjusted += adjusted;
            totalCost += cost;

            html += '<tr>' +
                '<td>' + (task.Task || 'Unnamed') + '</td>' +
                '<td>' + (task.LabourDefinition || 'N/A') + '</td>' +
                '<td>' + (task.CC || '-') + '</td>' +
                '<td style="text-align:right;">' + hours.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + effective.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + adjusted.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + formatMoney(getVal(task.RatePerHour)) + '</td>' +
                '<td style="text-align:right; font-weight:600;">' + formatMoney(cost) + '</td>' +
                '<td style="text-align:center;">' + count + '</td>' +
                '</tr>';
        });

        html += '<tr class="total-row">' +
            '<td colspan="3"><strong>TOTAL</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalHours.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalEffective.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalAdjusted.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"></td>' +
            '<td style="text-align:right;"><strong>' + formatMoney(totalCost) + '</strong></td>' +
            '<td style="text-align:center;"><strong>' + tasks.length + '</strong></td>' +
            '</tr>';

        tbody.html(html);
    }

    function showNoDataMessage() {
        $("#loadingIndicator").hide();
        $("#costSummaryContent").hide();
        $("#noDataMessage").show();
    }
</script>

