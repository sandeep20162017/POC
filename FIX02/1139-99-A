CREATE OR ALTER PROCEDURE [SBCES].[RptCostVariance]
    @Debug BIT = 1
AS
BEGIN
    SET NOCOUNT ON;
 
    IF @Debug = 1
    BEGIN
        DECLARE @RbTotal INT;
        SELECT @RbTotal = COUNT(*) FROM SBCES.RbMasterlist;
        PRINT '[DEBUG] SBCES.RbMasterlist total rows (no Active filter applied) = ' + CAST(@RbTotal AS VARCHAR(20));
 
        DECLARE @RbNullKey INT;
        SELECT @RbNullKey = COUNT(*) FROM SBCES.RbMasterlist WHERE RebuiltStockNum IS NULL OR RebuiltStockNum = '';
        PRINT '[DEBUG] RbMasterlist rows with NULL/blank RebuiltStockNum (breaks every join below) = ' + CAST(@RbNullKey AS VARCHAR(20));
    END;
 
    ------------------------------------------------------------------------
    -- STAGE 1: recursive BOM expansion. Adjustment is the compounded usage
    -- fraction from the root down to this node (see header). DECIMAL(28,10)
    -- to keep precision across several levels of multiplication.
    ------------------------------------------------------------------------
    DECLARE @Bom TABLE (RootRbNumber VARCHAR(30), LinkCode VARCHAR(30), Adjustment DECIMAL(28,10), Depth INT);
 
    ;WITH RbBom AS
    (
        SELECT
            rb.RebuiltStockNum       AS RootRbNumber,
            rb.RebuiltStockNum       AS LinkCode,
            CAST(1 AS DECIMAL(28,10)) AS Adjustment,
            0                         AS Depth
        FROM SBCES.RbMasterlist rb
 
        UNION ALL
 
        SELECT
            bom.RootRbNumber,
            spu.MmsRebuiltCode AS LinkCode,
            CAST(
                bom.Adjustment
                    * (ISNULL(TRY_CAST(spu.QtyReqd AS DECIMAL(18,6)), 0)
                       * ISNULL(TRY_CAST(spu.PercentUsage AS DECIMAL(18,6)), 0) / 100.0)
                AS DECIMAL(28,10)
            ) AS Adjustment,
            bom.Depth + 1 AS Depth
        FROM RbBom bom
        JOIN SBCES.ScPartsUsed spu
            ON spu.LinkCode = bom.LinkCode
           AND spu.RebuiltPart = 'Y'
           AND spu.LinkType = 'RB'
        WHERE bom.Depth < 50   -- guard against a cyclic BOM
    )
    INSERT INTO @Bom (RootRbNumber, LinkCode, Adjustment, Depth)
    SELECT RootRbNumber, LinkCode, Adjustment, Depth
    FROM RbBom
    OPTION (MAXRECURSION 100);
 
    IF @Debug = 1
    BEGIN
        DECLARE @BomRows INT, @BomRoots INT, @BomNested INT;
        SELECT @BomRows = COUNT(*), @BomRoots = COUNT(DISTINCT RootRbNumber) FROM @Bom;
        SELECT @BomNested = COUNT(*) FROM @Bom WHERE Depth > 0;
        PRINT '[DEBUG] @Bom total rows (all depths)   = ' + CAST(@BomRows AS VARCHAR(20));
        PRINT '[DEBUG] @Bom distinct root RB numbers    = ' + CAST(@BomRoots AS VARCHAR(20));
        PRINT '[DEBUG] @Bom nested (Depth > 0) rows      = ' + CAST(@BomNested AS VARCHAR(20));
    END;
 
    ------------------------------------------------------------------------
    -- STAGE 2: materials (stock + non-stock), per the real FinalCost-twice
    -- formula, scaled by each node's Adjustment.
    ------------------------------------------------------------------------
    DECLARE @MaterialCost TABLE (RootRbNumber VARCHAR(30), Cost DECIMAL(28,6));
    INSERT INTO @MaterialCost (RootRbNumber, Cost)
    SELECT
        bom.RootRbNumber,
        SUM(bom.Adjustment * parts.Cost)
    FROM @Bom bom
    CROSS APPLY (
        SELECT
            ISNULL(TRY_CAST(SBCES.FinalCost(spu.PercentUsage, spu.QtyReqd, spu.MmsCost,  0) AS DECIMAL(18,6)), 0)
          - ISNULL(TRY_CAST(SBCES.FinalCost(spu.PercentUsage, spu.QtyReqd, spu.CoreCost, 0) AS DECIMAL(18,6)), 0) AS Cost
        FROM SBCES.ScPartsUsed spu
        WHERE spu.LinkCode = bom.LinkCode
          AND spu.RebuiltPart = 'N'
          AND spu.LinkType = 'RB'
 
        UNION ALL
 
        SELECT
            ISNULL(TRY_CAST(SBCES.FinalCost(nsp.PercentUsage, nsp.QtyReqd, nsc.OemPartCost, 0) AS DECIMAL(18,6)), 0)
          - ISNULL(TRY_CAST(SBCES.FinalCost(nsp.PercentUsage, nsp.QtyReqd, nsp.CoreCost,    0) AS DECIMAL(18,6)), 0) AS Cost
        FROM SBCES.NscPartsUsed nsp
        LEFT JOIN SBCES.NonStockCodedParts nsc ON nsc.Id = nsp.Id
        WHERE nsp.LinkCode = bom.LinkCode
          AND nsp.LinkType = 'RB'
    ) parts
    GROUP BY bom.RootRbNumber;
 
    ------------------------------------------------------------------------
    -- STAGE 3: labour, per the real WriteLabour/GetLabourCost formula,
    -- scaled by each node's Adjustment.
    ------------------------------------------------------------------------
    DECLARE @LabourCost TABLE (RootRbNumber VARCHAR(30), Cost DECIMAL(28,6));
    INSERT INTO @LabourCost (RootRbNumber, Cost)
    SELECT
        bom.RootRbNumber,
        SUM(
            (sal.RatePerHour / 60.0)
            * ROUND(ISNULL(TRY_CAST(SBCES.HhmmToMinutes(el.TimeAddition) AS DECIMAL(18,2)), 0) * bom.Adjustment, 0)
            * (ISNULL(TRY_CAST(REPLACE(el.[Usage], ',', '.') AS DECIMAL(18,4)), 0) / 100.0)
        )
    FROM @Bom bom
    JOIN SBCES.EmployeeLabour el
        ON el.LinkNumber = bom.LinkCode
       AND el.TypeId = 'RB'
    JOIN SBCES.EmplClass ec
        ON UPPER(el.LabourDefn) = UPPER(ec.LabourDefn)
    JOIN SBCES.EmployeeSalaries sal
        ON sal.WageGroup = ec.WageGroup
    GROUP BY bom.RootRbNumber;
 
    IF @Debug = 1
    BEGIN
        DECLARE @McRows INT, @LcRows INT;
        SELECT @McRows = COUNT(*) FROM @MaterialCost;
        SELECT @LcRows = COUNT(*) FROM @LabourCost;
        PRINT '[DEBUG] @MaterialCost rows (RBs with any priced material)     = ' + CAST(@McRows AS VARCHAR(20));
        PRINT '[DEBUG] @LabourCost rows (RBs with RB-type labour)             = ' + CAST(@LcRows AS VARCHAR(20));
        PRINT '[DEBUG] --- end of debug block, result set follows ---';
    END;
 
    ------------------------------------------------------------------------
    -- FINAL: one row per RB (all of them - no Active filter), LEFT JOINed
    -- to whichever cost buckets have data (an RB with no materials or no
    -- labour still shows up with 0 in that bucket, not dropped).
    ------------------------------------------------------------------------
    SELECT
        rb.RebuiltStockNum AS RbNumber,
        ROUND(ISNULL(mc.Cost, 0) + ISNULL(lc.Cost, 0), 2) AS TotalCost,
        rb.DetailedDesc    AS DetailedDesc,
        rb.ExternalCost    AS ExternalCost,
        rb.Active          AS Active,
        rb.Keyword         AS Keyword
    FROM SBCES.RbMasterlist rb
    LEFT JOIN @MaterialCost mc ON mc.RootRbNumber = rb.RebuiltStockNum
    LEFT JOIN @LabourCost   lc ON lc.RootRbNumber = rb.RebuiltStockNum
    ORDER BY rb.RebuiltStockNum;
END;
GO
 
