    </div>
</div>

<script type="text/javascript">
    // Configuration
    var partNum = '@ViewBag.PartNum';
    var gridType = '@ViewBag.GridType';
    var totalCostDataUrl = '@Url.Action("GetTotalCostInEstimates", "TotalCost")' +
                           '?id=' + encodeURIComponent(partNum) +
                           '&gridType=' + encodeURIComponent(gridType);

    // Document ready
    $(document).ready(function() {
        console.log("TotalCostTab initialized");
        fetchTotalCostData();

        $("#retryButton").on('click', function() {
            $("#noDataMessage").hide();
            $("#loadingIndicator").show();
            $("#costSummaryContent").hide();
            fetchTotalCostData();
        });
    });

    // Context menu
    $("#reportMenu").kendoContextMenu({
        target: "#reportActions",
        showOn: "mouseenter",
        alignToAnchor: true,
        select: function(e) {
            var id = $(e.item).attr("id");
            if (id === "saveReport") saveReportAsPng();
            if (id === "copyReport") copyReportToClipboard();
        }
    });

    // ===== SAVE AS PNG =====
    function saveReportAsPng() {
        // Get the full content including header
        var fullContent = document.getElementById('reportHeader');
        var contentToExport = document.getElementById('costSummaryContent');

        // Create a wrapper with both header and content
        var wrapper = document.createElement('div');
        wrapper.appendChild(fullContent.cloneNode(true));
        wrapper.appendChild(contentToExport.cloneNode(true));

        // Add the wrapper to the DOM temporarily
        wrapper.id = 'exportWrapper';
        wrapper.style.padding = '20px';
        wrapper.style.background = 'white';
        document.body.appendChild(wrapper);

        kendo.drawing.drawDOM(wrapper, {
            paperSize: "auto",
            margin: "1cm",
            scale: 1
        })
        .then(function(group) {
            return kendo.drawing.exportImage(group);
        })
        .done(function(data) {
            // Remove the temporary wrapper
            document.body.removeChild(wrapper);
            kendo.saveAs({
                dataURI: data,
                fileName: "TotalCostSummary_" + partNum + ".png"
            });
        })
        .catch(function(err) {
            // Remove the temporary wrapper on error
            if (document.getElementById('exportWrapper')) {
                document.body.removeChild(document.getElementById('exportWrapper'));
            }
            kendo.alert("Error generating PNG: " + err.message);
        });
    }

    // ===== COPY TO CLIPBOARD =====
    function copyReportToClipboard() {
        // Get the full content including header
        var fullContent = document.getElementById('reportHeader');
        var contentToExport = document.getElementById('costSummaryContent');

        // Create a wrapper with both header and content
        var wrapper = document.createElement('div');
        wrapper.appendChild(fullContent.cloneNode(true));
        wrapper.appendChild(contentToExport.cloneNode(true));

        // Add the wrapper to the DOM temporarily
        wrapper.id = 'exportWrapper';
        wrapper.style.padding = '20px';
        wrapper.style.background = 'white';
        document.body.appendChild(wrapper);

        kendo.drawing.drawDOM(wrapper, {
            paperSize: "auto",
            margin: "1cm",
            scale: 1
        })
        .then(function(group) {
            return kendo.drawing.exportImage(group);
        })
        .done(function(data) {
            // Remove the temporary wrapper
            document.body.removeChild(wrapper);

            fetch(data)
                .then(res => res.blob())
                .then(blob => {
                    navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
                    kendo.alert("Report copied to clipboard.");
                })
                .catch(function(err) {
                    kendo.alert("Error copying to clipboard: " + err.message);
                });
        })
        .catch(function(err) {
            // Remove the temporary wrapper on error
            if (document.getElementById('exportWrapper')) {
                document.body.removeChild(document.getElementById('exportWrapper'));
            }
            kendo.alert("Error generating image: " + err.message);
        });
    }

    // Data fetching
    function fetchTotalCostData() {
        console.log("Fetching data from:", totalCostDataUrl);

        $.ajax({
            url: totalCostDataUrl,
            type: 'GET',
            dataType: 'json',
            timeout: 30000,
            success: function(response) {
                console.log("Response received:", response);
                if (response && response.Data && response.Data.length > 0) {
                    var costData = response.Data[0];
                    console.log("Cost data:", costData);
                    populateAllSections(costData);
                    $("#loadingIndicator").hide();
                    $("#costSummaryContent").show();
                    $("#noDataMessage").hide();
                } else {
                    console.log("No data in response");
                    showNoDataMessage();
                }
            },
            error: function(xhr, status, error) {
                console.error("Error fetching cost data:", status, error);
                showNoDataMessage();
            }
        });
    }

    // Helper functions
    function getVal(value) {
        if (value === null || value === undefined) return 0;
        var num = parseFloat(value);
        return isNaN(num) ? 0 : num;
    }

    function formatMoney(val) {
        return '$' + val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function setText(id, value) {
        $(id).text(formatMoney(value));
    }

    function setNumber(id, value) {
        var num = getVal(value);
        $(id).text(num.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }));
    }

    function setNumberDecimal(id, value) {
        var num = getVal(value);
        $(id).text(num.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }

    // Main population function
    function populateAllSections(costData) {
        // SECTION 1: Vehicle Details
        $('#vehicleSeries').text(costData.VehicleSeries || '-');
        $('#vehicleDescription').text(costData.VehicleDescription || '-');

        // SECTION 2: Material Cost Summary
        var totalParts = (costData.TotalStockPartsCount || 0) + (costData.TotalNonStockPartsCount || 0) + (costData.TotalRebuiltPartsCount || 0);
        $('#materialCountBadge').text(totalParts + ' parts');
        setNumber('#stockPartsCount', costData.TotalStockPartsCount);
        setNumber('#nonStockPartsCount', costData.TotalNonStockPartsCount);
        setNumber('#rebuiltPartsCount', costData.TotalRebuiltPartsCount);
        setText('#avgStockCost', costData.AverageStockPartCost);
        setText('#avgNonStockCost', costData.AverageNonStockPartCost);
        setText('#avgRebuiltCost', costData.AverageRebuiltPartCost);

        // SECTION 3: Material Lines
        populateMaterialLines(costData.MaterialLines || []);

        // SECTION 4: Labour Hours Summary
        setNumberDecimal('#totalHours', costData.TotalLabourHours);
        setNumberDecimal('#totalEffectiveHours', costData.TotalEffectiveHours);
        setNumberDecimal('#totalAdjustedHours', costData.TotalAdjustedHours);

        // SECTION 5: Labour Task Summary
        populateTaskSummary(costData.LabourTasks || []);

        // Material Section (side by side)
        var scParts = getVal(costData.SCPartsMaterialCost);
        var nscParts = getVal(costData.NSCSCPartsMaterialCost);
        var rbParts = getVal(costData.RBPartsMaterialCost);
        var partsTotalNoTax = getVal(costData.MaterialTotalCostNoTax);
        var materialTax = getVal(costData.MaterialTotalTaxAmount);
        var materialWithTax = getVal(costData.MaterialTotalWithTax);

        // Labour values
        var labourFringe = getVal(costData.LabourFringe);
        var labourBenefits = getVal(costData.LabourBenefits);
        var blendedFringeCost = getVal(costData.BlendedFringeBenefitCost);
        var labourOverhead = getVal(costData.LabourOverhead);
        var totalLabour = getVal(costData.FinalLabourCost);
        var totalWithTax = materialWithTax + totalLabour;

        setText("#scPartsDisplay", scParts);
        setText("#nscPartsDisplay", nscParts);
        setText("#rbCostDisplay", rbParts);
        setText("#partsTotalDisplay", partsTotalNoTax);
        setText("#materialTaxDisplay", materialTax);
        setText("#materialWithTaxDisplay", materialWithTax);

        setText("#labourFringeDisplay", labourFringe);
        setText("#labourBenefitsDisplay", labourBenefits);
        setText("#blendedFringeCostDisplay", blendedFringeCost);
        setText("#labourOverheadDisplay", labourOverhead);
        setText("#totalLabourCostDisplay", totalLabour);

        setText("#totalMaterialBoxDisplay", materialWithTax);
        setText("#totalLabourBoxDisplay", totalLabour);
        setText("#totalWithTaxDisplay", totalWithTax);
    }

    // Populate Material Lines
    function populateMaterialLines(lines) {
        var tbody = $('#materialLinesBody');
        var badge = $('#materialLinesBadge');
        var totalItems = lines.length;
        badge.text(totalItems + ' items');

        if (totalItems === 0) {
            tbody.html('<tr><td colspan="7" style="text-align:center; color:#6c757d; padding:20px;">No material items found</td></tr>');
            return;
        }

        var html = '';
        var typeTotals = { Stock: 0, Rebuilt: 0, 'Non-Stock': 0 };
        var grandTotal = 0;

        lines.forEach(function(item) {
            var type = item.Type || 'Stock';
            var typeClass = type.toLowerCase().replace('-', '');
            var badgeClass = typeClass === 'nonstock' ? 'nonstock' : typeClass;
            var totalCost = getVal(item.TotalCost);

            if (typeTotals[type] !== undefined) {
                typeTotals[type] += totalCost;
            }
            grandTotal += totalCost;

            html += '<tr class="type-' + typeClass + '">' +
                '<td><span class="type-badge ' + badgeClass + '">' + type + '</span></td>' +
                '<td>' + (item.StockCode || '-') + '</td>' +
                '<td>' + (item.CC || '-') + '</td>' +
                '<td>' + (item.Description || 'N/A') + '</td>' +
                '<td style="text-align:right;">' + getVal(item.Quantity).toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + formatMoney(getVal(item.UnitCost)) + '</td>' +
                '<td style="text-align:right;">' + getVal(item.PercentUsage).toFixed(1) + '%</td>' +
                '<td style="text-align:right; font-weight:600;">' + formatMoney(totalCost) + '</td>' +
                '</tr>';
        });

        // Add type subtotals
        var typeOrder = ['Stock', 'Rebuilt', 'Non-Stock'];
        typeOrder.forEach(function(type) {
            if (typeTotals[type] > 0) {
                html += '<tr class="subtotal-row">' +
                    '<td colspan="6" style="text-align:right; font-weight:600;">Subtotal - ' + type + '</td>' +
                    '<td style="text-align:right; font-weight:600;">' + formatMoney(typeTotals[type]) + '</td>' +
                    '</tr>';
            }
        });

        // Add grand total
        html += '<tr class="total-row">' +
            '<td colspan="6" style="text-align:right; font-weight:800; font-size:1.05em;">GRAND TOTAL</td>' +
            '<td style="text-align:right; font-weight:800; font-size:1.05em;">' + formatMoney(grandTotal) + '</td>' +
            '</tr>';

        tbody.html(html);
    }

    // Populate Task Summary
    function populateTaskSummary(tasks) {
        var tbody = $('#taskSummaryBody');
        var badge = $('#taskCountBadge');
        badge.text(tasks.length + ' tasks');

        if (tasks.length === 0) {
            tbody.html('<tr><td colspan="8" style="text-align:center; color:#6c757d; padding:20px;">No labour tasks found</td></tr>');
            return;
        }

        var html = '';
        var totalHours = 0, totalEffective = 0, totalAdjusted = 0, totalCost = 0;

        tasks.forEach(function(task) {
            var hours = getVal(task.Hours);
            var effective = getVal(task.EffectiveHours);
            var adjusted = getVal(task.AdjustedHours);
            var cost = getVal(task.TotalCost);
            var count = getVal(task.Count);

            totalHours += hours;
            totalEffective += effective;
            totalAdjusted += adjusted;
            totalCost += cost;

            html += '<tr>' +
                '<td>' + (task.Task || 'Unnamed') + '</td>' +
                '<td>' + (task.LabourDefinition || 'N/A') + '</td>' +
                 '<td>' + (item.CC || '-') + '</td>' +
                '<td style="text-align:right;">' + hours.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + effective.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + adjusted.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + formatMoney(getVal(task.RatePerHour)) + '</td>' +
                '<td style="text-align:right; font-weight:600;">' + formatMoney(cost) + '</td>' +
                '<td style="text-align:center;">' + count + '</td>' +
                '</tr>';
        });

        // Total row
        html += '<tr class="total-row">' +
            '<td colspan="2"><strong>TOTAL</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalHours.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalEffective.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalAdjusted.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"></td>' +
            '<td style="text-align:right;"><strong>' + formatMoney(totalCost) + '</strong></td>' +
            '<td style="text-align:center;"><strong>' + tasks.length + '</strong></td>' +
            '</tr>';

        tbody.html(html);
    }

    function showNoDataMessage() {
        $("#loadingIndicator").hide();
        $("#costSummaryContent").hide();
        $("#noDataMessage").show();
    }

    controller 
      private async Task<IEnumerable<TotalCostInEstimates>> GetTotalCostInVehicleEstimatesWithDetails(string id, string gridType)
  {
      try
      {
          var result = new List<TotalCostInEstimates>();
          var vehicleId = id;

          // STEP 1: Get Vehicle Details
          var vehicleDetails = await _dbConnection.QueryFirstOrDefaultAsync<dynamic>(
              @"SELECT ISNULL(ProjDesc, 'N/A') AS ProjDesc, ISNULL(VehSeriesCode, 'N/A') AS VehSeriesCode 
        FROM SBCES.VehicleList WHERE VehicleListId = @Id",
              new { Id = vehicleId });

          // STEP 2: Get Material Costs - Using CTE to avoid subquery in aggregate
          var materialCosts = await _dbConnection.QueryFirstOrDefaultAsync<dynamic>(
              @"
      WITH MaterialCosts AS (
          SELECT 
              TRY_CAST(SBCES.FinalCost(CAST(ISNULL(SUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(SUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(SCP.MmsNewCost, 0), 0) AS DECIMAL(18,2)) AS Cost,
              'SC' AS Type
          FROM SBCES.ScPartsUsed SUS
          LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
          WHERE SUS.LinkCode = @Id AND SUS.LinkType = 'BUS' AND SUS.RebuiltPart = 'N'
          UNION ALL
          SELECT 
              TRY_CAST(SBCES.FinalCost(CAST(ISNULL(SUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(SUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(SUS.MmsCost, 0), 0) AS DECIMAL(18,2)) AS Cost,
              'RB' AS Type
          FROM SBCES.ScPartsUsed SUS
          LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
          WHERE SUS.LinkCode = @Id AND SUS.LinkType = 'BUS' AND SUS.RebuiltPart = 'Y'
          UNION ALL
          SELECT 
              TRY_CAST(SBCES.FinalCost(CAST(ISNULL(NSUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(NSUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(NSUS.Cost, 0), 0) AS DECIMAL(18,2)) AS Cost,
              'NSC' AS Type
          FROM SBCES.NscPartsUsed NSUS 
          WHERE NSUS.LinkCode = @Id AND NSUS.LinkType = 'BUS'
      )
      SELECT 
          ISNULL((SELECT SUM(Cost) FROM MaterialCosts WHERE Type = 'SC'), 0) AS SCPartsMaterialCost,
          ISNULL((SELECT SUM(Cost) FROM MaterialCosts WHERE Type = 'RB'), 0) AS RBPartsMaterialCost,
          ISNULL((SELECT SUM(Cost) FROM MaterialCosts WHERE Type = 'NSC'), 0) AS NSCSCPartsMaterialCost,
          ISNULL((SELECT SUM(CoreCost) FROM SBCES.SCPartsUsed WHERE LinkCode = @Id AND LinkType = 'BUS'), 0) AS CoreCost",
              new { Id = vehicleId });

          // STEP 3: Get Labour Costs - Simplified with CTE
          var labourCosts = await _dbConnection.QueryFirstOrDefaultAsync<dynamic>(
              @"
      DECLARE @NonProductiveAdj DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'NON_PRODUCTIVE_ADJUSTMENT'), '1'), ',', '.') AS DECIMAL(18,6));
      DECLARE @Fringe DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'FRINGE'), '0'), ',', '.') AS DECIMAL(18,6));
      DECLARE @Benefit DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'BENEFIT'), '0'), ',', '.') AS DECIMAL(18,6));
      DECLARE @Overhead DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'OVERHEAD'), '0'), ',', '.') AS DECIMAL(18,6));
      DECLARE @TaxRate DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'TAX_RATE'), '0'), ',', '.') AS DECIMAL(18,6));

      -- Get labour data with rate lookup in a CTE
      WITH LabourData AS (
          SELECT 
              (CAST(ISNULL(LEFT(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) - 1), 0) AS DECIMAL(18,2)) + 
               CAST(ISNULL(SUBSTRING(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) + 1, LEN(EL.HrsReqd)), 0) AS DECIMAL(18,2)) / 60) AS DecimalHrs,
              CAST(NULLIF(EL.Usage, '') AS DECIMAL(18,2)) AS UsagePercent,
              ISNULL((SELECT TOP 1 ES.RatePerHour FROM CES.SBCES.EmployeeSalaries ES
                      WHERE ES.WageGroup = (SELECT TOP 1 EC.WageGroup FROM CES.SBCES.EmplClass EC
                                            WHERE EC.LabourDefn LIKE '%' + EL.LabourDefn + '%')), 0) AS RatePerHour,
              EL.LabourDefn
          FROM SBCES.EmployeeLabour EL
          WHERE EL.LinkNumber = @Id AND EL.TypeId = 'BUS'
      )
      SELECT 
          ISNULL(SUM(
              (DecimalHrs * UsagePercent / 100) / @NonProductiveAdj * RatePerHour
          ), 0) AS TotalLabourCost,
          @Fringe AS FringeRate,
          @Benefit AS BenefitRate,
          @Overhead AS OverheadRate,
          @TaxRate AS TaxRate
      FROM LabourData",
              new { Id = vehicleId });

          // STEP 4: Get Labour Tasks - Simplified with CTE
          var labourTasks = await _dbConnection.QueryAsync<LabourTaskSummary>(
              @"
      DECLARE @NonProductiveAdj DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'NON_PRODUCTIVE_ADJUSTMENT'), '1'), ',', '.') AS DECIMAL(18,6));

      WITH LabourData AS (
          SELECT 
              EL.Task,
              EL.LabourDefn,
                  EL.CostCentre as CC,

              (CAST(ISNULL(LEFT(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) - 1), 0) AS DECIMAL(18,2)) + 
               CAST(ISNULL(SUBSTRING(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) + 1, LEN(EL.HrsReqd)), 0) AS DECIMAL(18,2)) / 60) AS DecimalHrs,
              CAST(NULLIF(EL.Usage, '') AS DECIMAL(18,2)) AS UsagePercent,
              ISNULL((SELECT TOP 1 ES.RatePerHour FROM CES.SBCES.EmployeeSalaries ES
                      WHERE ES.WageGroup = (SELECT TOP 1 EC.WageGroup FROM CES.SBCES.EmplClass EC
                                            WHERE EC.LabourDefn LIKE '%' + EL.LabourDefn + '%')), 0) AS RatePerHour
          FROM SBCES.EmployeeLabour EL
          WHERE EL.LinkNumber = @Id AND EL.TypeId = 'BUS'
      )
      SELECT 
          ISNULL(Task, 'Unnamed Task') AS Task,
          ISNULL(LabourDefn, 'N/A') AS LabourDefinition,
          COUNT(*) AS Count,
          SUM(DecimalHrs) AS Hours,
          SUM(DecimalHrs * UsagePercent / 100) AS EffectiveHours,
          SUM(DecimalHrs / @NonProductiveAdj) AS AdjustedHours,
          AVG(RatePerHour) AS RatePerHour,
          SUM((DecimalHrs * UsagePercent / 100) / @NonProductiveAdj * RatePerHour) AS TotalCost
      FROM LabourData
      GROUP BY Task, LabourDefn
      ORDER BY Task",
              new { Id = vehicleId });

          // STEP 5: Get Stock Parts (Material Lines)
          var stockParts = await _dbConnection.QueryAsync<dynamic>(
              @"
      SELECT 
          'Stock' AS Type,
          SUS.MMSStockCode AS StockCode,
           SUS.CostCentre as CC,
          ISNULL(SCP.DetailedDesc, 'N/A') AS Description,
          SUS.QtyReqd AS Quantity,
          ISNULL(SCP.MmsNewCost, 0) AS UnitCost,
          SUS.PercentUsage,
          TRY_CAST(SBCES.FinalCost(CAST(ISNULL(SUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(SUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(SCP.MmsNewCost, 0), 0) AS DECIMAL(18,2)) AS TotalCost,
          '' AS Supplier
      FROM SBCES.ScPartsUsed SUS
      LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
      WHERE SUS.LinkCode = @Id AND SUS.LinkType = 'BUS' AND SUS.RebuiltPart = 'N'
      ORDER BY SUS.MMSStockCode",
              new { Id = vehicleId });

          // STEP 6: Get Rebuilt Parts (Material Lines)
          var rebuiltParts = await _dbConnection.QueryAsync<dynamic>(
              @"
      SELECT 
          'Rebuilt' AS Type,
          SUS.MMSStockCode AS StockCode,
          SUS.CostCentre as CC,
          ISNULL(SCP.DetailedDesc, 'N/A') AS Description,
          SUS.QtyReqd AS Quantity,
          ISNULL(SUS.MmsCost, 0) AS UnitCost,
          SUS.PercentUsage,
          TRY_CAST(SBCES.FinalCost(CAST(ISNULL(SUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(SUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(SUS.MmsCost, 0), 0) AS DECIMAL(18,2)) AS TotalCost,
          '' AS Supplier
      FROM SBCES.ScPartsUsed SUS
      LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
      WHERE SUS.LinkCode = @Id AND SUS.LinkType = 'BUS' AND SUS.RebuiltPart = 'Y'
      ORDER BY SUS.MMSStockCode",
              new { Id = vehicleId });

          // STEP 7: Get Non-Stock Parts (Material Lines)
          var nonStockParts = await _dbConnection.QueryAsync<dynamic>(
              @"
      SELECT 
          'Non-Stock' AS Type,
          NSUS.OrigSuppNum AS StockCode,
          NSUS.CostCentre as CC,

          ISNULL(NSUS.OrigSupplierName, 'N/A') AS Description,
          NSUS.QtyReqd AS Quantity,
          ISNULL(NSUS.Cost, 0) AS UnitCost,
          NSUS.PercentUsage,
          TRY_CAST(SBCES.FinalCost(CAST(ISNULL(NSUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(NSUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(NSUS.Cost, 0), 0) AS DECIMAL(18,2)) AS TotalCost,
          ISNULL(NSUS.OrigSupplierName, '') AS Supplier
      FROM SBCES.NscPartsUsed NSUS
      WHERE NSUS.LinkCode = @Id AND NSUS.LinkType = 'BUS'
      ORDER BY NSUS.OrigSuppNum",
              new { Id = vehicleId });

          // STEP 8: Build the result object
          var totalCost = new TotalCostInEstimates
          {
              LinkCode = vehicleId,
              VehicleDescription = vehicleDetails?.ProjDesc ?? "N/A",
              VehicleSeries = vehicleDetails?.VehSeriesCode ?? "N/A",

              // Material Costs
              SCPartsMaterialCost = Convert.ToDecimal(materialCosts?.SCPartsMaterialCost ?? 0),
              NSCSCPartsMaterialCost = Convert.ToDecimal(materialCosts?.NSCSCPartsMaterialCost ?? 0),
              RBPartsMaterialCost = Convert.ToDecimal(materialCosts?.RBPartsMaterialCost ?? 0),
              CoreCost = Convert.ToDecimal(materialCosts?.CoreCost ?? 0),

              // Material Summary
              TotalStockPartsCount = stockParts.Count(),
              TotalNonStockPartsCount = nonStockParts.Count(),
              TotalRebuiltPartsCount = rebuiltParts.Count(),
          };

          // Calculate material totals
          var scPartsCost = totalCost.SCPartsMaterialCost;
          var rbPartsCost = totalCost.RBPartsMaterialCost;
          var nscPartsCost = totalCost.NSCSCPartsMaterialCost;
          var materialTotalNoTax = scPartsCost + rbPartsCost + nscPartsCost;
          var taxRate = Convert.ToDecimal(labourCosts?.TaxRate ?? 0);
          var materialTax = (materialTotalNoTax * taxRate)/100;
          var materialTotalWithTax = materialTotalNoTax + materialTax;

          totalCost.MaterialTotalCostNoTax = materialTotalNoTax;
          totalCost.MaterialTotalTaxAmount = materialTax;
          totalCost.MaterialTotalWithTax = materialTotalWithTax;

          // Calculate averages
          totalCost.AverageStockPartCost = stockParts.Any() ? Convert.ToDecimal(stockParts.Average(p => (decimal?)p.UnitCost) ?? 0) : 0;
          totalCost.AverageNonStockPartCost = nonStockParts.Any() ? Convert.ToDecimal(nonStockParts.Average(p => (decimal?)p.UnitCost) ?? 0) : 0;
          totalCost.AverageRebuiltPartCost = rebuiltParts.Any() ? Convert.ToDecimal(rebuiltParts.Average(p => (decimal?)p.UnitCost) ?? 0) : 0;

          // Labour Costs
          var totalLabourCost = Convert.ToDecimal(labourCosts?.TotalLabourCost ?? 0);
          var fringeRate = Convert.ToDecimal(labourCosts?.FringeRate ?? 0);
          var benefitRate = Convert.ToDecimal(labourCosts?.BenefitRate ?? 0);
          var overheadRate = Convert.ToDecimal(labourCosts?.OverheadRate ?? 0);

          var labourFringe = totalLabourCost * fringeRate;
          var labourBenefits = (totalLabourCost + labourFringe) * benefitRate;
          var blendedFringeBenefitPercent = totalLabourCost > 0 ? ((labourFringe + labourBenefits) / totalLabourCost) * 100 : 0;
          var blendedFringeBenefitCost = labourFringe + labourBenefits;
          var labourOverhead = totalLabourCost * overheadRate;
          var finalLabourCost = totalLabourCost + labourFringe + labourBenefits + labourOverhead;

          totalCost.TotalLabourCost = totalLabourCost;
          totalCost.LabourFringe = labourFringe;
          totalCost.LabourBenefits = labourBenefits;
          totalCost.BlendedFringeBenefitPercent = blendedFringeBenefitPercent;
          totalCost.BlendedFringeBenefitCost = blendedFringeBenefitCost;
          totalCost.LabourOverhead = labourOverhead;
          totalCost.FinalLabourCost = finalLabourCost;

          // Labour Hours Summary
          totalCost.LabourTasks = labourTasks.ToList();
          totalCost.TotalLabourHours = labourTasks.Sum(t => t.Hours);
          totalCost.TotalEffectiveHours = labourTasks.Sum(t => t.EffectiveHours);
          totalCost.TotalAdjustedHours = labourTasks.Sum(t => t.AdjustedHours);

          // Material Lines
          var materialLines = new List<MaterialLineItem>();
          foreach (var p in stockParts)
          {
              materialLines.Add(new MaterialLineItem
              {
                  Type = p.Type,
                  StockCode = p.StockCode,
                  CC = p.CC,
                  Description = p.Description,
                  Quantity = Convert.ToDecimal(p.Quantity ?? 0),
                  UnitCost = Convert.ToDecimal(p.UnitCost ?? 0),
                  PercentUsage = Convert.ToDecimal(p.PercentUsage ?? 0),
                  TotalCost = Convert.ToDecimal(p.TotalCost ?? 0),
                  Supplier = p.Supplier
              });
          }
          foreach (var p in rebuiltParts)
          {
              materialLines.Add(new MaterialLineItem
              {
                  Type = p.Type,
                  StockCode = p.StockCode,
                  CC = p.CC,
                  Description = p.Description,
                  Quantity = Convert.ToDecimal(p.Quantity ?? 0),
                  UnitCost = Convert.ToDecimal(p.UnitCost ?? 0),
                  PercentUsage = Convert.ToDecimal(p.PercentUsage ?? 0),
                  TotalCost = Convert.ToDecimal(p.TotalCost ?? 0),
                  Supplier = p.Supplier
              });
          }
          foreach (var p in nonStockParts)
          {
              materialLines.Add(new MaterialLineItem
              {
                  Type = p.Type,
                  StockCode = p.StockCode,
                  CC = p.CC,
                  Description = p.Description,
                  Quantity = Convert.ToDecimal(p.Quantity ?? 0),
                  UnitCost = Convert.ToDecimal(p.UnitCost ?? 0),
                  PercentUsage = Convert.ToDecimal(p.PercentUsage ?? 0),
                  TotalCost = Convert.ToDecimal(p.TotalCost ?? 0),
                  Supplier = p.Supplier
              });
          }

          totalCost.MaterialLines = materialLines
              .Where(m => m.TotalCost > 0)
              .OrderBy(m => m.Type)
              .ThenBy(m => m.StockCode)
              .ToList();

          // Grand Totals
          totalCost.TotalWithoutTax = finalLabourCost + materialTotalNoTax;
          totalCost.TotalWithTax = finalLabourCost + materialTotalWithTax;

          result.Add(totalCost);
          return result;
      }
      catch (Exception ex)
      {
          Console.WriteLine($"Error in GetTotalCostInVehicleEstimatesWithDetails: {ex.Message}");
          Console.WriteLine($"Stack Trace: {ex.StackTrace}");
          throw;
      }
  }
</script>
