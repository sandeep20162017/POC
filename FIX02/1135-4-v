/* =====================================================================
   PICS - Script 3: views (converted from Oracle)
   Run after script 1 (tables must exist). Safe to re-run (CREATE OR ALTER).

   Conversion notes:
     - Oracle (+) outer joins        -> LEFT JOIN
     - Oracle a || ' ' || b          -> CONCAT(a, ' ', b)   (Oracle treats NULL as '' in ||)
     - RPAD(x,3,'0') / LPAD(x,6,'0') -> LEFT/REPLICATE equivalents (Oracle also truncates when longer)
     - V_WORKORDERS_MMS: the original "ORDER_TYPE=+ORDER_TYPES.ORDER_TYPE" is a plain
       equality (unary plus, not an outer join), so it is an INNER JOIN here.
     - INSTEAD OF trigger on V_WO_OPS and other triggers are not migrated (read-only database).
   ===================================================================== */
USE PICS;
GO

/* 1. V_WO2CLOSE */
CREATE OR ALTER VIEW PICS.V_WO2CLOSE AS
SELECT w.WO_ID, w.DATE_DONE, w.QUANTITY_REQ, w.QUANTITY, w.SOPS,
       wo.OP_ID, wo.QTY_IN, wo.QTY_OUT
FROM PICS.WORKORDERS w
JOIN PICS.WO_OPS wo ON wo.WO_ID = w.WO_ID
WHERE w.DATE_DONE IS NULL
  AND wo.LOCATION_ID = N'K'
  AND wo.F_ARRIVE = N'Y';
GO

/* 2. V_WORKORDERS */
CREATE OR ALTER VIEW PICS.V_WORKORDERS AS
SELECT w.WO_ID, w.JOB_ID, w.CODE_ID, w.JOB_TITLE, w.JOB_TYPE, w.CURRENT_OPERATION,
       w.DATE_ISSUE, w.ORDER_TYPE, w.ORDER_ID, w.STATUS, w.DATE_DONE, w.WO_COMMENT,
       w.PRIORITY, w.VEHICLE_ID, w.VEHICLE_TYPE, w.QUANTITY_REQ, w.QUANTITY, w.SOPS,
       w.DELIVER_TO, w.DWG, w.WO_MODE, w.REMARKS, o.ORDER_TYPE_DESC
FROM PICS.WORKORDERS w
LEFT JOIN PICS.ORDER_TYPES o ON w.ORDER_TYPE = o.ORDER_TYPE;
GO

/* 3. V_WO_MATERIALS */
CREATE OR ALTER VIEW PICS.V_WO_MATERIALS AS
SELECT m.WO_ID, m.ITEM_ID, m.ORDER_LOCATION_ID, m.MATERIAL, m.QUANTITY, m.UNITS,
       m.STOCK_ID, m.ACCOUNT_ID,
       CONCAT(l.CC, N' ', l.CC_DESC) AS COSTCENTER
FROM PICS.WO_MATERIALS m
JOIN PICS.LOCATIONS l ON m.ORDER_LOCATION_ID = l.LOCATION_ID;
GO

/* 4. V_WO_OPS */
CREATE OR ALTER VIEW PICS.V_WO_OPS AS
SELECT w.WO_ID, w.JOB_ID, w.CODE_ID, w.JOB_TYPE, w.DATE_ISSUE,
       o.ORDER_TYPE_DESC, w.STATUS, w.DATE_DONE,
       w.PRIORITY, w.VEHICLE_TYPE, w.WO_MODE,
       w.WO_COMMENT, w.QUANTITY_REQ, w.QUANTITY,
       wo.OP_ID, wo.LOCATION_ID, wo.OP_DESC, wo.F_ARRIVE,
       wo.DATE_ARRIVED, wo.DATE_START, wo.DATE_FINISH, wo.DATE_PICKUP,
       wo.USER_START, wo.USER_FINISH,
       CONCAT(l.CC, N' ', l.CC_DESC) AS COSTCENTER,
       wo.OP_COMMENT, wo.QTY_IN, wo.QTY_OUT
FROM PICS.WORKORDERS w
JOIN PICS.WO_OPS wo ON w.WO_ID = wo.WO_ID
JOIN PICS.LOCATIONS l ON wo.LOCATION_ID = l.LOCATION_ID
LEFT JOIN PICS.ORDER_TYPES o ON w.ORDER_TYPE = o.ORDER_TYPE
WHERE w.DATE_DONE IS NULL;
GO

/* 5. V_WO_OPS_BRWS */
CREATE OR ALTER VIEW PICS.V_WO_OPS_BRWS AS
SELECT wo.WO_ID, wo.OP_ID, wo.LOCATION_ID, wo.OP_DESC, wo.EST_HOURS,
       wo.DATE_ARRIVED, wo.DATE_START, wo.DATE_FINISH, wo.DATE_PICKUP,
       wo.OP_COMMENT, wo.USER_START, wo.USER_FINISH, wo.F_ARRIVE, wo.USER_ARRIVE,
       wo.QTY_IN, wo.QTY_OUT,
       CONCAT(l.CC, N' ', l.CC_DESC) AS COSTCENTER
FROM PICS.WO_OPS wo
JOIN PICS.LOCATIONS l ON wo.LOCATION_ID = l.LOCATION_ID;
GO

/* 6. V_WO_OPS_STORES */
CREATE OR ALTER VIEW PICS.V_WO_OPS_STORES AS
SELECT W.WO_ID, W.JOB_ID, W.CODE_ID, W.JOB_TYPE, W.DATE_ISSUE,
       W.STATUS, W.DATE_DONE, W.PRIORITY, W.JOB_TITLE,
       W.VEHICLE_TYPE, W.WO_MODE, W.WO_COMMENT, W.QUANTITY_REQ,
       O.ORDER_TYPE_DESC,
       A.OP_ID, A.LOCATION_ID, A.OP_DESC, A.F_ARRIVE,
       A.DATE_ARRIVED, A.DATE_START, A.DATE_FINISH, A.DATE_PICKUP,
       A.USER_START, A.USER_FINISH,
       CONCAT(LP.CC, N' ', LP.CC_DESC) AS COSTCENTER,
       A.OP_COMMENT, A.QTY_IN, A.QTY_OUT,
       A.LOCATION_ID AS PU_LOCATION_ID,
       CONCAT(LP.CC, N' ', LP.CC_DESC) AS LOCATION,
       B.LOCATION_ID AS DEST_LOCATION_ID,
       CONCAT(LD.CC, N' ', LD.CC_DESC) AS DESTINATION
FROM PICS.WO_OPS A
JOIN PICS.WO_OPS B
  ON A.WO_ID = B.WO_ID
 AND B.OP_ID = (SELECT MIN(C.OP_ID) FROM PICS.WO_OPS C
                WHERE C.WO_ID = A.WO_ID AND C.OP_ID > A.OP_ID)
JOIN PICS.WORKORDERS W ON W.WO_ID = A.WO_ID
JOIN PICS.LOCATIONS LP ON A.LOCATION_ID = LP.LOCATION_ID
JOIN PICS.LOCATIONS LD ON B.LOCATION_ID = LD.LOCATION_ID
LEFT JOIN PICS.ORDER_TYPES O ON W.ORDER_TYPE = O.ORDER_TYPE
WHERE W.DATE_DONE IS NULL;
GO

/* 7. V_WO_STORES_D */
CREATE OR ALTER VIEW PICS.V_WO_STORES_D AS
SELECT A.WO_ID, A.OP_ID, A.DATE_FINISH, A.DATE_PICKUP,
       W.JOB_TITLE, W.WO_COMMENT, W.CODE_ID, W.JOB_ID, W.JOB_TYPE,
       W.WO_MODE, W.DATE_ISSUE, W.VEHICLE_TYPE, W.DATE_DONE, W.PRIORITY,
       O.ORDER_TYPE_DESC,
       A.LOCATION_ID AS PU_LOCATION_ID,
       CONCAT(LP.CC, N' ', LP.CC_DESC) AS LOCATION,
       B.LOCATION_ID AS DEST_LOCATION_ID,
       CONCAT(LD.CC, N' ', LD.CC_DESC) AS DESTINATION
FROM PICS.WO_OPS A
JOIN PICS.WO_OPS B
  ON A.WO_ID = B.WO_ID
 AND B.OP_ID = (SELECT MIN(C.OP_ID) FROM PICS.WO_OPS C
                WHERE C.WO_ID = A.WO_ID AND C.OP_ID > A.OP_ID)
JOIN PICS.WORKORDERS W ON W.WO_ID = A.WO_ID
JOIN PICS.LOCATIONS LP ON A.LOCATION_ID = LP.LOCATION_ID
JOIN PICS.LOCATIONS LD ON B.LOCATION_ID = LD.LOCATION_ID
LEFT JOIN PICS.ORDER_TYPES O ON W.ORDER_TYPE = O.ORDER_TYPE
WHERE W.DATE_DONE IS NULL
  AND A.DATE_FINISH IS NOT NULL;
GO

/* 8. V_WORKORDERS_MMS */
CREATE OR ALTER VIEW PICS.V_WORKORDERS_MMS AS
SELECT w.WO_ID,
       w.ORDER_TYPE AS PICS_ORDER_TYPE,
       w.STATUS     AS PICS_STATUS,
       o.CODE, w.CODE_ID, w.ORDER_ID,
       -- RPAD(CODE,3,'0')
       LEFT(o.CODE + REPLICATE(N'0', 3), 3) AS PICS_PREFIX,
       -- LPAD(ORDER_ID,6,'0')
       LEFT(REPLICATE(N'0', CASE WHEN LEN(w.ORDER_ID) < 6 THEN 6 - LEN(w.ORDER_ID) ELSE 0 END)
            + w.ORDER_ID, 6) AS PICS_RIGHTORDNUM,
       CONCAT(
         LEFT(o.CODE + REPLICATE(N'0', 3), 3),
         LEFT(REPLICATE(N'0', CASE WHEN LEN(w.ORDER_ID) < 6 THEN 6 - LEN(w.ORDER_ID) ELSE 0 END)
              + w.ORDER_ID, 6)
       ) AS PICS_ORDERNUM
FROM PICS.WORKORDERS w
JOIN PICS.ORDER_TYPES o ON w.ORDER_TYPE = o.ORDER_TYPE
WHERE w.CODE_ID IS NOT NULL
  AND w.ORDER_ID IS NOT NULL
  AND w.ORDER_TYPE <> 0
  AND w.ORDER_TYPE <> 1
  AND w.ORDER_TYPE <> 3
  AND w.ORDER_TYPE <> 5;
GO

-- Sanity check: should return 8
SELECT COUNT(*) AS view_count FROM sys.views WHERE schema_id = SCHEMA_ID(N'PICS');
GO
