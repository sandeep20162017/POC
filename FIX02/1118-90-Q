}

@(Html.Kendo().ComboBox()
    .Name("OrigSupplierName")
    .DataTextField("Text")
    .DataValueField("Text")
    .Filter(FilterType.Contains)
    .ClearButton(false)
    .AutoBind(false)
    //.MinLength(1)
    .Placeholder("Select supplier name...")
    .HtmlAttributes(new Dictionary<string, object>
    {
        
         { "name", fieldName }, //ssk7 Disable columns on edit
        { "data-column", fieldName }, //ssk7 Disable columns on edit
         {"required", "required"},
    })
    .Events(e => e.Select("onNscPartsComboBoxSelect"))
    .DataSource(source =>
    {
        source.Read(read =>
        {
            read.Url(Url.Action("GetSupplierNames", "AutoComplete"))
