.k-grid {
    height: calc(100% - 100px);
}
.k-grid.k-grid-content {
    height: calc(100% - 25px) !important;
}
    */
/* End of Grid styles */

/* Pager styles */
.k-grid-pager .k-input-inner {
    padding-inline: 0.55rem;
    text-align: center;
}
/* End of Pager styles */

/* Bootstrap modal*/
.modal-header {
    cursor: move;
}
/* End of Bootstrap modal*/

.k-dialog-content {
    width: 700px;
}

#menu-tabs {
    /*border-bottom: 1px solid #dee2e6;*/
    background-color: #e4e7eb;
}

.card-header {
    padding: 0.5em 0.75em 0.5em 0.75em;
    background-color: rgba(0, 0, 0, 0.03);
}

.k-dialog .k-window-titlebar::before {
    content: 'Alert';
}

.k-dialog .k-window-titlebar {
    display: flex;
    justify-content: space-between;
}

    .k-dialog .k-window-titlebar .k-dialog-title {
        display: none;
    }

.k-panelbar .k-content {
    padding: 20px;
}

p .k-button {
    margin: 0 15px 0 0;
}

.k-state-active .label {
    font-size: 1em;
}

.k-datepicker {
    width: 12.4em;
}

#responsive-panel {
    padding: 0;
    width: 100%;
}

    #responsive-panel .k-menu {
        padding: .5rem;
    }
/* #endregion */
.badge {
    font-size: 12px;
    vertical-align: bottom;
}

@media (max-width: 767px) {
    #responsive-panel {
        transition: all linear .2s;
    }

    #configure {
        display: block;
        float: right;
    }

    .k-rpanel {
        width: 100%;
        padding: 0 1rem;
    }

    .k-rpanel-expanded {
        margin-top: 1rem;
        padding: .5rem 1rem;
    }

    .navbar-header {
        width: 100%;
    }

    .navbar-brand {
        font-size: 1.5rem;
    }

