html {
    position: relative;
    min-height: 100%;
    font-size: 13px;
}

body {
    margin-bottom: 40px;
}

.title {
    display: block;
    font-weight: bold;
}

.sub-title {
    font-size: small;
    margin-top: -5px;
}

/* Navigation bar */
.navbar-brand {
    font-size: x-large;
    font-weight: bold;
}

    .navbar-brand > img {
        height: 45px;
    }

.navbar-text {
    font-size: medium;
    font-weight: bold;
    color: white !important;
}

.bg-dark {
    background-color: #2f4e6d !important;
}

.nav-link {
    font-size: medium;
    color: #495057 !important;
}

    .nav-link.active {
        font-size: medium;
        font-weight: bold;
        /*color: #007bff !important;*/
    }

#help-link.nav-link.active {
    font-size: medium;
    font-weight: normal;
}

.env-name {
    font-size: 20px;
    padding: 7px 0 0 12px;
}
/* End of Navigation bar */

/* #region Navbar styles */
.navbar-header {
    border-bottom: 1px solid rgba(255,255,255, 0.1);
}

.navbar-brand {
    font-size: 2rem;
    font-weight: lighter;
}
/* #endregion */


/* #region Footer styles */
.footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    font-size: 0.85em;
}
/* #endregion */

/* #region custom Kendo UI styles */


h1 a {
    color: #fff;
    text-decoration: none;
}

h2 {
    font-weight: lighter;
}

.placeholder img {
    display: inline-block;
}

p .k-button {
    margin: 0 15px 0 0;
}

#configure {
    display: none;
}

/* Grid styles */
.k-grid-header .k-header {
    font-weight: bold;
    color: white;
    background-color: #2f4e6d;
    overflow: visible !important;
    white-space: normal !important;
    border-color: #FFFFFF;
    border-top: 0px;
}

.k-grid th.k-sorted {
    background-color: #0d6efd !important;
}

.k-grid-header .k-i-sort-asc-sm, .k-grid-header .k-i-sort-desc-sm {
    color: white;
}

.k-grid td, .k-grid th {
    /*padding: 0rem 0rem 0rem 0.25rem;*/
    border-width: 1px 1px 0px 0px !important;
}

.k-icon.k-i-filter {
    font-size: 12px;
}

.k-grid .k-sort-icon {
    color: #FFFFFF;
}

.k-grid .k-grid-search {
    margin-left: auto;
    margin-right: 0;
    width: 15.4em;
}

.k-grid .nowrap {
    white-space: nowrap;
}

.k-grid .k-column-title {
    white-space: unset;
}

.k-grid .k-cell-inner {
    align-items: end;
}

.k-grid-edit-command.k-button-solid-primary {
    border-color: var(--kendo-color-base, #dee2e6);
    color: var(--kendo-color-on-base, #212529);
    background-color: var(--kendo-color-base, #dee2e6)
}

    .k-grid-edit-command.k-button-solid-primary:hover, .k-button-solid-primary.k-hover {
        border-color: var(--kendo-color-base-hover, #ced4da);
        background-color: var(--kendo-color-base-hover, #ced4da);
    }

    .k-grid-edit-command.k-button-solid-primary:focus, .k-button-solid-primary.k-focus {
        box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--kendo-color-border, rgba(33,37,41,0.13)) 50%, transparent);
    }

    .k-grid-edit-command.k-button-solid-primary:active, .k-button-solid-primary.k-active {
        border-color: var(--kendo-color-base-active, #bdc4cb);
        background-color: var(--kendo-color-base-active, #bdc4cb);
    }

    .k-grid-edit-command.k-button-solid-primary.k-selected {
        border-color: var(--kendo-color-primary-active, #0a58ca);
        color: var(--kendo-color-on-primary, #fff);
        background-color: var(--kendo-color-primary-active, #0a58ca);
    }

