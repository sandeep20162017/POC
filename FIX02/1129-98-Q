_Vehile_LabourDetailsReport.cshtml
@{
    ViewData["Title"] = "Labour Details Report";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/_VehicleReportStyles.css" asp-append-version="true" />
</head>
<body>

    <div class="report-container" id="reportContainer">
        <!-- HEADER -->
        <div class="report-header">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div style="text-align: left;">
                    <div class="estimate-number">Vehicle Estimate #: <span id="estimateNumber">@ViewBag.PartNum</span></div>
                </div>
                <div style="text-align: center; flex: 1;">
                    <h1>LABOUR DETAILS REPORT</h1>
                    <div class="subtitle">Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</div>
                </div>
                <div style="text-align: right; min-width: 120px;">
                    <div class="status-badge">Status: <span class="active">● Active</span></div>
                </div>
            </div>
        </div>

        <!-- VEHICLE DETAILS -->
        <div class="detail-section">
            <div class="detail-header"><span>🚗 VEHICLE DETAILS</span></div>
            <div class="detail-body">
                <div class="vehicle-info">
                    <div class="vehicle-info-item"><span class="label">Detailed Description</span><span class="value">@ViewBag.VehicleDescription</span></div>
                    <div class="vehicle-info-item"><span class="label">Vehicle Series</span><span class="value">@ViewBag.VehicleSeries</span></div>
                    <div class="vehicle-info-item"><span class="label">Make</span><span class="value">@ViewBag.Make</span></div>
                    <div class="vehicle-info-item"><span class="label">Model</span><span class="value">@ViewBag.Model</span></div>
                    <div class="vehicle-info-item"><span class="label">Year</span><span class="value">@ViewBag.Year</span></div>
                    <div class="vehicle-info-item"><span class="label"># of Vehicles</span><span class="value">@ViewBag.NumOfVehicles</span></div>
                    <div class="vehicle-info-item"><span class="label">Engine</span><span class="value">@ViewBag.Engine</span></div>
                    <div class="vehicle-info-item"><span class="label">Transmission</span><span class="value">@ViewBag.Transmission</span></div>
                    <div class="vehicle-info-item"><span class="label">Differential</span><span class="value">@ViewBag.Differential</span></div>
                </div>
            </div>
        </div>

        <!-- LABOUR HOURS SUMMARY -->
        <div class="detail-section">
            <div class="detail-header"><span>⏱️ LABOUR HOURS SUMMARY</span></div>
            <div class="detail-body">
                <div class="summary-grid summary-grid-3">
                    <div class="summary-card"><span class="value">@ViewBag.TotalLabourHours.ToString("F2")</span><span class="label">Total Hours</span></div>
                    <div class="summary-card"><span class="value">@ViewBag.TotalEffectiveHours.ToString("F2")</span><span class="label">Effective Hours</span></div>
                    <div class="summary-card"><span class="value">@ViewBag.TotalAdjustedHours.ToString("F2")</span><span class="label">Adjusted Hours</span></div>
                </div>
            </div>
        </div>

        <!-- LABOUR TASK SUMMARY -->
        <div class="detail-section">
            <div class="detail-header"><span>📋 LABOUR TASK SUMMARY</span><span class="badge">@ViewBag.LabourTasksCount tasks</span></div>
            <div class="detail-body">
                <div class="task-table-wrap">
                    <table class="task-table">
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Labour Definition</th>
                                <th>CC</th>
                                <th style="text-align:right;">Hours</th>
                                <th style="text-align:right;">Effective Hrs</th>
                                <th style="text-align:right;">Adjusted Hrs</th>
                                <th style="text-align:right;">Rate/Hr</th>
                                <th style="text-align:right;">Total Cost</th>
                                <th style="text-align:center;">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.LabourTasks != null && ViewBag.LabourTasks.Count > 0)
                            {
                                var totalHours = 0m;
                                var totalEffective = 0m;
                                var totalAdjusted = 0m;
                                var totalCost = 0m;

                                foreach (var task in ViewBag.LabourTasks)
                                {
                                    totalHours += task.Hours;
                                    totalEffective += task.EffectiveHours;
                                    totalAdjusted += task.AdjustedHours;
                                    totalCost += task.TotalCost;

                                    <tr>
                                        <td>@(task.Task ?? "Unnamed")</td>
                                        <td>@(task.LabourDefinition ?? "N/A")</td>
                                        <td>@(task.CC ?? "-")</td>
                                        <td style="text-align:right;">@task.Hours.ToString("F2")</td>
                                        <td style="text-align:right;">@task.EffectiveHours.ToString("F2")</td>
                                        <td style="text-align:right;">@task.AdjustedHours.ToString("F2")</td>
                                        <td style="text-align:right;">@String.Format("{0:C}", task.RatePerHour)</td>
                                        <td style="text-align:right; font-weight:600;">@String.Format("{0:C}", task.TotalCost)</td>
                                        <td style="text-align:center;">@task.Count</td>
                                    </tr>
                                }

                                <tr class="total-row">
                                    <td colspan="3"><strong>TOTAL</strong></td>
                                    <td style="text-align:right;"><strong>@totalHours.ToString("F2")</strong></td>
                                    <td style="text-align:right;"><strong>@totalEffective.ToString("F2")</strong></td>
                                    <td style="text-align:right;"><strong>@totalAdjusted.ToString("F2")</strong></td>
                                    <td style="text-align:right;"></td>
                                    <td style="text-align:right;"><strong>@String.Format("{0:C}", totalCost)</strong></td>
                                    <td style="text-align:center;"><strong>@ViewBag.LabourTasks.Count</strong></td>
                                </tr>
                            }
                            else
                            {
                                <tr><td colspan="9" style="text-align:center; color:#6c757d; padding:20px;">No labour tasks found</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TOTALS ROW -->
        <div class="totals-row">
            <div class="total-box"><div class="total-box-label">TOTAL MATERIAL COST (With Tax)</div><div class="total-box-value">@String.Format("{0:C}", ViewBag.MaterialTotalWithTax)</div></div>
            <div class="total-box"><div class="total-box-label">TOTAL LABOUR COST</div><div class="total-box-value">@String.Format("{0:C}", ViewBag.FinalLabourCost)</div></div>
        </div>

        <!-- GRAND TOTAL -->
        <div class="grand-total-section">
            <table class="grand-total-table">
                <tr>
                    <td class="grand-total-label"><strong>💰 GRAND TOTAL (Material + Labour)</strong></td>
                    <td class="grand-total-value">@String.Format("{0:C}", ViewBag.MaterialTotalWithTax + ViewBag.FinalLabourCost)</td>
                </tr>
            </table>
        </div>

        <!-- AUDIT ROW -->
        <div class="vehicle-audit-row">
            <div class="vehicle-audit-item"><span class="label">Modified By</span><span class="value">@ViewBag.ModifiedLastBy</span></div>
            <div class="vehicle-audit-item"><span class="label">Modified Date</span><span class="value">@ViewBag.ModifiedLastDate</span></div>
        </div>

        <div class="report-footer">Estimate Generated On: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</div>
    </div>

</body>
</html>
_Vehicle_MaterialsEsstimate.cshtml
@{
    ViewData["Title"] = "Materials Estimate Report";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/_VehicleReportStyles.css" asp-append-version="true" />
</head>
<body>

    <div class="report-container" id="reportContainer">
        <!-- HEADER -->
        <div class="report-header">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div style="text-align: left;">
                    <div class="estimate-number">Vehicle Estimate #: <span id="estimateNumber">@ViewBag.PartNum</span></div>
                </div>
                <div style="text-align: center; flex: 1;">
                    <h1>MATERIALS ESTIMATE REPORT</h1>
                    <div class="subtitle">Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</div>
                </div>
                <div style="text-align: right; min-width: 120px;">
                    <div class="status-badge">Status: <span class="active">● Active</span></div>
                </div>
            </div>
        </div>

        <!-- VEHICLE DETAILS -->
        <div class="detail-section">
            <div class="detail-header"><span>🚗 VEHICLE DETAILS</span></div>
            <div class="detail-body">
                <div class="vehicle-info">
                    <div class="vehicle-info-item"><span class="label">Detailed Description</span><span class="value">@ViewBag.VehicleDescription</span></div>
                    <div class="vehicle-info-item"><span class="label">Vehicle Series</span><span class="value">@ViewBag.VehicleSeries</span></div>
                    <div class="vehicle-info-item"><span class="label">Make</span><span class="value">@ViewBag.Make</span></div>
                    <div class="vehicle-info-item"><span class="label">Model</span><span class="value">@ViewBag.Model</span></div>
                    <div class="vehicle-info-item"><span class="label">Year</span><span class="value">@ViewBag.Year</span></div>
                    <div class="vehicle-info-item"><span class="label"># of Vehicles</span><span class="value">@ViewBag.NumOfVehicles</span></div>
                    <div class="vehicle-info-item"><span class="label">Engine</span><span class="value">@ViewBag.Engine</span></div>
                    <div class="vehicle-info-item"><span class="label">Transmission</span><span class="value">@ViewBag.Transmission</span></div>
                    <div class="vehicle-info-item"><span class="label">Differential</span><span class="value">@ViewBag.Differential</span></div>
                </div>
            </div>
        </div>

        <!-- MATERIAL COST SUMMARY -->
        <div class="detail-section">
            <div class="detail-header"><span>📦 MATERIAL COST SUMMARY</span><span class="badge">@ViewBag.TotalParts parts</span></div>
            <div class="detail-body">
                <div class="summary-grid summary-grid-6">
                    <div class="summary-card"><span class="value">@ViewBag.TotalStockPartsCount</span><span class="label">Stock Parts</span></div>
                    <div class="summary-card"><span class="value">@ViewBag.TotalNonStockPartsCount</span><span class="label">Non-Stock Parts</span></div>
                    <div class="summary-card"><span class="value">@ViewBag.TotalRebuiltPartsCount</span><span class="label">Rebuilt Parts</span></div>
                    <div class="summary-card"><span class="value">@String.Format("{0:C}", ViewBag.SCPartsMaterialCost)</span><span class="label">Total Stock Cost</span></div>
                    <div class="summary-card"><span class="value">@String.Format("{0:C}", ViewBag.NSCSCPartsMaterialCost)</span><span class="label">Total Non-Stock Cost</span></div>
                    <div class="summary-card"><span class="value">@String.Format("{0:C}", ViewBag.RBPartsMaterialCost)</span><span class="label">Total Rebuilt Cost</span></div>
                </div>
            </div>
        </div>

        <!-- MATERIAL LINES -->
        <div class="detail-section">
            <div class="detail-header"><span>📋 MATERIAL</span><span class="badge">@ViewBag.MaterialLinesCount items</span></div>
            <div class="detail-body">
                <div class="material-table-wrap">
                    <table class="material-table">
                        <thead>
                            <tr>
                                <th style="width:90px;">Type</th>
                                <th style="width:120px;">Stock Code</th>
                                <th style="width:120px;">CC</th>
                                <th>Desc/Supp Name</th>
                                <th style="width:70px;text-align:right;">Qty</th>
                                <th style="width:100px;text-align:right;">Unit Cost</th>
                                <th style="width:80px;text-align:right;">Usage %</th>
                                <th style="width:110px;text-align:right;">Total Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.MaterialLines != null && ViewBag.MaterialLines.Count > 0)
                            {
                                var stockTotal = 0m;
                                var nonStockTotal = 0m;
                                var rebuiltTotal = 0m;
                                var grandTotal = 0m;

                                foreach (var item in ViewBag.MaterialLines)
                                {
                                    var type = item.Type ?? "Stock";
                                    var typeClass = type.ToLower().Replace("-", "");
                                    var badgeClass = typeClass == "nonstock" ? "nonstock" : typeClass;
                                    <tr class="type-@typeClass">
                                        <td><span class="type-badge @badgeClass">@type</span></td>
                                        <td>@(item.StockCode ?? "-")</td>
                                        <td>@(item.CC ?? "-")</td>
                                        <td>@(item.Description ?? "N/A")</td>
                                        <td style="text-align:right;">@item.Quantity.ToString("F2")</td>
                                        <td style="text-align:right;">@String.Format("{0:C}", item.UnitCost)</td>
                                        <td style="text-align:right;">@item.PercentUsage.ToString("F1")%</td>
                                        <td style="text-align:right; font-weight:600;">@String.Format("{0:C}", item.TotalCost)</td>
                                    </tr>

                                    if (type == "Stock") stockTotal += item.TotalCost;
                                    else if (type == "Non-Stock") nonStockTotal += item.TotalCost;
                                    else if (type == "Rebuilt") rebuiltTotal += item.TotalCost;
                                    grandTotal += item.TotalCost;
                                }

                                if (stockTotal > 0)
                                {
                                    <tr class="subtotal-row">
                                        <td colspan="7" style="text-align:right; font-weight:600;">Subtotal - Stock</td>
                                        <td style="text-align:right; font-weight:600;">@String.Format("{0:C}", stockTotal)</td>
                                    </tr>
                                }
                                if (nonStockTotal > 0)
                                {
                                    <tr class="subtotal-row">
                                        <td colspan="7" style="text-align:right; font-weight:600;">Subtotal - Non-Stock</td>
                                        <td style="text-align:right; font-weight:600;">@String.Format("{0:C}", nonStockTotal)</td>
                                    </tr>
                                }
                                if (rebuiltTotal > 0)
                                {
                                    <tr class="subtotal-row">
                                        <td colspan="7" style="text-align:right; font-weight:600;">Subtotal - Rebuilt</td>
                                        <td style="text-align:right; font-weight:600;">@String.Format("{0:C}", rebuiltTotal)</td>
                                    </tr>
                                }
                                <tr class="total-row">
                                    <td colspan="7" style="text-align:right; font-weight:800; font-size:1.05em;">GRAND TOTAL</td>
                                    <td style="text-align:right; font-weight:800; font-size:1.05em;">@String.Format("{0:C}", grandTotal)</td>
                                </tr>
                            }
                            else
                            {
                                <tr><td colspan="8" style="text-align:center; color:#6c757d; padding:20px;">No material items found</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TOTALS ROW -->
        <div class="totals-row">
            <div class="total-box"><div class="total-box-label">TOTAL MATERIAL COST (With Tax)</div><div class="total-box-value">@String.Format("{0:C}", ViewBag.MaterialTotalWithTax)</div></div>
            <div class="total-box"><div class="total-box-label">TOTAL LABOUR COST</div><div class="total-box-value">@String.Format("{0:C}", ViewBag.FinalLabourCost)</div></div>
        </div>

        <!-- GRAND TOTAL -->
        <div class="grand-total-section">
            <table class="grand-total-table">
                <tr>
                    <td class="grand-total-label"><strong>💰 GRAND TOTAL (Material + Labour)</strong></td>
                    <td class="grand-total-value">@String.Format("{0:C}", ViewBag.MaterialTotalWithTax + ViewBag.FinalLabourCost)</td>
                </tr>
            </table>
        </div>

        <!-- AUDIT ROW -->
        <div class="vehicle-audit-row">
            <div class="vehicle-audit-item"><span class="label">Modified By</span><span class="value">@ViewBag.ModifiedLastBy</span></div>
            <div class="vehicle-audit-item"><span class="label">Modified Date</span><span class="value">@ViewBag.ModifiedLastDate</span></div>
        </div>

        <div class="report-footer">Estimate Generated On: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</div>
    </div>

</body>
</html>
        


