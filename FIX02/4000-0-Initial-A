Table: SBCES.HelpPageMetadata
sql
USE CES;
GO

CREATE SCHEMA SBCES;
GO

-- Main table for storing page metadata
CREATE TABLE SBCES.HelpPageMetadata (
    [Id] INT IDENTITY(1,1) PRIMARY KEY,
    [PageName] NVARCHAR(200) NOT NULL,           -- e.g., "MakeVsBuyIndex"
    [PageType] NVARCHAR(50) NOT NULL,            -- "Estimate", "Admin", "Master", "Report"
    [Module] NVARCHAR(100) NOT NULL,              -- "Make Vs Buy", "Administration", etc.
    [Controller] NVARCHAR(100) NULL,              -- "MakeVsBuy"
    [Action] NVARCHAR(100) NULL,                  -- "Index"
    [Url] NVARCHAR(500) NULL,                     -- "/MakeVsBuyIndex"
    [JsonMetadata] NVARCHAR(MAX) NOT NULL,        -- The structured JSON metadata
    [IsActive] BIT DEFAULT 1,
    [Version] INT DEFAULT 1,
    [CreatedDate] DATETIME DEFAULT GETDATE(),
    [LastUpdated] DATETIME DEFAULT GETDATE(),
    [CreatedBy] NVARCHAR(100) NULL,
    [UpdatedBy] NVARCHAR(100) NULL,
    
    CONSTRAINT UQ_PageName UNIQUE (PageName)
);

-- Indexes for faster lookups
CREATE INDEX IX_HelpPageMetadata_PageName ON SBCES.HelpPageMetadata(PageName);
CREATE INDEX IX_HelpPageMetadata_PageType ON SBCES.HelpPageMetadata(PageType);
CREATE INDEX IX_HelpPageMetadata_Module ON SBCES.HelpPageMetadata(Module);
CREATE INDEX IX_HelpPageMetadata_IsActive ON SBCES.HelpPageMetadata(IsActive);

-- Full-text search for JSON content (optional)
CREATE FULLTEXT CATALOG HelpMetadataCatalog AS DEFAULT;
CREATE FULLTEXT INDEX ON SBCES.HelpPageMetadata(JsonMetadata) 
    KEY INDEX PK__HelpPageMetadata__Id
    WITH STOPLIST = SYSTEM;
GO

