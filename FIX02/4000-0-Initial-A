Query to Verify Data
sql
-- Get all active pages
SELECT 
    Id,
    PageName,
    PageType,
    Module,
    Controller,
    Action,
    Url,
    IsActive,
    Version,
    CreatedDate,
    LastUpdated
FROM SBCES.HelpPageMetadata
WHERE IsActive = 1
ORDER BY Module, PageName;

-- Get a specific page with JSON
SELECT 
    PageName,
    JsonMetadata
FROM SBCES.HelpPageMetadata
WHERE PageName = 'MakeVsBuyIndex' AND IsActive = 1;

-- Search within JSON (using JSON_VALUE)
SELECT 
    PageName,
    PageType,
    JSON_VALUE(JsonMetadata, '$.pageInfo.description') AS Description
FROM SBCES.HelpPageMetadata
WHERE IsActive = 1
AND JSON_VALUE(JsonMetadata, '$.pageInfo.module') = 'Make Vs Buy';

-- Get all Admin pages
SELECT 
    PageName,
    Module,
    JSON_VALUE(JsonMetadata, '$.pageInfo.description') AS Description
FROM SBCES.HelpPageMetadata
WHERE PageType = 'Admin' AND IsActive = 1;

-- Count pages by type
SELECT 
    PageType,
    COUNT(*) AS PageCount
FROM SBCES.HelpPageMetadata
WHERE IsActive = 1
GROUP BY PageType;
