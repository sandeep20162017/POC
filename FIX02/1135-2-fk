/* =====================================================================
   PICS - Script 2 of 2: foreign keys
   Run AFTER the data has been loaded (any table order works then).
   WITH CHECK validates existing rows; if it fails on orphans, the error names
   the constraint. Oracle enforced all of these, so the data should be clean.
   ===================================================================== */
USE PICS;
GO

ALTER TABLE PICS.USERS WITH CHECK
    ADD CONSTRAINT USER_FK FOREIGN KEY (SEC_GROUP_ID) REFERENCES PICS.SEC_GROUPS (GROUP_ID);

ALTER TABLE PICS.USER_LOCATIONS WITH CHECK
    ADD CONSTRAINT USER_LOCATION_FK1 FOREIGN KEY (USER_ID) REFERENCES PICS.USERS (USER_ID);

ALTER TABLE PICS.USER_LOCATIONS WITH CHECK
    ADD CONSTRAINT USER_LOCATION_FK2 FOREIGN KEY (LOCATION_ID) REFERENCES PICS.LOCATIONS (LOCATION_ID);

ALTER TABLE PICS.JOB_MATERIALS WITH CHECK
    ADD CONSTRAINT JOB_MATERIAL_FK FOREIGN KEY (JOB_ID) REFERENCES PICS.JOBS (JOB_ID);

ALTER TABLE PICS.JOB_OPS WITH CHECK
    ADD CONSTRAINT JOB_OP_FK1 FOREIGN KEY (JOB_ID) REFERENCES PICS.JOBS (JOB_ID);

ALTER TABLE PICS.WO_OPS WITH CHECK
    ADD CONSTRAINT WO_OP_FK1 FOREIGN KEY (WO_ID) REFERENCES PICS.WORKORDERS (WO_ID);

ALTER TABLE PICS.WO_OPS WITH CHECK
    ADD CONSTRAINT WO_OP_FK2 FOREIGN KEY (LOCATION_ID) REFERENCES PICS.LOCATIONS (LOCATION_ID);

ALTER TABLE PICS.WO_MATERIALS WITH CHECK
    ADD CONSTRAINT WO_MATERIAL_FK2 FOREIGN KEY (ORDER_LOCATION_ID) REFERENCES PICS.LOCATIONS (LOCATION_ID);
GO

-- Sanity check: should return 8
SELECT COUNT(*) AS fk_count FROM sys.foreign_keys WHERE schema_id = SCHEMA_ID(N'PICS');
GO

