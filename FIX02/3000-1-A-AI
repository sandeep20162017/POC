        [HttpGet]
        public async Task<IActionResult> GetPageMetadata(string pageName)
        {
            var metadata = await GetPageMetadataAsync(pageName);
            if (metadata == null)
                return NotFound(new { error = "Page not found" });

            return Ok(new
            {
                metadata.PageName,
                metadata.PageType,
                metadata.Module,
                metadata.Url,
                ExtractedMetadata = GetExtractedMetadata(metadata)
            });
        }

        [HttpGet]
        public async Task<IActionResult> GetAllPages()
        {
            var pages = await GetAllActivePagesAsync();
            return Ok(pages.Select(p => new
            {
                p.Id,
                p.PageName,
                p.PageType,
                p.Module,
                p.Url
            }));
        }

        [HttpGet]
        public async Task<IActionResult> SearchPages(string term)
        {
            if (string.IsNullOrWhiteSpace(term))
                return Ok(new List<object>());

            var pages = await SearchPagesAsync(term);
            return Ok(pages.Select(p => new
            {
                p.PageName,
                p.Module,
                p.PageType
            }));
        }
