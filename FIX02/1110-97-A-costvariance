using System;

namespace BCES.Models.Reports
{
    // One row of [SBCES].[RptCostVarianceV2]. The Active column is not mapped (not displayed).
    public class CostVarianceReportRow
    {
        // Mapped by Dapper from the result set
        public string RbNumber { get; set; }
        public string Keyword { get; set; }
        public string DetailedDesc { get; set; }
        public decimal TotalCost { get; set; }
        public decimal? ExternalCost { get; set; }

        // Display values (read-only, not mapped by Dapper)
        public decimal Cost => Math.Round(TotalCost, 2, MidpointRounding.AwayFromZero);

        public decimal? ExtCost => ExternalCost.HasValue
            ? Math.Round(ExternalCost.Value, 2, MidpointRounding.AwayFromZero)
            : (decimal?)null;

        // (TotalCost - ExternalCost) / ExternalCost * 100, null when ExternalCost is NULL or 0
        public decimal? VariancePct => (ExternalCost.HasValue && ExternalCost.Value != 0m)
            ? Math.Round((TotalCost - ExternalCost.Value) / ExternalCost.Value * 100m, 2, MidpointRounding.AwayFromZero)
            : (decimal?)null;
    }
}

WHY: Typed row matching the proc's columns, with rounding and variance calculated in one place.

