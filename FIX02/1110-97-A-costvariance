using BCES.Controllers.Base;
using BCES.Data;
using BCES.Models.Reports;
using Dapper;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;
using System.Threading.Tasks;

namespace BCES.Controllers.Reports
{
    public class ReportsController : BaseController
    {
        private readonly DapperContext _db;
        private readonly IDbConnection _dbConnection;
        private readonly IHttpContextAccessor _httpContextAccessor;

        public ReportsController(DapperContext dapper, IHttpContextAccessor httpContextAccessor)
            : base(dapper, httpContextAccessor)
        {
            _db = dapper;
            _dbConnection = _db.CreateConnection();
            _httpContextAccessor = httpContextAccessor;
        }

        // GET: /Reports/CostVarianceReport
        [HttpGet]
        public async Task<IActionResult> CostVarianceReport()
        {
            try
            {
                var rows = await GetCostVarianceReportData();
                return View(rows); // Views/Reports/CostVarianceReport.cshtml
            }
            catch (Exception ex)
            {
                return StatusCode(500, "Error loading Cost Variance report: " + ex.Message);
            }
        }

        private async Task<List<CostVarianceReportRow>> GetCostVarianceReportData()
        {
            var result = await _dbConnection.QueryAsync<CostVarianceReportRow>(
                "[SBCES].[RptCostVarianceV2]",
                commandType: CommandType.StoredProcedure,
                commandTimeout: 120);

            return result.ToList();
        }
    }
}

WHY: Runs the no-argument proc with async Dapper and passes the typed rows to the view.

