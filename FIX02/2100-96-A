CREATE OR ALTER FUNCTION SBCES.HhmmToMinutes (@TimeStr VARCHAR(10))
RETURNS INT
AS
BEGIN
    DECLARE @Minutes INT = 0;
    IF @TimeStr IS NOT NULL AND @TimeStr != ''
    BEGIN
        DECLARE @Pos INT = CHARINDEX(':', @TimeStr);
        IF @Pos > 0
        BEGIN
            SET @Minutes = CAST(SUBSTRING(@TimeStr, 1, @Pos - 1) AS INT) * 60
                         + CAST(SUBSTRING(@TimeStr, @Pos + 1, LEN(@TimeStr)) AS INT);
        END
    END
    RETURN @Minutes;
END;
GO

CREATE OR ALTER FUNCTION SBCES.HhmmToDecimal (@TimeStr VARCHAR(10))
RETURNS DECIMAL(20,10)
AS
BEGIN
    DECLARE @Decimal DECIMAL(20,10) = 0;
    IF @TimeStr IS NOT NULL AND @TimeStr != ''
    BEGIN
        DECLARE @Pos INT = CHARINDEX(':', @TimeStr);
        IF @Pos > 0
        BEGIN
            DECLARE @Hours INT = CAST(SUBSTRING(@TimeStr, 1, @Pos - 1) AS INT);
            DECLARE @Mins INT = CAST(SUBSTRING(@TimeStr, @Pos + 1, LEN(@TimeStr)) AS INT);
            SET @Decimal = @Hours + (@Mins / 60.0);
        END
    END
    RETURN @Decimal;
END;
GO

CREATE OR ALTER FUNCTION SBCES.FinalCost (
    @PercentUsage DECIMAL(20,10),
    @QtyReqd DECIMAL(20,10),
    @Cost DECIMAL(20,10),
    @Adjustment DECIMAL(20,10)
)
RETURNS DECIMAL(20,10)
AS
BEGIN
    RETURN ISNULL((@PercentUsage / 100.0) * @QtyReqd * @Cost, 0);
END;
GO

