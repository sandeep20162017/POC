CREATE OR ALTER PROCEDURE SBCES.WriteLabour
    @viIdnum    VARCHAR(30),
    @viAdjustment DECIMAL(20,10)
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @V_Price DECIMAL(20,10);

    INSERT INTO SBCES.TempLabourList
    SELECT
        EL.LabourDefn,
        EL.CostCentre,
        EL.Task,
        REPLACE(EL.Usage, ',', '.') AS Usage,
        ROUND(SBCES.HhmmToMinutes(EL.TimeAddition) * @viAdjustment, 0) AS TimeAddition,
        ES.RatePerHour,
        (ES.RatePerHour / 60.0)
            * ROUND(SBCES.HhmmToMinutes(EL.TimeAddition) * @viAdjustment, 0)
            * (REPLACE(EL.Usage, ',', '.') / 100.0) AS TotalCost,
        ROUND((REPLACE(EL.Usage, ',', '.') / 100.0)
            * SBCES.HhmmToMinutes(EL.TimeAddition) * @viAdjustment, 0) AS WrenchTime,
        'RB' AS LinkType,
        UPPER(@viIdnum) AS LinkNumber,
        ROUND((REPLACE(EL.Usage, ',', '.') / 100.0)
            * ROUND(SBCES.HhmmToDecimal(EL.AdjHrs) * @viAdjustment, 0), 0) AS AdjustedWrenchTime
    FROM SBCES.EmployeeLabour EL
    INNER JOIN SBCES.EmplClass EC ON EL.LabourDefn = EC.LabourDefn
    INNER JOIN SBCES.EmployeeSalaries ES ON ES.WageGroup = EC.WageGroup
    WHERE EL.LinkNumber = @viIdnum
      AND EL.TypeId = 'RB';

    SELECT @V_Price = COUNT(*)
    FROM SBCES.ScPartsUsed
    WHERE RebuiltPart = 'Y'
      AND LinkType = 'RB'
      AND LinkCode = @viIdnum;

    IF @V_Price > 0
    BEGIN
        DECLARE @RebuiltCode VARCHAR(30), @Qty DECIMAL(20,10), @Pct DECIMAL(20,10), @Adj DECIMAL(20,10);
        DECLARE rb_cursor CURSOR LOCAL FOR
            SELECT DISTINCT MmsRebuiltCode, QtyReqd, PercentUsage
            FROM SBCES.ScPartsUsed
            WHERE RebuiltPart = 'Y'
              AND LinkType = 'RB'
              AND LinkCode = @viIdnum;
        OPEN rb_cursor;
        FETCH NEXT FROM rb_cursor INTO @RebuiltCode, @Qty, @Pct;
        WHILE @@FETCH_STATUS = 0
        BEGIN
            SET @Adj = (@Qty * ISNULL(@Pct, 0) / 100.0) * @viAdjustment;
            EXEC SBCES.WriteLabour @viIdnum = @RebuiltCode, @viAdjustment = @Adj;
            FETCH NEXT FROM rb_cursor INTO @RebuiltCode, @Qty, @Pct;
        END
        CLOSE rb_cursor;
        DEALLOCATE rb_cursor;
    END;
END;
GO

CREATE OR ALTER PROCEDURE SBCES.WriteMaterials
    @viIdnum        VARCHAR(30),
    @viAdjustment   DECIMAL(20,10),
    @viRbReference  VARCHAR(30),
    @viAdjustment2  DECIMAL(20,10)
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @V_Price DECIMAL(20,10);

    ;WITH MaterialCTE AS (
        SELECT
            ISNULL(C.Name, 'NONE') AS AssemblyArea,
            ISNULL(SPU.CostCentre, '0') AS CostCentre,
            SUM((SBCES.FinalCost(SPU.PercentUsage, SPU.QtyReqd, SPU.MmsCost, 0)
                - SBCES.FinalCost(SPU.PercentUsage, SPU.QtyReqd, SPU.CoreCost, 0)) * @viAdjustment) AS TotalCost,
            SUM(SBCES.FinalCost(SPU.PercentUsage, SPU.QtyReqd, SPU.MmsCost, 0) * @viAdjustment) AS TaxableCost
        FROM SBCES.ScPartsUsed SPU
        LEFT JOIN SBCES.CostCentres C ON C.CostCentre = SPU.CostCentre
        WHERE SPU.LinkCode = @viIdnum
          AND SPU.RebuiltPart = 'N'
          AND SPU.LinkType = 'RB'
        GROUP BY C.Name, SPU.CostCentre
        UNION ALL
        SELECT
            ISNULL(C.Name, 'NONE') AS AssemblyArea,
            ISNULL(NSPU.CostCentre, '0') AS CostCentre,
            SUM((SBCES.FinalCost(NSPU.PercentUsage, NSPU.QtyReqd, NSCP.OemPartCost, 0)
                - SBCES.FinalCost(NSPU.PercentUsage, NSPU.QtyReqd, NSPU.CoreCost, 0)) * @viAdjustment) AS TotalCost,
            SUM(SBCES.FinalCost(NSPU.PercentUsage, NSPU.QtyReqd, NSCP.OemPartCost, 0) * @viAdjustment) AS TaxableCost
        FROM SBCES.NscPartsUsed NSPU
        LEFT JOIN SBCES.NonStockCodedParts NSCP ON NSCP.ID = NSPU.ID
        LEFT JOIN SBCES.CostCentres C ON C.CostCentre = NSPU.CostCentre
        WHERE NSPU.LinkCode = @viIdnum
          AND NSPU.LinkType = 'RB'
        GROUP BY C.Name, NSPU.CostCentre
    )
    INSERT INTO SBCES.TempMaterialsList
    SELECT
        AssemblyArea,
        CostCentre,
        ROUND(TotalCost, 2),
        TaxableCost,
        @viRbReference,
        @viAdjustment2 * TotalCost
    FROM MaterialCTE;

    SELECT @V_Price = COUNT(*)
    FROM SBCES.ScPartsUsed
    WHERE RebuiltPart = 'Y'
      AND LinkType = 'RB'
      AND LinkCode = @viIdnum;

    IF @V_Price > 0
    BEGIN
        DECLARE @RebuiltCode VARCHAR(30), @Qty DECIMAL(20,10), @Pct DECIMAL(20,10), @Adj DECIMAL(20,10), @Adj2 DECIMAL(20,10);
        DECLARE rb_cursor CURSOR LOCAL FOR
            SELECT DISTINCT MmsRebuiltCode, QtyReqd, PercentUsage
            FROM SBCES.ScPartsUsed
            WHERE RebuiltPart = 'Y'
              AND LinkType = 'RB'
              AND LinkCode = @viIdnum;
        OPEN rb_cursor;
        FETCH NEXT FROM rb_cursor INTO @RebuiltCode, @Qty, @Pct;
        WHILE @@FETCH_STATUS = 0
        BEGIN
            SET @Adj = (@Qty * ISNULL(@Pct, 0) / 100.0) * @viAdjustment;
            SET @Adj2 = @viAdjustment2 * (@Qty * ISNULL(@Pct, 0) / 100.0);
            EXEC SBCES.WriteMaterials
                @viIdnum = @RebuiltCode,
                @viAdjustment = @Adj,
                @viRbReference = @viRbReference,
                @viAdjustment2 = @Adj2;
            FETCH NEXT FROM rb_cursor INTO @RebuiltCode, @Qty, @Pct;
        END
        CLOSE rb_cursor;
        DEALLOCATE rb_cursor;
    END;
END;
GO

