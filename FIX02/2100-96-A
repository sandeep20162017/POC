CREATE OR ALTER PROCEDURE SBCES.GetMaterialCost
    @viIdnum    VARCHAR(30),
    @viType     VARCHAR(10),
    @voResult   DECIMAL(20,10) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @V_Price DECIMAL(20,10) = 0;
    DECLARE @V_Final_Price DECIMAL(20,10) = 0;
    DECLARE @V_Kit_Total DECIMAL(20,10) = 0;

    TRUNCATE TABLE SBCES.TempMaterialsList;

    ;WITH MaterialCTE AS (
        SELECT
            ISNULL(C.Name, 'NONE') AS AssemblyArea,
            ISNULL(SPU.CostCentre, '0') AS CostCentre,
            SUM(SBCES.FinalCost(SPU.PercentUsage, SPU.QtyReqd, SPU.MmsCost, 0)
                - SBCES.FinalCost(SPU.PercentUsage, SPU.QtyReqd, SPU.CoreCost, 0)) AS TotalCost,
            SUM(SBCES.FinalCost(SPU.PercentUsage, SPU.QtyReqd, SPU.MmsCost, 0)) AS TaxableCost
        FROM SBCES.ScPartsUsed SPU
        LEFT JOIN SBCES.CostCentres C ON C.CostCentre = SPU.CostCentre
        WHERE SPU.LinkCode = @viIdnum
          AND SPU.RebuiltPart = 'N'
          AND SPU.LinkType = @viType
        GROUP BY C.Name, SPU.CostCentre
        UNION ALL
        SELECT
            ISNULL(C.Name, 'NONE') AS AssemblyArea,
            ISNULL(NSPU.CostCentre, '0') AS CostCentre,
            SUM(SBCES.FinalCost(NSPU.PercentUsage, NSPU.QtyReqd, NSCP.OemPartCost, 0)
                - SBCES.FinalCost(NSPU.PercentUsage, NSPU.QtyReqd, NSPU.CoreCost, 0)) AS TotalCost,
            SUM(SBCES.FinalCost(NSPU.PercentUsage, NSPU.QtyReqd, NSCP.OemPartCost, 0)) AS TaxableCost
        FROM SBCES.NscPartsUsed NSPU
        LEFT JOIN SBCES.NonStockCodedParts NSCP ON NSCP.ID = NSPU.ID
        LEFT JOIN SBCES.CostCentres C ON C.CostCentre = NSPU.CostCentre
        WHERE NSPU.LinkCode = @viIdnum
          AND NSPU.LinkType = @viType
        GROUP BY C.Name, NSPU.CostCentre
    )
    INSERT INTO SBCES.TempMaterialsList
    SELECT
        AssemblyArea,
        CostCentre,
        TotalCost,
        TaxableCost,
        @viIdnum,
        TotalCost
    FROM MaterialCTE;

    SELECT @V_Price = COUNT(*)
    FROM SBCES.ScPartsUsed
    WHERE RebuiltPart = 'Y'
      AND LinkType = @viType
      AND LinkCode = @viIdnum;

    IF @V_Price > 0
    BEGIN
        DECLARE @RebuiltCode VARCHAR(30), @Adj DECIMAL(20,10);
        DECLARE rb_cursor CURSOR LOCAL FOR
            SELECT DISTINCT MmsRebuiltCode, QtyReqd * PercentUsage / 100.0
            FROM SBCES.ScPartsUsed
            WHERE RebuiltPart = 'Y'
              AND LinkType = @viType
              AND LinkCode = @viIdnum;
        OPEN rb_cursor;
        FETCH NEXT FROM rb_cursor INTO @RebuiltCode, @Adj;
        WHILE @@FETCH_STATUS = 0
        BEGIN
            EXEC SBCES.WriteMaterials
                @viIdnum = @RebuiltCode,
                @viAdjustment = @Adj,
                @viRbReference = @RebuiltCode,
                @viAdjustment2 = 1;
            FETCH NEXT FROM rb_cursor INTO @RebuiltCode, @Adj;
        END
        CLOSE rb_cursor;
        DEALLOCATE rb_cursor;
    END;

    IF UPPER(@viType) = 'BUS'
    BEGIN
        SELECT @V_Kit_Total = COUNT(*) FROM SBCES.OemKitsTotal2 WHERE Link = @viIdnum;
        IF @V_Kit_Total > 0
        BEGIN
            SELECT @V_Kit_Total = TotalKitCost FROM SBCES.OemKitsTotal2 WHERE Link = @viIdnum;
            INSERT INTO SBCES.TempMaterialsList VALUES ('KITS', '05H7', @V_Kit_Total, @V_Kit_Total, @viIdnum, @V_Kit_Total);
        END
    END;

    SELECT @V_Final_Price = ROUND(SUM(ISNULL(TotalCost, 0)), 2)
    FROM SBCES.TempMaterialsList;

    SET @voResult = ISNULL(@V_Final_Price, 0);
END;
GO

CREATE OR ALTER PROCEDURE SBCES.GetLabourCost
    @viIdnum    VARCHAR(30),
    @viType     VARCHAR(10),
    @voResult   DECIMAL(20,10) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @V_Price DECIMAL(20,10) = 0;
    DECLARE @V_Final_Price DECIMAL(20,10) = 0;

    TRUNCATE TABLE SBCES.TempLabourList;

    INSERT INTO SBCES.TempLabourList
    SELECT
        EL.LabourDefn,
        EL.CostCentre,
        EL.Task,
        REPLACE(EL.Usage, ',', '.') AS Usage,
        SBCES.HhmmToMinutes(EL.TimeAddition) AS TimeAddition,
        ES.RatePerHour,
        (ES.RatePerHour / 60.0) * SBCES.HhmmToMinutes(EL.TimeAddition) * (REPLACE(EL.Usage, ',', '.') / 100.0) AS TotalCost,
        ROUND((REPLACE(EL.Usage, ',', '.') / 100.0) * SBCES.HhmmToMinutes(EL.TimeAddition), 0) AS WrenchTime,
        @viType AS LinkType,
        UPPER(@viIdnum),
        ROUND((REPLACE(EL.Usage, ',', '.') / 100.0) * SBCES.HhmmToDecimal(EL.AdjHrs), 0) AS AdjustedWrenchTime
    FROM SBCES.EmployeeLabour EL
    INNER JOIN SBCES.EmplClass EC ON EL.LabourDefn = EC.LabourDefn
    INNER JOIN SBCES.EmployeeSalaries ES ON ES.WageGroup = EC.WageGroup
    WHERE EL.LinkNumber = @viIdnum
      AND EL.TypeId = @viType;

    SELECT @V_Price = COUNT(*)
    FROM SBCES.ScPartsUsed
    WHERE RebuiltPart = 'Y'
      AND LinkType = @viType
      AND LinkCode = @viIdnum;

    IF @V_Price > 0
    BEGIN
        DECLARE @RebuiltCode VARCHAR(30), @Adj DECIMAL(20,10);
        DECLARE rb_cursor CURSOR LOCAL FOR
            SELECT DISTINCT MmsRebuiltCode, QtyReqd * PercentUsage / 100.0
            FROM SBCES.ScPartsUsed
            WHERE RebuiltPart = 'Y'
              AND LinkType = @viType
              AND LinkCode = @viIdnum;
        OPEN rb_cursor;
        FETCH NEXT FROM rb_cursor INTO @RebuiltCode, @Adj;
        WHILE @@FETCH_STATUS = 0
        BEGIN
            EXEC SBCES.WriteLabour @viIdnum = @RebuiltCode, @viAdjustment = @Adj;
            FETCH NEXT FROM rb_cursor INTO @RebuiltCode, @Adj;
        END
        CLOSE rb_cursor;
        DEALLOCATE rb_cursor;
    END;

    SELECT @V_Final_Price = ROUND(SUM(ISNULL(TotalCost, 0)), 2)
    FROM SBCES.TempLabourList;

    SET @voResult = ISNULL(@V_Final_Price, 0);
END;
GO

CREATE OR ALTER PROCEDURE SBCES.RptRbpCost
    @viRbnum      VARCHAR(30),
    @viLinkType   VARCHAR(10),
    @voTotalCost  DECIMAL(20,10) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @LabourSubtotal DECIMAL(20,10) = 0;
    DECLARE @LabourOverhead DECIMAL(20,10) = 0;
    DECLARE @LabourTotal    DECIMAL(20,10) = 0;
    DECLARE @MaterialsTotal DECIMAL(20,10) = 0;
    DECLARE @CoreCost       DECIMAL(20,10) = 0;
    DECLARE @CoreCostStr    VARCHAR(30);
    DECLARE @V_Price        DECIMAL(20,10) = 0;

    -- Get material cost
    EXEC SBCES.GetMaterialCost
        @viIdnum  = UPPER(@viRbnum),
        @viType   = @viLinkType,
        @voResult = @V_Price OUTPUT;

    SELECT @MaterialsTotal = ISNULL(SUM(TotalCost), 0)
    FROM SBCES.TempMaterialsList;

    -- Get labour cost
    EXEC SBCES.GetLabourCost
        @viIdnum  = UPPER(@viRbnum),
        @viType   = @viLinkType,
        @voResult = @V_Price OUTPUT;

    SELECT @LabourSubtotal = ISNULL(SUM(TotalCost), 0)
    FROM SBCES.TempLabourList;

    -- Labour overhead
    SELECT @LabourOverhead = ISNULL(MAX(REPLACE(CS.Value, ',', '.')), 0) * @LabourSubtotal
    FROM SBCES.CesSettings CS
    WHERE CS.Parameter = 'OVERHEAD';

    SET @LabourTotal = @LabourSubtotal + ISNULL(@LabourOverhead, 0);

    -- Core cost
    SELECT @CoreCostStr = CoreCharge
    FROM SBCES.RbMasterlist
    WHERE UPPER(RebuiltStockNum) = UPPER(@viRbnum);

    IF @CoreCostStr IS NULL OR @CoreCostStr = '' OR @CoreCostStr = ' '
        SET @CoreCost = 0;
    ELSE
        SET @CoreCost = CAST(REPLACE(REPLACE(@CoreCostStr, ',', '.'), '$', '') AS DECIMAL(20,10));

    SET @voTotalCost = ROUND(ISNULL((@MaterialsTotal - @CoreCost + @LabourTotal), 0), 2);
END;
GO

