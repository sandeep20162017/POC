         MB_LIST.external_cost,
         nvl(STOCK_CODED_PARTS.MMS_NEW_COST,0),
         MB_LIST.internal_cost,
         MB_LIST.sop_number,
         MB_LIST.core_cost,
         NVL(MB_LIST.job_number, ' '),
         SYSDATE,
         vi_username,
         vi_labour_cost,
