USE [CES]
GO

SET ANSI_NULLS ON
GO

SET QUOTED_IDENTIFIER ON
GO

ALTER PROCEDURE [SBCES].[CopyMbEstimate]
(
    @viMbNumber        VARCHAR(50),
    @viNewMbNumber     VARCHAR(50),   -- Will be generated by the procedure
    @viKeyword         VARCHAR(100),
    @viRebuildNumber   VARCHAR(50),
    @viEnteredBy       VARCHAR(50),
    @voRetVal          INT OUTPUT
)
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @ret INT = 0;

    DECLARE @Prefix VARCHAR(10);
    DECLARE @NextNumber INT;

    -- Used to safely capture the incremented sequence number
    DECLARE @SequenceResult TABLE
    (
        LastNumber INT
    );

    PRINT 'CopyMbEstimate: START';
    PRINT '  viMbNumber      = ' + ISNULL(@viMbNumber, '<NULL>');
    PRINT '  viNewMbNumber   = ' + ISNULL(@viNewMbNumber, '<NULL>');
    PRINT '  viKeyword       = ' + ISNULL(@viKeyword, '<NULL>');
    PRINT '  viRebuildNumber = ' + ISNULL(@viRebuildNumber, '<NULL>');
    PRINT '  viEnteredBy     = ' + ISNULL(@viEnteredBy, '<NULL>');

    BEGIN TRY

        BEGIN TRAN;

        --------------------------------------------------------------------
        -- 1. Validate source MB number
        --------------------------------------------------------------------
        IF NULLIF(LTRIM(RTRIM(@viMbNumber)), '') IS NULL
        BEGIN
            RAISERROR('SOURCE_MB_NUMBER_REQUIRED', 16, 1);
        END;

        IF LEN(LTRIM(RTRIM(@viMbNumber))) < 3
        BEGIN
            RAISERROR('INVALID_MB_NUMBER_PREFIX', 16, 1);
        END;

        --------------------------------------------------------------------
        -- 2. Extract the first 3 characters as the MB prefix
        --
        -- Examples:
        --     MBD000047 -> MBD
        --     MBH000021 -> MBH
        --------------------------------------------------------------------
        SET @Prefix = UPPER(LEFT(LTRIM(RTRIM(@viMbNumber)), 3));

        PRINT '  Derived Prefix = ' + ISNULL(@Prefix, '<NULL>');

        --------------------------------------------------------------------
        -- 3. Verify that the source MB exists BEFORE changing the sequence
        --------------------------------------------------------------------
        IF NOT EXISTS
        (
            SELECT 1
            FROM SBCES.MbList
            WHERE MbNumber = @viMbNumber
        )
        BEGIN
            RAISERROR('NO_DATA_FOUND_MBLIST', 16, 1);
        END;

        --------------------------------------------------------------------
        -- 4. Atomically increment the sequence and capture the NEW number
        --
        -- Example:
        --
        -- Before:
        --     MBD | 47
        --
        -- This statement changes it to:
        --     MBD | 48
        --
        -- and captures 48 into @NextNumber.
        --
        -- Because this occurs inside the transaction, the update will be
        -- rolled back automatically if anything later in the procedure fails.
        --
        -- UPDLOCK + HOLDLOCK prevents two concurrent executions from
        -- generating the same number.
        --------------------------------------------------------------------
        PRINT 'Updating SBCES.MBPrefixSequence...';

        UPDATE seq
            SET LastNumber = LastNumber + 1
            OUTPUT inserted.LastNumber
                INTO @SequenceResult (LastNumber)
        FROM SBCES.MBPrefixSequence AS seq WITH (UPDLOCK, HOLDLOCK)
        WHERE seq.PrefixCode = @Prefix;

        IF @@ROWCOUNT = 0
        BEGIN
            RAISERROR('MB_PREFIX_NOT_FOUND', 16, 1);
        END;

        SELECT TOP (1)
            @NextNumber = LastNumber
        FROM @SequenceResult;

        --------------------------------------------------------------------
        -- 5. Build the new MB number
        --
        -- Prefix + 6 digit padded number
        --
        -- Example:
        --     MBD + 48 = MBD000048
        --     MBH + 22 = MBH000022
        --------------------------------------------------------------------
        SET @viNewMbNumber =
            @Prefix + RIGHT('000000' + CAST(@NextNumber AS VARCHAR(6)), 6);

        PRINT '  Generated viNewMbNumber = ' + @viNewMbNumber;

        --------------------------------------------------------------------
        -- 6. Copy the main information for the MB estimate (MbList)
        --------------------------------------------------------------------
        PRINT 'Inserting into SBCES.MbList...';

        INSERT INTO SBCES.MbList
        (
             mbNumber,
             keyword,
             description,
             busType,
             numBusComp,
             vendorPartNum,
             buyCode,
             rebuildCode,
             coreCode,
             annualUsage,
             benchNumber,
             sampleProvided,
             recommendation,
             remanCost,
             externalCost,
             buyNewCost,
             internalCost,
             sopNumber,
             coreCost,
             jobNumber,
             dateOpened,
             readManualNewPrice
        )
        SELECT
             @viNewMbNumber,
             UPPER(ISNULL(@viKeyword, ' ')),
             description,
             busType,
             numBusComp,
             vendorPartNum,
             buyCode,
             UPPER(ISNULL(@viRebuildNumber, ' ')),
             coreCode,
             annualUsage,
             benchNumber,
             sampleProvided,
             recommendation,
             remanCost,
             externalCost,
             buyNewCost,
             internalCost,
             sopNumber,
             coreCost,
             jobNumber,
             GETDATE(),
             readManualNewPrice
        FROM SBCES.MbList
        WHERE mbNumber = @viMbNumber;

        IF @@ROWCOUNT = 0
        BEGIN
            RAISERROR('NO_DATA_FOUND_MBLIST', 16, 1);
        END;

        PRINT '  MbList inserted successfully.';

        --------------------------------------------------------------------
        -- 7. Add the Non Stock Coded Parts used in the estimate
        --    (NscPartsUsed)
        --------------------------------------------------------------------
        PRINT 'Inserting into SBCES.NscPartsUsed...';

        INSERT INTO SBCES.NscPartsUsed
        (
            origSuppNum,
            origSupplierName,
            costCentre,
            percentUsage,
            enteredBy,
            dateEntered,
            lastModifiedBy,
            lastModifiedDate,
            linkCode,
            qtyReqd,
            cost,
            linkType,
            coreCost,
            id
        )
        SELECT
            origSuppNum,
            origSupplierName,
            costCentre,
            percentUsage,
            UPPER(ISNULL(@viEnteredBy, ' ')),
            GETDATE(),
            UPPER(ISNULL(@viEnteredBy, ' ')),
            GETDATE(),
            @viNewMbNumber,
            qtyReqd,
            cost,
            'MB',
            coreCost,
            id
        FROM SBCES.NscPartsUsed
        WHERE linkCode = @viMbNumber
          AND linkType = 'MB';

        PRINT '  Rows inserted into NscPartsUsed: '
            + CAST(@@ROWCOUNT AS VARCHAR(20));

        --------------------------------------------------------------------
        -- 8. Add the Stock Coded and Rebuilt Parts used in the estimate
        --    (ScPartsUsed)
        --------------------------------------------------------------------
        PRINT 'Inserting into SBCES.ScPartsUsed...';

        INSERT INTO SBCES.ScPartsUsed
        (
            mmsStockCode,
            costCentre,
            percentUsage,
            EnteredBy,
            dateEntered,
            lastModifiedBy,
            lastModifiedDate,
            linkCode,
            qtyReqd,
            rebPartCost,
            mmsRebuiltCode,
            rebuiltPart,
            linkType,
            coreCost,
            mmsCost,
            oemCost
        )
        SELECT
            mmsStockCode,
            costCentre,
            percentUsage,
            UPPER(ISNULL(@viEnteredBy, ' ')),
            GETDATE(),
            UPPER(ISNULL(@viEnteredBy, ' ')),
            GETDATE(),
            @viNewMbNumber,
            qtyReqd,
            rebPartCost,
            mmsRebuiltCode,
            rebuiltPart,
            'MB',
            coreCost,
            mmsCost,
            oemCost
        FROM SBCES.ScPartsUsed
        WHERE linkCode = @viMbNumber
          AND linkType = 'MB';

        PRINT '  Rows inserted into ScPartsUsed: '
            + CAST(@@ROWCOUNT AS VARCHAR(20));

        --------------------------------------------------------------------
        -- 9. Add Labour to the estimate (EmployeeLabour)
        --------------------------------------------------------------------
        PRINT 'Inserting into SBCES.EmployeeLabour...';

        INSERT INTO SBCES.EmployeeLabour
        (
            labourDefn,
            dateEntered,
            linkNumber,
            typeId,
            costCentre,
            [task],
            labourType,
            usage,
            hrsReqd,
            adjHrs,
            dateRevised,
            timeAddition,
            rebuiltPartNum,
            lastModifiedBy
        )
        SELECT
            labourDefn,
            GETDATE(),
            @viNewMbNumber,
            'MB',
            costCentre,
            [task],
            labourType,
            usage,
            hrsReqd,
            adjHrs,
            GETDATE(),
            timeAddition,
            rebuiltPartNum,
            UPPER(ISNULL(@viEnteredBy, ' '))
        FROM SBCES.EmployeeLabour
        WHERE linkNumber = @viMbNumber
          AND typeId = 'MB';

        PRINT '  Rows inserted into EmployeeLabour: '
            + CAST(@@ROWCOUNT AS VARCHAR(20));

        --------------------------------------------------------------------
        -- 10. Add Bus List to the estimate (MbListOfBuses)
        --------------------------------------------------------------------
        PRINT 'Inserting into SBCES.MbListOfBuses...';

        INSERT INTO SBCES.MbListOfBuses
        (
             mbNumber,
             listId
        )
        SELECT
             @viNewMbNumber,
             listId
        FROM SBCES.MbListOfBuses
        WHERE mbNumber = @viMbNumber;

        PRINT '  Rows inserted into MbListOfBuses: '
            + CAST(@@ROWCOUNT AS VARCHAR(20));

        --------------------------------------------------------------------
        -- 11. Everything succeeded.
        --
        -- The MBPrefixSequence increment and all copied data are committed
        -- together.
        --------------------------------------------------------------------
        COMMIT TRAN;

        SET @voRetVal = 0;
        SET @ret = 0;

        PRINT 'CopyMbEstimate: SUCCESS';
        PRINT '  Prefix         = ' + @Prefix;
        PRINT '  New Number     = ' + @viNewMbNumber;
        PRINT '  New LastNumber = ' + CAST(@NextNumber AS VARCHAR(20));
        PRINT '  voRetVal       = 0';

        RETURN @ret;
    END TRY

    BEGIN CATCH

        IF XACT_STATE() <> 0
            ROLLBACK TRAN;

        DECLARE @errNum INT =
            ERROR_NUMBER();

        DECLARE @errMsg NVARCHAR(4000) =
            ERROR_MESSAGE();

        PRINT 'CopyMbEstimate: ERROR';
        PRINT '  ErrorNumber = ' + CAST(@errNum AS VARCHAR(20));
        PRINT '  ErrorMessage = ' + ISNULL(@errMsg, '<NULL>');

        --------------------------------------------------------------------
        -- Map to Oracle-style return codes
        --------------------------------------------------------------------
        IF @errMsg LIKE 'NO_DATA_FOUND_MBLIST%'
        BEGIN
            SET @voRetVal = -146;
            SET @ret = -1;
        END
        ELSE IF @errMsg LIKE 'MB_PREFIX_NOT_FOUND%'
        BEGIN
            SET @voRetVal = -149;
            SET @ret = -1;
        END
        ELSE IF @errMsg LIKE 'SOURCE_MB_NUMBER_REQUIRED%'
        BEGIN
            SET @voRetVal = -150;
            SET @ret = -1;
        END
        ELSE IF @errMsg LIKE 'INVALID_MB_NUMBER_PREFIX%'
        BEGIN
            SET @voRetVal = -151;
            SET @ret = -1;
        END
        ELSE IF @errNum IN (2601, 2627)
        BEGIN
            SET @voRetVal = -147;
            SET @ret = -1;
        END
        ELSE
        BEGIN
            SET @voRetVal = -148;
            SET @ret = -1;
        END;

        PRINT 'CopyMbEstimate: FAILURE';
        PRINT '  voRetVal = ' + CAST(@voRetVal AS VARCHAR(20));

        RETURN @ret;
    END CATCH;
END;
GO
