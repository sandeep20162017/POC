// Completely rewritten print function - works without popup blocking
$(document).ready(function() {
    // Print button handler
    $('#printReportBtn').on('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        // Show loading indicator
        var btn = $(this);
        var originalText = btn.text();
        btn.text('⏳ Preparing print...');
        btn.prop('disabled', true);
        
        // Use setTimeout to let the UI update
        setTimeout(function() {
            printReport();
            btn.text(originalText);
            btn.prop('disabled', false);
        }, 100);
    });
    
    // Also handle keyboard shortcut Ctrl+P
