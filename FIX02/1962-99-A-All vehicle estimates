    }

    .detail-section {
        border: 1px solid #000000 !important;
    }

    .material-section,
    .labour-section {
        border: 2px solid #000000 !important;
    }

    .total-box {
        border: 2px solid #000000 !important;
    }

    .grand-total-section {
        border: 2px solid #000000 !important;
    }

    .summary-card .value,
    .vehicle-info-item .value,
    .total-box-value,
    .grand-total-value {
