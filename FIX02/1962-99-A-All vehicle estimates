                    <span class="label">Effective Hours</span>
                </div>
                <div class="summary-card">
                    <span class="value">@ViewBag.TotalAdjustedHours.ToString("F2")</span>
                    <span class="label">Adjusted Hours</span>
                </div>
            </div>
        </div>
