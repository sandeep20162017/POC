/* ============================================
   VEHICLE REPORT STYLES
   Production Grade - Black & White Print Ready
   ============================================ */

/* ===== BASE RESET ===== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', 'Roboto', Arial, sans-serif;
    background: #ffffff;
    margin: 0;
    padding: 20px;
    color: #000000;
}

/* ===== REPORT CONTAINER ===== */
.report-container {
    max-width: 1280px;
    margin: 0 auto;
    background: #ffffff;
    padding: 16px 20px 22px 20px;
}

/* ===== REPORT HEADER ===== */
.report-header {
    text-align: center;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 3px solid #2c3e50;
}

.report-header h1 {
    margin: 0 0 8px 0;
    color: #1a5276;
    font-size: 28px;
    letter-spacing: 1px;
}

.report-header .subtitle {
    color: #5d6d7e;
    font-size: 13px;
    font-family: 'Courier New', monospace;
}

.report-header .estimate-number {
    font-size: 14px;
    color: #5d6d7e;
    font-weight: 600;
}

.report-header .estimate-number span {
    color: #1a5276;
    font-weight: 700;
}

.report-header .status-badge {
    font-size: 12px;
    color: #5d6d7e;
}

.report-header .status-badge .active {
    color: #27ae60;
    font-weight: 600;
}

/* ===== SECTION STYLES ===== */
.detail-section {
    margin-bottom: 14px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    overflow: hidden;
    page-break-inside: avoid;
}

.detail-header {
    background: #2c3e50;
    color: #ffffff;
    padding: 9px 14px;
    font-weight: 700;
    font-size: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}

.detail-header .badge {
    background: rgba(255, 255, 255, 0.2);
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 400;
}

.detail-body {
    padding: 10px 14px;
}

/* ===== VEHICLE INFO GRID ===== */
.vehicle-info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
}

.vehicle-info-item {
    display: flex;
    flex-direction: column;
    padding: 7px 10px;
    background: #f8f9fa;
    border-radius: 6px;
    border-left: 4px solid #2c3e50;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}

.vehicle-info-item .label {
    font-size: 11px;
    color: #6c757d;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.vehicle-info-item .value {
    font-size: 14px;
    font-weight: 600;
    color: #1a5276;
    margin-top: 2px;
    word-break: break-word;
}

/* ===== SUMMARY CARDS ===== */
.summary-grid {
    display: grid;
    gap: 12px;
}

.summary-grid-3 {
    grid-template-columns: repeat(3, minmax(115px, 1fr));
}

.summary-grid-6 {
    grid-template-columns: repeat(6, minmax(115px, 1fr));
}

.summary-card {
    background: #f8f9fa;
    padding: 8px 8px;
    border-radius: 6px;
    text-align: center;
    border: 1px solid #e9ecef;
