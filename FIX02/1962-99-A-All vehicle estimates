            <div class="labour-body">
                <table class="info-table">
                    <tr><td class="label-col"><strong>Fringe</strong></td><td class="value-col">@String.Format("{0:C}", ViewBag.LabourFringe)</td></tr>
                    <tr><td class="label-col"><strong>Benefits</strong></td><td class="value-col">@String.Format("{0:C}", ViewBag.LabourBenefits)</td></tr>
                    <tr><td class="label-col"><strong>Blended Fringe & Benefits</strong></td><td class="value-col">@String.Format("{0:C}", ViewBag.BlendedFringeBenefitCost)</td></tr>
                    <tr><td class="label-col"><strong>Overhead</strong></td><td class="value-col">@String.Format("{0:C}", ViewBag.LabourOverhead)</td></tr>
                    <tr class="total-row"><td class="label-col"><strong>= Total Labour Cost</strong></td><td class="value-col">@String.Format("{0:C}", ViewBag.FinalLabourCost)</td></tr>
                </table>
