/**
 * ============================================
 * VEHICLE REPORT UTILITIES
 * Production Grade - Copy & PDF Export
 * ============================================
 */

var VehicleReport = (function() {
    'use strict';

    // ===== PRIVATE VARIABLES =====
    var _config = {
        partNum: '',
        reportType: 'full',
        baseUrl: '',
        debug: false
    };

    // ===== PRIVATE METHODS =====

    /**
     * Log debug messages
     */
    function _log(message, data) {
        if (_config.debug) {
            console.log('[VehicleReport] ' + message, data || '');
        }
    }

    /**
     * Get the report title based on type
     */
    function _getReportTitle(reportType) {
        var titles = {
            full: 'FULL VEHICLE ESTIMATE REPORT',
            vehicle: 'VEHICLE COST SUMMARY REPORT',
            labour: 'LABOUR DETAILS REPORT',
            materials: 'MATERIALS ESTIMATE REPORT'
        };
        return titles[reportType] || titles.full;
    }

    /**
     * Get the report file name
     */
    function _getReportFileName(reportType, estimateNum) {
        var types = {
            full: 'FullVehicleEstimate',
            vehicle: 'VehicleEstimate',
            labour: 'LabourDetails',
            materials: 'MaterialsEstimate'
        };
        var typeName = types[reportType] || 'VehicleEstimate';
        var cleanEstimate = (estimateNum || 'Estimate').replace(/[^a-z0-9_.-]/gi, '_');
        return typeName + '_' + cleanEstimate;
    }

    /**
     * Get success message for clipboard
     */
    function _getClipboardMessage(reportType) {
        var messages = {
            full: 'Full Vehicle Estimate Report',
            vehicle: 'Vehicle Estimate Report',
            labour: 'Labour Details Report',
            materials: 'Materials Estimate Report'
        };
        return messages[reportType] || 'Report';
    }

    /**
     * Get element by ID with error handling
     */
    function _getElement(id) {
        var el = document.getElementById(id);
        if (!el) {
            _log('Element not found: ' + id);
        }
        return el;
    }

    /**
     * Show a Kendo alert or fallback
     */
    function _showAlert(message, isError) {
        _log('Alert: ' + message, { isError: isError });
        
        if (typeof kendo !== 'undefined' && kendo.alert) {
            kendo.alert(message);
        } else {
            alert(message);
        }
    }

    /**
     * Check if Kendo is available
     */
    function _isKendoAvailable() {
        return typeof kendo !== 'undefined' && 
               kendo.drawing && 
               kendo.drawing.drawDOM && 
               kendo.drawing.exportPDF && 
               kendo.saveAs;
    }

    /**
     * Create a safe wrapper for export
     */
    function _createExportWrapper(container, reportType) {
        var wrapper = document.createElement('div');
        wrapper.id = 'exportWrapper_' + Date.now();
        wrapper.style.cssText = [
            'padding: 20px',
            'background: white',
            'font-family: "Segoe UI", Arial, sans-serif',
            'position: absolute',
            'left: -100000px',
            'top: 0',
            'width: 1100px',
            'z-index: 9999'
        ].join('; ');

        // Clone the container
        var clone = container.cloneNode(true);
        
        // Update the title
        var titleEl = clone.querySelector('h1');
        if (titleEl) {
            titleEl.textContent = _getReportTitle(reportType);
        }

        wrapper.appendChild(clone);
        document.body.appendChild(wrapper);

        // Remove any print-only or UI elements
        var noPrintElements = wrapper.querySelectorAll('.no-print, button, .k-button, .k-context-menu, .report-toolbar');
        noPrintElements.forEach(function(el) {
            el.style.display = 'none';
        });

        // Ensure all sections are visible
        var sections = wrapper.querySelectorAll('.detail-section, .side-by-side, .totals-row, .grand-total-section');
        sections.forEach(function(el) {
            el.style.display = '';
            el.style.visibility = 'visible';
        });

        // Force layout
        void wrapper.offsetWidth;
        void wrapper.offsetHeight;

        return wrapper;
    }

    /**
     * Clean up export wrapper
     */
    function _removeExportWrapper(wrapperId) {
        var wrapper = document.getElementById(wrapperId);
        if (wrapper) {
            document.body.removeChild(wrapper);
        }
    }

    // ===== PUBLIC API =====

    /**
     * Initialize the report module
     */
    function init(config) {
        _config = Object.assign({}, _config, config || {});
        _log('Initialized with config:', _config);
    }

    /**
     * Save report as PDF
     */
    function saveAsPdf(containerId, reportType, fileName) {
        _log('saveAsPdf called', { containerId: containerId, reportType: reportType });

        var container = _getElement(containerId);
        if (!container) {
            _showAlert('Unable to find the estimate report.', true);
            return;
        }

        if (!_isKendoAvailable()) {
            _showAlert('Kendo PDF export is not available on this page.', true);
            return;
        }

        // Get estimate number
        var estimateNum = '';
        var estimateEl = document.querySelector('#estimateNumber');
        if (estimateEl) {
            estimateNum = estimateEl.textContent.trim();
        }

        var pdfFileName = fileName || _getReportFileName(reportType, estimateNum) + '.pdf';
        var wrapper = null;
        var wrapperId = '';

        try {
            // Create export wrapper
            wrapper = _createExportWrapper(container, reportType);
            wrapperId = wrapper.id;

            // Validate dimensions
            if (wrapper.offsetWidth <= 0 || wrapper.offsetHeight <= 0) {
                throw new Error('PDF export target has zero width or height.');
            }

            _log('Export wrapper dimensions:', {
                width: wrapper.offsetWidth,
                height: wrapper.offsetHeight
            });

            // Draw and export
            var drawRequest = kendo.drawing.drawDOM(wrapper, {
                paperSize: 'Letter',
                landscape: true,
                margin: {
                    top: '0.35in',
                    bottom: '0.35in',
                    left: '0.35in',
                    right: '0.35in'
                },
                scale: 0.78,
                multiPage: true,
                avoidLinks: true,
                keepTogether: '.vehicle-audit-row, .summary-card'
            });

            drawRequest.done(function(group) {
                if (!group) {
                    _removeExportWrapper(wrapperId);
                    _showAlert('Kendo did not return printable report content.', true);
                    return;
                }

                var pdfRequest = kendo.drawing.exportPDF(group, {
                    paperSize: 'Letter',
                    landscape: true,
                    margin: {
                        top: '0.35in',
                        bottom: '0.35in',
                        left: '0.35in',
                        right: '0.35in'
                    }
                });

                pdfRequest.done(function(dataUri) {
                    _removeExportWrapper(wrapperId);
                    
                    if (!dataUri || dataUri.length < 100) {
                        throw new Error('Kendo returned empty PDF data.');
                    }

                    kendo.saveAs({
                        dataURI: dataUri,
                        fileName: pdfFileName
                    });

                    _log('PDF created successfully:', pdfFileName);
                });

                pdfRequest.fail(function(err) {
                    _removeExportWrapper(wrapperId);
                    _log('PDF export error:', err);
                    _showAlert('Error generating PDF: ' + (err && err.message ? err.message : 'Unknown error.'), true);
                });
            });

            drawRequest.fail(function(err) {
                _removeExportWrapper(wrapperId);
                _log('drawDOM error:', err);
                _showAlert('Error preparing PDF: ' + (err && err.message ? err.message : 'Unknown error.'), true);
            });

        } catch (err) {
            _removeExportWrapper(wrapperId);
            _log('PDF setup error:', err);
            _showAlert('Error generating PDF: ' + (err && err.message ? err.message : 'Unknown error.'), true);
        }
    }

    /**
     * Copy report to clipboard as image
     */
    function copyToClipboard(containerId, reportType) {
        _log('copyToClipboard called', { containerId: containerId, reportType: reportType });

        var container = _getElement(containerId);
        if (!container) {
            _showAlert('Unable to find the estimate report.', true);
            return;
        }

        if (!_isKendoAvailable()) {
            _showAlert('Kendo export is not available on this page.', true);
            return;
        }

        if (!navigator.clipboard) {
            _showAlert('Clipboard API is not available. Please use a modern browser.', true);
            return;
        }

        var wrapper = null;
        var wrapperId = '';

        try {
            wrapper = _createExportWrapper(container, reportType);
            wrapperId = wrapper.id;

            var drawRequest = kendo.drawing.drawDOM(wrapper, {
                paperSize: 'auto',
                margin: '1cm',
                scale: 1
            });

            drawRequest.then(function(group) {
                return kendo.drawing.exportImage(group);
            }).done(function(data) {
                _removeExportWrapper(wrapperId);
                
                fetch(data)
                    .then(function(res) { return res.blob(); })
                    .then(function(blob) {
                        navigator.clipboard.write([
                            new ClipboardItem({ 'image/png': blob })
                        ]);
                        var message = _getClipboardMessage(reportType) + ' copied to clipboard.';
                        _showAlert(message);
                        _log('Clipboard copy successful');
                    })
                    .catch(function(err) {
                        _log('Clipboard error:', err);
                        _showAlert('Error copying to clipboard: ' + err.message, true);
                    });
            }).catch(function(err) {
                _removeExportWrapper(wrapperId);
                _log('Export image error:', err);
                _showAlert('Error generating image: ' + (err && err.message ? err.message : 'Unknown error.'), true);
            });

        } catch (err) {
            _removeExportWrapper(wrapperId);
            _log('Copy setup error:', err);
            _showAlert('Error copying to clipboard: ' + (err && err.message ? err.message : 'Unknown error.'), true);
        }
    }

    /**
     * Open report in new window/tab
     */
    function viewReport(reportType, id, actionUrl) {
        _log('viewReport called', { reportType: reportType, id: id });

        var url = actionUrl || _config.baseUrl;
        if (url) {
            var fullUrl = url + '?reportType=' + encodeURIComponent(reportType) + '&id=' + encodeURIComponent(id);
            window.open(fullUrl, '_blank');
        } else {
            _showAlert('View URL not configured.', true);
        }
    }

    /**
     * Set debug mode
     */
    function setDebug(enabled) {
        _config.debug = enabled === true;
        _log('Debug mode: ' + (_config.debug ? 'ON' : 'OFF'));
    }

    // ===== PUBLIC EXPOSURE =====
    return {
        init: init,
        saveAsPdf: saveAsPdf,
        copyToClipboard: copyToClipboard,
        viewReport: viewReport,
        setDebug: setDebug
    };

})();
