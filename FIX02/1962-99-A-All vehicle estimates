                    <tr class="tax-row"><td class="label-col"><strong>+ Material Tax</strong></td><td class="value-col">@String.Format("{0:C}", ViewBag.MaterialTotalTaxAmount)</td></tr>
                    <tr class="total-row"><td class="label-col"><strong>= Total Material Cost (With Tax)</strong></td><td class="value-col">@String.Format("{0:C}", ViewBag.MaterialTotalWithTax)</td></tr>
                </table>
            </div>
        </div>

