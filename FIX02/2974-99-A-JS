const recommendedScale = 1.5; // 150%
const recommendedWidth = 1920;
const recommendedHeight = 1080;

// Allowed CSS pixel tolerance
const widthMin = 1915;
const widthMax = 1925;
const heightMin = 1075;
const heightMax = 1085;

function checkDisplaySettings() {

    const scale = window.devicePixelRatio;

    // Browser-reported CSS pixels
    const cssWidth = window.screen.width;
    const cssHeight = window.screen.height;

    // Actual physical resolution
    const realWidth = Math.round(cssWidth * scale);
    const realHeight = Math.round(cssHeight * scale);

    let messages = [];

    // Scaling check (exact match)
    if (scale !== recommendedScale) {
        messages.push(
            `Your display scaling is ${scale * 100}%. Recommended: 150%.`
        );
    }

    // CSS pixel range check
    const cssWidthOutOfRange = cssWidth < widthMin || cssWidth > widthMax;
    const cssHeightOutOfRange = cssHeight < heightMin || cssHeight > heightMax;

    if (cssWidthOutOfRange || cssHeightOutOfRange) {
        messages.push(
            `Your screen CSS resolution is ${cssWidth}×${cssHeight}. Recommended: ~1920×1080.`
        );
    }

    // Physical resolution check (optional but kept)
    if (realWidth !== recommendedWidth || realHeight !== recommendedHeight) {
        messages.push(
            `Your physical resolution is ${realWidth}×${realHeight}. Recommended: 1920×1080.`
        );
    }

    if (messages.length > 0) {
        banner.style.display = "block";
        banner.innerHTML = messages.join("<br>");
    } else {
        banner.style.display = "none";
    }
}

checkDisplaySettings();

// Detect scaling changes live
window.matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`)
    .addEventListener("change", () => location.reload());

// Detect monitor changes
window.addEventListener("resize", checkDisplaySettings);
