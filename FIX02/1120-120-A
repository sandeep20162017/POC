// Non-productive adjustment as a number (SQL handles the comma/dot and fallback to 1)
var npa = await _dbConnection.QueryFirstOrDefaultAsync<decimal?>(
    @"SELECT TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS
                                       WHERE Parameter = 'NON_PRODUCTIVE_ADJUSTMENT'), '1'), ',', '.') AS DECIMAL(18,6))",
    transaction: transaction) ?? 1m;
if (npa <= 0) npa = 1m;

// LabourHrs and LabourMins are int, so use them directly
int reqMinutes = model.LabourHrs * 60 + model.LabourMins;

int wrenchMinutes = (int)Math.Round(reqMinutes / npa, MidpointRounding.AwayFromZero);
string wrenchTime = $"{wrenchMinutes / 60}:{wrenchMinutes % 60:D2}";   // 2:00 / 1.2 = 100 min -> "1:40"
