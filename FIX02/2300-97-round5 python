def insert_generic(sql_conn, table, oracle_table, oracle_conn):
    rows = fetch_oracle_rows(oracle_conn, f"SELECT * FROM {oracle_table}")
    if not rows:
        logger.info(f"{table}: no rows")
        return
    cur = sql_conn.cursor()
    placeholders = ", ".join(["?"] * len(rows[0]))
    sql = f"INSERT INTO {SQL_SCHEMA}.{table} VALUES ({placeholders})"
    success = 0
    fail = 0
    for idx, r in enumerate(rows):
        try:
            cur.execute(sql, r)
            success += 1
        except Exception as e:
            fail += 1
            logger.error(f"{table} row {idx} failed: {e} | Row={r}")
    sql_conn.commit()
    cur.close()
    logger.info(f"{table}: {success} succeeded, {fail} failed")

def main():
    oracle_conn = get_oracle_conn()
    sql_conn = get_sql_conn()

    # FK-safe delete
    for table in DELETE_ORDER:
        delete_sql_table(sql_conn, table)

    # FK-safe insert
    migrate_costcentres(oracle_conn, sql_conn)
    migrate_emplclass(oracle_conn, sql_conn)
    migrate_employeelabour(oracle_conn, sql_conn)

    # Insert remaining tables
    for table in INSERT_ORDER:
        if table in ("CostCentres", "EmplClass", "EmployeeLabour"):
            continue
        oracle_table = ROUND5_TABLES.get(table)
        if oracle_table:
            insert_generic(sql_conn, table, oracle_table, oracle_conn)

    oracle_conn.close()
    sql_conn.close()

if __name__ == "__main__":
    main()
