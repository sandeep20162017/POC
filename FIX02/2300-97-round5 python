def get_oracle_conn():
    return oracledb.connect(user=ORACLE_USER, password=ORACLE_PASSWORD, dsn=ORACLE_DSN)

def get_sql_conn():
    conn = pyodbc.connect(SQL_CONN_STR, timeout=10)
    cur = conn.cursor()
    cur.execute("SET ANSI_WARNINGS OFF;")
    cur.close()
    return conn

def delete_sql_table(sql_conn, table):
    cur = sql_conn.cursor()
    try:
        cur.execute(f"DELETE FROM {SQL_SCHEMA}.{table}")
        sql_conn.commit()
        logger.info(f"Deleted {table}")
    except Exception as e:
        logger.error(f"Delete failed for {table}: {e}")
    cur.close()

def fetch_oracle_rows(oracle_conn, sql):
    cur = oracle_conn.cursor()
    cur.execute(sql)
    rows = cur.fetchall()
    cur.close()
    return rows

def migrate_costcentres(oracle_conn, sql_conn):
    logger.info("Migrating CostCentres (explicit mapping)")
    rows = fetch_oracle_rows(oracle_conn, """
        SELECT NAME, DATE_ENTERED, COST_CENTRE
        FROM COST_CENTRES
    """)
    sql = f"""
        INSERT INTO {SQL_SCHEMA}.CostCentres
        (CostCentre, Name, DateEntered)
        VALUES (?, ?, ?)
    """
    cur = sql_conn.cursor()
    success = 0
    fail = 0
    for idx, (name, date_entered, cost_centre) in enumerate(rows):
        try:
            cur.execute(sql, (cost_centre, name, date_entered))
            success += 1
        except Exception as e:
            fail += 1
            logger.error(f"CostCentres row {idx} failed: {e} | Row={(name, date_entered, cost_centre)}")
    sql_conn.commit()
    cur.close()
    logger.info(f"CostCentres: {success} succeeded, {fail} failed")

