-- ===== 4. ONE PACKAGE ONLY (change the name) =====
SELECT src
FROM (
  SELECT line AS ord,
         CASE WHEN line = 1 THEN 'CREATE OR REPLACE ' END
         || RTRIM(text, CHR(10) || CHR(13)) AS src
  FROM   all_source
  WHERE  owner = 'CES' AND type = 'PACKAGE BODY' AND name = 'CES_ARCHIVE'
  UNION ALL
  SELECT MAX(line) + 1, '-----------'
  FROM   all_source
  WHERE  owner = 'CES' AND type = 'PACKAGE BODY' AND name = 'CES_ARCHIVE'
  HAVING COUNT(*) > 0
)
ORDER BY ord;
