-- Schema: CES

-- ===== 1. ALL PACKAGE BODIES -> save as ces_package_bodies.txt =====
SELECT src
FROM (
  SELECT name, line AS ord,
         CASE WHEN line = 1 THEN 'CREATE OR REPLACE ' END
         || RTRIM(text, CHR(10) || CHR(13)) AS src
  FROM   all_source
  WHERE  owner = 'CES' AND type = 'PACKAGE BODY'
  UNION ALL
  SELECT name, MAX(line) + 1, '-----------'
  FROM   all_source
  WHERE  owner = 'CES' AND type = 'PACKAGE BODY'
  GROUP  BY name
)
ORDER BY name, ord;

