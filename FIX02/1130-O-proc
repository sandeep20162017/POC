-- Run with "Run Script" (F5). Edit the two DEFINE lines below first.
-- The output folder MUST already exist. Use forward slashes.

DEFINE p_owner  = 'MYSCHEMA'
DEFINE p_folder = 'C:/temp'

SET ECHO OFF
SET FEEDBACK OFF
SET HEADING OFF
SET VERIFY OFF
SET PAGESIZE 0
SET LINESIZE 4000
SET LONG 1000000
SET TRIMSPOOL ON
SET SQLBLANKLINES ON

SPOOL &p_folder./all_procedures.sql

SELECT src
FROM (
    SELECT name, line AS ord,
           CASE WHEN line = 1 THEN 'CREATE OR REPLACE ' END
           || RTRIM(text, CHR(10) || CHR(13)) AS src
    FROM   all_source
    WHERE  owner = UPPER('&p_owner')
    AND    type  = 'PROCEDURE'
    UNION ALL
    SELECT name, MAX(line) + 1, '/' || CHR(10)
    FROM   all_source
    WHERE  owner = UPPER('&p_owner')
    AND    type  = 'PROCEDURE'
    GROUP  BY name
)
ORDER BY name, ord;

SPOOL OFF
PROMPT Done: &p_folder./all_procedures.sql
