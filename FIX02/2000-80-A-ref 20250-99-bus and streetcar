8. GetUsers — return Department

Your current query is:

SELECT u.UserId, u.UserName, u.userADId, u.RoleId, r.RoleName,
       ...
FROM SBCES.[Users] u

Change it to:

const string query = @"
    SELECT
        u.UserId,
        u.UserName,
        u.UserADId,
        u.RoleId,
        r.RoleName,
        u.Department,

        STRING_AGG(CAST(us.SiteId AS VARCHAR), ',') AS SiteId,
        STRING_AGG(s.SiteName, ',') AS SiteName

    FROM SBCES.Users u

    INNER JOIN SBCES.Roles r
        ON u.RoleId = r.RoleId

    LEFT JOIN SBCES.UserSites us
        ON u.UserId = us.UserId

    LEFT JOIN SBCES.Sites s
        ON us.SiteId = s.SiteId

    GROUP BY
        u.UserADId,
        u.UserId,
        u.UserName,
        u.RoleId,
        r.RoleName,
        u.Department

    ORDER BY u.UserADId;
";
