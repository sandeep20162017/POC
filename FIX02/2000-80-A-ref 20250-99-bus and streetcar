1. Database migration

Your current Users table has no Department column.

Your current VehicleList table also has no Department column.

Run this migration.

USE [CES];
GO

SET ANSI_NULLS ON;
GO

SET QUOTED_IDENTIFIER ON;
GO

/* ============================================================
   1. USERS.Department
   ============================================================ */

IF COL_LENGTH('SBCES.Users', 'Department') IS NULL
BEGIN
    ALTER TABLE [SBCES].[Users]
    ADD [Department] VARCHAR(20) NULL;
END
GO

/* Existing users default to BUS */
UPDATE [SBCES].[Users]
SET [Department] = 'BUS'
WHERE [Department] IS NULL;
GO

/* Default for all future users */
IF NOT EXISTS
(
    SELECT 1
    FROM sys.default_constraints dc
    INNER JOIN sys.columns c
        ON dc.parent_object_id = c.object_id
       AND dc.parent_column_id = c.column_id
    WHERE dc.parent_object_id = OBJECT_ID('SBCES.Users')
      AND c.name = 'Department'
)
BEGIN
    ALTER TABLE [SBCES].[Users]
    ADD CONSTRAINT [DF_Users_Department]
        DEFAULT ('BUS') FOR [Department];
END
GO

/* Make Department mandatory */
ALTER TABLE [SBCES].[Users]
ALTER COLUMN [Department] VARCHAR(20) NOT NULL;
GO

/* Valid department values only */
IF NOT EXISTS
(
    SELECT 1
    FROM sys.check_constraints
    WHERE parent_object_id = OBJECT_ID('SBCES.Users')
      AND name = 'CK_Users_Department'
)
BEGIN
    ALTER TABLE [SBCES].[Users]
    ADD CONSTRAINT [CK_Users_Department]
        CHECK ([Department] IN ('BUS', 'STREETCAR'));
END
GO


/* ============================================================
   2. VehicleList.Department
   ============================================================ */

IF COL_LENGTH('SBCES.VehicleList', 'Department') IS NULL
BEGIN
    ALTER TABLE [SBCES].[VehicleList]
    ADD [Department] VARCHAR(20) NULL;
END
GO

/* Existing estimates are BUS */
UPDATE [SBCES].[VehicleList]
SET [Department] = 'BUS'
WHERE [Department] IS NULL;
GO

/* Default for future estimates */
IF NOT EXISTS
(
    SELECT 1
    FROM sys.default_constraints dc
    INNER JOIN sys.columns c
        ON dc.parent_object_id = c.object_id
       AND dc.parent_column_id = c.column_id
    WHERE dc.parent_object_id = OBJECT_ID('SBCES.VehicleList')
      AND c.name = 'Department'
)
BEGIN
    ALTER TABLE [SBCES].[VehicleList]
    ADD CONSTRAINT [DF_VehicleList_Department]
        DEFAULT ('BUS') FOR [Department];
END
GO

/* Make Department mandatory */
ALTER TABLE [SBCES].[VehicleList]
ALTER COLUMN [Department] VARCHAR(20) NOT NULL;
GO

/* Valid department values only */
IF NOT EXISTS
(
    SELECT 1
    FROM sys.check_constraints
    WHERE parent_object_id = OBJECT_ID('SBCES.VehicleList')
      AND name = 'CK_VehicleList_Department'
)
BEGIN
    ALTER TABLE [SBCES].[VehicleList]
    ADD CONSTRAINT [CK_VehicleList_Department]
        CHECK ([Department] IN ('BUS', 'STREETCAR'));
