19. Delete method
private async Task DeleteVehicleAsync(int vehicleListId)
{
    _dbConnection.Open();

    using var transaction =
        _dbConnection.BeginTransaction();

    try
    {
        /*
         * IMPORTANT:
         * Do not allow deletion of a vehicle estimate
         * from another department.
         *
         * Authorization has already been checked by
         * DeleteVehicle(), but we check again inside
         * the transaction to prevent race conditions.
         */

        var currentUserDepartment =
            await GetCurrentUserDepartmentAsync();

        const string deleteSql = @"
            DELETE FROM SBCES.VehicleList
            WHERE VehicleListId = @VehicleListId
              AND Department = @Department;
        ";

        var rows = await _dbConnection.ExecuteAsync(
            deleteSql,
            new
            {
                VehicleListId = vehicleListId,
                Department = currentUserDepartment
            },
            transaction);

        if (rows == 0)
        {
            throw new UnauthorizedAccessException(
                "The estimate does not belong to your Department " +
                "or it no longer exists.");
        }

        transaction.Commit();
    }
    catch
    {
        transaction.Rollback();
        throw;
    }
    finally
    {
        _dbConnection.Close();
    }
}
