10. Add Department validation helper

Add this to the controller:

private static string NormalizeDepartment(string? department)
{
    if (string.Equals(department, "STREETCAR",
        StringComparison.OrdinalIgnoreCase))
    {
        return "STREETCAR";
    }

    return "BUS";
}

However, for production I would not silently convert an invalid value to BUS. Better:

private static string NormalizeDepartment(string? department)
{
    if (string.Equals(department, "BUS",
        StringComparison.OrdinalIgnoreCase))
    {
        return "BUS";
    }

    if (string.Equals(department, "STREETCAR",
        StringComparison.OrdinalIgnoreCase))
    {
        return "STREETCAR";
    }

    throw new ArgumentException("Invalid Department.");
}

Use this version.

