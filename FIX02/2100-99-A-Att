Create a reusable attribute: /BCES/Attributes/UppercaseAttribute.cs
This attribute modifies the model value itself, not validation.

csharp
using System;
using System.ComponentModel.DataAnnotations;
using System.Reflection;

namespace BCES.Attributes
{
    [AttributeUsage(AttributeTargets.Property)]
    public class UppercaseAttribute : ValidationAttribute
    {
        protected override ValidationResult IsValid(object value, ValidationContext context)
        {
            if (value is string str && !string.IsNullOrEmpty(str))
            {
                // Get the property
                PropertyInfo prop = context.ObjectType.GetProperty(context.MemberName);

                if (prop != null && prop.CanWrite)
                {
                    // Convert to uppercase and write back into the model
                    prop.SetValue(context.ObjectInstance, str.ToUpperInvariant());
                }
            }

            // Always valid — no errors
            return ValidationResult.Success;
        }
    }
}
⭐ What this attribute does
It never throws an error

It writes uppercase back into the model property

It works before EF Core saves, so DB always gets uppercase

It works in any model across your app

This is the cleanest, safest, most reusable approach.

✅ Use it in any model
csharp
using BCES.Attributes;

public class MyModel
{
    [Uppercase]
    public string Code { get; set; }
}
