-- Parameters
DECLARE @site     varchar(30) = 'CONSS';
DECLARE @assetnum varchar(30) = 'T1-5002A';   -- or '11765'

-- 1) Build the hierarchy ONCE
IF OBJECT_ID('tempdb..#h') IS NOT NULL DROP TABLE #h;
CREATE TABLE #h (assetid bigint NOT NULL PRIMARY KEY, assetnum varchar(30) NOT NULL, siteid varchar(8) NOT NULL);

WITH AssetHierarchy AS
(
    SELECT a.assetid, a.assetnum, a.siteid
    FROM maximo.asset a
    WHERE a.siteid = @site AND a.assetnum = @assetnum

    UNION ALL

    SELECT c.assetid, c.assetnum, c.siteid
    FROM maximo.asset c
    INNER JOIN AssetHierarchy h
        ON c.parent = h.assetnum AND c.siteid = h.siteid
)
INSERT INTO #h (assetid, assetnum, siteid)
SELECT assetid, assetnum, siteid FROM AssetHierarchy
OPTION (MAXRECURSION 0);

-- 2) Selected asset's model and LCN (one row each)
DECLARE @modelid bigint, @sel_lcn varchar(100), @sel_indenture int;

SELECT @modelid = COALESCE(a.plusamodelid, anc.plusamodelid)
FROM maximo.asset a
LEFT JOIN maximo.asset anc ON anc.assetnum = a.ancestor AND anc.siteid = a.siteid
WHERE a.assetnum = @assetnum AND a.siteid = @site;

SELECT TOP (1) @sel_lcn = p.lcn, @sel_indenture = b.indenture
FROM maximo.asset a
INNER JOIN maximo.plusasaonoff p ON p.assetid = a.assetid AND p.offtime IS NULL
INNER JOIN maximo.plusacmbuild b ON b.lcn = p.lcn
WHERE a.assetnum = @assetnum AND a.siteid = @site
ORDER BY b.indenture;

-- 3) Active installs for the hierarchy, one row per LCN, plus the LCNs to show
IF OBJECT_ID('tempdb..#ci') IS NOT NULL DROP TABLE #ci;
SELECT assetid, lcn, instwonum, remwonum, ontime, offtime
INTO #ci
FROM (
    SELECT p.assetid, p.lcn, p.instwonum, p.remwonum, p.ontime, p.offtime,
           ROW_NUMBER() OVER (PARTITION BY p.lcn ORDER BY p.ontime DESC) AS rn
    FROM maximo.plusasaonoff p
    INNER JOIN #h h ON h.assetid = p.assetid
    WHERE p.offtime IS NULL
) x
WHERE rn = 1;
CREATE CLUSTERED INDEX ix_ci_lcn ON #ci (lcn);

IF OBJECT_ID('tempdb..#vl') IS NOT NULL DROP TABLE #vl;
SELECT lcn INTO #vl
FROM (
    SELECT p.lcn FROM maximo.plusasaonoff p
    INNER JOIN #h h ON h.assetid = p.assetid
    WHERE p.offtime IS NULL
    UNION                                   -- UNION removes duplicates, replacing DISTINCT
    SELECT p.lcn FROM maximo.plusasaonoff p
    INNER JOIN #h h ON h.assetid = p.parentassetid
    WHERE p.offtime IS NULL
) v;
CREATE CLUSTERED INDEX ix_vl_lcn ON #vl (lcn);

-- 4) Final result
SELECT
    b.indenture, b.lcn, b.position,
    bi.plusacmbuilditemid, bi.name AS build_position,
    a.itemnum AS cm_item, a.assetnum, a.description AS asset_desc,
    a.serialnum, a.status, a.plustcomp AS component,
    pm.model, pm.description AS model_desc,
    pc.plusacmconfigid, pc.variation AS variant, pc.description AS variant_desc,
    a.parent, a2.description AS parent_desc, a2.serialnum AS parent_serialnum,
    a.ancestor AS top_asset, ta.description AS topasset_desc, ta.serialnum AS topasset_serialnum,
    a.siteid, a.orgid,
    ci.instwonum, ci.remwonum, ci.ontime, ci.offtime,
    CASE WHEN ci.ontime IS NOT NULL THEN DATEDIFF(DAY, ci.ontime, GETDATE()) END AS days_in_position
FROM maximo.plusacmbuild b
INNER JOIN #vl vl                     ON vl.lcn = b.lcn
INNER JOIN maximo.plusacmbuilditem bi ON bi.plusacmbuilditemid = b.builditemid
LEFT  JOIN #ci ci                     ON ci.lcn = b.lcn
LEFT  JOIN maximo.asset a             ON a.assetid = ci.assetid
LEFT  JOIN maximo.asset a2            ON a2.assetnum = a.parent   AND a2.siteid = a.siteid
LEFT  JOIN maximo.asset ta            ON ta.assetnum = a.ancestor AND ta.siteid = a.siteid
LEFT  JOIN maximo.plusacmmodel pm     ON pm.plusacmmodelid  = COALESCE(a.plusamodelid,  ta.plusamodelid)
LEFT  JOIN maximo.plusacmconfig pc    ON pc.plusacmconfigid = COALESCE(a.plusaconfigid, ta.plusaconfigid)
WHERE b.modelid = @modelid
  AND (@sel_indenture = 1 OR b.lcn = @sel_lcn)
ORDER BY b.lcn;
