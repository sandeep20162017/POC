/* Hide initially (same as original) */
#reportMenu {
    display: none;
}

/* Each line has fixed width */
.report-menu .menu-line {
    width: 340px;          /* ← Adjust width here */
    padding: 6px 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    border-bottom: 1px solid #e0e0e0;
    white-space: nowrap;   /* prevents stretching */
}

/* Icons */
.menu-icon {
    font-size: 20px;
    padding: 4px;
    transition: color .15s ease, transform .15s ease;
}

/* Hover */
.menu-line:hover .menu-icon {
    color: #0078d7;
    transform: scale(1.15);
}

/* Text */
.menu-text {
    font-size: 14px;
    color: #333;
}
