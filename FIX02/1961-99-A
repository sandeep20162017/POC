@{
    ViewData["Title"] = "Vehicle Cost Summary";
}

<style>
    /* ===== BASE STYLES ===== */
    * {
        box-sizing: border-box;
    }

    .total-cost-body {
        font-family: 'Segoe UI', 'Roboto', Arial, sans-serif;
        background: #eef2f5;
        margin: 0;
        padding: 20px;
        overflow-y: auto;
    }

    .report-container {
        max-width: 1280px;
        margin: 0 auto;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        padding: 16px 20px 22px 20px;
    }

    .report-header {
        text-align: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 3px solid #2c3e50;
    }

        .report-header h1 {
            margin: 0 0 8px 0;
            color: #1a5276;
            font-size: 28px;
            letter-spacing: 1px;
        }

        .report-header .subtitle {
            color: #5d6d7e;
            font-size: 13px;
            font-family: monospace;
        }

    /* ===== SECTION STYLES ===== */
    .detail-section {
        margin-bottom: 14px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
    }

    .detail-header {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 9px 14px;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .detail-header .badge {
            background: rgba(255,255,255,0.2);
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 400;
        }

    .detail-body {
        padding: 10px 14px;
    }

    /* ===== VEHICLE INFO ===== */
    .vehicle-info {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }

    .vehicle-info-item {
        display: flex;
        flex-direction: column;
        padding: 7px 10px;
        background: #f8f9fa;
        border-radius: 6px;
        border-left: 4px solid #2c3e50;
    }

        .vehicle-info-item .label {
            font-size: 11px;
            color: #6c757d;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .vehicle-info-item .value {
            font-size: 14px;
            font-weight: 600;
            color: #1a5276;
            margin-top: 2px;
        }


    .vehicle-audit-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid #dee2e6;
    }

    .vehicle-audit-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 6px 10px;
        background: #f8f9fa;
        border-radius: 5px;
    }

        .vehicle-audit-item .label {
            font-size: 9px;
            color: #6c757d;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .vehicle-audit-item .value {
            font-size: 11px;
            color: #495057;
            font-weight: 600;
        }
    /* ===== SUMMARY CARDS ===== */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(115px, 1fr));
        gap: 12px;
    }

    .summary-card {
        background: #f8f9fa;
        padding: 8px 8px;
        border-radius: 6px;
        text-align: center;
        border: 1px solid #e9ecef;
        transition: all 0.2s;
    }

        .summary-card:hover {
            background: #e8f0fe;
            border-color: #1a5276;
        }

        .summary-card .value {
            font-size: 18px;
            font-weight: 700;
            color: #1a5276;
            display: block;
        }

            .summary-card .value.green {
                color: #27ae60;
            }

            .summary-card .value.blue {
                color: #2980b9;
            }

            .summary-card .value.orange {
                color: #e67e22;
            }

            .summary-card .value.purple {
                color: #8e44ad;
            }

        .summary-card .label {
            font-size: 11px;
            color: #6c757d;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 4px;
            display: block;
        }

    /* ===== MATERIAL LINES TABLE ===== */
    .material-table-wrap {
        overflow-x: auto;
        margin-top: 5px;
    }

    .material-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .material-table th {
            background: #2c3e50;
            color: white;
            padding: 6px 8px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .material-table td {
            padding: 5px 8px;
            border-bottom: 1px solid #e0e4e8;
        }

        .material-table tr:hover td {
            background: #f8f9fa;
        }

        /* Row type colors */
        .material-table tr.type-stock td:first-child {
            border-left: 3px solid #27ae60;
        }

        .material-table tr.type-rebuilt td:first-child {
            border-left: 3px solid #e67e22;
        }

        .material-table tr.type-nonstock td:first-child {
            border-left: 3px solid #2980b9;
        }

        .material-table .type-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

    .type-badge.stock {
        background: #d5f5e3;
        color: #1a7a3a;
    }

    .type-badge.rebuilt {
        background: #fdebd0;
        color: #a04000;
    }

    .type-badge.nonstock {
        background: #d6eaf8;
        color: #1a5276;
    }

    .material-table .total-row td {
        background: #e8f0fe;
        font-weight: 700;
        border-top: 2px solid #2c3e50;
        padding-top: 12px;
    }

    .material-table .subtotal-row td {
        background: #f0f3f7;
        font-weight: 600;
        border-top: 1px solid #cbd5e1;
    }

        .material-table .subtotal-row td:first-child {
            padding-left: 20px;
        }

    /* ===== TASK TABLE ===== */
    .task-table-wrap {
        overflow-x: auto;
        margin-top: 5px;
    }

    .task-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .task-table th {
            background: #2c3e50;
            color: white;
            padding: 6px 8px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .task-table td {
            padding: 5px 8px;
            border-bottom: 1px solid #e0e4e8;
        }

        .task-table tr:hover td {
            background: #f8f9fa;
        }

        .task-table .total-row td {
            background: #e8f0fe;
            font-weight: 700;
            border-top: 2px solid #2c3e50;
            padding-top: 12px;
        }

        .task-table .text-right {
            text-align: right;
        }

        .task-table .text-center {
            text-align: center;
        }

    /* ===== SIDE BY SIDE ===== */
    .side-by-side {
        display: flex;
        gap: 14px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .material-section, .labour-section {
        flex: 1;
        min-width: 300px;
        background: #ffffff;
        border: 2px solid #2c3e50;
        border-radius: 8px;
        overflow: hidden;
    }

    .material-header, .labour-header {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 8px 12px;
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        letter-spacing: 1px;
    }

    .material-body, .labour-body {
        padding: 8px 12px;
    }

    /* ===== INFO TABLE ===== */
    .info-table {
        width: 100%;
        border-collapse: collapse;
    }

        .info-table tr {
            border-bottom: 1px solid #e0e4e8;
        }

            .info-table tr:last-child {
                border-bottom: none;
            }

        .info-table td {
            padding: 6px 8px;
            vertical-align: middle;
        }

    .label-col {
        font-weight: 600;
        color: #2c3e50;
        width: 55%;
    }

    .value-col {
        font-weight: 500;
        color: #1a5276;
        text-align: right;
        width: 45%;
    }

    .total-row td {
        padding-top: 12px;
        border-top: 2px solid #cbd5e1;
    }

    .total-row .label-col {
        font-weight: 800;
        font-size: 1.05em;
        color: #0b3b5f;
    }

    .total-row .value-col {
        font-weight: 800;
        font-size: 1.05em;
        color: #0b3b5f;
    }

    .tax-row .label-col {
        color: #e67e22;
    }

    .tax-row .value-col {
        color: #e67e22;
        font-weight: 600;
    }

    /* ===== TOTALS ROW ===== */
    .totals-row {
        display: flex;
        gap: 30px;
        margin: 12px 0;
        flex-wrap: wrap;
    }

    .total-box {
        flex: 1;
        background: #e8f0fe;
        border: 2px solid #1a5276;
        border-radius: 8px;
        padding: 8px 12px;
        text-align: center;
    }

    .total-box-label {
        font-weight: 700;
        font-size: 14px;
        color: #2c3e50;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .total-box-value {
        font-weight: 800;
        font-size: 24px;
        color: #1a5276;
    }

    /* ===== GRAND TOTAL ===== */
    .grand-total-section {
        margin-top: 20px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 2px solid #1a5276;
    }

    .grand-total-table {
        width: 100%;
        border-collapse: collapse;
    }

        .grand-total-table td {
            padding: 10px 14px;
        }

    .grand-total-label {
        font-weight: 800;
        font-size: 1.05em;
        color: #1a5276;
        background: #e8f0fe;
    }

    .grand-total-value {
        font-weight: 800;
        font-size: 1.2em;
        color: #1a5276;
        text-align: right;
        background: #e8f0fe;
    }

    /* ===== MISC ===== */
    .report-footer {
        margin-top: 25px;
        padding: 10px;
        background: #f8f9fa;
        font-size: 11px;
        color: #5d6d7e;
        text-align: center;
        border-radius: 4px;
        border-top: 1px solid #dee2e6;
    }

    .report-toolbar {
        position: absolute;
        top: 8px;
        right: 12px;
        z-index: 1000;
    }

    .loading-spinner {
        text-align: center;
        padding: 60px;
        color: #5d6d7e;
        font-size: 16px;
    }

    .no-data-message {
        text-align: center;
        padding: 50px;
        background: #fef9e6;
        border-radius: 8px;
    }

    .retry-btn {
        background-color: #2c3e50;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 4px;
        margin-top: 15px;
        cursor: pointer;
    }

        .retry-btn:hover {
            background-color: #1a5276;
        }

    .clearfix::after {
        content: "";
        clear: both;
        display: table;
    }

    .no-print {
        display: block;
    }


    /* ===== PRINT STYLES ===== */
    @@media print {
        @@page {
            size: Letter landscape;
            margin: 0.35in;
        }

        .no-print {
            display: none !important;
        }

        body {
            background: white;
            margin: 0;
            padding: 0;
        }

        .report-container {
            box-shadow: none;
            padding: 0.2in;
            max-width: 100% !important;
        }

        .side-by-side {
            display: flex !important;
            gap: 20px;
            page-break-inside: avoid;
        }

        .material-section, .labour-section {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .grand-total-section {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .detail-section {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .material-table, .task-table {
            font-size: 10px;
        }

            .material-table th, .material-table td, .task-table th, .task-table td {
                padding: 4px 8px;
            }

        .summary-grid {
            display: grid !important;
            grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
            gap: 5px !important;
        }

        .summary-card {
            margin-bottom: 0;
            padding: 5px 6px;
        }

            .summary-card .value {
                font-size: 14px;
            }

            .summary-card .label {
                font-size: 8px;
            }

        .vehicle-info {
            display: grid !important;
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
            gap: 5px !important;
        }

        .vehicle-info-item {
            margin-bottom: 0;
            padding: 5px 7px;
        }

            .vehicle-info-item .label {
                font-size: 8px;
            }

            .vehicle-info-item .value {
                font-size: 10px;
            }

        .vehicle-audit-row {
            grid-template-columns: 1fr 1fr !important;
            gap: 5px;
            margin-top: 5px;
            padding-top: 5px;
        }

        .vehicle-audit-item {
            padding: 4px 6px;
        }

            .vehicle-audit-item .label, .vehicle-audit-item .value {
                font-size: 8px;
            }

        .report-header h1 {
            font-size: 22px;
        }

        .total-box-value {
            font-size: 18px;
        }

        .grand-total-value {
            font-size: 20px;
        }

        html, body {
            height: auto !important;
            overflow: visible !important;
        }
    }

    /* ===== PDF EXPORT ===== */
    #pdfExportWrapper {
        position: absolute;
        left: -100000px;
        top: 0;
        background: #fff;
    }

        #pdfExportWrapper .detail-section {
            page-break-inside: avoid;
        }

        #pdfExportWrapper table {
            width: 100%;
            border-collapse: collapse;
        }

</style>

<div class="report-toolbar no-print">
    <button id="reportActions" class="k-button k-button-icon" title="Report actions" style="width:32px; padding:4px;">
        <span class="k-icon k-i-more-vertical"></span>
    </button>
</div>

<ul id="reportMenu" class="no-print">
    <li id="copyReport"><span class="k-icon k-i-copy"></span> Copy to Clipboard</li>
    <li id="saveReport"><span class="k-icon k-i-image"></span> Save as PNG</li>
    <li id="saveReportPdf"><span class="k-icon k-i-file-pdf"></span> Save as PDF</li>
</ul>

<div class="report-container">
    <!-- HEADER - This is what will be included in PNG/Copy -->
    <div class="report-header" id="reportHeader">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div style="text-align: left;">
                <div style="font-size: 14px; color: #5d6d7e; font-weight: 600;">Vehicle Estimate #: <span style="color: #1a5276; font-weight: 700;" id="estimateNumber">@ViewBag.PartNum</span></div>
            </div>
            <div style="text-align: center; flex: 1;">
                <h1 style="margin: 0 0 8px 0; color: #1a5276; font-size: 28px; letter-spacing: 1px;">VEHICLE COST SUMMARY REPORT</h1>
                <div class="subtitle" id="generatedDate">Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</div>
            </div>
            <div style="text-align: right; min-width: 120px;">
                <div style="font-size: 12px; color: #5d6d7e;">Status: <span style="color: #27ae60; font-weight: 600;">● Active</span></div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div id="loadingIndicator" class="loading-spinner">
        <span>⏳ Loading cost data...</span>
    </div>

    <!-- Content -->
    <div id="costSummaryContent" style="display: none;">

        <!-- SECTION 1: VEHICLE DETAILS -->
        <div class="detail-section">
            <div class="detail-header">
                <span>🚗 VEHICLE DETAILS</span>
            </div>
            <div class="detail-body">
                <div class="vehicle-info">
                    <div class="vehicle-info-item vehicle-description">
                        <span class="label">Detailed Description</span>
                        <span class="value" id="vehicleDescription">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Vehicle Series</span>
                        <span class="value" id="vehicleSeries">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Make</span>
                        <span class="value" id="vehicleMake">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Model</span>
                        <span class="value" id="vehicleModel">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Year</span>
                        <span class="value" id="vehicleYear">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label"># of Vehicles</span>
                        <span class="value" id="numberOfVehicles">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Engine</span>
                        <span class="value" id="vehicleEngine">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Transmission</span>
                        <span class="value" id="vehicleTransmission">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Differential</span>
                        <span class="value" id="vehicleDifferential">-</span>
                    </div>
                </div>
                
            </div>
        </div>

        <!-- SECTION 2: MATERIAL COST SUMMARY -->
        <div class="detail-section">
            <div class="detail-header">
                <span>📦 MATERIAL COST SUMMARY</span>
                <span class="badge" id="materialCountBadge">0 parts</span>
            </div>
            <div class="detail-body">
                <div class="summary-grid">
                    <div class="summary-card">
                        <span class="value green" id="stockPartsCount">0</span>
                        <span class="label">Stock Parts</span>
                    </div>
                    <div class="summary-card">
                        <span class="value blue" id="nonStockPartsCount">0</span>
                        <span class="label">Non-Stock Parts</span>
                    </div>
                    <div class="summary-card">
                        <span class="value orange" id="rebuiltPartsCount">0</span>
                        <span class="label">Rebuilt Parts</span>
                    </div>
                    <div class="summary-card">
                        <span class="value" id="stockCost">$0.00</span>
                        <span class="label">Total Stock Cost</span>
                    </div>
                    <div class="summary-card">
                        <span class="value" id="totalNonStockCost">$0.00</span>
                        <span class="label">Total Non-Stock Cost</span>
                    </div>
                    <div class="summary-card">
                        <span class="value" id="totalRebuiltCost">$0.00</span>
                        <span class="label">Total Rebuilt Cost</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 3: MATERIAL LINES (Individual) -->
        <div class="detail-section">
            <div class="detail-header">
                <span>📋 MATERIAL </span>
                <span class="badge" id="materialLinesBadge">0 items</span>
            </div>
            <div class="detail-body">
                <div class="material-table-wrap">
                    <table class="material-table" id="materialLinesTable">
                        <thead>
                            <tr>
                                <th style="width:90px;">Type</th>
                                <th style="width:120px;">Stock Code</th>
                                <th style="width:120px;">CC</th>
                                <th>Desc/Supp Name</th>
                                <th style="width:70px;text-align:right;">Qty</th>
                                <th style="width:100px;text-align:right;">Unit Cost</th>
                                <th style="width:80px;text-align:right;">Usage %</th>
                                <th style="width:110px;text-align:right;">Total Cost</th>
                            </tr>
                        </thead>
                        <tbody id="materialLinesBody">
                            <tr><td colspan="8" style="text-align:center; color:#6c757d; padding:20px;">No material items found</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECTION 4: LABOUR HOURS SUMMARY -->
        <div class="detail-section">
            <div class="detail-header">
                <span>⏱️ LABOUR HOURS SUMMARY</span>
            </div>
            <div class="detail-body">
                <div class="summary-grid">
                    <div class="summary-card">
                        <span class="value blue" id="totalHours">0.00</span>
                        <span class="label">Total Hours</span>
                    </div>
                    <div class="summary-card">
                        <span class="value green" id="totalEffectiveHours">0.00</span>
                        <span class="label">Effective Hours</span>
                    </div>
                    <div class="summary-card">
                        <span class="value orange" id="totalAdjustedHours">0.00</span>
                        <span class="label">Adjusted Hours</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 5: LABOUR TASK SUMMARY -->
        <div class="detail-section">
            <div class="detail-header">
                <span>📋 LABOUR TASK SUMMARY</span>
                <span class="badge" id="taskCountBadge">0 tasks</span>
            </div>
            <div class="detail-body">
                <div class="task-table-wrap">
                    <table class="task-table" id="taskSummaryTable">
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Labour Definition</th>
                                <th>CC</th>
                                <th style="text-align:right;">Hours</th>
                                <th style="text-align:right;">Effective Hrs</th>
                                <th style="text-align:right;">Adjusted Hrs</th>
                                <th style="text-align:right;">Rate/Hr</th>
                                <th style="text-align:right;">Total Cost</th>
                                <th style="text-align:center;">Count</th>
                            </tr>
                        </thead>
                        <tbody id="taskSummaryBody">
                            <tr><td colspan="9" style="text-align:center; color:#6c757d; padding:20px;">No labour tasks found</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SIDE BY SIDE: MATERIAL COST | LABOUR COST -->
        <div class="side-by-side">
            <div class="material-section">
                <div class="material-header">📦 MATERIAL COST</div>
                <div class="material-body">
                    <table class="info-table">
                        <tr><td class="label-col"><strong>Stock Coded Parts</strong></td><td class="value-col" id="scPartsDisplay">$0.00</td></tr>
                        <tr><td class="label-col"><strong>Non-Stock Coded Parts</strong></td><td class="value-col" id="nscPartsDisplay">$0.00</td></tr>
                        <tr><td class="label-col"><strong>Rebuilt Parts</strong></td><td class="value-col" id="rbCostDisplay">$0.00</td></tr>
                        <tr class="total-row"><td class="label-col"><strong>Parts Total (No Tax)</strong></td><td class="value-col" id="partsTotalDisplay">$0.00</td></tr>
                        <tr class="tax-row"><td class="label-col"><strong>+ Material Tax</strong></td><td class="value-col" id="materialTaxDisplay">$0.00</td></tr>
                        <tr class="total-row"><td class="label-col"><strong>= Total Material Cost (With Tax)</strong></td><td class="value-col" id="materialWithTaxDisplay">$0.00</td></tr>
                    </table>
                </div>
            </div>

            <div class="labour-section">
                <div class="labour-header">🔧 LABOUR COST</div>
                <div class="labour-body">
                    <table class="info-table">
                        <tr><td class="label-col"><strong>Fringe</strong></td><td class="value-col" id="labourFringeDisplay">$0.00</td></tr>
                        <tr><td class="label-col"><strong>Benefits</strong></td><td class="value-col" id="labourBenefitsDisplay">$0.00</td></tr>
                        <tr><td class="label-col"><strong>Blended Fringe & Benefits</strong></td><td class="value-col" id="blendedFringeCostDisplay">$0.00</td></tr>
                        <tr><td class="label-col"><strong>Overhead</strong></td><td class="value-col" id="labourOverheadDisplay">$0.00</td></tr>
                        <tr class="total-row"><td class="label-col"><strong>= Total Labour Cost</strong></td><td class="value-col" id="totalLabourCostDisplay">$0.00</td></tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- TOTALS ROW -->
        <div class="totals-row">
            <div class="total-box">
                <div class="total-box-label">TOTAL MATERIAL COST (With Tax)</div>
                <div class="total-box-value" id="totalMaterialBoxDisplay">$0.00</div>
            </div>
            <div class="total-box">
                <div class="total-box-label">TOTAL LABOUR COST</div>
                <div class="total-box-value" id="totalLabourBoxDisplay">$0.00</div>
            </div>
        </div>

        <!-- GRAND TOTAL -->
        <div class="grand-total-section">
            <table class="grand-total-table">
                <tr>
                    <td class="grand-total-label"><strong>💰 GRAND TOTAL (Material + Labour)</strong></td>
                    <td class="grand-total-value" id="totalWithTaxDisplay">$0.00</td>
                </tr>
            </table>
        </div>
        <div class="vehicle-audit-row">
            <div class="vehicle-audit-item">
                <span class="label">Modified By</span>
                <span class="value" id="modifiedLastBy">-</span>
            </div>
            <div class="vehicle-audit-item">
                <span class="label">Modified Date</span>
                <span class="value" id="modifiedLastDate">-</span>
            </div>
        </div>

        <div class="report-footer">
            Estimate Generated On: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
        </div>
    </div>

    <!-- No data -->
    <div id="noDataMessage" class="no-data-message" style="display: none;">
        <div class="warning-icon">⚠️</div>
        <p style="font-size:16px; margin:10px 0;"><strong>No cost data available</strong></p>
        <p>No cost data found for Estimate ID: @ViewBag.PartNum</p>
        <button id="retryButton" class="retry-btn">⟳ Retry Loading</button>
    </div>
</div>

<script type="text/javascript">
    // Configuration
    var partNum = '@ViewBag.PartNum';
    var gridType = '@ViewBag.GridType';
    var totalCostDataUrl = '@Url.Action("GetTotalCostInEstimates", "TotalCost")' +
                           '?id=' + encodeURIComponent(partNum) +
                           '&gridType=' + encodeURIComponent(gridType);

    // Document ready
    $(document).ready(function() {
        console.log("TotalCostTab initialized");
        fetchTotalCostData();

        $("#retryButton").on('click', function() {
            $("#noDataMessage").hide();
            $("#loadingIndicator").show();
            $("#costSummaryContent").hide();
            fetchTotalCostData();
        });
    });

    // Context menu
    $("#reportMenu").kendoContextMenu({
        target: "#reportActions",
        showOn: "mouseenter",
        alignToAnchor: true,
        select: function(e) {
            var id = $(e.item).attr("id");
            if (id === "saveReport") saveReportAsPng();
            if (id === "saveReportPdf") saveReportAsPdf();
            if (id === "copyReport") copyReportToClipboard();
        }
    });

    // ===== SAVE AS PNG =====
    function saveReportAsPng() {
        // Get the full content including header
        var fullContent = document.getElementById('reportHeader');
        var contentToExport = document.getElementById('costSummaryContent');

        // Create a wrapper with both header and content
        var wrapper = document.createElement('div');
        wrapper.appendChild(fullContent.cloneNode(true));
        wrapper.appendChild(contentToExport.cloneNode(true));

        // Add the wrapper to the DOM temporarily
        wrapper.id = 'exportWrapper';
        wrapper.style.padding = '20px';
        wrapper.style.background = 'white';
        document.body.appendChild(wrapper);

        kendo.drawing.drawDOM(wrapper, {
            paperSize: "auto",
            margin: "1cm",
            scale: 1
        })
        .then(function(group) {
            return kendo.drawing.exportImage(group);
        })
        .done(function(data) {
            // Remove the temporary wrapper
            document.body.removeChild(wrapper);
            kendo.saveAs({
                dataURI: data,
                fileName: "TotalCostSummary_" + partNum + ".png"
            });
        })
        .catch(function(err) {
            // Remove the temporary wrapper on error
            if (document.getElementById('exportWrapper')) {
                document.body.removeChild(document.getElementById('exportWrapper'));
            }
            kendo.alert("Error generating PNG: " + err.message);
        });
    }

    // ===== FIXED: SAVE AS PDF =====
    function saveReportAsPdf() {
        console.log("PDF export started");
        
        // Get the report container
        var reportContainer = document.querySelector('.report-container');
        if (!reportContainer) {
            kendo.alert('Unable to find the estimate report.');
            return;
        }

        // Check if content is loaded
        var content = document.getElementById('costSummaryContent');
        if (!content || content.style.display === 'none') {
            kendo.alert('Please wait for the report to finish loading.');
            return;
        }

        // Check Kendo availability
        if (typeof kendo === 'undefined' || !kendo.drawing || !kendo.drawing.drawDOM || !kendo.drawing.exportPDF || !kendo.saveAs) {
            kendo.alert('Kendo PDF export is not available on this page.');
            return;
        }

        // Show loading indicator on button
        var button = document.querySelector('#saveReportPdf');
        var originalText = button ? button.innerHTML : '';
        if (button) {
            button.innerHTML = '⏳ Generating PDF...';
        }

        try {
            // Create a wrapper for PDF export - render the FULL report container
            var wrapper = document.createElement('div');
            wrapper.id = 'pdfExportWrapper_' + Date.now();
            wrapper.style.cssText = [
                'padding: 20px',
                'background: white',
                'font-family: "Segoe UI", Arial, sans-serif',
                'position: absolute',
                'left: -100000px',
                'top: 0',
                'width: 1100px',
                'z-index: 9999'
            ].join('; ');

            // Clone the entire report container
            var clone = reportContainer.cloneNode(true);
            
            // Remove UI elements from clone
            var elementsToRemove = clone.querySelectorAll('.no-print, .report-toolbar, .k-button, button, #reportMenu');
            elementsToRemove.forEach(function(el) {
                el.style.display = 'none';
            });

            // Ensure all content sections are visible
            var contentSections = clone.querySelectorAll('.detail-section, .side-by-side, .totals-row, .grand-total-section, .vehicle-audit-row, .report-footer');
            contentSections.forEach(function(el) {
                el.style.display = '';
                el.style.visibility = 'visible';
                el.style.overflow = 'visible';
                el.style.height = 'auto';
                el.style.maxHeight = 'none';
            });

            // Make sure the content div is visible
            var contentClone = clone.querySelector('#costSummaryContent');
            if (contentClone) {
                contentClone.style.display = 'block';
                contentClone.style.visibility = 'visible';
            }

            // Make sure header is visible
            var headerClone = clone.querySelector('#reportHeader');
            if (headerClone) {
                headerClone.style.display = '';
                headerClone.style.visibility = 'visible';
            }

            wrapper.appendChild(clone);
            document.body.appendChild(wrapper);

            // Force layout rendering
            void wrapper.offsetWidth;
            void wrapper.offsetHeight;

            console.log('PDF wrapper created, dimensions:', {
                width: wrapper.offsetWidth,
                height: wrapper.offsetHeight,
                contentVisible: contentClone ? contentClone.style.display : 'not found'
            });

            // Use a small delay to ensure DOM is fully rendered
            setTimeout(function() {
                // Draw the DOM
                var drawRequest = kendo.drawing.drawDOM(wrapper, {
                    paperSize: 'Letter',
                    landscape: true,
                    margin: {
                        top: '0.35in',
                        bottom: '0.35in',
                        left: '0.35in',
                        right: '0.35in'
                    },
                    scale: 0.78,
                    multiPage: true,
                    avoidLinks: true,
                    keepTogether: '.detail-section, .side-by-side, .grand-total-section'
                });

                drawRequest.done(function(group) {
                    console.log('Kendo drawing group created');
                    
                    if (!group) {
                        throw new Error('Kendo returned null drawing group.');
                    }

                    var pdfRequest = kendo.drawing.exportPDF(group, {
                        paperSize: 'Letter',
                        landscape: true,
                        margin: {
                            top: '0.35in',
                            bottom: '0.35in',
                            left: '0.35in',
                            right: '0.35in'
                        }
                    });

                    pdfRequest.done(function(dataUri) {
                        // Clean up wrapper
                        if (document.getElementById(wrapper.id)) {
                            document.body.removeChild(wrapper);
                        }

                        if (!dataUri || dataUri.length < 100) {
                            throw new Error('Kendo returned empty PDF data.');
                        }

                        var estimateNumber = ($('#estimateNumber').text() || 'Estimate').trim().replace(/[^a-z0-9_.-]/gi, '_');
                        var fileName = 'VehicleCostFinalEstimate_' + estimateNumber + '.pdf';

                        // Restore button
                        if (button) {
                            button.innerHTML = originalText;
                        }

                        kendo.saveAs({
                            dataURI: dataUri,
                            fileName: fileName
                        });

                        console.log('PDF created successfully:', fileName);
                    });

                    pdfRequest.fail(function(err) {
                        // Clean up wrapper
                        if (document.getElementById(wrapper.id)) {
                            document.body.removeChild(wrapper);
                        }
                        
                        if (button) {
                            button.innerHTML = originalText;
                        }
                        
                        console.error('Kendo PDF export error:', err);
                        kendo.alert('Error generating PDF: ' + (err && err.message ? err.message : 'Unknown error.'));
                    });
                });

                drawRequest.fail(function(err) {
                    // Clean up wrapper
                    if (document.getElementById(wrapper.id)) {
                        document.body.removeChild(wrapper);
                    }
                    
                    if (button) {
                        button.innerHTML = originalText;
                    }
                    
                    console.error('Kendo drawDOM error:', err);
                    kendo.alert('Error preparing PDF: ' + (err && err.message ? err.message : 'Unknown error.'));
                });
            }, 300); // 300ms delay for DOM rendering

        } catch (err) {
            // Clean up wrapper if exists
            var wrapperId = 'pdfExportWrapper_' + Date.now();
            if (document.getElementById(wrapperId)) {
                document.body.removeChild(document.getElementById(wrapperId));
            }
            
            if (button) {
                button.innerHTML = originalText;
            }
            
            console.error('PDF export setup error:', err);
            kendo.alert('Error generating PDF: ' + (err && err.message ? err.message : 'Unknown error.'));
        }
    }

    // ===== COPY TO CLIPBOARD =====
    function copyReportToClipboard() {
        // Get the full content including header
        var fullContent = document.getElementById('reportHeader');
        var contentToExport = document.getElementById('costSummaryContent');

        // Create a wrapper with both header and content
        var wrapper = document.createElement('div');
        wrapper.appendChild(fullContent.cloneNode(true));
        wrapper.appendChild(contentToExport.cloneNode(true));

        // Add the wrapper to the DOM temporarily
        wrapper.id = 'exportWrapper';
        wrapper.style.padding = '20px';
        wrapper.style.background = 'white';
        document.body.appendChild(wrapper);

        kendo.drawing.drawDOM(wrapper, {
            paperSize: "auto",
            margin: "1cm",
            scale: 1
        })
        .then(function(group) {
            return kendo.drawing.exportImage(group);
        })
        .done(function(data) {
            // Remove the temporary wrapper
            document.body.removeChild(wrapper);

            fetch(data)
                .then(res => res.blob())
                .then(blob => {
                    navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
                    kendo.alert("Report copied to clipboard.");
                })
                .catch(function(err) {
                    kendo.alert("Error copying to clipboard: " + err.message);
                });
        })
        .catch(function(err) {
            // Remove the temporary wrapper on error
            if (document.getElementById('exportWrapper')) {
                document.body.removeChild(document.getElementById('exportWrapper'));
            }
            kendo.alert("Error generating image: " + err.message);
        });
    }

    // Data fetching
    function fetchTotalCostData() {
        console.log("Fetching data from:", totalCostDataUrl);

        $.ajax({
            url: totalCostDataUrl,
            type: 'GET',
            dataType: 'json',
            timeout: 30000,
            success: function(response) {
                console.log("Response received:", response);
                if (response && response.Data && response.Data.length > 0) {
                    var costData = response.Data[0];
                    console.log("Cost data:", costData);
                    populateAllSections(costData);
                    $("#loadingIndicator").hide();
                    $("#costSummaryContent").show();
                    $("#noDataMessage").hide();
                } else {
                    console.log("No data in response");
                    showNoDataMessage();
                }
            },
            error: function(xhr, status, error) {
                console.error("Error fetching cost data:", status, error);
                showNoDataMessage();
            }
        });
    }

    // Helper functions
    function getVal(value) {
        if (value === null || value === undefined) return 0;
        var num = parseFloat(value);
        return isNaN(num) ? 0 : num;
    }

    function formatMoney(val) {
        return '$' + val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function setText(id, value) {
        $(id).text(formatMoney(value));
    }

    function setNumber(id, value) {
        var num = getVal(value);
        $(id).text(num.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }));
    }

    function formatIntegerOrDash(value) {
        if (value === null || value === undefined || value === '') return '-';
        var num = parseInt(value, 10);
        return isNaN(num) ? '-' : num.toLocaleString();
    }

    function formatDateTime(value) {
        if (value === null || value === undefined || value === '') return '-';
        var date = new Date(value);
        if (isNaN(date.getTime())) return String(value);
        return date.toLocaleString(undefined, {
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit'
        });
    }

    function setNumberDecimal(id, value) {
        var num = getVal(value);
        $(id).text(num.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }

    // Main population function
    function populateAllSections(costData) {
        // SECTION 1: Vehicle Details
        $('#vehicleSeries').text(costData.VehicleSeries || '-');
        $('#vehicleDescription').text(costData.VehicleDescription || '-');
        $('#vehicleMake').text(costData.Make || '-');
        $('#vehicleModel').text(costData.Model || '-');
        $('#vehicleYear').text(formatIntegerOrDash(costData.Year));
        $('#numberOfVehicles').text(formatIntegerOrDash(costData.NumOfVehicles));
        $('#vehicleEngine').text(costData.Engine || '-');
        $('#vehicleTransmission').text(costData.Transmission || '-');
        $('#vehicleDifferential').text(costData.Differential || '-');
        $('#modifiedLastBy').text(costData.ModifiedLastBy || '-');
        $('#modifiedLastDate').text(formatDateTime(costData.ModifiedLastDate));

        // SECTION 2: Material Cost Summary
        var totalParts = (costData.TotalStockPartsCount || 0) + (costData.TotalNonStockPartsCount || 0) + (costData.TotalRebuiltPartsCount || 0);
        $('#materialCountBadge').text(totalParts + ' parts');
        setNumber('#stockPartsCount', costData.TotalStockPartsCount);
        setNumber('#nonStockPartsCount', costData.TotalNonStockPartsCount);
        setNumber('#rebuiltPartsCount', costData.TotalRebuiltPartsCount);
        setText('#stockCost', costData.SCPartsMaterialCost);
        setText('#totalNonStockCost', costData.NSCSCPartsMaterialCost);
        setText('#totalRebuiltCost', costData.RBPartsMaterialCost);

        // SECTION 3: Material Lines
        populateMaterialLines(costData.MaterialLines || []);

        // SECTION 4: Labour Hours Summary
        setNumberDecimal('#totalHours', costData.TotalLabourHours);
        setNumberDecimal('#totalEffectiveHours', costData.TotalEffectiveHours);
        setNumberDecimal('#totalAdjustedHours', costData.TotalAdjustedHours);

        // SECTION 5: Labour Task Summary
        populateTaskSummary(costData.LabourTasks || []);

        // Material Section (side by side)
        var scParts = getVal(costData.SCPartsMaterialCost);
        var nscParts = getVal(costData.NSCSCPartsMaterialCost);
        var rbParts = getVal(costData.RBPartsMaterialCost);
        var partsTotalNoTax = getVal(costData.MaterialTotalCostNoTax);
        var materialTax = getVal(costData.MaterialTotalTaxAmount);
        var materialWithTax = getVal(costData.MaterialTotalWithTax);

        // Labour values
        var labourFringe = getVal(costData.LabourFringe);
        var labourBenefits = getVal(costData.LabourBenefits);
        var blendedFringeCost = getVal(costData.BlendedFringeBenefitCost);
        var labourOverhead = getVal(costData.LabourOverhead);
        var totalLabour = getVal(costData.FinalLabourCost);
        var totalWithTax = materialWithTax + totalLabour;

        setText("#scPartsDisplay", scParts);
        setText("#nscPartsDisplay", nscParts);
        setText("#rbCostDisplay", rbParts);
        setText("#partsTotalDisplay", partsTotalNoTax);
        setText("#materialTaxDisplay", materialTax);
        setText("#materialWithTaxDisplay", materialWithTax);

        setText("#labourFringeDisplay", labourFringe);
        setText("#labourBenefitsDisplay", labourBenefits);
        setText("#blendedFringeCostDisplay", blendedFringeCost);
        setText("#labourOverheadDisplay", labourOverhead);
        setText("#totalLabourCostDisplay", totalLabour);

        setText("#totalMaterialBoxDisplay", materialWithTax);
        setText("#totalLabourBoxDisplay", totalLabour);
        setText("#totalWithTaxDisplay", totalWithTax);
    }

    // Populate Material Lines
    function populateMaterialLines(lines) {
        var tbody = $('#materialLinesBody');
        var badge = $('#materialLinesBadge');
        var totalItems = lines.length;
        badge.text(totalItems + ' items');

        if (totalItems === 0) {
            tbody.html('<tr><td colspan="8" style="text-align:center; color:#6c757d; padding:20px;">No material items found</td></tr>');
            return;
        }

        var html = '';
        var typeTotals = { Stock: 0, Rebuilt: 0, 'Non-Stock': 0 };
        var grandTotal = 0;

        lines.forEach(function(item) {
            var type = item.Type || 'Stock';
            var typeClass = type.toLowerCase().replace('-', '');
            var badgeClass = typeClass === 'nonstock' ? 'nonstock' : typeClass;
            var totalCost = getVal(item.TotalCost);

            if (typeTotals[type] !== undefined) {
                typeTotals[type] += totalCost;
            }
            grandTotal += totalCost;

            html += '<tr class="type-' + typeClass + '">' +
                '<td><span class="type-badge ' + badgeClass + '">' + type + '</span></td>' +
                '<td>' + (item.StockCode || '-') + '</td>' +
                '<td>' + (item.CC || '-') + '</td>' +
                '<td>' + (item.Description || 'N/A') + '</td>' +
                '<td style="text-align:right;">' + getVal(item.Quantity).toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + formatMoney(getVal(item.UnitCost)) + '</td>' +
                '<td style="text-align:right;">' + getVal(item.PercentUsage).toFixed(1) + '%</td>' +
                '<td style="text-align:right; font-weight:600;">' + formatMoney(totalCost) + '</td>' +
                '</tr>';
        });

        // Add type subtotals
        var typeOrder = ['Stock', 'Rebuilt', 'Non-Stock'];
        typeOrder.forEach(function(type) {
            if (typeTotals[type] > 0) {
                html += '<tr class="subtotal-row">' +
                    '<td colspan="7" style="text-align:right; font-weight:600;">Subtotal - ' + type + '</td>' +
                    '<td style="text-align:right; font-weight:600;">' + formatMoney(typeTotals[type]) + '</td>' +
                    '</tr>';
            }
        });

        // Add grand total
        html += '<tr class="total-row">' +
            '<td colspan="7" style="text-align:right; font-weight:800; font-size:1.05em;">GRAND TOTAL</td>' +
            '<td style="text-align:right; font-weight:800; font-size:1.05em;">' + formatMoney(grandTotal) + '</td>' +
            '</tr>';

        tbody.html(html);
    }

    // Populate Task Summary
    function populateTaskSummary(tasks) {
        var tbody = $('#taskSummaryBody');
        var badge = $('#taskCountBadge');
        badge.text(tasks.length + ' tasks');

        if (tasks.length === 0) {
            tbody.html('<tr><td colspan="9" style="text-align:center; color:#6c757d; padding:20px;">No labour tasks found</td></tr>');
            return;
        }

        var html = '';
        var totalHours = 0, totalEffective = 0, totalAdjusted = 0, totalCost = 0;

        tasks.forEach(function(task) {
            var hours = getVal(task.Hours);
            var effective = getVal(task.EffectiveHours);
            var adjusted = getVal(task.AdjustedHours);
            var cost = getVal(task.TotalCost);
            var count = getVal(task.Count);

            totalHours += hours;
            totalEffective += effective;
            totalAdjusted += adjusted;
            totalCost += cost;

            html += '<tr>' +
                '<td>' + (task.Task || 'Unnamed') + '</td>' +
                '<td>' + (task.LabourDefinition || 'N/A') + '</td>' +
                 '<td>' + (task.CC || '-') + '</td>' +
                '<td style="text-align:right;">' + hours.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + effective.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + adjusted.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + formatMoney(getVal(task.RatePerHour)) + '</td>' +
                '<td style="text-align:right; font-weight:600;">' + formatMoney(cost) + '</td>' +
                '<td style="text-align:center;">' + count + '</td>' +
                '</tr>';
        });

        // Total row
        html += '<tr class="total-row">' +
            '<td colspan="3"><strong>TOTAL</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalHours.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalEffective.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalAdjusted.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"></td>' +
            '<td style="text-align:right;"><strong>' + formatMoney(totalCost) + '</strong></td>' +
            '<td style="text-align:center;"><strong>' + tasks.length + '</strong></td>' +
            '</tr>';

        tbody.html(html);
    }

    function showNoDataMessage() {
        $("#loadingIndicator").hide();
        $("#costSummaryContent").hide();
        $("#noDataMessage").show();
    }
</script>
