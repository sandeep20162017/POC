public async Task<IActionResult> CreateBus([DataSourceRequest] DataSourceRequest request, [FromForm] BusModel busModel)
{
    if (!ModelState.IsValid)
    {
        return BadRequest(ModelState);
    }

    try
    {
        // Avoid duplicates
        const string listQuery = @"
            SELECT COUNT(*)
            FROM SBCES.ListOfBuses
            WHERE Description = @Description";

        var existingCount = await _dbConnection.QuerySingleOrDefaultAsync<int>(
            listQuery,
            new { busModel.Description });

        if (existingCount > 0)
        {
            return StatusCode(500, "An error occurred while updating the Vehicle. Vehicle exists or you are trying to add the same vehicle in batch mode. ");
        }

        const string insertQuery = @"
            INSERT INTO SBCES.ListOfBuses (ListID, Description)
            VALUES ((SELECT ISNULL(MAX(ListID), 0) + 1 FROM SBCES.ListOfBuses), @Description);";

        await _dbConnection.ExecuteAsync(insertQuery, new { busModel.Description });
        return Ok();
    }
    catch (Exception ex)
    {
        // _logger.LogError(ex, "Error creating bus {Description}", busModel.Description);
        return StatusCode(500, "An error occurred while updating the Vehicle. Vehicle exists or you are trying to add the same vehicle in batch mode.  ");
    }
}
