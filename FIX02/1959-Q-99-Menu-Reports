    </li>

    <li class="menu-line" data-action="saveVehicleEstimatePdf">
        <span class="menu-icon k-icon k-i-file-pdf"
              title="Save to PDF - Vehicle Estimate Report"></span>
        <span class="menu-text">Vehicle Estimate Report</span>
    </li>

    <!-- ========================= -->
    <!-- LINE 2 – Labour Details -->
    <!-- ========================= -->
    <li class="menu-line" data-action="viewLabourDetails">
        <span class="menu-icon k-icon k-i-preview"
              title="View - Labour Details Report"></span>
        <span class="menu-text">Labour Details Report</span>
    </li>

 

    <!-- ========================= -->
    <!-- LINE 3 – Materials Estimate -->
