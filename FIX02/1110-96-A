@model IEnumerable<BCES.Models.Reports.CostVarianceReportRow>
@{
    ViewData["Title"] = "Cost Variance Report";
}

<h4>Cost Variance Report</h4>

@(Html.Kendo().Grid<BCES.Models.Reports.CostVarianceReportRow>()
    .Name("costVarianceGrid")
    .Columns(columns =>
    {
        columns.Bound(c => c.RbNumber).Title("RBPartNum").Width(120);
        columns.Bound(c => c.Keyword).Title("Keyword").Width(140);
        columns.Bound(c => c.DetailedDesc).Title("Description");
        columns.Bound(c => c.Cost).Title("Cost").Format("{0:N2}").Width(120).Filterable(false);
        columns.Bound(c => c.ExtCost).Title("External Cost").Format("{0:N2}").Width(140).Filterable(false);
        columns.Bound(c => c.VariancePct).Title("% Variance").Width(120).Filterable(false)
               .ClientTemplate("#= VariancePct == null ? 'N/A' : kendo.toString(VariancePct, 'n2') + '%' #");
    })
    .Sortable()
    .Filterable(f => f
        .Extra(false)
        .Operators(o => o.ForString(s => s
            .Clear()
            .Contains("Contains")
            .StartsWith("Starts with"))))
    .Pageable(p => p.PageSizes(new[] { 25, 50, 100 }))
    .DataSource(ds => ds
        .Ajax()
        .PageSize(50)
        .ServerOperation(false))
    .BindTo(Model)
