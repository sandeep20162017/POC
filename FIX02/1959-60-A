function createExportWrapper(container, reportType) {

    // Create wrapper
    var wrapper = document.createElement('div');
    wrapper.id = 'exportWrapper_' + Date.now();
    wrapper.style.cssText = [
        'padding: 20px',
        'background: white',
        'font-family: "Segoe UI", Arial, sans-serif',
        'position: absolute',
        'left: -100000px',
        'top: 0',
        'width: 1100px',
        'z-index: 9999'
    ].join('; ');

    // Move the ORIGINAL DOM into wrapper
    var originalParent = container.parentNode;
    wrapper.appendChild(container);

    document.body.appendChild(wrapper);

    // Update title
    var titles = {
        'full': 'FULL VEHICLE ESTIMATE REPORT',
        'vehicle': 'VEHICLE COST ESTIMATE REPORT',
        'labour': 'LABOUR DETAILS REPORT',
        'materials': 'MATERIALS ESTIMATE REPORT'
    };
    var titleEl = wrapper.querySelector('h1');
    if (titleEl) {
        titleEl.textContent = titles[reportType] || titles.vehicle;
    }

    // Hide UI-only elements
    wrapper.querySelectorAll('.no-print, .report-toolbar, .report-menu-dropdown')
        .forEach(el => el.style.display = 'none');

    // Return a cleanup function so we can restore DOM later
    wrapper.restore = function () {
        originalParent.appendChild(container);
        document.body.removeChild(wrapper);
    };

    return wrapper;
}
