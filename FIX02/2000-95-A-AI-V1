using Dapper;
using Microsoft.Data.SqlClient;
using System.Text.Json;

namespace BCES.AI
{
    public static class SchemaExtractor
    {
        public static async Task GenerateSchemaJson(string connectionString, string outputPath = "schema.json")
        {
            try
            {
                using var conn = new SqlConnection(connectionString);
                await conn.OpenAsync();

                // Get all tables
                var tables = await conn.QueryAsync<string>(
                    "SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_TYPE = 'BASE TABLE'"
                );

                var schemaDict = new Dictionary<string, List<string>>();

                foreach (var table in tables)
                {
                    var columns = await conn.QueryAsync<string>(
                        @"SELECT COLUMN_NAME 
                          FROM INFORMATION_SCHEMA.COLUMNS 
                          WHERE TABLE_NAME = @TableName 
                          ORDER BY ORDINAL_POSITION",
                        new { TableName = table }
                    );

                    schemaDict[table] = columns.ToList();
                }

                var options = new JsonSerializerOptions
                {
                    WriteIndented = true,
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                };

                var json = JsonSerializer.Serialize(schemaDict, options);
                await File.WriteAllTextAsync(outputPath, json);

                Console.WriteLine($"Schema generated successfully at {outputPath}");
                Console.WriteLine($"Tables found: {schemaDict.Count}");
                foreach (var table in schemaDict)
                {
                    Console.WriteLine($"- {table.Key}: {table.Value.Count} columns");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error generating schema: {ex.Message}");
                throw;
            }
        }
    }
}
