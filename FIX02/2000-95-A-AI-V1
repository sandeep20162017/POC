using Dapper;
using Microsoft.Data.SqlClient;
using System.Text.Json;

namespace BCES.AI.Agents
{
    public class SqlAgent : BaseAgent
    {
        public override string Name => "SqlAgent";
        public override string Description => "Executes SQL queries on the database and returns results";

        public SqlAgent(OllamaClient ollamaClient, SchemaProvider schemaProvider, IConfiguration configuration)
            : base(ollamaClient, schemaProvider, configuration)
        {
        }

        public override async Task<string> HandleAsync(string userQuestion, string context = "")
        {
            try
            {
                // Step 1: Generate SQL from question
                var sqlPrompt = $@"
                    You are a SQL generation expert for SQL Server.

                    Database Schema:
                    {_schemaProvider.SchemaText}

                    User Question: {userQuestion}

                    Generate T-SQL query to answer this question.
                    Return ONLY JSON in this format:
                    {{
                        ""query"": ""YOUR SQL QUERY""
                    }}
                    
                    Rules:
                    - Use proper SQL Server syntax
                    - Use table aliases
                    - Include appropriate WHERE clauses
                    - Use TOP/LIMIT when appropriate
                    - Return only the JSON, no explanations";

                var sqlResponse = await _ollamaClient.CompleteAsync(sqlPrompt);
                var sqlJson = JsonDocument.Parse(sqlResponse);
                var sqlQuery = sqlJson.RootElement.GetProperty("query").GetString() ?? throw new Exception("Failed to parse SQL query");

                // Step 2: Execute SQL
                var connectionString = _configuration.GetConnectionString("DefaultConnection") ?? 
                    throw new Exception("DefaultConnection not found in configuration");

                using var connection = new SqlConnection(connectionString);
                await connection.OpenAsync();

                // Determine if it's a SELECT query
                var isSelect = sqlQuery.Trim().StartsWith("SELECT", StringComparison.OrdinalIgnoreCase);
                
                object? result;
                if (isSelect)
                {
                    var rows = await connection.QueryAsync(sqlQuery);
                    result = rows;
                }
                else
                {
                    // For non-SELECT queries, return count
                    var affectedRows = await connection.ExecuteAsync(sqlQuery);
                    result = new { AffectedRows = affectedRows };
                }

                var resultJson = JsonSerializer.Serialize(result, new JsonSerializerOptions
                {
                    WriteIndented = true
                });

                // Step 3: Summarize results
                var summaryPrompt = $@"
                    User Question: {userQuestion}

                    SQL Query Executed: {sqlQuery}

                    Query Results (JSON): {resultJson}

                    Provide a clear, natural language answer to the user's question.
                    Be concise and friendly.
                    Include relevant numbers and details from the results.
                    If there were no results, say so politely.
                    Format as plain text with no markdown.";

                var summary = await _ollamaClient.CompleteAsync(summaryPrompt);
                return summary;
            }
            catch (Exception ex)
            {
                return $"I encountered an error processing your question: {ex.Message}";
            }
        }

        public override bool CanHandle(string userQuestion)
        {
            // Ask LLM if this is a data question
            // Simple approach - check for data-related keywords
            var keywords = new[] { "show", "list", "find", "get", "select", "query", "database", "table", "data" };
            return keywords.Any(k => userQuestion.Contains(k, StringComparison.OrdinalIgnoreCase));
        }
    }
}
