using BCES.AI.Models;
using BCES.AI.Services;
using Microsoft.AspNetCore.Mvc;

namespace BCES.AI.Controllers
{
    public class ChatController : Controller
    {
        private readonly Orchestrator _orchestrator;
        private readonly ILogger<ChatController> _logger;

        public ChatController(Orchestrator orchestrator, ILogger<ChatController> logger)
        {
            _orchestrator = orchestrator;
            _logger = logger;
        }

        [HttpGet]
        public IActionResult Index()
        {
            var model = new ChatModel();
            return View(model);
        }

        [HttpPost]
        public async Task<IActionResult> Ask(string question)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(question))
                {
                    return Json(new { error = "Please enter a question." });
                }

                _logger.LogInformation($"Processing question: {question}");
                var answer = await _orchestrator.HandleAsync(question);
                _logger.LogInformation($"Generated answer: {answer.Substring(0, Math.Min(50, answer.Length))}...");

                return Json(new { answer });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error processing chat question");
                return Json(new { error = "An error occurred processing your question." });
            }
        }

        [HttpPost]
        public async Task<IActionResult> AnalyzeQuery(string sqlQuery)
        {
            try
            {
                // Simple validation and analysis
                return Json(new { 
                    isValid = !string.IsNullOrWhiteSpace(sqlQuery),
                    message = "Query received for analysis"
                });
            }
            catch (Exception ex)
            {
                return Json(new { error = ex.Message });
            }
        }
    }
}
