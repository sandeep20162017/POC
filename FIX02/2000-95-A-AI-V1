using System.Text.Json;

namespace BCES.AI.Services
{
    public class SchemaProvider
    {
        public string SchemaText { get; }
        public Dictionary<string, List<string>> SchemaDict { get; }

        public SchemaProvider(IWebHostEnvironment environment)
        {
            var path = Path.Combine(environment.ContentRootPath, "schema.json");
            
            if (!File.Exists(path))
            {
                throw new FileNotFoundException($"Schema file not found at {path}. Please run schema extraction first.");
            }

            var json = File.ReadAllText(path);
            SchemaDict = JsonSerializer.Deserialize<Dictionary<string, List<string>>>(json) ?? new();
            
            // Generate human-readable schema description
            SchemaText = string.Join("\n", SchemaDict.Select(t =>
                $"{t.Key}: {string.Join(", ", t.Value)}"
            ));
        }

        public string GetTableSchema(string tableName)
        {
            if (SchemaDict.TryGetValue(tableName, out var columns))
            {
                return $"{tableName}({string.Join(", ", columns)})";
            }
            return string.Empty;
        }

        public string GetFilteredSchema(List<string> tableNames)
        {
            var filtered = SchemaDict
                .Where(kvp => tableNames.Contains(kvp.Key))
                .Select(kvp => $"{kvp.Key}: {string.Join(", ", kvp.Value)}");
            
            return string.Join("\n", filtered);
        }
    }
}
