using BCES.AI.Agents;
using Microsoft.SemanticKernel;
using Microsoft.SemanticKernel.AI.ChatCompletion;
using Microsoft.SemanticKernel.Connectors.AI.OpenAI;
using System.Text.Json;

namespace BCES.AI.Services
{
    public class Orchestrator
    {
        private readonly IReadOnlyList<IAgent> _agents;
        private readonly OllamaClient _ollamaClient;
        private readonly SchemaProvider _schemaProvider;
        private readonly IKernel _kernel;

        public Orchestrator(IEnumerable<IAgent> agents, OllamaClient ollamaClient, SchemaProvider schemaProvider)
        {
            _agents = agents.ToList();
            _ollamaClient = ollamaClient;
            _schemaProvider = schemaProvider;

            // Setup Semantic Kernel
            var builder = new KernelBuilder();
            builder.WithOpenAIChatCompletionService(
                modelId: "phi3",
                apiKey: "not-needed" // We'll use Ollama instead
            );
            _kernel = builder.Build();

            // Register agents as functions
            foreach (var agent in _agents)
            {
                _kernel.RegisterSemanticFunction(
                    promptTemplate: $"{{{{$input}}}}\n\nAgent: {agent.Name}",
                    functionName: agent.Name,
                    description: agent.Description
                );
            }
        }

        public async Task<string> HandleAsync(string userQuestion)
        {
            try
            {
                // Step 1: Use Semantic Kernel to determine which agent to use
                var selectionPrompt = $@"
                    You are an intelligent orchestrator.
                    
                    Available Agents:
                    {string.Join("\n", _agents.Select(a => $"- {a.Name}: {a.Description}"))}
                    
                    Database Schema:
                    {_schemaProvider.SchemaText}
                    
                    User Question: {userQuestion}
                    
                    Select the best agent to handle this question.
                    Consider the nature of the question, what data is needed, and which agent has the right expertise.
                    
                    Return ONLY JSON with this format:
                    {{
                        ""agent"": ""[agent name]"",
                        ""reasoning"": ""[brief explanation]""
                    }}";

                var selectionResponse = await _ollamaClient.CompleteAsync(selectionPrompt);
                var selectionJson = JsonDocument.Parse(selectionResponse);
                var agentName = selectionJson.RootElement.GetProperty("agent").GetString() ?? throw new Exception("No agent selected");

                // Step 2: Find the selected agent
                var selectedAgent = _agents.FirstOrDefault(a => a.Name == agentName);
                if (selectedAgent == null)
                {
                    return $"I couldn't find a suitable agent. Available agents: {string.Join(", ", _agents.Select(a => a.Name))}";
                }

                // Step 3: Let the agent handle the question
                return await selectedAgent.HandleAsync(userQuestion);
            }
            catch (Exception ex)
            {
                // Fallback to direct LLM response
                try
                {
                    var fallbackPrompt = $@"
                        I couldn't route your question to a specific agent. 
                        Please answer this question directly using your knowledge:
                        
                        User Question: {userQuestion}
                        
                        Database Schema: {_schemaProvider.SchemaText}
                        
                        Provide a helpful response, acknowledging the limitation.";

                    return await _ollamaClient.CompleteAsync(fallbackPrompt);
                }
                catch
                {
                    return $"I encountered an error processing your question. Please try again with a different question.";
                }
            }
        }
    }
}
