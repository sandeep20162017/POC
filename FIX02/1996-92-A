    </style>
</head>
<body>

    <div class="report-container" id="reportContainer">

        <!-- Print Button -->
        <button class="print-btn no-print" onclick="window.print()">🖨️ Print Report</button>
        <div class="clearfix"></div>

        @if (data != null)
        {
            <!-- HEADER -->
            <div class="report-header">
                <div>
                    <div class="report-title">VEHICLE COST ESTIMATE</div>
                    <div class="report-subtitle">Detailed Cost Breakdown Report</div>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 9pt; font-weight: 600; color: #2c3e50;">Estimate #: @($"VEH-{data.LinkCode}")</div>
                    <div style="font-size: 8pt; color: #6c757d;">Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                    <div style="font-size: 8pt; color: #6c757d;">SOP #: @data.Sopnumber</div>
                </div>
            </div>

            <!-- VEHICLE DETAILS (Requirement #1 & #2) -->
            <div class="vehicle-details-grid">
                <div class="vehicle-detail-item">
                    <span class="label">Make</span>
                    <span class="value">@data.Make</span>
                </div>
                <div class="vehicle-detail-item">
                    <span class="label">Model</span>
                    <span class="value">@data.Model</span>
                </div>
                <div class="vehicle-detail-item">
                    <span class="label">Year</span>
                    <span class="value">@data.Year</span>
                </div>
                <div class="vehicle-detail-item">
                    <span class="label"># of Vehicles</span>
                    <span class="value">@data.NumOfVehicles</span>
                </div>
                <div class="vehicle-detail-item">
                    <span class="label">Engine</span>
                    <span class="value">@data.Engine</span>
                </div>
                <div class="vehicle-detail-item">
                    <span class="label">Transmission</span>
                    <span class="value">@data.Transmission</span>
                </div>
                <div class="vehicle-detail-item">
                    <span class="label">Differential</span>
                    <span class="value">@data.Differential</span>
                </div>
                <div class="vehicle-detail-item">
                    <span class="label">Project Description</span>
                    <span class="value">@data.VehicleDescription</span>
                </div>
            </div>

            <!-- MATERIAL COST SUMMARY (Requirement #3) -->
            <div class="section">
                <div class="section-header">
                    <span>📦 MATERIAL COST SUMMARY</span>
                    <span class="sub-count">Stock: @data.TotalStockPartsCount | Non-Stock: @data.TotalNonStockPartsCount | Rebuilt: @data.TotalRebuiltPartsCount</span>
                </div>

                <table class="summary-table">
                    <thead>
                        <tr>
                            <th style="text-align:left; width:25%;">Category</th>
                            <th style="width:18.75%;">Stock Cost</th>
                            <th style="width:18.75%;">Total Non-Stock Cost</th>
                            <th style="width:18.75%;">Total Rebuilt Cost</th>
                            <th style="width:18.75%;">Core Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="label-cell">Material Costs</td>
                            <td>@data.SCPartsMaterialCost.ToString("C2")</td>
                            <td>@data.NSCSCPartsMaterialCost.ToString("C2")</td>
                            <td>@data.RBPartsMaterialCost.ToString("C2")</td>
                            <td>@data.CoreCost.ToString("C2")</td>
                        </tr>
                        <tr>
                            <td class="label-cell">Averages</td>
                            <td>@data.AverageStockPartCost.ToString("C2")</td>
                            <td>@data.AverageNonStockPartCost.ToString("C2")</td>
                            <td>@data.AverageRebuiltPartCost.ToString("C2")</td>
                            <td>-</td>
                        </tr>
                        <tr class="total-row">
                            <td class="label-cell">Material Total (No Tax)</td>
                            <td colspan="3">@data.MaterialTotalCostNoTax.ToString("C2")</td>
                            <td>@data.MaterialTotalTaxAmount.ToString("C2")</td>
                        </tr>
                        <tr class="total-row">
                            <td class="label-cell">Material Total (With Tax)</td>
                            <td colspan="4">@data.MaterialTotalWithTax.ToString("C2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- LABOUR COST SUMMARY -->
            <div class="section">
                <div class="section-header">
                    <span>👨‍🔧 LABOUR COST SUMMARY</span>
                    <span class="sub-count">Hours: @data.TotalLabourHours.ToString("F2") | Effective: @data.TotalEffectiveHours.ToString("F2") | Adjusted: @data.TotalAdjustedHours.ToString("F2")</span>
                </div>

                <div class="cost-cards">
                    <div class="cost-card">
                        <div class="card-label">Base Labour</div>
                        <div class="card-value">@data.TotalLabourCost.ToString("C2")</div>
                        <div class="card-sub">Before adjustments</div>
                    </div>
                    <div class="cost-card">
                        <div class="card-label">Fringe & Benefits</div>
                        <div class="card-value">@((data.LabourFringe + data.LabourBenefits).ToString("C2"))</div>
                        <div class="card-sub">Fringe: @((data.LabourFringe / (data.TotalLabourCost > 0 ? data.TotalLabourCost : 1) * 100).ToString("F1"))% | Benefits: @((data.LabourBenefits / (data.TotalLabourCost > 0 ? data.TotalLabourCost : 1) * 100).ToString("F1"))%</div>
                    </div>
                    <div class="cost-card">
                        <div class="card-label">Final Labour</div>
                        <div class="card-value">@data.FinalLabourCost.ToString("C2")</div>
                        <div class="card-sub">Overhead: @((data.LabourOverhead / (data.TotalLabourCost > 0 ? data.TotalLabourCost : 1) * 100).ToString("F1"))%</div>
                    </div>
                </div>
            </div>

            <!-- LABOUR TASKS TABLE -->
            <div class="section">
                <div class="section-header">
                    <span>📋 LABOUR TASKS</span>
                    <span class="sub-count">Total Tasks: @(data.LabourTasks?.Count ?? 0)</span>
                </div>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th style="width:18%;">Task</th>
                                <th style="width:17%;">Labour Definition</th>
                                <th style="width:8%;">CC</th>
                                <th style="width:8%; text-align:center;">Count</th>
                                <th style="width:10%; text-align:right;">Hours</th>
                                <th style="width:10%; text-align:right;">Effective Hrs</th>
                                <th style="width:10%; text-align:right;">Adjusted Hrs</th>
                                <th style="width:9%; text-align:right;">Rate/Hr</th>
                                <th style="width:10%; text-align:right;">Total Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (data.LabourTasks != null && data.LabourTasks.Any())
                            {
                                foreach (var task in data.LabourTasks)
                                {
                                    <tr>
                                        <td>@task.Task</td>
                                        <td>@task.LabourDefinition</td>
                                        <td>@task.CC</td>
                                        <td style="text-align:center;">@task.Count</td>
                                        <td style="text-align:right;">@task.Hours.ToString("F2")</td>
                                        <td style="text-align:right;">@task.EffectiveHours.ToString("F2")</td>
                                        <td style="text-align:right;">@task.AdjustedHours.ToString("F2")</td>
                                        <td style="text-align:right;">@task.RatePerHour.ToString("C2")</td>
                                        <td style="text-align:right; font-weight:600;">@task.TotalCost.ToString("C2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" style="text-align:center; color:#6c757d;">No labour tasks found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MATERIAL LINES TABLE -->
            <div class="section">
                <div class="section-header">
                    <span>🔧 MATERIAL LINES</span>
                    <span class="sub-count">Total Parts: @(data.MaterialLines?.Count ?? 0)</span>
                </div>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th style="width:10%;">Type</th>
                                <th style="width:12%;">Stock Code</th>
                                <th style="width:7%;">CC</th>
                                <th style="width:25%;">Description</th>
                                <th style="width:8%; text-align:right;">Qty</th>
                                <th style="width:10%; text-align:right;">Unit Cost</th>
                                <th style="width:8%; text-align:right;">Usage %</th>
                                <th style="width:10%; text-align:right;">Total Cost</th>
                                <th style="width:10%;">Supplier</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (data.MaterialLines != null && data.MaterialLines.Any())
                            {
                                var badgeClass = "";
                                foreach (var item in data.MaterialLines)
                                {
                                    badgeClass = item.Type == "Stock" ? "badge-stock" :
                                    (item.Type == "Rebuilt" ? "badge-rebuilt" : "badge-nonstock");
                                    <tr>
                                        <td><span class="badge @badgeClass">@item.Type</span></td>
                                        <td>@item.StockCode</td>
                                        <td>@item.CC</td>
                                        <td>@item.Description</td>
                                        <td style="text-align:right;">@item.Quantity.ToString("F1")</td>
                                        <td style="text-align:right;">@item.UnitCost.ToString("C2")</td>
                                        <td style="text-align:right;">@item.PercentUsage.ToString("F1")%</td>
                                        <td style="text-align:right; font-weight:600;">@item.TotalCost.ToString("C2")</td>
                                        <td>@item.Supplier</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" style="text-align:center; color:#6c757d;">No material lines found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- GRAND TOTALS -->
            <div class="section">
                <div class="section-header" style="background: #1a252f;">
                    <span>💰 GRAND TOTALS</span>
                    <span></span>
                </div>
                <table class="summary-table">
                    <tbody>
                        <tr>
                            <td class="label-cell" style="width:25%;">Total Without Tax</td>
                            <td style="font-weight:bold; font-size:12pt; width:25%;">@data.TotalWithoutTax.ToString("C2")</td>
                            <td class="label-cell" style="width:25%;">Total With Tax</td>
                            <td style="font-weight:bold; font-size:12pt; color:#2c3e50; width:25%;">@data.TotalWithTax.ToString("C2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- FOOTER (Requirement #5) -->
            <div class="report-footer">
                <div>
                    <span class="modified-info">Modified Last By: @data.ModifiedLastBy</span>
                    <span style="margin-left:20px;" class="modified-info">Modified Last Date: @data.ModifiedLastDate.ToString("yyyy-MM-dd HH:mm:ss")</span>
                </div>
                <div>
                    <span style="font-size:7pt; color:#adb5bd;">Entered By: @data.EnteredBy | @data.DateEntered.ToString("yyyy-MM-dd")</span>
                </div>
            </div>
        }
        else
        {
            <div style="text-align:center; padding:40px; color:#6c757d;">
                <h3>No data found for this vehicle</h3>
                <p>Please check the vehicle ID and try again.</p>
            </div>
        }

    </div>

    <script>
        // Auto-print functionality (optional)
        document.addEventListener('DOMContentLoaded', function() {
            // You can uncomment this to auto-print when page loads
            // window.print();
        });
    </script>

</body>
</html>

