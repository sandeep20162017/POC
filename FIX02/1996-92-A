        /* Badge */
        .badge {
            display: inline-block;
            padding: 1px 8px;
            border-radius: 12px;
            font-size: 6.5pt;
            font-weight: 600;
            height: 18px;
            line-height: 18px;
        }

        .badge-stock {
            background: #d4edda;
            color: #155724;
        }

        .badge-rebuilt {
            background: #fff3cd;
            color: #856404;
        }

        .badge-nonstock {
            background: #f8d7da;
            color: #721c24;
        }

        /* Footer - Adjusted Height */
        .report-footer {
            margin-top: 20px;
            padding-top: 10px;
            border-top: 2px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            font-size: 8pt;
            color: #6c757d;
            min-height: 30px;
            align-items: center;
        }

        .modified-info {
            font-weight: 500;
            color: #2c3e50;
        }

        /* Utility Classes */
        .text-right {
            text-align: right;
        }

        .text-left {
            text-align: left;
        }

        .text-center {
            text-align: center;
        }

        .font-bold {
            font-weight: bold;
        }

        .mt-1 {
            margin-top: 4px;
        }

        .mt-2 {
            margin-top: 8px;
