DECLARE @SchemaName SYSNAME = 'BCES';
DECLARE @FixCollation SYSNAME = 'SQL_Latin1_General_CP1_CI_AS';

------------------------------------------------------------
-- 1. DROP FOREIGN KEYS
------------------------------------------------------------
DECLARE @sql NVARCHAR(MAX);

SET @sql = (
    SELECT STRING_AGG(
        (
            'ALTER TABLE [' + @SchemaName + '].[' +
            OBJECT_NAME(parent_object_id) COLLATE SQL_Latin1_General_CP1_CI_AS +
            '] DROP CONSTRAINT [' + name COLLATE SQL_Latin1_General_CP1_CI_AS + '];'
        ) COLLATE SQL_Latin1_General_CP1_CI_AS,
        CHAR(10)
    ) COLLATE SQL_Latin1_General_CP1_CI_AS
    FROM sys.foreign_keys
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);

PRINT @sql;
EXEC(@sql);


