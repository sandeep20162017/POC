DECLARE @SchemaName SYSNAME = 'BCES';

------------------------------------------------------------
-- Helper: forces collation to avoid STRING_AGG conflicts
------------------------------------------------------------
DECLARE @Collation SYSNAME = 'DATABASE_DEFAULT';


------------------------------------------------------------
-- 1. DROP FOREIGN KEYS
------------------------------------------------------------
DECLARE @sql NVARCHAR(MAX);

SET @sql = (
    SELECT STRING_AGG(
        'ALTER TABLE [' + @SchemaName + '].[' +
        OBJECT_NAME(parent_object_id) COLLATE DATABASE_DEFAULT +
        '] DROP CONSTRAINT [' + name COLLATE DATABASE_DEFAULT + '];',
        CHAR(10)
    ) COLLATE DATABASE_DEFAULT
    FROM sys.foreign_keys
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);

PRINT @sql;
EXEC(@sql);


------------------------------------------------------------
-- 2. DROP CHECK CONSTRAINTS
------------------------------------------------------------
SET @sql = (
    SELECT STRING_AGG(
        'ALTER TABLE [' + @SchemaName + '].[' +
        OBJECT_NAME(parent_object_id) COLLATE DATABASE_DEFAULT +
        '] DROP CONSTRAINT [' + name COLLATE DATABASE_DEFAULT + '];',
        CHAR(10)
    ) COLLATE DATABASE_DEFAULT
    FROM sys.check_constraints
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);

PRINT @sql;
EXEC(@sql);


------------------------------------------------------------
-- 3. DROP DEFAULT CONSTRAINTS
------------------------------------------------------------
SET @sql = (
    SELECT STRING_AGG(
        'ALTER TABLE [' + @SchemaName + '].[' +
        OBJECT_NAME(parent_object_id) COLLATE DATABASE_DEFAULT +
        '] DROP CONSTRAINT [' + name COLLATE DATABASE_DEFAULT + '];',
        CHAR(10)
    ) COLLATE DATABASE_DEFAULT
    FROM sys.default_constraints
