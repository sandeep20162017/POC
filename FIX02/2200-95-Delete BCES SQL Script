DECLARE @Schema SYSNAME = 'BCES';
DECLARE @sql NVARCHAR(MAX);

------------------------------------------------------------
-- 1. DROP FOREIGN KEYS
------------------------------------------------------------
WHILE EXISTS (
    SELECT 1
    FROM sys.foreign_keys fk
    JOIN sys.objects o ON fk.parent_object_id = o.object_id
    WHERE o.schema_id = SCHEMA_ID(@Schema)
)
BEGIN
    SELECT TOP 1 @sql =
        'ALTER TABLE [' + @Schema + '].[' + OBJECT_NAME(parent_object_id) +
        '] DROP CONSTRAINT [' + name + '];'
    FROM sys.foreign_keys fk
    JOIN sys.objects o ON fk.parent_object_id = o.object_id
    WHERE o.schema_id = SCHEMA_ID(@Schema);

    PRINT @sql;
    EXEC(@sql);
END

------------------------------------------------------------
-- 2. DROP OTHER CONSTRAINTS (PK, UNIQUE, CHECK, DEFAULT)
------------------------------------------------------------
WHILE EXISTS (
    SELECT 1
    FROM sys.objects
    WHERE schema_id = SCHEMA_ID(@Schema)
      AND type IN ('PK','UQ','C','D')
)
BEGIN
    SELECT TOP 1 @sql =
        'ALTER TABLE [' + @Schema + '].[' + OBJECT_NAME(parent_object_id) +
        '] DROP CONSTRAINT [' + name + '];'
    FROM sys.objects
    WHERE schema_id = SCHEMA_ID(@Schema)
      AND type IN ('PK','UQ','C','D');

    PRINT @sql;
    EXEC(@sql);
END

------------------------------------------------------------
-- 3. DROP ALL TABLES
------------------------------------------------------------
WHILE EXISTS (
    SELECT 1 FROM sys.tables WHERE schema_id = SCHEMA_ID(@Schema)
)
BEGIN
    SELECT TOP 1 @sql =
        'DROP TABLE [' + @Schema + '].[' + name + '];'
    FROM sys.tables
    WHERE schema_id = SCHEMA_ID(@Schema);

    PRINT @sql;
    EXEC(@sql);
END

------------------------------------------------------------
-- 4. DROP ALL VIEWS
------------------------------------------------------------
WHILE EXISTS (
    SELECT 1 FROM sys.views WHERE schema_id = SCHEMA_ID(@Schema)
)
BEGIN
    SELECT TOP 1 @sql =
        'DROP VIEW [' + @Schema + '].[' + name + '];'
    FROM sys.views
    WHERE schema_id = SCHEMA_ID(@Schema);

    PRINT @sql;
    EXEC(@sql);
END

------------------------------------------------------------
-- 5. DROP ALL PROCEDURES
------------------------------------------------------------
WHILE EXISTS (
    SELECT 1 FROM sys.objects WHERE schema_id = SCHEMA_ID(@Schema) AND type = 'P'
)
BEGIN
    SELECT TOP 1 @sql =
        'DROP PROCEDURE [' + @Schema + '].[' + name + '];'
    FROM sys.objects
    WHERE schema_id = SCHEMA_ID(@Schema) AND type = 'P';

    PRINT @sql;
    EXEC(@sql);
END

------------------------------------------------------------
-- 6. DROP ALL FUNCTIONS
------------------------------------------------------------
WHILE EXISTS (
    SELECT 1 FROM sys.objects WHERE schema_id = SCHEMA_ID(@Schema) AND type IN ('FN','IF','TF')
)
BEGIN
    SELECT TOP 1 @sql =
        'DROP FUNCTION [' + @Schema + '].[' + name + '];'
    FROM sys.objects
    WHERE schema_id = SCHEMA_ID(@Schema) AND type IN ('FN','IF','TF');

    PRINT @sql;
    EXEC(@sql);
END

------------------------------------------------------------
-- 7. DROP ALL SEQUENCES
------------------------------------------------------------
WHILE EXISTS (
    SELECT 1 FROM sys.sequences WHERE schema_id = SCHEMA_ID(@Schema)
)
BEGIN
    SELECT TOP 1 @sql =
        'DROP SEQUENCE [' + @Schema + '].[' + name + '];'
    FROM sys.sequences
    WHERE schema_id = SCHEMA_ID(@Schema);

    PRINT @sql;
    EXEC(@sql);
END

------------------------------------------------------------
-- 8. DROP THE SCHEMA
------------------------------------------------------------
SET @sql = 'DROP SCHEMA [' + @Schema + '];';
PRINT @sql;
EXEC(@sql);
