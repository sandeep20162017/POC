------------------------------------------------------------
-- 4. DROP PK + UNIQUE CONSTRAINTS
------------------------------------------------------------
SET @sql = (
    SELECT STRING_AGG(
        'ALTER TABLE [' + @SchemaName + '].[' +
        OBJECT_NAME(parent_object_id) COLLATE DATABASE_DEFAULT +
        '] DROP CONSTRAINT [' + name COLLATE DATABASE_DEFAULT + '];',
        CHAR(10)
    ) COLLATE DATABASE_DEFAULT
    FROM sys.key_constraints
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);

PRINT @sql;
EXEC(@sql);


------------------------------------------------------------
-- 5. DROP ALL OBJECTS IN SCHEMA
------------------------------------------------------------
SET @sql = (
    SELECT STRING_AGG(
        'DROP ' +
        CASE type
            WHEN 'U' THEN 'TABLE'
            WHEN 'V' THEN 'VIEW'
            WHEN 'P' THEN 'PROCEDURE'
            WHEN 'FN' THEN 'FUNCTION'
            WHEN 'IF' THEN 'FUNCTION'
            WHEN 'TF' THEN 'FUNCTION'
            WHEN 'TR' THEN 'TRIGGER'
            WHEN 'SQ' THEN 'SEQUENCE'
            ELSE type
        END +
        ' [' + @SchemaName + '].[' + name COLLATE DATABASE_DEFAULT + '];',
        CHAR(10)
    ) COLLATE DATABASE_DEFAULT
    FROM sys.objects
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);

PRINT @sql;
EXEC(@sql);


------------------------------------------------------------
-- 6. DROP SCHEMA
------------------------------------------------------------
SET @sql = 'DROP SCHEMA [' + @SchemaName + '];';
PRINT @sql;
EXEC(@sql);
