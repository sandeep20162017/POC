DECLARE @SchemaName SYSNAME = 'BCES';

------------------------------------------------------------
-- 1. DROP ALL CONSTRAINTS (FK, PK, UNIQUE, CHECK, DEFAULT)
------------------------------------------------------------
DECLARE @sql NVARCHAR(MAX);

-- Foreign Keys
SET @sql = (
    SELECT STRING_AGG(
        'ALTER TABLE [' + @SchemaName + '].[' + OBJECT_NAME(parent_object_id) + '] DROP CONSTRAINT [' + name + '];',
        CHAR(10)
    )
    FROM sys.foreign_keys
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);
PRINT @sql;
EXEC(@sql);

-- Check Constraints
SET @sql = (
    SELECT STRING_AGG(
        'ALTER TABLE [' + @SchemaName + '].[' + OBJECT_NAME(parent_object_id) + '] DROP CONSTRAINT [' + name + '];',
        CHAR(10)
    )
    FROM sys.check_constraints
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);
PRINT @sql;
EXEC(@sql);

-- Default Constraints
SET @sql = (
    SELECT STRING_AGG(
        'ALTER TABLE [' + @SchemaName + '].[' + OBJECT_NAME(parent_object_id) + '] DROP CONSTRAINT [' + name + '];',
        CHAR(10)
    )
    FROM sys.default_constraints
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);
PRINT @sql;
EXEC(@sql);

-- PK + Unique Constraints
SET @sql = (
    SELECT STRING_AGG(
        'ALTER TABLE [' + @SchemaName + '].[' + OBJECT_NAME(parent_object_id) + '] DROP CONSTRAINT [' + name + '];',
        CHAR(10)
    )
    FROM sys.key_constraints
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);
PRINT @sql;
EXEC(@sql);

------------------------------------------------------------
-- 2. DROP ALL OBJECTS IN THE SCHEMA
------------------------------------------------------------
SET @sql = (
    SELECT STRING_AGG(
        'DROP ' +
        CASE type
            WHEN 'U' THEN 'TABLE'
            WHEN 'V' THEN 'VIEW'
            WHEN 'P' THEN 'PROCEDURE'
            WHEN 'FN' THEN 'FUNCTION'
            WHEN 'IF' THEN 'FUNCTION'
            WHEN 'TF' THEN 'FUNCTION'
            WHEN 'TR' THEN 'TRIGGER'
            WHEN 'SQ' THEN 'SEQUENCE'
            ELSE type
        END +
        ' [' + @SchemaName + '].[' + name + '];',
        CHAR(10)
    )
    FROM sys.objects
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);
PRINT @sql;
EXEC(@sql);

------------------------------------------------------------
-- 3. DROP THE SCHEMA
------------------------------------------------------------
SET @sql = 'DROP SCHEMA [' + @SchemaName + '];';
PRINT @sql;
EXEC(@sql);
