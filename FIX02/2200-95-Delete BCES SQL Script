DECLARE @Schema SYSNAME = 'BCES';
DECLARE @Object SYSNAME;
DECLARE @sql NVARCHAR(MAX);

DECLARE cur CURSOR FOR
    SELECT QUOTENAME(@Schema) + '.' + QUOTENAME(name)
    FROM sys.objects
    WHERE type = 'U' AND schema_id = SCHEMA_ID(@Schema);

OPEN cur;
FETCH NEXT FROM cur INTO @Object;

WHILE @@FETCH_STATUS = 0
BEGIN
    SET @sql = 'DROP TABLE ' + @Object + ';';
    PRINT @sql;
    EXEC(@sql);

    FETCH NEXT FROM cur INTO @Object;
END

CLOSE cur;
DEALLOCATE cur;
