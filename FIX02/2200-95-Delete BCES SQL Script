------------------------------------------------------------
-- 5. DROP ALL OBJECTS IN SCHEMA
------------------------------------------------------------
SET @sql = (
    SELECT STRING_AGG(
        (
            'DROP ' +
            CASE type
                WHEN 'U' THEN 'TABLE'
                WHEN 'V' THEN 'VIEW'
                WHEN 'P' THEN 'PROCEDURE'
                WHEN 'FN' THEN 'FUNCTION'
                WHEN 'IF' THEN 'FUNCTION'
                WHEN 'TF' THEN 'FUNCTION'
                WHEN 'TR' THEN 'TRIGGER'
                WHEN 'SQ' THEN 'SEQUENCE'
                ELSE type
            END +
            ' [' + @SchemaName + '].[' + name COLLATE SQL_Latin1_General_CP1_CI_AS + '];'
        ) COLLATE SQL_Latin1_General_CP1_CI_AS,
        CHAR(10)
    ) COLLATE SQL_Latin1_General_CP1_CI_AS
    FROM sys.objects
    WHERE schema_id = SCHEMA_ID(@SchemaName)
);

PRINT @sql;
EXEC(@sql);


------------------------------------------------------------
-- 6. DROP SCHEMA
------------------------------------------------------------
SET @sql = 'DROP SCHEMA [' + @SchemaName + '];';
PRINT @sql;
EXEC(@sql);
