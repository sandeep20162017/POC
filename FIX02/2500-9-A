import os
import sys
import platform
import struct
import subprocess

try:
    import pyodbc
except Exception:
    pyodbc = None


def header(title):
    print("\n" + "=" * 80)
    print(title)
    print("=" * 80)


header("PYTHON INFORMATION")

print("Python Executable :", sys.executable)
print("Python Version    :", sys.version)
print("Architecture      :", platform.architecture()[0])
print("Pointer Size      :", struct.calcsize("P") * 8, "bit")
print("Platform          :", platform.platform())


###########################################################################
# ODBC Drivers
###########################################################################

header("ODBC DRIVERS")

if pyodbc is None:
    print("pyodbc NOT installed.")
else:
    drivers = pyodbc.drivers()

    if not drivers:
        print("No ODBC drivers found.")
    else:
        for d in drivers:
            print(d)


###########################################################################
# Oracle Client
###########################################################################

header("ORACLE CLIENT")

oracle_paths = []

for p in os.environ.get("PATH", "").split(";"):
    if "oracle" in p.lower():
        oracle_paths.append(p)

if oracle_paths:
    print("Oracle folders in PATH:")
    for p in oracle_paths:
        print("   ", p)
else:
    print("No Oracle folder found in PATH.")


