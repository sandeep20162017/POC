header("TNS_ADMIN")

print(os.environ.get("TNS_ADMIN", "Not Set"))


###########################################################################
# OCI.DLL
###########################################################################

header("OCI.DLL SEARCH")

found = False

for p in os.environ.get("PATH", "").split(";"):
    dll = os.path.join(p, "oci.dll")
    if os.path.exists(dll):
        found = True
        print(dll)

if not found:
    print("OCI.DLL not found in PATH")


###########################################################################
# Registry Oracle Homes
###########################################################################

header("REGISTERED ORACLE HOMES")

try:
    import winreg

    for hive in (
        winreg.HKEY_LOCAL_MACHINE,
    ):

        try:
            key = winreg.OpenKey(
                hive,
                r"SOFTWARE\ORACLE"
            )

            i = 0
            while True:
                try:
                    name = winreg.EnumKey(key, i)
                    print(name)
                    i += 1
                except OSError:
                    break

        except:
            pass

except Exception as ex:
    print(ex)


