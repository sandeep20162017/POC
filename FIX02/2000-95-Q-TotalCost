                                                ISNULL(
                                                    (SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'FRINGE'), '0'
                                                ), ',', '.') AS DECIMAL(18,6));

                                        -- Get Benefit (varchar to decimal)
