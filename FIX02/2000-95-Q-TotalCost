                                                CASE WHEN LC.TotalLabourCost = 0 THEN 0 ELSE
                                                ((LC.TotalLabourCost * @Fringe) + ((LC.TotalLabourCost + (LC.TotalLabourCost * @Fringe)) * @Benefit)) / LC.TotalLabourCost
