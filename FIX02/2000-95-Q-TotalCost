                                            AS DECIMAL(18,2)) AS TotalWithTax

                                        FROM MaterialCost MC
                                        CROSS JOIN FinalCalc FC;

                                    END TRY
                                    BEGIN CATCH
                                        PRINT 'Error: ' + ERROR_MESSAGE();
                                    END CATCH;
                                 
                                     
                                 
                                     ";

