@{
    ViewData["Title"] = "AI Assistance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .ai-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .ai-header {
        background: linear-gradient(135deg, #0078d4, #005a9e);
        color: white;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 30px;
        text-align: center;
    }

    .ai-header h1 {
        margin: 0;
        font-size: 28px;
    }

    .ai-header p {
        margin: 10px 0 0;
        opacity: 0.9;
    }

    .ai-chat {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 600px;
    }

    .ai-messages {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        background: #f8f9fa;
    }

    .ai-message {
        margin-bottom: 16px;
        padding: 12px 16px;
        border-radius: 8px;
        max-width: 85%;
        word-wrap: break-word;
        animation: fadeIn 0.3s ease;
    }

    .ai-message.user {
        background: #0078d4;
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 4px;
    }

    .ai-message.assistant {
        background: white;
        border: 1px solid #e0e0e0;
        margin-right: auto;
        border-bottom-left-radius: 4px;
    }

    .ai-message.error {
        background: #dc3545;
        color: white;
        margin-left: auto;
    }

    .ai-message .time {
        font-size: 0.75em;
        opacity: 0.7;
        margin-top: 4px;
        display: block;
    }

    .ai-message ul {
        margin: 8px 0;
        padding-left: 20px;
    }

    .ai-message li {
        margin: 4px 0;
    }

    .ai-message code {
        background: #f0f0f0;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: 'Consolas', 'Monaco', monospace;
    }

    .ai-message strong {
        font-weight: 600;
    }

    .ai-message h3 {
        margin: 12px 0 8px;
        color: #0078d4;
        font-size: 1.1em;
    }

    .ai-message h4 {
        margin: 10px 0 6px;
        color: #005a9e;
        font-size: 1em;
    }

    .ai-message blockquote {
        border-left: 3px solid #0078d4;
        margin: 8px 0;
        padding: 8px 16px;
        background: #f0f7ff;
    }

    .ai-input-container {
        padding: 16px 20px;
        background: white;
        border-top: 1px solid #e0e0e0;
        display: flex;
        gap: 12px;
        align-items: flex-end;
    }

    .ai-input-container textarea {
        flex: 1;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
        resize: vertical;
        min-height: 50px;
        max-height: 150px;
        font-size: 14px;
        font-family: inherit;
    }

    .ai-input-container textarea:focus {
        border-color: #0078d4;
        box-shadow: 0 0 0 2px rgba(0,120,212,0.1);
    }

    .ai-input-container .btn-send {
        padding: 12px 24px;
        background: #0078d4;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        height: 50px;
        min-width: 80px;
    }

    .ai-input-container .btn-send:hover:not(:disabled) {
        background: #005a9e;
    }

    .ai-input-container .btn-send:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .ai-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 12px 20px;
        background: #f8f9fa;
        border-top: 1px solid #e0e0e0;
    }

    .ai-suggestions .suggestion-btn {
        padding: 6px 14px;
        background: white;
        border: 1px solid #ddd;
        border-radius: 20px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        color: #333;
    }

    .ai-suggestions .suggestion-btn:hover {
        background: #0078d4;
        color: white;
        border-color: #0078d4;
    }

    .ai-typing {
        display: none;
        padding: 12px 16px;
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        margin-right: auto;
        max-width: 80px;
    }

    .ai-typing.active {
        display: block;
    }

    .ai-typing-dots {
        display: flex;
        gap: 4px;
        justify-content: center;
    }

    .ai-typing-dots span {
        width: 8px;
        height: 8px;
        background: #0078d4;
        border-radius: 50%;
        animation: typing 1.4s infinite both;
    }

    .ai-typing-dots span:nth-child(2) {
        animation-delay: 0.2s;
    }

    .ai-typing-dots span:nth-child(3) {
        animation-delay: 0.4s;
    }

    @@keyframes typing {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .ai-message pre {
        background: #f0f0f0;
        padding: 12px;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 13px;
        margin: 8px 0;
    }

    .ai-message pre code {
        background: none;
        padding: 0;
    }

    .ai-related-actions {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #e0e0e0;
    }

    .ai-related-actions .action-btn {
        padding: 4px 12px;
        margin: 4px 4px 0 0;
        background: #e8f0fe;
        border: 1px solid #d2e3fc;
        border-radius: 4px;
        color: #1a73e8;
        cursor: pointer;
        font-size: 0.85em;
    }

    .ai-related-actions .action-btn:hover {
        background: #d2e3fc;
    }

    @@media (max-width: 768px) {
        .ai-chat {
            height: calc(100vh - 200px);
        }

        .ai-messages {
            padding: 12px;
        }

        .ai-message {
            max-width: 95%;
        }

        .ai-input-container {
            padding: 12px;
            flex-direction: column;
        }

        .ai-input-container textarea {
            min-height: 40px;
        }

        .ai-input-container .btn-send {
            width: 100%;
            height: 44px;
        }
    }

    /* Debug Panel Styles */
    #debugPanel {
        background: #1e1e1e;
        color: #d4d4d4;
        border: 1px solid #333;
        padding: 10px;
        margin-bottom: 10px;
        border-radius: 4px;
        display: none;
        max-height: 300px;
        overflow-y: auto;
        font-size: 12px;
        font-family: 'Consolas', 'Monaco', monospace;
    }

    #debugPanel strong {
        color: #569cd6;
    }

    #debugPanel .debug-info { color: #4fc3f7; }
    #debugPanel .debug-success { color: #81c784; }
    #debugPanel .debug-error { color: #e57373; }
    #debugPanel .debug-warning { color: #ffb74d; }
</style>

<div class="ai-container">
    <div class="ai-header">
        <h1>
            <span class="k-icon k-i-robot" style="margin-right: 10px;"></span>
            AI Assistance
        </h1>
        <p>Ask me anything about the Cost Estimation System. I'm here to help!</p>
    </div>

    <!-- Debug Panel (Ctrl+Shift+D to toggle) -->
    <div id="debugPanel">
        <strong>Debug Log:</strong>
        <div id="debugLog"></div>
    </div>

    <div class="ai-chat">
        <div class="ai-messages" id="chatMessages">
            <div class="ai-message assistant">
                <strong>👋 Hello! I'm your AI Assistant for the Cost Estimation System.</strong>
                <p>I can help you with:</p>
                <ul>
                    <li>Creating and managing estimates</li>
                    <li>Adding stock, non-stock, and rebuilt parts</li>
                    <li>Understanding labour and cost calculations</li>
                    <li>Step-by-step workflows</li>
                    <li>Troubleshooting common issues</li>
                </ul>
                <p>Try asking me a question below!</p>
                <span class="time">Just now</span>
            </div>
        </div>

        <div class="ai-suggestions">
            <span style="color: #666; font-size: 13px; padding: 4px 0;">Suggested:</span>
            <button class="suggestion-btn" onclick="askSuggestion('How to create a Make vs Buy estimate?')">
                Create Make vs Buy
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('How to add a stock coded part?')">
                Add Stock Part
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('How to add labour to an estimate?')">
                Add Labour
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('How to convert Make vs Buy to Rebuilt Part?')">
                Convert MB to RB
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('What fields are required for a vehicle estimate?')">
                Required Fields
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('How to add a user in User Management?')">
                Add User
            </button>
        </div>

        <div class="ai-input-container">
            <textarea id="userQuestion" 
                      placeholder="Type your question here... (e.g., 'How do I add a rebuilt part?')" 
                      rows="1"></textarea>
            <button class="btn-send" id="sendButton" onclick="sendQuestion()">
                <span class="k-icon k-i-send"></span> Send
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let isProcessing = false;
        let conversationHistory = [];
        let debugEnabled = true; // Debug enabled by default

        $(document).ready(function() {
            // Show debug panel
            $('#debugPanel').show();
            addDebug('=== AI Assistance Started ===', 'info');
            addDebug('Debug panel is ON. Press Ctrl+Shift+D to toggle.', 'info');

            // Auto-resize textarea
            $('#userQuestion').on('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 150) + 'px';
            });

            // Enter key support (Shift+Enter for new line)
            $('#userQuestion').on('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendQuestion();
                }
            });

            // Focus input on load
            setTimeout(function() {
                $('#userQuestion').focus();
                addDebug('Ready to accept questions', 'success');
            }, 500);

            // Keyboard shortcut: Ctrl+Shift+D to toggle debug panel
            $(document).on('keydown', function(e) {
                if (e.ctrlKey && e.shiftKey && (e.key === 'D' || e.key === 'd')) {
                    e.preventDefault();
                    debugEnabled = !debugEnabled;
                    $('#debugPanel').toggle(debugEnabled);
                    addDebug('Debug panel ' + (debugEnabled ? 'enabled' : 'disabled'), 'info');
                }
            });
        });

        function addDebug(message, type) {
            if (!debugEnabled) return;
            
            var log = $('#debugLog');
            if (!log.length) return;
            
            var timestamp = new Date().toLocaleTimeString();
            var cssClass = 'debug-' + (type || 'info');
            log.append('<div class="' + cssClass + '">[' + timestamp + '] ' + escapeHtml(message) + '</div>');
            log.parent().scrollTop(log.parent()[0].scrollHeight);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function askSuggestion(question) {
            addDebug('Suggestion clicked: ' + question, 'info');
            $('#userQuestion').val(question);
            sendQuestion();
        }

        function sendQuestion() {
            var input = $('#userQuestion');
            var question = input.val().trim();

            if (!question) {
                addDebug('Empty question, ignoring', 'warning');
                return;
            }

            if (isProcessing) {
                addDebug('Already processing, please wait', 'warning');
                return;
            }

            addDebug('=== Sending Question ===', 'info');
            addDebug('Question: ' + question, 'info');

            // Add user message
            addMessage(question, 'user');
            input.val('');
            input.css('height', 'auto');

            // Show typing indicator
            showTypingIndicator(true);

            isProcessing = true;
            $('#sendButton').prop('disabled', true);

            var requestData = {
                text: question,
                pageContext: {
                    url: window.location.href,
                    pageName: 'AIAssistance',
                    module: 'AI Help',
                    view: 'AIAssistance',
                    hasGrid: false,
                    visibleFields: []
                },
                conversationHistory: conversationHistory.slice(-5)
            };

            addDebug('AJAX Request Data: ' + JSON.stringify(requestData), 'info');

            // Send to server
            $.ajax({
                url: '/AIHelp/AskQuestion',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                beforeSend: function() {
                    addDebug('AJAX request sent to /AIHelp/AskQuestion', 'info');
                },
                success: function(response, status, xhr) {
                    addDebug('=== AJAX SUCCESS ===', 'success');
                    addDebug('Status: ' + status, 'success');
                    addDebug('Response type: ' + typeof response, 'info');
                    addDebug('Response: ' + JSON.stringify(response).substring(0, 500), 'info');
                    
                    showTypingIndicator(false);
                    
                    // Check if response is valid
                    if (!response) {
                        addDebug('Response is null or undefined', 'error');
                        addMessage('❌ Sorry, I received an empty response. Please try again.', 'error');
                        return;
                    }

                    // Handle different response types
                    if (typeof response === 'string') {
                        addDebug('Response is a string', 'info');
                        addMessage(response, 'assistant');
                        return;
                    }

                    if (typeof response === 'object') {
                        // Check for error
                        if (response.error) {
                            addDebug('Server returned error: ' + response.error, 'error');
                            addMessage('❌ ' + response.error, 'error');
                            return;
                        }

                        // Check for answer
                        if (response.answer) {
                            addDebug('Answer received, length: ' + response.answer.length, 'success');
                            addMessage(response.answer, 'assistant');

                            // Show related actions if any
                            if (response.relatedActions && response.relatedActions.length > 0) {
                                addDebug('Related actions: ' + response.relatedActions.length, 'info');
                                addRelatedActions(response.relatedActions);
                            }

                            conversationHistory.push(
                                { role: 'user', content: question },
                                { role: 'assistant', content: response.answer }
                            );
                            return;
                        }

                        // Check if response has a message property (common in some APIs)
                        if (response.message) {
                            addDebug('Response has message property', 'info');
                            addMessage(response.message, 'assistant');
                            return;
                        }

                        // If we get here, we don't know how to handle the response
                        addDebug('Unknown response format', 'error');
                        addDebug('Response keys: ' + Object.keys(response).join(', '), 'error');
                        addMessage('❌ Sorry, I received an unexpected response format. Please try again.', 'error');
                        return;
                    }

                    // Fallback for any other type
                    addDebug('Unexpected response type: ' + typeof response, 'error');
                    addMessage('❌ Sorry, I received an unexpected response. Please try again.', 'error');
                },
                error: function(xhr, status, error) {
                    addDebug('=== AJAX ERROR ===', 'error');
                    addDebug('Status: ' + status, 'error');
                    addDebug('Error: ' + error, 'error');
                    addDebug('XHR Status: ' + xhr.status, 'error');
                    addDebug('XHR Status Text: ' + xhr.statusText, 'error');
                    addDebug('XHR Response Text: ' + (xhr.responseText || 'No response text'), 'error');
                    
                    // Try to parse response text
                    var errorMsg = 'An error occurred. Please try again.';
                    try {
                        if (xhr.responseText) {
                            var parsed = JSON.parse(xhr.responseText);
                            if (parsed && parsed.error) {
                                errorMsg = parsed.error;
                                addDebug('Parsed error message: ' + errorMsg, 'error');
                            } else if (parsed && parsed.message) {
                                errorMsg = parsed.message;
                                addDebug('Parsed message: ' + errorMsg, 'error');
                            }
                        }
                    } catch (e) {
                        addDebug('Could not parse error response: ' + e.message, 'error');
                        if (xhr.responseText) {
                            errorMsg = xhr.responseText.substring(0, 200);
                            addDebug('Using raw response: ' + errorMsg, 'error');
                        }
                    }
                    
                    showTypingIndicator(false);
                    addMessage('❌ ' + errorMsg, 'error');
                },
                complete: function() {
                    addDebug('AJAX request completed', 'info');
                    isProcessing = false;
                    $('#sendButton').prop('disabled', false);
                    $('#userQuestion').focus();
                }
            });
        }

        function addMessage(content, type) {
            addDebug('addMessage called - type: ' + type + ', content length: ' + (content ? content.length : 0), 'info');
            
            // SAFETY: Check if content is valid
            if (!content) {
                content = 'Sorry, I received an empty response. Please try again.';
                type = 'error';
                addDebug('Content was null/empty, using default message', 'warning');
            }

            // Ensure content is a string
            if (typeof content !== 'string') {
                addDebug('Content is not a string: ' + typeof content, 'warning');
                try {
                    content = JSON.stringify(content);
                } catch (e) {
                    content = 'Invalid response format. Please try again.';
                    addDebug('Could not stringify content: ' + e.message, 'error');
                }
                type = 'error';
            }

            var container = $('#chatMessages');
            if (!container.length) {
                addDebug('Chat messages container not found!', 'error');
                return;
            }

            var messageDiv = $('<div>').addClass('ai-message ' + type);

            if (type === 'assistant') {
                try {
                    // Convert markdown-like formatting to HTML
                    var html = content
                        // Headers
                        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
                        .replace(/^## (.*$)/gim, '<h4>$1</h4>')
                        .replace(/^# (.*$)/gim, '<h3>$1</h3>')
                        // Bold
                        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                        // Italic
                        .replace(/\*(.*?)\*/g, '<em>$1</em>')
                        // Code blocks
                        .replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
                        // Inline code
                        .replace(/`(.*?)`/g, '<code>$1</code>')
                        // Blockquotes
                        .replace(/^> (.*$)/gim, '<blockquote>$1</blockquote>')
                        // Line breaks
                        .replace(/\n/g, '<br />')
                        // Lists - handle both * and -
                        .replace(/^[*-] (.*$)/gim, '<li>$1</li>')
                        .replace(/(<li>.*?<\/li>)/gs, function(match) {
                            return '<ul>' + match + '</ul>';
                        });

                    // Clean up multiple <br> tags
                    html = html.replace(/(<br \/>){2,}/g, '<br />');
                    // Clean up empty ul tags
                    html = html.replace(/<ul><\/ul>/g, '');

                    messageDiv.html(html);
                    addDebug('Message formatted as HTML', 'success');
                } catch (e) {
                    addDebug('Error formatting message: ' + e.message, 'error');
                    messageDiv.text(content);
                }
            } else {
                messageDiv.text(content);
            }

            // Add timestamp
            var time = new Date().toLocaleTimeString();
            messageDiv.append('<span class="time">' + time + '</span>');

            container.append(messageDiv);
            container.scrollTop(container[0].scrollHeight);
            
            addDebug('Message added to chat: ' + type + ' - length: ' + content.length, 'info');
        }

        function addRelatedActions(actions) {
            if (!actions || actions.length === 0) {
                addDebug('No related actions to show', 'info');
                return;
            }

            addDebug('Adding ' + actions.length + ' related actions', 'info');

            var container = $('#chatMessages');
            if (!container.length) return;

            var div = $('<div class="ai-message assistant">');
            div.append('<div class="ai-related-actions"><strong>Related Actions:</strong><br>');

            $.each(actions, function(index, action) {
                if (action && action.label) {
                    var btn = $('<button class="action-btn" onclick="performAction(\'' + escapeHtml(action.id || '') + '\', \'' + escapeHtml(action.type || 'navigate') + '\', \'' + escapeHtml(action.target || '') + '\')">' + escapeHtml(action.label) + '</button>');
                    div.find('.ai-related-actions').append(btn);
                }
            });

            div.append('</div>');
            container.append(div);
            container.scrollTop(container[0].scrollHeight);
        }

        function performAction(id, type, target) {
            addDebug('Performing action: ' + id + ' (' + type + ' -> ' + target + ')', 'info');
            
            if (!target) {
                addDebug('No target specified for action', 'warning');
                return;
            }

            switch(type) {
                case 'navigate':
                    addDebug('Navigating to: ' + target, 'info');
                    window.location.href = target;
                    break;
                case 'open':
                    // Try to open a Kendo window
                    try {
                        var win = $('#' + target + 'PopupWindow').data('kendoWindow');
                        if (win) {
                            addDebug('Opening Kendo window: ' + target, 'info');
                            win.open();
                        } else {
                            addDebug('Kendo window not found, navigating to: ' + target, 'warning');
                            window.location.href = target;
                        }
                    } catch (e) {
                        addDebug('Error opening window: ' + e.message, 'error');
                        window.location.href = target;
                    }
                    break;
                default:
                    addDebug('Unknown action type: ' + type, 'error');
                    console.log('Action:', id, type, target);
            }
        }

        function showTypingIndicator(show) {
            var container = $('#chatMessages');
            if (!container.length) return;

            var indicator = $('.ai-typing');

            if (show) {
                if (indicator.length === 0) {
                    indicator = $(
                        '<div class="ai-typing active">' +
                            '<div class="ai-typing-dots">' +
                                '<span></span>' +
                                '<span></span>' +
                                '<span></span>' +
                            '</div>' +
                        '</div>'
                    );
                    container.append(indicator);
                    addDebug('Typing indicator shown', 'info');
                }
                indicator.addClass('active');
                container.scrollTop(container[0].scrollHeight);
            } else {
                indicator.removeClass('active');
                setTimeout(function() {
                    indicator.remove();
                }, 300);
                addDebug('Typing indicator hidden', 'info');
            }
        }

        // Auto-send on paste of long questions
        $('#userQuestion').on('paste', function() {
            var self = this;
            setTimeout(function() {
                var text = $(self).val();
                if (text && text.length > 50) {
                    addDebug('Paste detected (length: ' + text.length + '), auto-sending', 'info');
                    sendQuestion();
                }
            }, 100);
        });

        // Add a test button to verify the chat works
        $(document).on('keydown', function(e) {
            if (e.ctrlKey && e.shiftKey && (e.key === 'T' || e.key === 't')) {
                e.preventDefault();
                addDebug('Test button pressed - sending test question', 'info');
                askSuggestion('How to create a Make vs Buy estimate?');
            }
        });

        addDebug('Press Ctrl+Shift+T to send a test question', 'info');
    </script>
}
