/****** Object:  StoredProcedure [SBCES].[WriteLabour]    Script Date: 9/17/2026 3:56:35 PM ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE   PROCEDURE [SBCES].[WriteLabour]
(
      @ViIdnum VARCHAR(30)
    , @ViAdjustment DECIMAL(18,6)
)
AS
BEGIN
    SET NOCOUNT ON;

    PRINT '---------------------------------------------';
    PRINT 'WriteLabour START';
    PRINT ' @ViIdnum      = ' + ISNULL(@ViIdnum,'NULL');
    PRINT ' @ViAdjustment = ' + CAST(ISNULL(@ViAdjustment,0) AS VARCHAR(50));
    PRINT '---------------------------------------------';

    SELECT DebugStage = 'START',
           ViIdnum = @ViIdnum,
           ViAdjustment = @ViAdjustment;

    DECLARE @VPrice INT;

    BEGIN TRY

        PRINT 'Inserting labour rows for LinkNumber=' + @ViIdnum;

        SELECT DebugStage = 'Before Insert',
               LinkNumber = @ViIdnum,
               Adjustment = @ViAdjustment;

        INSERT INTO SBCES.TempLabourList
        (
              LabourType
            , Cc
            , Task
            , Usage
            , Time
            , RatePerHour
            , TotalCost
            , ExtendedTime
            , EstimateType
            , EstimateNumber
            , WrenchTime
        )
        SELECT
              EL.LabourDefn
            , EL.CostCentre
            , EL.Task
            , CAST(REPLACE(EL.[Usage], ',', '.') AS DECIMAL(18,2))
            , ROUND(
                CAST(SBCES.HhmmToMinutes(EL.TimeAddition) AS DECIMAL(18,2))
                * @ViAdjustment
              ,0)
            , ES.RatePerHour
            ,
              (ES.RatePerHour / 60.0)
              *
              ROUND(
                    CAST(SBCES.HhmmToMinutes(EL.TimeAddition) AS DECIMAL(18,2))
                    * @ViAdjustment
              ,0)
              *
              (
                CAST(REPLACE(EL.[Usage], ',', '.') AS DECIMAL(18,4))
                / 100.0
              )
            ,
              CAST
              (
                ROUND
                (
                    (
                        CAST(REPLACE(EL.[Usage], ',', '.') AS DECIMAL(18,4))
                        / 100.0
                    )
                    *
                    CAST(SBCES.HhmmToMinutes(EL.TimeAddition) AS DECIMAL(18,2))
                    *
                    @ViAdjustment
                ,0)
                AS VARCHAR(8)
              )
            ,
              'RB'
            ,
              UPPER(@ViIdnum)
            ,
              CAST
              (
                ROUND
                (
                    (
                        CAST(REPLACE(EL.[Usage], ',', '.') AS DECIMAL(18,4))
                        / 100.0
                    )
                    *
                    ROUND
                    (
                        CAST
                        (
                            SBCES.HhmmToMinutes
                            (
                                SBCES.HhmmToDecimal(EL.AdjHrs)
                            ) AS DECIMAL(18,2)
                        )
                        * @ViAdjustment
                    ,0)
                ,0)
                AS VARCHAR(25)
              )
        FROM SBCES.EmployeeLabour EL
        INNER JOIN SBCES.EmplClass EC
            ON UPPER(EL.LabourDefn) = UPPER(EC.LabourDefn)
        INNER JOIN SBCES.EmployeeSalaries ES
            ON ES.WageGroup = EC.WageGroup
        WHERE EL.LinkNumber = @ViIdnum
          AND EL.TypeId = 'RB';

        PRINT 'Insert complete for ' + @ViIdnum;

        SELECT DebugStage = 'After Insert',
               InsertedFor = @ViIdnum;

        ---------------------------------------------------------
        -- Recursive rebuilt parts
        ---------------------------------------------------------

        SELECT
            @VPrice = COUNT(*)
        FROM SBCES.ScPartsUsed
        WHERE RebuiltPart = 'Y'
          AND LinkType = 'RB'
          AND UPPER(LinkCode) = UPPER(@ViIdnum);

        PRINT 'Rebuilt parts found: ' + CAST(@VPrice AS VARCHAR(20));

        SELECT DebugStage = 'Rebuilt Parts Count',
               LinkCode = @ViIdnum,
               RebuiltCount = @VPrice;

        IF @VPrice > 0
        BEGIN
            DECLARE
                  @LinkCode VARCHAR(30)
                , @Qty DECIMAL(18,6)
                , @PercentUsage DECIMAL(18,6)
                , @RebuiltCode VARCHAR(30);

            DECLARE RB_CURSOR CURSOR LOCAL FAST_FORWARD FOR
                SELECT DISTINCT
                      UPPER(LinkCode)
                    , CAST(QtyReqd AS DECIMAL(18,6))
                    , CAST(PercentUsage AS DECIMAL(18,6))
                    , UPPER(MmsRebuiltCode)
                FROM SBCES.ScPartsUsed
                WHERE RebuiltPart = 'Y'
                  AND LinkType = 'RB'
                  AND UPPER(LinkCode) = UPPER(@ViIdnum);

            OPEN RB_CURSOR;

            FETCH NEXT FROM RB_CURSOR
            INTO
                  @LinkCode
                , @Qty
                , @PercentUsage
                , @RebuiltCode;

            WHILE @@FETCH_STATUS = 0
            BEGIN

                PRINT 'Recursive call: RebuiltCode=' + @RebuiltCode
                      + ', Qty=' + CAST(@Qty AS VARCHAR(50))
                      + ', PercentUsage=' + CAST(@PercentUsage AS VARCHAR(50));

                SELECT DebugStage = 'Recursive Call',
                       Parent = @ViIdnum,
                       ChildRebuiltCode = @RebuiltCode,
                       Qty = @Qty,
                       PercentUsage = @PercentUsage,
                       NewAdjustment = (@Qty * @PercentUsage / 100.0) * @ViAdjustment;

               
				DECLARE @sql NVARCHAR(MAX);
				SET @sql = N'
                    EXEC SBCES.WriteLabour
                         @ViIdnum = ''' + @RebuiltCode + ''',
                         @ViAdjustment = ' + CAST((@Qty * @PercentUsage / 100.0) * @ViAdjustment AS VARCHAR(50)) ;
                        

                PRINT 'DEBUG: Dynamic SQL = ' + @sql;

                EXEC sys.sp_executesql @sql;

                FETCH NEXT FROM RB_CURSOR
                INTO
                      @LinkCode
                    , @Qty
                    , @PercentUsage
                    , @RebuiltCode;
            END

            CLOSE RB_CURSOR;
            DEALLOCATE RB_CURSOR;
        END

    END TRY
    BEGIN CATCH

        PRINT 'ERROR in WriteLabour: ' + ERROR_MESSAGE();

        SELECT
              DebugStage = 'ERROR',
              ErrorMessage = ERROR_MESSAGE(),
              ErrorLine    = ERROR_LINE(),
              ErrorNumber  = ERROR_NUMBER(),
              ErrorState   = ERROR_STATE(),
              ErrorSeverity= ERROR_SEVERITY();

        THROW;
    END CATCH

    PRINT 'WriteLabour END for ' + @ViIdnum;
    PRINT '---------------------------------------------';

    SELECT DebugStage = 'END',
           ViIdnum = @ViIdnum;

END
GO
