CREATE   PROCEDURE [SBCES].[IfsMmsSync]
AS
BEGIN
    SET NOCOUNT ON;

    BEGIN TRY

        --------------------------------------------------------------------
        -- Backup StockCodedParts
        --------------------------------------------------------------------
        TRUNCATE TABLE SBCES.StockCodedPartsBackup;

        INSERT INTO SBCES.StockCodedPartsBackup
        (
            MmsStockCode,
            CorePartNumber,
            PartType,
            JobNumber,
            DetailedDesc,
            DateEntered,
            ItemRefNumber,
            OverheadType,
            CoreCharge,
            PartCost,
            LastModifiedDate,
            LastModifiedBy,
            AddedBy,
            MmsNewCost,
            OemPartCost,
            MmsSyncDate,
            OrigSupplierNum,
            OrigSupplierName
        )
        SELECT
            RTRIM(ISNULL(MmsStockCode,'')),
            ISNULL(CorePartNumber,''),
            ISNULL(PartType,''),
            ISNULL(JobNumber,''),
            ISNULL(DetailedDesc,''),
            ISNULL(DateEntered,''),
            ISNULL(ItemRefNumber,''),
            ISNULL(OverheadType,0),
            ISNULL(CoreCharge,0),
            ISNULL(PartCost,0),
            LastModifiedDate,
            LastModifiedBy,
            ISNULL(AddedBy,''),
            ISNULL(MmsNewCost,0),
            ISNULL(OemPartCost,0),
            MmsSyncDate,
            ISNULL(OrigSupplierNum,''),
            ISNULL(OrigSupplierName,'')
        FROM SBCES.StockCodedParts;

        --------------------------------------------------------------------
        -- Clear tables
        --------------------------------------------------------------------
        TRUNCATE TABLE SBCES.StockCodedParts;
        TRUNCATE TABLE SBCES.PriceNoTax;
        TRUNCATE TABLE SBCES.LastPriceNoTax;

        --------------------------------------------------------------------
        -- Populate StockCodedParts
        --------------------------------------------------------------------
        INSERT INTO SBCES.StockCodedParts
        (
            MmsStockCode,
            PartType,
            MmsNewCost,
            DetailedDesc,
            MmsSyncDate,
            OrigSupplierName,
            OrigSupplierNum
        )
        SELECT DISTINCT
            RTRIM(a.PartNumber),
            LEFT(a.DescriptionPm,30),
            SBCES.GetNewCost(
                ISNULL(a.LevelTotalCostLaPm,0),
                a.LevelTotalCostWaPm
            ),
            b.PartXdescEdLine,
            GETDATE(),
            ISNULL(RTRIM(b.BusinessName),''),
            ISNULL(b.VendorPartNumber,'')
        FROM SBCES.PartMaster a
        LEFT JOIN
        (
            SELECT
                A.PrintSeq,
                A.PartNumber,
                A.BusinessName,
                A.VendorPartNumber,
                A.PartXdescEdLine
            FROM SBCES.VendorPartDesc A
            INNER JOIN
            (
                SELECT
                    PartNumber AS Pn,
                    MAX(PrintSeq) AS Seq
                FROM SBCES.VendorPartDesc
                WHERE VendorPartNumber <> ' '
                  AND BusinessName NOT LIKE '%SUPERSEDED%'
                GROUP BY PartNumber
            ) B
            ON RTRIM(A.PartNumber)=RTRIM(B.Pn)
            AND A.PrintSeq=B.Seq
        ) b
        ON RTRIM(a.PartNumber)=RTRIM(b.PartNumber)
        WHERE a.ProductCodePm NOT LIKE '%PLUM%';

        --------------------------------------------------------------------
        -- MMS_COST_TEMP
        --------------------------------------------------------------------
        TRUNCATE TABLE SBCES.MmsCostTemp;

        INSERT INTO SBCES.MmsCostTemp
        (
            MmsNewCode,
            MmsNewCost
        )
        SELECT
            MmsStockCode,
            MmsNewCost
        FROM SBCES.StockCodedParts
        WHERE ISNULL(MmsNewCost,0)=0;

        UPDATE t
        SET t.MmsNewCost = b.MmsNewCost
        FROM SBCES.MmsCostTemp t
        INNER JOIN SBCES.StockCodedPartsBackup b
            ON RTRIM(t.MmsNewCode)=RTRIM(b.MmsStockCode);

        UPDATE s
        SET s.MmsNewCost = t.MmsNewCost
        FROM SBCES.StockCodedParts s
        INNER JOIN SBCES.MmsCostTemp t
            ON RTRIM(s.MmsStockCode)=RTRIM(t.MmsNewCode);

        --------------------------------------------------------------------
        -- NON_STOCK_CODED_PARTS
        --------------------------------------------------------------------
        INSERT INTO SBCES.NonStockCodedParts
        (
            OrigSupplierName,
            OrigSupplierNum,
            DetailedDesc,
            Keyword,
            DateEntered
        )
        SELECT
            RTRIM(a.BusinessName),
            a.VendorPartNumber,
            RTRIM(a.PartXdescEdLine),
            RTRIM(b.PartType),
            GETDATE()
        FROM SBCES.VendorPartDesc a,
             SBCES.StockCodedParts b,
             (
                SELECT DISTINCT RTRIM(OrigSupplierNum) AS OrigSupplierNum
                FROM SBCES.NonStockCodedParts
             ) c
        WHERE RTRIM(a.PartNumber)=RTRIM(b.MmsStockCode)
          AND a.VendorPartNumber <> ''
          AND RTRIM(a.VendorPartNumber) <> c.OrigSupplierNum;

        --------------------------------------------------------------------
        -- SC_OEMKITS_TEXT_DATA
        --------------------------------------------------------------------
        TRUNCATE TABLE SBCES.ScOemkitsTextData;

        INSERT INTO SBCES.ScOemkitsTextData
        (
            MmsNewCode,
            TextData
        )
        SELECT
            b.MmsStockCode,
            a.TextLineTx
        FROM SBCES.TextData a
        INNER JOIN SBCES.StockCodedParts b
            ON RTRIM(a.TextKey)=RTRIM(b.MmsStockCode)
        WHERE a.TextType='PM5P';

        --------------------------------------------------------------------
        -- Replace Oracle cursor with set-based update
        --------------------------------------------------------------------
        UPDATE spu
        SET spu.MmsCost = scp.MmsNewCost
        FROM SBCES.ScPartsUsed spu
        INNER JOIN SBCES.StockCodedParts scp
            ON RTRIM(spu.MmsStockCode)=RTRIM(scp.MmsStockCode)
        WHERE spu.RebuiltPart='N';

        --------------------------------------------------------------------
        -- KitsMasterlist
        --------------------------------------------------------------------
        UPDATE k
        SET k.EstimatedCost = s.MmsNewCost
        FROM SBCES.KitsMasterlist k
        INNER JOIN SBCES.StockCodedParts s
            ON RTRIM(k.PartNumber)=RTRIM(s.MmsStockCode);

    END TRY

    BEGIN CATCH

        DECLARE
            @ErrorMessage NVARCHAR(4000),
            @ErrorNumber INT,
            @ErrorSeverity INT,
            @ErrorState INT;

        SELECT
            @ErrorMessage = ERROR_MESSAGE(),
            @ErrorNumber = ERROR_NUMBER(),
            @ErrorSeverity = ERROR_SEVERITY(),
            @ErrorState = ERROR_STATE();

        THROW @ErrorNumber, @ErrorMessage, @ErrorState;

    END CATCH

END
GO
/****** Object:  StoredProcedure [SBCES].[InternalRbPrice]    Script Date: 9/17/2026 3:56:35 PM ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

CREATE PROCEDURE [SBCES].[InternalRbPrice]
AS
BEGIN
    SET NOCOUNT ON;

    -------------------------------------------------------------------------
    -- Counters
    -------------------------------------------------------------------------
    DECLARE @TotalRows          INT = 0;
    DECLARE @SuccessfulRows     INT = 0;
    DECLARE @RejectedRows       INT = 0;
    DECLARE @SourceErrors       INT = 0;
    DECLARE @InsertErrors       INT = 0;
    DECLARE @NullCostRows       INT = 0;

    -------------------------------------------------------------------------
    -- Variables
    -------------------------------------------------------------------------
    DECLARE @RebuiltStockNum      VARCHAR(30);
    DECLARE @MmsStockCode         VARCHAR(30);
    DECLARE @DetailedDesc         VARCHAR(250);
    DECLARE @RawBuyNewCost        VARCHAR(100);
    DECLARE @BuyNewCost           VARCHAR(30);
    DECLARE @Active               BIT;
    DECLARE @Keyword              VARCHAR(250);

    DECLARE @TotalPrice           DECIMAL(25,10);
    DECLARE @BuyNewCostNumeric    DECIMAL(25,10);

    DECLARE @DebugMessage         VARCHAR(2047);

    -------------------------------------------------------------------------
    -- Clear target
    -------------------------------------------------------------------------
    TRUNCATE TABLE SBCES.TempRbpCost;

    -------------------------------------------------------------------------
    -- Cursor
    -------------------------------------------------------------------------
    DECLARE rb_cursor CURSOR LOCAL FAST_FORWARD FOR

        SELECT
            RBM.RebuiltStockNum,
            SCP.MmsStockCode,
            RBM.DetailedDesc,

            -- Keep source value as VARCHAR.
            -- Do not perform numeric conversion here.
            CONVERT(VARCHAR(100), SCP.MmsNewCost) AS RawBuyNewCost,

            RBM.Active,
            RBM.Keyword

        FROM SBCES.RbMasterlist RBM

        LEFT JOIN SBCES.StockCodedParts SCP
            ON RBM.MmsStockCode = SCP.MmsStockCode

        ORDER BY RBM.RebuiltStockNum DESC;

    -------------------------------------------------------------------------
    -- Open cursor
    -------------------------------------------------------------------------
    OPEN rb_cursor;

    FETCH NEXT FROM rb_cursor
    INTO
        @RebuiltStockNum,
        @MmsStockCode,
        @DetailedDesc,
        @RawBuyNewCost,
        @Active,
        @Keyword;

    -------------------------------------------------------------------------
    -- Process rows
    -------------------------------------------------------------------------
    WHILE @@FETCH_STATUS = 0
    BEGIN

        SET @TotalRows = @TotalRows + 1;

        ---------------------------------------------------------------------
        -- Reset
        ---------------------------------------------------------------------
        SET @BuyNewCost = NULL;
        SET @BuyNewCostNumeric = NULL;
        SET @TotalPrice = NULL;

        ---------------------------------------------------------------------
        -- Current row
        ---------------------------------------------------------------------
        SET @DebugMessage =
            '[InternalRbPrice] Processing #' +
            CAST(@TotalRows AS VARCHAR(20)) +
            ' | RebuiltStockNum=[' +
            ISNULL(@RebuiltStockNum, '<NULL>') +
            '] | MmsStockCode=[' +
            ISNULL(@MmsStockCode, '<NULL>') +
            '] | RawMmsNewCost=[' +
            ISNULL(@RawBuyNewCost, '<NULL>') +
            ']';

        RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

        ---------------------------------------------------------------------
        -- Convert MmsNewCost safely
        ---------------------------------------------------------------------
        SET @BuyNewCostNumeric =
            TRY_CONVERT(
                DECIMAL(25,10),
                REPLACE(
                    REPLACE(
                        LTRIM(RTRIM(ISNULL(@RawBuyNewCost, ''))),
                        '$',
                        ''
                    ),
                    ',',
                    '.'
                )
            );

        ---------------------------------------------------------------------
        -- BAD SOURCE COST
        ---------------------------------------------------------------------
        IF @RawBuyNewCost IS NOT NULL
           AND LTRIM(RTRIM(@RawBuyNewCost)) <> ''
           AND @BuyNewCostNumeric IS NULL
        BEGIN

            SET @SourceErrors = @SourceErrors + 1;
            SET @RejectedRows = @RejectedRows + 1;

            SET @DebugMessage =
                '*** REJECTED - SOURCE NUMERIC ERROR ***' +
                ' | RebuiltStockNum=[' +
                ISNULL(@RebuiltStockNum, '<NULL>') +
                ']' +
                ' | MmsStockCode=[' +
                ISNULL(@MmsStockCode, '<NULL>') +
                ']' +
                ' | RawMmsNewCost=[' +
                ISNULL(@RawBuyNewCost, '<NULL>') +
                ']' +
                ' | Reason=[MmsNewCost cannot be converted to DECIMAL]';

            RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

            FETCH NEXT FROM rb_cursor
            INTO
                @RebuiltStockNum,
                @MmsStockCode,
                @DetailedDesc,
                @RawBuyNewCost,
                @Active,
                @Keyword;

            CONTINUE;
        END;

        ---------------------------------------------------------------------
        -- NULL / BLANK SOURCE COST
        ---------------------------------------------------------------------
        IF @RawBuyNewCost IS NULL
           OR LTRIM(RTRIM(@RawBuyNewCost)) = ''
        BEGIN

            SET @NullCostRows = @NullCostRows + 1;

            SET @BuyNewCost = '0.00';
            SET @BuyNewCostNumeric = 0;

            SET @DebugMessage =
                '[InternalRbPrice] NULL/BLANK COST -> 0.00' +
                ' | RebuiltStockNum=[' +
                ISNULL(@RebuiltStockNum, '<NULL>') +
                ']' +
                ' | MmsStockCode=[' +
                ISNULL(@MmsStockCode, '<NULL>') +
                ']';

            RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;
        END
        ELSE
        BEGIN

            -----------------------------------------------------------------
            -- Valid numeric cost
            -----------------------------------------------------------------
            SET @BuyNewCost =
                CONVERT(
                    VARCHAR(30),
                    CAST(
                        ROUND(@BuyNewCostNumeric, 2)
                        AS DECIMAL(25,2)
                    )
                );

            SET @BuyNewCost = LTRIM(RTRIM(@BuyNewCost));

        END;

        ---------------------------------------------------------------------
        -- RptRbpCost
        ---------------------------------------------------------------------
        /*
        EXEC SBCES.RptRbpCost
            @viRbnum     = UPPER(@RebuiltStockNum),
            @viLinkType  = 'RB',
            @voTotalCost = @TotalPrice OUTPUT;
        */

        ---------------------------------------------------------------------
        -- INSERT
        ---------------------------------------------------------------------
        BEGIN TRY

            INSERT INTO SBCES.TempRbpCost
            VALUES
            (
                @RebuiltStockNum,
                @TotalPrice,
                @DetailedDesc,
                @BuyNewCost,
                @Active,
                @Keyword
            );

            SET @SuccessfulRows = @SuccessfulRows + 1;

        END TRY
        BEGIN CATCH

            SET @InsertErrors = @InsertErrors + 1;
            SET @RejectedRows = @RejectedRows + 1;

            -----------------------------------------------------------------
            -- VERY IMPORTANT:
            -- Print every value participating in the INSERT.
            -----------------------------------------------------------------
            SET @DebugMessage =
                '*** REJECTED - INSERT ERROR ***' +
                ' | Row#=' +
                CAST(@TotalRows AS VARCHAR(20)) +

                ' | RebuiltStockNum=[' +
                ISNULL(@RebuiltStockNum, '<NULL>') +
                ']' +

                ' | MmsStockCode=[' +
                ISNULL(@MmsStockCode, '<NULL>') +
                ']' +

                ' | DetailedDesc=[' +
                ISNULL(@DetailedDesc, '<NULL>') +
                ']' +

                ' | RawMmsNewCost=[' +
                ISNULL(@RawBuyNewCost, '<NULL>') +
                ']' +

                ' | BuyNewCost=[' +
                ISNULL(@BuyNewCost, '<NULL>') +
                ']' +

                ' | BuyNewCostNumeric=[' +
                ISNULL(CONVERT(VARCHAR(50), @BuyNewCostNumeric), '<NULL>') +
                ']' +

                ' | TotalPrice=[' +
                ISNULL(CONVERT(VARCHAR(50), @TotalPrice), '<NULL>') +
                ']' +

                ' | Active=[' +
                ISNULL(CONVERT(VARCHAR(10), @Active), '<NULL>') +
                ']' +

                ' | Keyword=[' +
                ISNULL(@Keyword, '<NULL>') +
                ']' +

                ' | ERROR=[' +
                ISNULL(ERROR_MESSAGE(), '<UNKNOWN>') +
                ']';

            RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

        END CATCH;

        ---------------------------------------------------------------------
        -- Next row
        ---------------------------------------------------------------------
        FETCH NEXT FROM rb_cursor
        INTO
            @RebuiltStockNum,
            @MmsStockCode,
            @DetailedDesc,
            @RawBuyNewCost,
            @Active,
            @Keyword;

    END;

    -------------------------------------------------------------------------
    -- Cleanup
    -------------------------------------------------------------------------
    CLOSE rb_cursor;
    DEALLOCATE rb_cursor;

    -------------------------------------------------------------------------
    -- FINAL SUMMARY
    -------------------------------------------------------------------------
    RAISERROR('', 10, 1) WITH NOWAIT;

    SET @DebugMessage =
        '============================================================';

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

    SET @DebugMessage =
        '[InternalRbPrice] FINAL SUMMARY';

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

    SET @DebugMessage =
        'Total Rows Processed       = ' +
        CAST(@TotalRows AS VARCHAR(20));

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

    SET @DebugMessage =
        'Successfully Inserted      = ' +
        CAST(@SuccessfulRows AS VARCHAR(20));

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

    SET @DebugMessage =
        'Total Rejected             = ' +
        CAST(@RejectedRows AS VARCHAR(20));

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

    SET @DebugMessage =
        'Source Conversion Errors   = ' +
        CAST(@SourceErrors AS VARCHAR(20));

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

    SET @DebugMessage =
        'Insert Errors              = ' +
        CAST(@InsertErrors AS VARCHAR(20));

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

    SET @DebugMessage =
        'NULL/Blank Cost Rows       = ' +
        CAST(@NullCostRows AS VARCHAR(20));

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

    SET @DebugMessage =
        '============================================================';

    RAISERROR('%s', 10, 1, @DebugMessage) WITH NOWAIT;

END;
GO
