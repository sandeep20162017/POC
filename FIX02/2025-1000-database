                EXEC sys.sp_executesql @sql;

                FETCH NEXT FROM RB_CURSOR
                INTO @LinkCode, @Qty, @PercentUsage, @RebuiltCode;
            END

            CLOSE RB_CURSOR;
            DEALLOCATE RB_CURSOR;
        END

        PRINT 'DEBUG: WriteMaterials END for ' + @ViIdnum;

    END TRY
