CREATE   PROCEDURE [SBCES].[WriteMaterials]
(
      @ViIdnum VARCHAR(30)
    , @ViAdjustment DECIMAL(18,6)
    , @ViRbReference VARCHAR(25)
    , @ViAdjustment2 DECIMAL(18,6)
)
AS
BEGIN
    SET NOCOUNT ON;

    PRINT '====================================================';
    PRINT 'DEBUG: WriteMaterials START';
    PRINT ' @ViIdnum      = ' + ISNULL(@ViIdnum,'NULL');
    PRINT ' @ViAdjustment = ' + CAST(ISNULL(@ViAdjustment,0) AS VARCHAR(50));
    PRINT ' @ViRbReference= ' + ISNULL(@ViRbReference,'NULL');
    PRINT ' @ViAdjustment2= ' + CAST(ISNULL(@ViAdjustment2,0) AS VARCHAR(50));
    PRINT '====================================================';

    DECLARE @VPrice INT;

    BEGIN TRY

        ------------------------------------------------------------
        -- DEBUG: Show raw source rows
        ------------------------------------------------------------
        PRINT 'DEBUG: Raw ScPartsUsed rows for ' + @ViIdnum;
        SELECT * FROM SBCES.ScPartsUsed
        WHERE LinkType='RB' AND UPPER(LinkCode)=UPPER(@ViIdnum);

        PRINT 'DEBUG: Raw NscPartsUsed rows for ' + @ViIdnum;
        SELECT * FROM SBCES.NscPartsUsed
        WHERE LinkType='RB' AND UPPER(LinkCode)=UPPER(@ViIdnum);

        ------------------------------------------------------------
        -- DEBUG: Show computed material rows BEFORE INSERT
        ------------------------------------------------------------
        PRINT 'DEBUG: Material cost rows BEFORE INSERT';

        SELECT
              ISNULL(CC.Name,'NONE') AS AssemblyArea
            , ISNULL(M.CostCentre,'0') AS CostCentre
            , ROUND(M.TotalCost * @ViAdjustment,2) AS TotalCost
            , M.TaxableCost * @ViAdjustment AS TaxableCost
            , @ViRbReference AS RbReference
            , @ViAdjustment2 * M.TotalCost AS TotalUnitCost
        FROM
        (
            SELECT
                  A.CostCentre
                , SUM(A.Cost) AS TotalCost
                , SUM(A.TaxCost) AS TaxableCost
            FROM
            (
                ----------------------------------------------------------
                -- Stock Parts
                ----------------------------------------------------------
                SELECT
                      SPU.CostCentre
                    ,
                      CAST(
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    SPU.PercentUsage,
                                    SPU.QtyReqd,
                                    SPU.MmsCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                            -
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    SPU.PercentUsage,
                                    SPU.QtyReqd,
                                    SPU.CoreCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                      AS DECIMAL(18,2)) AS Cost
                    ,
                      CAST(
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    SPU.PercentUsage,
                                    SPU.QtyReqd,
                                    SPU.MmsCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                      AS DECIMAL(18,2)) AS TaxCost
                FROM SBCES.ScPartsUsed SPU
                WHERE SPU.LinkCode = UPPER(@ViIdnum)
                  AND SPU.RebuiltPart = 'N'
                  AND SPU.LinkType = 'RB'

                UNION ALL

                ----------------------------------------------------------
                -- Non Stock Parts
                ----------------------------------------------------------
                SELECT
                      NSPU.CostCentre
                    ,
                      CAST(
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    NSPU.PercentUsage,
                                    NSPU.QtyReqd,
                                    NSCP.OemPartCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                            -
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    NSPU.PercentUsage,
                                    NSPU.QtyReqd,
                                    NSPU.CoreCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                      AS DECIMAL(18,2)) AS Cost
                    ,
                      CAST(
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    NSPU.PercentUsage,
                                    NSPU.QtyReqd,
                                    NSCP.OemPartCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                      AS DECIMAL(18,2)) AS TaxCost
                FROM SBCES.NscPartsUsed NSPU
                LEFT JOIN SBCES.NonStockCodedParts NSCP
                    ON NSCP.Id = NSPU.Id
                WHERE NSPU.LinkCode = UPPER(@ViIdnum)
                  AND NSPU.LinkType = 'RB'

            ) A
            GROUP BY A.CostCentre
        ) M
        LEFT JOIN SBCES.CostCentres CC
            ON CC.CostCentre = M.CostCentre;

        ------------------------------------------------------------
        -- DEBUG: Now perform actual INSERT
        ------------------------------------------------------------
        PRINT 'DEBUG: Performing INSERT into TempMaterialsList';

        INSERT INTO SBCES.TempMaterialsList
        (
              AssemblyArea
            , CostCentre
            , TotalCost
            , TaxableCost
            , RbReference
            , TotalUnitCost
        )
        SELECT
              ISNULL(CC.Name,'NONE')
            , ISNULL(M.CostCentre,'0')
            , CAST(ROUND(M.TotalCost * @ViAdjustment,2) AS VARCHAR(25))
            , CAST(M.TaxableCost * @ViAdjustment AS VARCHAR(25))
            , @ViRbReference
            , CAST(@ViAdjustment2 * M.TotalCost AS VARCHAR(25))
        FROM
        (
            SELECT
                  A.CostCentre
                , SUM(A.Cost) AS TotalCost
                , SUM(A.TaxCost) AS TaxableCost
            FROM
            (
                ----------------------------------------------------------
                -- Stock Parts
                ----------------------------------------------------------
                SELECT
                      SPU.CostCentre
                    ,
                      CAST(
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    SPU.PercentUsage,
                                    SPU.QtyReqd,
                                    SPU.MmsCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                            -
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    SPU.PercentUsage,
                                    SPU.QtyReqd,
                                    SPU.CoreCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                      AS DECIMAL(18,2)) AS Cost
                    ,
                      CAST(
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    SPU.PercentUsage,
                                    SPU.QtyReqd,
                                    SPU.MmsCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                      AS DECIMAL(18,2)) AS TaxCost
                FROM SBCES.ScPartsUsed SPU
                WHERE SPU.LinkCode = UPPER(@ViIdnum)
                  AND SPU.RebuiltPart = 'N'
                  AND SPU.LinkType = 'RB'

                UNION ALL

                ----------------------------------------------------------
                -- Non Stock Parts
                ----------------------------------------------------------
                SELECT
                      NSPU.CostCentre
                    ,
                      CAST(
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    NSPU.PercentUsage,
                                    NSPU.QtyReqd,
                                    NSCP.OemPartCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                            -
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    NSPU.PercentUsage,
                                    NSPU.QtyReqd,
                                    NSPU.CoreCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                      AS DECIMAL(18,2)) AS Cost
                    ,
                      CAST(
                            ISNULL(
                                TRY_CAST(SBCES.FinalCost(
                                    NSPU.PercentUsage,
                                    NSPU.QtyReqd,
                                    NSCP.OemPartCost,
                                    0
                                ) AS DECIMAL(18,6)),0)
                      AS DECIMAL(18,2)) AS TaxCost
                FROM SBCES.NscPartsUsed NSPU
                LEFT JOIN SBCES.NonStockCodedParts NSCP
                    ON NSCP.Id = NSPU.Id
                WHERE NSPU.LinkCode = UPPER(@ViIdnum)
                  AND NSPU.LinkType = 'RB'

            ) A
            GROUP BY A.CostCentre
        ) M
        LEFT JOIN SBCES.CostCentres CC
            ON CC.CostCentre = M.CostCentre;

        ------------------------------------------------------------
        -- DEBUG: Check for recursive rebuilt parts
        ------------------------------------------------------------
        PRINT 'DEBUG: Checking for recursive rebuilt parts';

        SELECT @VPrice = COUNT(*)
        FROM SBCES.ScPartsUsed
        WHERE RebuiltPart='Y'
          AND LinkType='RB'
          AND UPPER(LinkCode)=UPPER(@ViIdnum);

        PRINT 'DEBUG: RebuiltPart count = ' + CAST(@VPrice AS VARCHAR(20));

        IF @VPrice > 0
        BEGIN
            PRINT 'DEBUG: Entering recursion block';

            DECLARE
                  @LinkCode VARCHAR(30)
                , @Qty DECIMAL(18,6)
                , @PercentUsage DECIMAL(18,6)
                , @RebuiltCode VARCHAR(30);

            DECLARE RB_CURSOR CURSOR LOCAL FAST_FORWARD FOR
                SELECT DISTINCT
                      UPPER(LinkCode)
                    , CAST(QtyReqd AS DECIMAL(18,6))
                    , CAST(PercentUsage AS DECIMAL(18,6))
                    , UPPER(MmsRebuiltCode)
                FROM SBCES.ScPartsUsed
                WHERE RebuiltPart='Y'
                  AND LinkType='RB'
                  AND UPPER(LinkCode)=UPPER(@ViIdnum);

            OPEN RB_CURSOR;

            FETCH NEXT FROM RB_CURSOR
            INTO @LinkCode, @Qty, @PercentUsage, @RebuiltCode;

            WHILE @@FETCH_STATUS = 0
            BEGIN
                PRINT '----------------------------------------------------';
                PRINT 'DEBUG: Recursive Call';
                PRINT ' LinkCode      = ' + @LinkCode;
                PRINT ' Qty           = ' + CAST(@Qty AS VARCHAR(50));
                PRINT ' PercentUsage  = ' + CAST(@PercentUsage AS VARCHAR(50));
                PRINT ' RebuiltCode   = ' + @RebuiltCode;

                DECLARE @sql NVARCHAR(MAX);

                SET @sql = N'
                    EXEC SBCES.WriteMaterials
                         @ViIdnum = ''' + @RebuiltCode + ''',
                         @ViAdjustment = ' + CAST((@Qty * @PercentUsage / 100.0) * @ViAdjustment AS VARCHAR(50)) + ',
