CREATE   FUNCTION [SBCES].[GetNewCost]
(
    @LaCost NUMERIC(15,5),
    @WaCost NUMERIC(15,5)
)
RETURNS NUMERIC(15,5)
AS
BEGIN
    DECLARE @Result NUMERIC(15,5);

    IF @LaCost > 0.001
        SET @Result = @LaCost;
    ELSE
        SET @Result = @WaCost;

    RETURN @Result;
