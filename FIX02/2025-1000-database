CREATE   VIEW [SBCES].[ViewNscMaterialList]
(
    OrigSuppNum,
    OrigSupplierName,
    CostCentre,
    QtyReqd,
    PercentUsage,
    DateEntered,
    EnteredBy,
    LastModifiedBy,
    LastModifiedDate,
    LinkCode,
    Cost,
    LinkType,
    CoreCost,
    FinalCost,
    Keyword,
    DetailedDesc,
    AdjQty
)
AS
SELECT
    B.OrigSupplierNum,
    B.OrigSupplierName,
    A.CostCentre,
    A.QtyReqd,
    A.PercentUsage,
    A.DateEntered,
    A.EnteredBy,
    A.LastModifiedBy,
    A.LastModifiedDate,
    A.LinkCode,
    B.OemPartCost AS Cost,
    A.LinkType,
    CAST(SBCES.FinalCost(A.PercentUsage, A.QtyReqd, A.CoreCost, 0) AS DECIMAL(18,4)) AS CoreCost,
    SBCES.FinalCost(A.PercentUsage, A.QtyReqd, B.OemPartCost, 0) AS FinalCost,
    B.Keyword,
    B.DetailedDesc,
    SBCES.FinalCost(A.PercentUsage, A.QtyReqd, 1, 0) AS AdjQty
FROM SBCES.NscPartsUsed A
JOIN SBCES.NonStockCodedParts B
    ON A.Id = B.Id;
