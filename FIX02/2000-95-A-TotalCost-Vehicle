    .vehicle-info-item .value {
        font-size: 18px;
        font-weight: 600;
        color: #1a5276;
        margin-top: 2px;
    }

    /* ===== SUMMARY CARDS ===== */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
    }

    .summary-card {
        background: #f8f9fa;
        padding: 12px 15px;
        border-radius: 6px;
        text-align: center;
        border: 1px solid #e9ecef;
        transition: all 0.2s;
    }

    .summary-card:hover {
        background: #e8f0fe;
        border-color: #1a5276;
    }

    .summary-card .value {
        font-size: 22px;
        font-weight: 700;
        color: #1a5276;
        display: block;
    }

    .summary-card .value.green { color: #27ae60; }
    .summary-card .value.blue { color: #2980b9; }
    .summary-card .value.orange { color: #e67e22; }
    .summary-card .value.purple { color: #8e44ad; }

    .summary-card .label {
        font-size: 11px;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 4px;
        display: block;
    }

    /* ===== MATERIAL LINES TABLE ===== */
    .material-table-wrap {
        overflow-x: auto;
        margin-top: 5px;
    }

    .material-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .material-table th {
        background: #2c3e50;
        color: white;
        padding: 10px 12px;
        text-align: left;
        font-weight: 600;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .material-table td {
        padding: 8px 12px;
        border-bottom: 1px solid #e0e4e8;
    }

    .material-table tr:hover td {
        background: #f8f9fa;
    }

    /* Row type colors */
    .material-table tr.type-stock td:first-child {
        border-left: 3px solid #27ae60;
    }
    .material-table tr.type-rebuilt td:first-child {
        border-left: 3px solid #e67e22;
    }
    .material-table tr.type-nonstock td:first-child {
        border-left: 3px solid #2980b9;
    }

    .material-table .type-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }
    .type-badge.stock { background: #d5f5e3; color: #1a7a3a; }
    .type-badge.rebuilt { background: #fdebd0; color: #a04000; }
    .type-badge.nonstock { background: #d6eaf8; color: #1a5276; }

    .material-table .total-row td {
        background: #e8f0fe;
        font-weight: 700;
        border-top: 2px solid #2c3e50;
        padding-top: 12px;
    }

    .material-table .subtotal-row td {
        background: #f0f3f7;
        font-weight: 600;
        border-top: 1px solid #cbd5e1;
    }

    .material-table .subtotal-row td:first-child {
        padding-left: 20px;
    }

    /* ===== TASK TABLE ===== */
    .task-table-wrap {
        overflow-x: auto;
        margin-top: 5px;
    }

    .task-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .task-table th {
        background: #2c3e50;
        color: white;
        padding: 10px 12px;
        text-align: left;
        font-weight: 600;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .task-table td {
        padding: 8px 12px;
        border-bottom: 1px solid #e0e4e8;
    }

    .task-table tr:hover td {
        background: #f8f9fa;
    }

    .task-table .total-row td {
        background: #e8f0fe;
        font-weight: 700;
        border-top: 2px solid #2c3e50;
        padding-top: 12px;
    }

    .task-table .text-right { text-align: right; }
    .task-table .text-center { text-align: center; }

    /* ===== SIDE BY SIDE ===== */
    .side-by-side {
        display: flex;
        gap: 30px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .material-section, .labour-section {
        flex: 1;
        min-width: 300px;
        background: #ffffff;
        border: 2px solid #2c3e50;
        border-radius: 8px;
        overflow: hidden;
    }

    .material-header, .labour-header {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 12px 20px;
        font-size: 16px;
        font-weight: 700;
        text-align: center;
        letter-spacing: 1px;
    }

    .material-body, .labour-body {
        padding: 15px 20px;
    }

    /* ===== INFO TABLE ===== */
    .info-table {
        width: 100%;
        border-collapse: collapse;
    }

    .info-table tr {
        border-bottom: 1px solid #e0e4e8;
    }
    .info-table tr:last-child { border-bottom: none; }

    .info-table td {
