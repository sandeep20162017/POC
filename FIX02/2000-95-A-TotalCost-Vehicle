        [HttpGet]
        [AllowAnonymous]
        public async Task<IActionResult> GetTotalCostInEstimates([DataSourceRequest] DataSourceRequest request, [FromQuery] string id, [FromQuery] string gridType)
        {
            if (string.IsNullOrEmpty(id))
            {
                return BadRequest("id is required for gridType :" + gridType);
            }

            if (gridType == "RebuiltGrid")
            {
                var rbNscModel = await GetTotalCostInRBEstimates(id, gridType);
                return Json(rbNscModel.ToDataSourceResult(request));
            }
            if (gridType == "VehicleGrid")
            {
                var vehNscmodel = await GetTotalCostInVehicleEstimatesWithDetails(id, gridType);
                return Json(vehNscmodel.ToDataSourceResult(request));
            }
            if (gridType == "ArchivedVehicleGrid")
            {
                var vehArchNscmodel = await GetTotalCostInArchVehicleEstimates(id, gridType);
                return Json(vehArchNscmodel.ToDataSourceResult(request));
            }
            if (gridType == "MakeVsBuyGrid")
            {
                var vehNscmodel = await GetTotalCostInMbEstimates(id, gridType);
                return Json(vehNscmodel.ToDataSourceResult(request));
            }
            if (gridType == "ArchivedMakeVsBuyGrid")
            {
                return StatusCode(500, "An error occurred while fetching data. Implement this.");
            }
            if (gridType == "ArchivedRebuiltGrid")
            {
                return StatusCode(500, "An error occurred while fetching data. Implement this.");
            }
            return StatusCode(500, "An error occurred while fetching data.");
        }

        private async Task<IEnumerable<TotalCostInEstimates>> GetTotalCostInVehicleEstimatesWithDetails(string id, string gridType)
        {
            try
            {
                string query = @"DECLARE @LinkCode VARCHAR(30) = '" + id + @"'

                BEGIN TRY
                    -- Get settings
                    DECLARE @TaxRate DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'TAX_RATE'), '0'), ',', '.') AS DECIMAL(18,6));
                    DECLARE @Fringe DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'FRINGE'), '0'), ',', '.') AS DECIMAL(18,6));
                    DECLARE @Benefit DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'BENEFIT'), '0'), ',', '.') AS DECIMAL(18,6));
                    DECLARE @Overhead DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'OVERHEAD'), '0'), ',', '.') AS DECIMAL(18,6));
                    DECLARE @NonProductiveAdj DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'NON_PRODUCTIVE_ADJUSTMENT'), '1'), ',', '.') AS DECIMAL(18,6));

                    -- Vehicle Details
                    DECLARE @VehicleDesc NVARCHAR(500) = (SELECT ISNULL(ProjDesc, 'N/A') FROM SBCES.VehicleList WHERE VehicleListId = @LinkCode);
                    DECLARE @VehicleSeries NVARCHAR(100) = (SELECT ISNULL(VehSeriesCode, 'N/A') FROM SBCES.VehicleList WHERE VehicleListId = @LinkCode);

                    -- Material Cost CTE
                    WITH MaterialCost AS (
                        SELECT 
                            ISNULL((
                                SELECT SUM(CASE WHEN SUS.RebuiltPart = 'N' AND SUS.LinkType = 'BUS' AND SUS.LinkCode = @LinkCode
                                    THEN TRY_CAST(SBCES.FinalCost(CAST(ISNULL(SUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(SUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(SCP.MmsNewCost, 0), 0) AS DECIMAL(18,2))
                                    ELSE 0 END)
                                FROM SBCES.ScPartsUsed SUS
                                LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
                                WHERE SUS.LinkCode = @LinkCode
                            ), 0) AS SCPartsMaterialCost,

                            ISNULL((
                                SELECT SUM(CASE WHEN SUS.RebuiltPart = 'Y' AND SUS.LinkType = 'BUS' AND SUS.LinkCode = @LinkCode
                                    THEN TRY_CAST(SBCES.FinalCost(CAST(ISNULL(SUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(SUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(SUS.MmsCost, 0), 0) AS DECIMAL(18,2))
                                    ELSE 0 END)
                                FROM SBCES.ScPartsUsed SUS
                                LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
                                WHERE SUS.LinkType = 'BUS' AND SUS.LinkCode = @LinkCode
                            ), 0) AS RBPartsMaterialCost,

                            ISNULL((
                                SELECT SUM(CASE WHEN NSUS.LinkType = 'BUS' AND NSUS.LinkCode = @LinkCode
                                    THEN TRY_CAST(SBCES.FinalCost(CAST(ISNULL(NSUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(NSUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(NSUS.Cost, 0), 0) AS DECIMAL(18,2))
                                    ELSE 0 END)
                                FROM SBCES.NscPartsUsed NSUS WHERE NSUS.LinkCode = @LinkCode
                            ), 0) AS NSCSCPartsMaterialCost,

                            -- Counts for summary
                            (SELECT COUNT(*) FROM SBCES.ScPartsUsed WHERE LinkCode = @LinkCode AND LinkType = 'BUS' AND RebuiltPart = 'N') AS StockPartsCount,
                            (SELECT COUNT(*) FROM SBCES.NscPartsUsed WHERE LinkCode = @LinkCode AND LinkType = 'BUS') AS NonStockPartsCount,
                            (SELECT COUNT(*) FROM SBCES.ScPartsUsed WHERE LinkCode = @LinkCode AND LinkType = 'BUS' AND RebuiltPart = 'Y') AS RebuiltPartsCount,

                            -- Average costs
                            ISNULL((SELECT AVG(TRY_CAST(SCP.MmsNewCost AS DECIMAL(18,2))) 
                                FROM SBCES.ScPartsUsed SUS
                                LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
                                WHERE SUS.LinkCode = @LinkCode AND SUS.LinkType = 'BUS' AND SUS.RebuiltPart = 'N'), 0) AS AvgStockCost,

                            ISNULL((SELECT AVG(TRY_CAST(NSUS.Cost AS DECIMAL(18,2))) 
                                FROM SBCES.NscPartsUsed NSUS 
                                WHERE NSUS.LinkCode = @LinkCode AND NSUS.LinkType = 'BUS'), 0) AS AvgNonStockCost,

                            ISNULL((SELECT AVG(TRY_CAST(SUS.MmsCost AS DECIMAL(18,2))) 
                                FROM SBCES.ScPartsUsed SUS 
                                WHERE SUS.LinkCode = @LinkCode AND SUS.LinkType = 'BUS' AND SUS.RebuiltPart = 'Y'), 0) AS AvgRebuiltCost
                    ),
                    
                    -- Labour calculation
                    LabourRows AS (
                        SELECT
                            (CAST(ISNULL(LEFT(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) - 1), 0) AS DECIMAL(18,2)) + 
                             CAST(ISNULL(SUBSTRING(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) + 1, LEN(EL.HrsReqd)), 0) AS DECIMAL(18,2)) / 60) AS DecimalHrs,

                            ((CAST(ISNULL(LEFT(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) - 1), 0) AS DECIMAL(18,2)) + 
                              CAST(ISNULL(SUBSTRING(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) + 1, LEN(EL.HrsReqd)), 0) AS DECIMAL(18,2)) / 60)
                              * CAST(NULLIF(EL.Usage, '') AS DECIMAL(18,2)) / 100) AS EffectiveHours,

                            ISNULL((SELECT TOP 1 ES.RatePerHour FROM CES.SBCES.EmployeeSalaries ES
                                    WHERE ES.WageGroup = (SELECT TOP 1 EC.WageGroup FROM CES.SBCES.EmplClass EC
                                                          WHERE EC.LabourDefn LIKE '%' + EL.LabourDefn + '%')), 0) AS LabourRate,

                            (((CAST(ISNULL(LEFT(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) - 1), 0) AS DECIMAL(18,2)) + 
                               CAST(ISNULL(SUBSTRING(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) + 1, LEN(EL.HrsReqd)), 0) AS DECIMAL(18,2)) / 60)
                               * CAST(NULLIF(EL.Usage, '') AS DECIMAL(18,2)) / 100) 
                              / @NonProductiveAdj
                              * ISNULL((SELECT TOP 1 ES.RatePerHour FROM CES.SBCES.EmployeeSalaries ES
                                        WHERE ES.WageGroup = (SELECT TOP 1 EC.WageGroup FROM CES.SBCES.EmplClass EC
                                                              WHERE EC.LabourDefn LIKE '%' + EL.LabourDefn + '%')), 0)) AS LabourCost,

                            EL.LabourDefn,
                            EL.Task,
                            EL.HrsReqd,
                            EL.Usage,
                            EL.TimeAddition
                        FROM SBCES.EmployeeLabour EL
                        WHERE EL.LinkNumber = @LinkCode AND EL.TypeId = 'BUS'
                    ),

                    LabourCost AS (
                        SELECT
                            SUM(LabourCost) AS TotalLabourCost,
                            SUM(DecimalHrs) AS TotalHours,
                            SUM(EffectiveHours) AS TotalEffectiveHours,
                            SUM(DecimalHrs / @NonProductiveAdj) AS TotalAdjustedHours
                        FROM LabourRows
                    ),

                    -- Labour Task Summary grouped by Task
                    LabourTaskSummary AS (
                        SELECT 
                            ISNULL(Task, 'Unnamed Task') AS Task,
                            ISNULL(LabourDefn, 'N/A') AS LabourDefn,
                            COUNT(*) AS TaskCount,
                            SUM(DecimalHrs) AS TaskHours,
                            SUM(EffectiveHours) AS TaskEffectiveHours,
                            SUM(DecimalHrs / @NonProductiveAdj) AS TaskAdjustedHours,
                            AVG(LabourRate) AS AvgRate,
                            SUM(LabourCost) AS TaskCost
                        FROM LabourRows
                        GROUP BY Task, LabourDefn
                    ),

                    -- Material Lines for individual display
                    StockMaterialLines AS (
                        SELECT 
                            'Stock' AS Type,
                            SUS.MMSStockCode AS StockCode,
                            ISNULL(SCP.SCDescription, 'N/A') AS Description,
                            SUS.QtyReqd AS Quantity,
                            ISNULL(SCP.MmsNewCost, 0) AS UnitCost,
                            SUS.PercentUsage,
                            TRY_CAST(SBCES.FinalCost(CAST(ISNULL(SUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(SUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(SCP.MmsNewCost, 0), 0) AS DECIMAL(18,2)) AS TotalCost,
                            '' AS Supplier
                        FROM SBCES.ScPartsUsed SUS
                        LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
                        WHERE SUS.LinkCode = @LinkCode AND SUS.LinkType = 'BUS' AND SUS.RebuiltPart = 'N'
                    ),
                    RebuiltMaterialLines AS (
                        SELECT 
                            'Rebuilt' AS Type,
                            SUS.MMSStockCode AS StockCode,
                            ISNULL(SCP.SCDescription, 'N/A') AS Description,
                            SUS.QtyReqd AS Quantity,
                            ISNULL(SUS.MmsCost, 0) AS UnitCost,
                            SUS.PercentUsage,
                            TRY_CAST(SBCES.FinalCost(CAST(ISNULL(SUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(SUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(SUS.MmsCost, 0), 0) AS DECIMAL(18,2)) AS TotalCost,
                            '' AS Supplier
                        FROM SBCES.ScPartsUsed SUS
                        LEFT JOIN SBCES.StockCodedParts SCP ON SUS.MMSStockCode = SCP.MMSStockCode
                        WHERE SUS.LinkCode = @LinkCode AND SUS.LinkType = 'BUS' AND SUS.RebuiltPart = 'Y'
                    ),
                    NSCMaterialLines AS (
                        SELECT 
                            'Non-Stock' AS Type,
                            NSUS.OrigSuppNum AS StockCode,
                            ISNULL(NSUS.OrigSupplierName, 'N/A') AS Description,
                            NSUS.QtyReqd AS Quantity,
                            ISNULL(NSUS.Cost, 0) AS UnitCost,
                            NSUS.PercentUsage,
                            TRY_CAST(SBCES.FinalCost(CAST(ISNULL(NSUS.PercentUsage,'0') AS VARCHAR(20)), CAST(ISNULL(NSUS.QtyReqd,'0') AS VARCHAR(20)), ISNULL(NSUS.Cost, 0), 0) AS DECIMAL(18,2)) AS TotalCost,
                            ISNULL(NSUS.OrigSupplierName, '') AS Supplier
                        FROM SBCES.NscPartsUsed NSUS
                        WHERE NSUS.LinkCode = @LinkCode AND NSUS.LinkType = 'BUS'
                    ),
                    AllMaterialLines AS (
                        SELECT * FROM StockMaterialLines
                        UNION ALL
                        SELECT * FROM RebuiltMaterialLines
                        UNION ALL
                        SELECT * FROM NSCMaterialLines
                    ),

                    FinalCalc AS (
                        SELECT 
                            MC.*,
                            LC.TotalLabourCost,
                            LC.TotalHours,
                            LC.TotalEffectiveHours,
                            LC.TotalAdjustedHours,
                            LC.TotalLabourCost * @Fringe AS LabourFringe,
                            (LC.TotalLabourCost + (LC.TotalLabourCost * @Fringe)) * @Benefit AS LabourBenefits,
                            CASE WHEN LC.TotalLabourCost = 0 THEN 0 
                                 ELSE ((LC.TotalLabourCost * @Fringe) + ((LC.TotalLabourCost + (LC.TotalLabourCost * @Fringe)) * @Benefit)) / LC.TotalLabourCost 
                            END AS BlendedFringeBenefitPercent,
                            ((LC.TotalLabourCost * @Fringe) + ((LC.TotalLabourCost + (LC.TotalLabourCost * @Fringe)) * @Benefit)) AS BlendedFringeBenefitCost,
                            LC.TotalLabourCost * @Overhead AS LabourOverhead,
                            LC.TotalLabourCost + ((LC.TotalLabourCost * @Fringe) + ((LC.TotalLabourCost + (LC.TotalLabourCost * @Fringe)) * @Benefit)) + (LC.TotalLabourCost * @Overhead) AS FinalLabourCost
                        FROM MaterialCost MC
                        CROSS JOIN LabourCost LC
                    )

                    SELECT
                        @LinkCode AS LinkCode,
                        @VehicleDesc AS VehicleDescription,
                        @VehicleSeries AS VehicleSeries,
                        
                        -- Material costs
                        MC.SCPartsMaterialCost,
                        MC.NSCSCPartsMaterialCost,
                        MC.RBPartsMaterialCost,
                        CAST(MC.SCPartsMaterialCost + MC.RBPartsMaterialCost + MC.NSCSCPartsMaterialCost AS DECIMAL(18,2)) AS MaterialTotalCostNoTax,
                        CAST((MC.SCPartsMaterialCost + MC.RBPartsMaterialCost + MC.NSCSCPartsMaterialCost) * @TaxRate AS DECIMAL(18,2)) AS MaterialTotalTaxAmount,
                        CAST((MC.SCPartsMaterialCost + MC.RBPartsMaterialCost + MC.NSCSCPartsMaterialCost) * (1 + @TaxRate) AS DECIMAL(18,2)) AS MaterialTotalWithTax,

                        -- Labour
                        CAST(FC.TotalLabourCost AS DECIMAL(18,2)) AS TotalLabourCost,
                        CAST(FC.LabourFringe AS DECIMAL(18,2)) AS LabourFringe,
                        CAST(FC.LabourBenefits AS DECIMAL(18,2)) AS LabourBenefits,
                        CAST(FC.BlendedFringeBenefitPercent * 100 AS DECIMAL(18,2)) AS BlendedFringeBenefitPercent,
                        CAST(FC.BlendedFringeBenefitCost AS DECIMAL(18,2)) AS BlendedFringeBenefitCost,
                        CAST(FC.LabourOverhead AS DECIMAL(18,2)) AS LabourOverhead,
                        CAST(FC.FinalLabourCost AS DECIMAL(18,2)) AS FinalLabourCost,

                        -- Labour Hours Summary
                        CAST(FC.TotalHours AS DECIMAL(18,2)) AS TotalLabourHours,
                        CAST(FC.TotalEffectiveHours AS DECIMAL(18,2)) AS TotalEffectiveHours,
                        CAST(FC.TotalAdjustedHours AS DECIMAL(18,2)) AS TotalAdjustedHours,

                        -- Material Summary
                        MC.StockPartsCount AS TotalStockPartsCount,
                        MC.NonStockPartsCount AS TotalNonStockPartsCount,
                        MC.RebuiltPartsCount AS TotalRebuiltPartsCount,
                        CAST(MC.AvgStockCost AS DECIMAL(18,2)) AS AverageStockPartCost,
                        CAST(MC.AvgNonStockCost AS DECIMAL(18,2)) AS AverageNonStockPartCost,
                        CAST(MC.AvgRebuiltCost AS DECIMAL(18,2)) AS AverageRebuiltPartCost,

                        -- Core Cost
                        ISNULL((SELECT SUM(CoreCost) FROM SBCES.SCPartsUsed WHERE LinkCode = @LinkCode), 0) AS CoreCost,

                        -- Totals
                        CAST(FC.FinalLabourCost + (MC.SCPartsMaterialCost + MC.RBPartsMaterialCost + MC.NSCSCPartsMaterialCost) AS DECIMAL(18,2)) AS TotalWithoutTax,
                        CAST(FC.FinalLabourCost + ((MC.SCPartsMaterialCost + MC.RBPartsMaterialCost + MC.NSCSCPartsMaterialCost) * (1 + @TaxRate)) AS DECIMAL(18,2)) AS TotalWithTax,

                        -- JSON for Labour Tasks
                        (SELECT 
                            Task,
                            LabourDefn AS LabourDefinition,
                            CAST(TaskHours AS DECIMAL(18,2)) AS Hours,
                            CAST(TaskEffectiveHours AS DECIMAL(18,2)) AS EffectiveHours,
                            CAST(TaskAdjustedHours AS DECIMAL(18,2)) AS AdjustedHours,
                            CAST(AvgRate AS DECIMAL(18,2)) AS RatePerHour,
                            CAST(TaskCost AS DECIMAL(18,2)) AS TotalCost,
                            TaskCount AS Count
                        FROM LabourTaskSummary
                        FOR JSON PATH) AS LabourTasksJson,

                        -- JSON for Material Lines
                        (SELECT 
                            Type,
                            StockCode,
                            Description,
                            CAST(Quantity AS DECIMAL(18,2)) AS Quantity,
                            CAST(UnitCost AS DECIMAL(18,2)) AS UnitCost,
                            CAST(PercentUsage AS DECIMAL(18,2)) AS PercentUsage,
                            CAST(TotalCost AS DECIMAL(18,2)) AS TotalCost,
                            Supplier
                        FROM AllMaterialLines
                        WHERE TotalCost > 0
                        ORDER BY Type, StockCode
                        FOR JSON PATH) AS MaterialLinesJson

                    FROM MaterialCost MC
                    CROSS JOIN FinalCalc FC;

                END TRY
                BEGIN CATCH
                    SELECT 
                        @LinkCode AS LinkCode,
                        'Error: ' + ERROR_MESSAGE() AS ErrorMessage;
                END CATCH;";

                var result = await _dbConnection.QueryAsync<dynamic>(query);
                
                // Parse the JSON results into the model
                var finalResults = new List<TotalCostInEstimates>();
                
                foreach (var row in result)
                {
                    var model = new TotalCostInEstimates
                    {
                        LinkCode = row.LinkCode,
                        VehicleDescription = row.VehicleDescription,
                        VehicleSeries = row.VehicleSeries,
                        SCPartsMaterialCost = row.SCPartsMaterialCost ?? 0,
                        NSCSCPartsMaterialCost = row.NSCSCPartsMaterialCost ?? 0,
                        RBPartsMaterialCost = row.RBPartsMaterialCost ?? 0,
                        MaterialTotalCostNoTax = row.MaterialTotalCostNoTax ?? 0,
                        MaterialTotalTaxAmount = row.MaterialTotalTaxAmount ?? 0,
                        MaterialTotalWithTax = row.MaterialTotalWithTax ?? 0,
                        TotalLabourCost = row.TotalLabourCost ?? 0,
                        LabourFringe = row.LabourFringe ?? 0,
                        LabourBenefits = row.LabourBenefits ?? 0,
                        BlendedFringeBenefitPercent = row.BlendedFringeBenefitPercent ?? 0,
                        BlendedFringeBenefitCost = row.BlendedFringeBenefitCost ?? 0,
                        LabourOverhead = row.LabourOverhead ?? 0,
                        FinalLabourCost = row.FinalLabourCost ?? 0,
                        TotalLabourHours = row.TotalLabourHours ?? 0,
                        TotalEffectiveHours = row.TotalEffectiveHours ?? 0,
                        TotalAdjustedHours = row.TotalAdjustedHours ?? 0,
                        TotalStockPartsCount = row.TotalStockPartsCount ?? 0,
                        TotalNonStockPartsCount = row.TotalNonStockPartsCount ?? 0,
                        TotalRebuiltPartsCount = row.TotalRebuiltPartsCount ?? 0,
                        AverageStockPartCost = row.AverageStockPartCost ?? 0,
                        AverageNonStockPartCost = row.AverageNonStockPartCost ?? 0,
                        AverageRebuiltPartCost = row.AverageRebuiltPartCost ?? 0,
                        CoreCost = row.CoreCost ?? 0,
                        TotalWithoutTax = row.TotalWithoutTax ?? 0,
                        TotalWithTax = row.TotalWithTax ?? 0
                    };

                    // Parse Labour Tasks JSON
                    if (row.LabourTasksJson != null)
                    {
                        var tasksJson = row.LabourTasksJson.ToString();
                        if (!string.IsNullOrEmpty(tasksJson))
                        {
                            model.LabourTasks = Newtonsoft.Json.JsonConvert.DeserializeObject<List<LabourTaskSummary>>(tasksJson);
                        }
                    }
                    else
                    {
                        model.LabourTasks = new List<LabourTaskSummary>();
                    }

                    // Parse Material Lines JSON
                    if (row.MaterialLinesJson != null)
                    {
                        var linesJson = row.MaterialLinesJson.ToString();
                        if (!string.IsNullOrEmpty(linesJson))
                        {
                            model.MaterialLines = Newtonsoft.Json.JsonConvert.DeserializeObject<List<MaterialLineItem>>(linesJson);
                        }
                    }
                    else
                    {
                        model.MaterialLines = new List<MaterialLineItem>();
                    }

                    finalResults.Add(model);
                }

                return finalResults;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
                return null;
            }
        }

