                        <span class="label">Avg Stock Cost</span>
                    </div>
                    <div class="summary-card">
                        <span class="value" id="avgNonStockCost">$0.00</span>
                        <span class="label">Avg Non-Stock Cost</span>
                    </div>
                    <div class="summary-card">
                        <span class="value" id="avgRebuiltCost">$0.00</span>
                        <span class="label">Avg Rebuilt Cost</span>
                    </div>
