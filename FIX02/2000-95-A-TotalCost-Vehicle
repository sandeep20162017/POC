        color: #0b3b5f;
    }
    .total-row .value-col {
        font-weight: 800;
        font-size: 1.05em;
        color: #0b3b5f;
    }

    .tax-row .label-col { color: #e67e22; }
    .tax-row .value-col { color: #e67e22; font-weight: 600; }

    /* ===== TOTALS ROW ===== */
    .totals-row {
        display: flex;
        gap: 30px;
        margin: 20px 0;
        flex-wrap: wrap;
    }

    .total-box {
        flex: 1;
        background: #e8f0fe;
        border: 2px solid #1a5276;
        border-radius: 8px;
        padding: 15px 20px;
        text-align: center;
    }

    .total-box-label {
        font-weight: 700;
        font-size: 14px;
        color: #2c3e50;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .total-box-value {
        font-weight: 800;
        font-size: 24px;
        color: #1a5276;
    }

    /* ===== GRAND TOTAL ===== */
    .grand-total-section {
        margin-top: 20px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 2px solid #1a5276;
    }

    .grand-total-table {
        width: 100%;
        border-collapse: collapse;
    }
    .grand-total-table td {
        padding: 18px 25px;
    }

    .grand-total-label {
        font-weight: 800;
        font-size: 1.2em;
        color: #1a5276;
        background: #e8f0fe;
    }

    .grand-total-value {
        font-weight: 800;
        font-size: 1.4em;
        color: #1a5276;
        text-align: right;
        background: #e8f0fe;
    }

    /* ===== MISC ===== */
    .report-footer {
        margin-top: 25px;
        padding: 10px;
        background: #f8f9fa;
        font-size: 11px;
        color: #5d6d7e;
        text-align: center;
        border-radius: 4px;
        border-top: 1px solid #dee2e6;
    }

    .report-toolbar {
        position: absolute;
        top: 8px;
        right: 12px;
        z-index: 1000;
    }

    .loading-spinner {
        text-align: center;
        padding: 60px;
        color: #5d6d7e;
        font-size: 16px;
    }

    .no-data-message {
        text-align: center;
        padding: 50px;
        background: #fef9e6;
        border-radius: 8px;
    }

    .retry-btn {
        background-color: #2c3e50;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 4px;
        margin-top: 15px;
        cursor: pointer;
    }
    .retry-btn:hover { background-color: #1a5276; }

    .print-button {
        background-color: #2c3e50;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 20px;
        float: right;
        transition: background 0.2s;
    }
    .print-button:hover { background-color: #1a5276; }

    .clearfix::after {
        content: "";
        clear: both;
        display: table;
    }

    .no-print { display: block; }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .no-print { display: none !important; }
        body { background: white; margin: 0; padding: 0; }
        .report-container { box-shadow: none; padding: 0.2in; max-width: 100% !important; }
        .side-by-side { display: flex !important; gap: 20px; page-break-inside: avoid; }
        .material-section, .labour-section { break-inside: avoid; page-break-inside: avoid; }
        .grand-total-section { break-inside: avoid; page-break-inside: avoid; }
        .detail-section { break-inside: avoid; page-break-inside: avoid; }
        .material-table, .task-table { font-size: 10px; }
        .material-table th, .material-table td, .task-table th, .task-table td { padding: 4px 8px; }
        .summary-grid { display: block !important; }
        .summary-card { margin-bottom: 8px; }
        .vehicle-info { display: block !important; }
        .vehicle-info-item { margin-bottom: 6px; }
        .report-header h1 { font-size: 22px; }
        .total-box-value { font-size: 18px; }
        .grand-total-value { font-size: 20px; }
        html, body { height: auto !important; overflow: visible !important; }
    }
</style>

<div class="report-toolbar no-print">
    <button id="reportActions" class="k-button k-button-icon" title="Report actions" style="width:32px; padding:4px;">
        <span class="k-icon k-i-more-vertical"></span>
    </button>
</div>

<ul id="reportMenu" class="no-print">
    <li id="copyReport"><span class="k-icon k-i-copy"></span> Copy to Clipboard</li>
    <li id="saveReport"><span class="k-icon k-i-image"></span> Save as PNG</li>
</ul>

<div class="report-container">
    <div class="clearfix">
        <button class="print-button no-print" onclick="window.print();">🖨️ Print Full Report</button>
    </div>

    <div class="report-header">
