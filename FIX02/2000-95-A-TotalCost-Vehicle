        border-radius: 12px;
        font-size: 13px;
        font-weight: 400;
    }

    .detail-body {
        padding: 15px 20px;
    }

    /* ===== VEHICLE INFO ===== */
    .vehicle-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .vehicle-info-item {
        display: flex;
        flex-direction: column;
        padding: 10px 15px;
        background: #f8f9fa;
        border-radius: 6px;
        border-left: 4px solid #2c3e50;
    }

    .vehicle-info-item .label {
