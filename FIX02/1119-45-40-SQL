[HttpPost]
[AllowAnonymous]
public async Task<IActionResult> CreateDifferential([DataSourceRequest] DataSourceRequest request, [FromForm] DifferentialModel differentialModel)
{
    try
    {
        const string insertQuery = "INSERT INTO SBCES.Differential (NAME) VALUES (@Name)";
        await _dbConnection.ExecuteAsync(insertQuery, new { Name = differentialModel.Name });

        return Json(new { success = true });
    }
    catch (Exception ex)
    {
        // _logger.LogError(ex, "Error creating differential");
        return StatusCode(500, "An error occurred while creating the differential.");
    }
}

[HttpPost]
[AllowAnonymous]
public async Task<IActionResult> UpdateDifferential([DataSourceRequest] DataSourceRequest request, [FromForm] DifferentialModel differentialModel)
{
    try
    {
        _dbConnection.Open(); // only if the connection isn't already open; see note below

        using var transaction = _dbConnection.BeginTransaction();

        const string deleteQuery = "DELETE FROM SBCES.Differential WHERE NAME = @Name";
        await _dbConnection.ExecuteAsync(deleteQuery, new { Name = differentialModel.Name }, transaction);

        const string insertQuery = "INSERT INTO SBCES.Differential (NAME) VALUES (@Name)";
        await _dbConnection.ExecuteAsync(insertQuery, new { Name = differentialModel.Name }, transaction);

        transaction.Commit();

        return Json(new { success = true });
    }
    catch (Exception ex)
    {
        // _logger.LogError(ex, "Error updating differential");
        return StatusCode(500, "An error occurred while updating the differential.");
    }
}
