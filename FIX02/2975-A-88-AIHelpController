[HttpGet]
public async Task<IActionResult> TestOpenAI()
{
    try
    {
        var testPrompt = "Say 'Hello, the OpenAI API key is working correctly!' in one sentence.";
        var result = await OpenAIHelper.GetChatCompletionAsync(
            "You are a helpful assistant.", 
            testPrompt, 
            maxTokens: 50
        );
        
        return Ok(new { 
            success = true, 
            message = "OpenAI API test successful!", 
            response = result,
            apiKeyPrefix = OpenAIHelper.GetApiKeyPrefix() // Add this method below
        });
    }
    catch (Exception ex)
    {
        return StatusCode(500, new { 
            success = false, 
            error = ex.Message,
            stackTrace = ex.StackTrace
        });
    }
}
