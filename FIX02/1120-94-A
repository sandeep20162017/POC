DECLARE @NonProductiveAdj DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'NON_PRODUCTIVE_ADJUSTMENT'), '1'), ',', '.') AS DECIMAL(18,6));

WITH LabourData AS (
    SELECT
        EL.Task,
        EL.LabourDefn,
        EL.CostCentre AS CC,

        -- Required hours "H:MM" -> decimal hours
        (CAST(ISNULL(LEFT(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) - 1), 0) AS DECIMAL(18,2)) +
         CAST(ISNULL(SUBSTRING(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) + 1, LEN(EL.HrsReqd)), 0) AS DECIMAL(18,2)) / 60) AS DecimalHrs,

        -- Wrench time (AdjHrs "H:MM") -> decimal hours (full precision)
        CASE WHEN CHARINDEX(':', EL.AdjHrs) > 0
             THEN CAST(LEFT(EL.AdjHrs, CHARINDEX(':', EL.AdjHrs) - 1) AS DECIMAL(18,6))
                + CAST(SUBSTRING(EL.AdjHrs, CHARINDEX(':', EL.AdjHrs) + 1, 10) AS DECIMAL(18,6)) / 60.0
             ELSE ISNULL(TRY_CAST(REPLACE(EL.AdjHrs, ',', '.') AS DECIMAL(18,6)), 0)
        END AS WrenchHrs,

        -- Adjusted hours (TimeAddition) as decimal hours
        ISNULL(TRY_CAST(REPLACE(CAST(EL.TimeAddition AS VARCHAR(30)), ',', '.') AS DECIMAL(18,6)), 0) AS AdjHrsValue,

        CAST(NULLIF(EL.Usage, '') AS DECIMAL(18,2)) AS UsagePercent,
        ISNULL((SELECT TOP 1 ES.RatePerHour FROM CES.SBCES.EmployeeSalaries ES
                WHERE ES.WageGroup = (SELECT TOP 1 EC.WageGroup FROM CES.SBCES.EmplClass EC
                                      WHERE EC.LabourDefn LIKE '%' + EL.LabourDefn + '%')), 0) AS RatePerHour
    FROM SBCES.EmployeeLabour EL
    WHERE EL.LinkNumber = 'MB143' AND EL.TypeId = 'MB'
)
SELECT
    ISNULL(Task, 'Unnamed Task') AS Task,
    ISNULL(LabourDefn, 'N/A') AS LabourDefinition,
    ISNULL(CC, '') AS CC,
    COUNT(*) AS Count,
    @NonProductiveAdj AS NonProductiveAdj,

    SUM(DecimalHrs) AS Hours,
    SUM(DecimalHrs * UsagePercent / 100) AS EffectiveHours,

    -- Wrench time in minutes = ROUND(usage% x AdjHrs in minutes)
    ROUND(SUM(WrenchHrs * 60 * UsagePercent / 100), 0) AS WrenchTimeMinutes,
    -- Same value as H:MM
    CONCAT(CAST(ROUND(SUM(WrenchHrs * 60 * UsagePercent / 100), 0) AS INT) / 60, ':',
           RIGHT('0' + CAST(CAST(ROUND(SUM(WrenchHrs * 60 * UsagePercent / 100), 0) AS INT) % 60 AS VARCHAR(2)), 2)) AS WrenchTime,

    -- Adjusted hours = usage% x TimeAddition
    SUM(AdjHrsValue * UsagePercent / 100) AS AdjustedHours,
    ROUND(SUM(AdjHrsValue * 60 * UsagePercent / 100), 0) AS AdjustedMinutes,

    AVG(RatePerHour) AS RatePerHour,
    SUM((DecimalHrs * UsagePercent / 100) / @NonProductiveAdj * RatePerHour) AS TotalCost
FROM LabourData
GROUP BY Task, LabourDefn, CC
ORDER BY Task;
