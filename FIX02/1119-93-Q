GO
create view [dbo].[ahlocationslocanapmval] as select locations.locationsid, locations.siteid, locations.status,(case when r.value=-1 then null else r.value end) as health, locancestor.location, locancestor.ancestor, locancestor.systemid, (case when r1.value=-1 then null else r1.value end) as risk, (case when r2.value=-1 then null else r2.value end) as criticality, (case when r3.value=-1 then null else r3.value end) as eol, (case when r4.value=-1 then null else r4.value end) as effectiveage  from locations left join locancestor on locations.siteid=locancestor.siteid and locations.location=locancestor.location and locancestor.location!=locancestor.ancestor 
          left join ahscore r on r.objectname='LOCATIONS' and r.attributename = 'HEALTH' and locations.locationsid=r.ownerrecordid
          left join ahscore r1 on r.objectname='LOCATIONS' and r1.attributename = 'RISK' and locations.locationsid=r1.ownerrecordid
          left join ahscore r2 on r2.objectname='LOCATIONS' and r2.attributename ='CRITICALITY' and locations.locationsid=r2.ownerrecordid 
          left join ahscore r3 on r3.objectname='LOCATIONS' and r3.attributename ='EOL' and locations.locationsid=r3.ownerrecordid 
          left join ahscore r4 on r4.objectname='LOCATIONS' and r4.attributename ='EFFECTIVEAGE' and locations.locationsid=r4.ownerrecordid
