create function [dbo].[COMPONENT_COUNT](@in_assetid bigint, @in_siteid varchar(20), @in_metername varchar(20), @in_date datetime)
returns float
begin
	declare @reading float;
	declare @return_value float;
	declare @componentreadingdate datetime;
	declare @componentreadingtype varchar(20);
	
	declare c_latestReading cursor for
		select * from dbo.LATEST_READING(@in_assetid, @in_siteid, @in_metername, @in_date);
	
	declare c_anchorReading cursor for
		select * from dbo.ANCHOR(@in_assetid, @in_siteid, @in_metername, @in_date);
	
	declare c_latestActualReading cursor for
		select * from dbo.LATEST_ACTUAL_READING(@in_assetid, @in_siteid, @in_metername, @in_date);
	
   	open c_latestReading
   	fetch next from c_latestReading into @reading, @componentreadingdate, @componentreadingtype
   	close c_latestReading;
   	deallocate c_latestReading;

	--set @reading = dbo.LATEST_READING.latest_reading(@in_assetid, @in_siteid, @in_metername, @in_date, @componentreadingdate, @componentreadingtype);

	if (@componentreadingdate is null)
	begin
		--set @reading = dbo.ANCHOR(@in_assetid, @in_siteid, @in_metername, @in_date, @componentreadingdate, @componentreadingtype);

		open c_anchorReading
		fetch next from c_anchorReading into @reading, @componentreadingdate, @componentreadingtype
   		close c_anchorReading;
   		deallocate c_anchorReading;

		if (@componentreadingdate is null)
			return 0;
		else
			return @reading;
	end
	if (@componentreadingtype = 'ACTUAL') 
		return @reading;
	
	--set @reading = dbo.LATEST_ACTUAL_READING(@in_assetid, @in_siteid, @in_metername, @in_date, @componentreadingdate, @componentreadingtype);	

	open c_latestActualReading
	fetch next from c_latestActualReading into @reading, @componentreadingdate, @componentreadingtype
   	close c_latestActualReading;
   	deallocate c_latestActualReading;

	if (@componentreadingdate is null)
	begin
		--set @reading = dbo.ANCHOR(@in_assetid, @in_siteid, @in_metername, @in_date, @componentreadingdate, @componentreadingtype);
		open c_anchorReading
		fetch next from c_anchorReading into @reading, @componentreadingdate, @componentreadingtype
   		close c_anchorReading;
   		deallocate c_anchorReading;

		if (@componentreadingdate is null) 
			return 0;
	end
	
 	if (@componentreadingdate <= @in_date)
		set @return_value = (@reading + dbo.SUM_DELTAS(@in_assetid, @in_siteid, @in_metername, 1, @componentreadingdate, @in_date)); 
	else
		set @return_value = (@reading - dbo.SUM_DELTAS(@in_assetid, @in_siteid, @in_metername, 0, @in_date, @componentreadingdate));
		
	set @return_value = isnull(@return_value,0);
	
   	return @return_value;
   	
end;

