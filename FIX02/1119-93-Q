create view [dbo].[ahassetlocanapmval] as select asset.assetnum, asset.siteid, asset.status, (case when r.value=-1 then null else r.value end) as assethealth, locancestor.location, locancestor.ancestor, locancestor.systemid, (case when r1.value=-1 then null else r1.value end) as risk, (case when r2.value=-1 then null else r2.value end) as criticality, (case when r3.value=-1 then null else r3.value end) as eol, (case when r4.value=-1 then null else r4.value end) as effectiveage  from asset left join locancestor on asset.siteid=locancestor.siteid and asset.location=locancestor.location and locancestor.location!=locancestor.ancestor 
            left join ahscore r on r.objectname='ASSET' and r.attributename = 'ASSETHEALTH' and asset.assetid=r.ownerrecordid
            left join ahscore r1 on r.objectname='ASSET' and r1.attributename = 'RISK' and asset.assetid=r1.ownerrecordid
            left join ahscore r2 on r2.objectname='ASSET' and r2.attributename ='CRITICALITY' and asset.assetid=r2.ownerrecordid 
            left join ahscore r3 on r3.objectname='ASSET' and r3.attributename ='EOL' and asset.assetid=r3.ownerrecordid 
            left join ahscore r4 on r4.objectname='ASSET' and r4.attributename ='EFFECTIVEAGE' and asset.assetid=r4.ownerrecordid
