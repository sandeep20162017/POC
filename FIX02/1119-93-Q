              left join apmvalue r2 on r2.apmownertable='ASSET' and r2.apmattrname='CRITICALITY' and asset.assetid=r2.apmownerid 
              left join apmvalue r3 on r3.apmownertable='ASSET' and r3.apmattrname='EOL' and asset.assetid=r3.apmownerid 
              left join apmvalue r4 on r4.apmownertable='ASSET' and r4.apmattrname='AIOEFFECTIVEAGE' and asset.assetid=r4.apmownerid 
              left join apmvalue r5 on r5.apmownertable='ASSET' and r5.apmattrname='AIOEOLPREDICTCURVE' and asset.assetid=r5.apmownerid 
              left join apmvalue r6 on r6.apmownertable='ASSET' and r6.apmattrname='AIORISKPREDICTCURVE' and asset.assetid=r6.apmownerid 
      
       where (r.apmassessmentdate = (select max(apmassessmentdate) from apmvalue where apmownerid = r.apmownerid and apmattrname = 'RISK' and apmownertable='ASSET') or r.apmassessmentdate is null)
        and (r2.apmassessmentdate = (select max(apmassessmentdate) from apmvalue where apmownerid = r2.apmownerid and apmattrname = 'CRITICALITY' and apmownertable='ASSET') or r2.apmassessmentdate is null)
        and (r3.apmassessmentdate = (select max(apmassessmentdate) from apmvalue where apmownerid = r3.apmownerid and apmattrname = 'EOL' and apmownertable='ASSET') or r3.apmassessmentdate is null)
        and (r4.apmassessmentdate = (select max(apmassessmentdate) from apmvalue where apmownerid = r4.apmownerid and apmattrname = 'AIOEFFECTIVEAGE' and apmownertable='ASSET' and apmusewith='AIO') or r4.apmassessmentdate is null)
        and (r5.apmassessmentdate = (select max(apmassessmentdate) from apmvalue where apmownerid = r5.apmownerid and apmattrname = 'AIOEOLPREDICTCURVE' and apmownertable='ASSET' and apmusewith='AIO') or r5.apmassessmentdate is null)
        and (r6.apmassessmentdate = (select max(apmassessmentdate) from apmvalue where apmownerid = r6.apmownerid and apmattrname = 'AIORISKPREDICTCURVE' and apmownertable='ASSET' and apmusewith='AIO') or r6.apmassessmentdate is null)
