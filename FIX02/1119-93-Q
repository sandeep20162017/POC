create function [dbo].[SUM_DELTAS](@in_assetid bigint, @in_siteid varchar(20), @in_metername varchar(20), @in_polarity bit, @in_d1 datetime, @in_d2 datetime)
returns float
as
begin
	declare @result float;
	if (@in_polarity=1)
	begin
 		set @result =
 			(
 			select sum(delta)
			from meterreading
			where assetid = @in_assetid
			and siteid = @in_siteid
			and metername = @in_metername
			and readingtype in (select value from synonymdomain where domainid = 'READINGTYPE' and maxvalue in ('DELTA'))
			and readingdate > @in_d1
			and readingdate <= @in_d2
			);
 	end
 	else
 	begin
 		set @result = 
 			(
	 		select sum(delta)
			from meterreading
			where assetid = @in_assetid
			and siteid = @in_siteid
			and metername = @in_metername
			and readingtype in (select value from synonymdomain where domainid = 'READINGTYPE' and maxvalue in ('DELTA'))
			and readingdate >= @in_d1
			and readingdate < @in_d2
			);
 	end
 	set @result = isnull(@result,0);
 	return @result;
end;

GO
