-------------------------------------------------------------------------------
-- Create or alter the assessment procedure
-------------------------------------------------------------------------------

CREATE   PROCEDURE [dbo].[usp_ACM_FleetMigrationAssessment]
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @SiteID VARCHAR(10) = 'RCS';

    BEGIN TRY

        -----------------------------------------------------------------------
        -- Clean up temporary tables from any prior execution in this session
        -----------------------------------------------------------------------

        DROP TABLE IF EXISTS #ApprovedPrefixes;
        DROP TABLE IF EXISTS #Fleet;
        DROP TABLE IF EXISTS #Hierarchy;
        DROP TABLE IF EXISTS #Findings;
        DROP TABLE IF EXISTS #VehicleStatus;
        DROP TABLE IF EXISTS #CombinedResults;

        -----------------------------------------------------------------------
        -- Approved RCS parent-asset prefixes
        -----------------------------------------------------------------------

        CREATE TABLE #ApprovedPrefixes
        (
              PrefixName VARCHAR(20) NOT NULL
            , SortOrder  INT         NOT NULL
            , CONSTRAINT PK_ApprovedPrefixes
                  PRIMARY KEY CLUSTERED (PrefixName)
        );

        INSERT INTO #ApprovedPrefixes
        (
              PrefixName
            , SortOrder
        )
        VALUES
              ('TRTRAIN',   10)
            , ('T1VEHICLE', 20)
            , ('WORKCAR',   30);

        -----------------------------------------------------------------------
        -- Fleet inventory
        --
        -- A fleet root is an RCS parent asset referenced by at least one child
        -- where the parent ASSETNUM starts with an approved prefix.
        -----------------------------------------------------------------------

        SELECT DISTINCT
              p.siteid            AS SiteID
            , p.assetnum          AS VehicleAsset
            , p.serialnum         AS VehicleSerial
            , p.description       AS VehicleDescription
            , p.status            AS VehicleStatus
            , p.classstructureid  AS VehicleClassStructureID
            , ap.PrefixName       AS VehicleType
            , ap.SortOrder        AS VehicleTypeSortOrder
        INTO #Fleet
        FROM dbo.asset AS child
        INNER JOIN #ApprovedPrefixes AS ap
            ON child.parent LIKE ap.PrefixName + '%'
        INNER JOIN dbo.asset AS p
            ON p.siteid = child.siteid
           AND p.assetnum = child.parent
        WHERE child.siteid = @SiteID
          AND p.siteid = @SiteID
          AND NULLIF(LTRIM(RTRIM(child.parent)), '') IS NOT NULL;

        CREATE UNIQUE CLUSTERED INDEX IX_Fleet_Site_Vehicle
            ON #Fleet
            (
                  SiteID
                , VehicleAsset
            );

        CREATE NONCLUSTERED INDEX IX_Fleet_Type
            ON #Fleet
            (
                  VehicleType
                , VehicleAsset
            );

        -----------------------------------------------------------------------
        -- Hierarchy inventory
        --
        -- ASSETANCESTOR is used to retrieve the fleet root and descendants.
        -- The parent fleet asset is included even if its self-row is absent
        -- from ASSETANCESTOR.
        -----------------------------------------------------------------------

        ;WITH HierarchySource AS
        (
            SELECT
                  f.SiteID
                , f.VehicleAsset
                , f.VehicleSerial
                , f.VehicleDescription
                , f.VehicleStatus
                , f.VehicleClassStructureID
                , f.VehicleType
                , f.VehicleTypeSortOrder
                , aa.assetnum
                , aa.ancestor
                , aa.hierarchylevels
            FROM #Fleet AS f
            INNER JOIN dbo.assetancestor AS aa
                ON aa.siteid = f.SiteID
               AND aa.ancestor = f.VehicleAsset

            UNION ALL

            SELECT
                  f.SiteID
                , f.VehicleAsset
                , f.VehicleSerial
                , f.VehicleDescription
                , f.VehicleStatus
                , f.VehicleClassStructureID
                , f.VehicleType
                , f.VehicleTypeSortOrder
                , f.VehicleAsset AS assetnum
                , f.VehicleAsset AS ancestor
                , 0              AS hierarchylevels
            FROM #Fleet AS f
            WHERE NOT EXISTS
            (
                SELECT 1
                FROM dbo.assetancestor AS aa
                WHERE aa.siteid = f.SiteID
                  AND aa.ancestor = f.VehicleAsset
                  AND aa.assetnum = f.VehicleAsset
                  AND aa.hierarchylevels = 0
            )
        )
        SELECT DISTINCT
              hs.SiteID
            , hs.VehicleType
            , hs.VehicleTypeSortOrder
            , hs.VehicleAsset
            , hs.VehicleSerial
            , hs.VehicleDescription
            , hs.VehicleStatus
            , hs.VehicleClassStructureID
            , hs.assetnum              AS AssetNum
            , a.serialnum              AS SerialNum
            , a.parent                 AS ParentAsset
            , hs.ancestor              AS AncestorAsset
            , hs.hierarchylevels       AS HierarchyLevel
            , a.description            AS AssetDescription
            , a.status                 AS AssetStatus
            , a.classstructureid       AS ClassStructureID
        INTO #Hierarchy
        FROM HierarchySource AS hs
        LEFT JOIN dbo.asset AS a
            ON a.siteid = hs.SiteID
           AND a.assetnum = hs.assetnum;

        CREATE CLUSTERED INDEX IX_Hierarchy_Site_Vehicle_Asset
            ON #Hierarchy
            (
                  SiteID
                , VehicleAsset
                , AssetNum
                , HierarchyLevel
            );

        CREATE NONCLUSTERED INDEX IX_Hierarchy_Serial
            ON #Hierarchy
            (
                  SiteID
                , SerialNum
            );

        CREATE NONCLUSTERED INDEX IX_Hierarchy_Parent
            ON #Hierarchy
            (
                  SiteID
                , ParentAsset
            );

        -----------------------------------------------------------------------
        -- Findings table
        -----------------------------------------------------------------------

        CREATE TABLE #Findings
        (
              FindingID     BIGINT IDENTITY(1,1) NOT NULL
            , Severity      VARCHAR(20)           NOT NULL
            , SiteID        VARCHAR(10)           NOT NULL
            , VehicleType   VARCHAR(20)           NULL
            , VehicleAsset  VARCHAR(100)          NULL
            , AssetNum      VARCHAR(100)          NULL
            , SerialNum     VARCHAR(100)          NULL
            , IssueType     VARCHAR(100)          NOT NULL
            , Details       VARCHAR(1000)         NOT NULL
            , CONSTRAINT PK_Findings
                  PRIMARY KEY CLUSTERED (FindingID)
        );

        -----------------------------------------------------------------------
        -- 1. Missing serial numbers
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'WARNING'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'MISSING_SERIAL'
            , 'Asset has no serial number.'
        FROM #Hierarchy AS h
        WHERE NULLIF(LTRIM(RTRIM(h.SerialNum)), '') IS NULL;

        -----------------------------------------------------------------------
        -- 2. Duplicate serial numbers within RCS
        -----------------------------------------------------------------------

        ;WITH DuplicateSerials AS
        (
            SELECT
                  a.siteid
                , a.serialnum
                , COUNT(*) AS SerialCount
            FROM dbo.asset AS a
            WHERE a.siteid = @SiteID
              AND NULLIF(LTRIM(RTRIM(a.serialnum)), '') IS NOT NULL
            GROUP BY
                  a.siteid
                , a.serialnum
            HAVING COUNT(*) > 1
        )
        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT DISTINCT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'DUPLICATE_SERIAL'
            , CONCAT(
                  'Serial number ',
                  h.SerialNum,
                  ' is assigned to ',
                  d.SerialCount,
                  ' RCS assets.'
              )
        FROM #Hierarchy AS h
        INNER JOIN DuplicateSerials AS d
            ON d.siteid = h.SiteID
           AND d.serialnum = h.SerialNum;

        -----------------------------------------------------------------------
        -- 3. Missing parent records
        --
        -- Root fleet assets at level zero are excluded because they may
        -- legitimately have no parent.
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'MISSING_PARENT'
            , CONCAT(
                  'Referenced parent asset does not exist at site RCS: ',
                  COALESCE(NULLIF(h.ParentAsset, ''), '[NULL]')
              )
        FROM #Hierarchy AS h
        WHERE h.HierarchyLevel > 0
          AND NULLIF(LTRIM(RTRIM(h.ParentAsset)), '') IS NOT NULL
          AND NOT EXISTS
          (
              SELECT 1
              FROM dbo.asset AS p
              WHERE p.siteid = h.SiteID
                AND p.assetnum = h.ParentAsset
          );

        -----------------------------------------------------------------------
        -- 4. Descendant with no direct parent
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'DESCENDANT_WITHOUT_PARENT'
            , CONCAT(
                  'Hierarchy descendant at level ',
                  h.HierarchyLevel,
                  ' has no direct parent.'
              )
        FROM #Hierarchy AS h
        WHERE h.HierarchyLevel > 0
          AND NULLIF(LTRIM(RTRIM(h.ParentAsset)), '') IS NULL;

        -----------------------------------------------------------------------
        -- 5. Self-referencing parent
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'SELF_REFERENCE'
            , 'Asset references itself as its direct parent.'
        FROM #Hierarchy AS h
        WHERE h.AssetNum = h.ParentAsset;

        -----------------------------------------------------------------------
        -- 6. Fleet root has no descendants
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , f.SiteID
            , f.VehicleType
            , f.VehicleAsset
            , f.VehicleAsset
            , f.VehicleSerial
            , 'NO_HIERARCHY'
            , 'Fleet parent asset has no descendants in ASSETANCESTOR.'
        FROM #Fleet AS f
        WHERE NOT EXISTS
        (
            SELECT 1
            FROM #Hierarchy AS h
            WHERE h.SiteID = f.SiteID
              AND h.VehicleAsset = f.VehicleAsset
              AND h.HierarchyLevel > 0
        );

        -----------------------------------------------------------------------
        -- 7. Duplicate asset rows within a vehicle hierarchy
        -----------------------------------------------------------------------

        ;WITH DuplicateHierarchyRows AS
        (
            SELECT
                  h.SiteID
                , h.VehicleAsset
                , h.AssetNum
                , h.HierarchyLevel
                , COUNT(*) AS DuplicateCount
            FROM #Hierarchy AS h
            GROUP BY
                  h.SiteID
                , h.VehicleAsset
                , h.AssetNum
                , h.HierarchyLevel
            HAVING COUNT(*) > 1
        )
        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT DISTINCT
              'WARNING'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'DUPLICATE_HIERARCHY_ROW'
            , CONCAT(
                  'Asset occurs ',
                  d.DuplicateCount,
                  ' times at hierarchy level ',
                  d.HierarchyLevel,
                  '.'
              )
        FROM #Hierarchy AS h
        INNER JOIN DuplicateHierarchyRows AS d
            ON d.SiteID = h.SiteID
           AND d.VehicleAsset = h.VehicleAsset
           AND d.AssetNum = h.AssetNum
           AND d.HierarchyLevel = h.HierarchyLevel;

        -----------------------------------------------------------------------
        -- 8. Missing status
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'MISSING_STATUS'
            , 'Asset status is NULL or blank.'
        FROM #Hierarchy AS h
        WHERE NULLIF(LTRIM(RTRIM(h.AssetStatus)), '') IS NULL;

        -----------------------------------------------------------------------
        -- 9. Missing description
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'WARNING'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'MISSING_DESCRIPTION'
            , 'Asset description is NULL or blank.'
        FROM #Hierarchy AS h
        WHERE NULLIF(LTRIM(RTRIM(h.AssetDescription)), '') IS NULL;

        -----------------------------------------------------------------------
        -- 10. Missing classification
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'WARNING'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'MISSING_CLASSIFICATION'
            , 'Asset CLASSSTRUCTUREID is NULL or blank.'
        FROM #Hierarchy AS h
        WHERE NULLIF(LTRIM(RTRIM(h.ClassStructureID)), '') IS NULL;

        -----------------------------------------------------------------------
        -- 11. Missing asset record referenced by ASSETANCESTOR
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'MISSING_ASSET_RECORD'
            , CONCAT(
                  'ASSETANCESTOR references an ASSETNUM that does not exist ',
                  'in dbo.ASSET for RCS: ',
                  h.AssetNum
              )
        FROM #Hierarchy AS h
        WHERE h.AssetStatus IS NULL
          AND h.AssetDescription IS NULL
          AND h.ClassStructureID IS NULL;

        -----------------------------------------------------------------------
        -- 12. Invalid hierarchy level
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'INVALID_HIERARCHY_LEVEL'
            , CONCAT(
                  'Hierarchy level cannot be negative. Current value: ',
                  h.HierarchyLevel
              )
        FROM #Hierarchy AS h
        WHERE h.HierarchyLevel < 0;

        -----------------------------------------------------------------------
        -- 13. Circular ancestor reference
        --
        -- An ASSETNUM equal to ANCESTOR is only valid at hierarchy level zero.
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'CIRCULAR_REFERENCE'
            , CONCAT(
                  'Asset references itself as an ancestor at hierarchy level ',
                  h.HierarchyLevel,
                  '.'
              )
        FROM #Hierarchy AS h
        WHERE h.AssetNum = h.AncestorAsset
          AND h.HierarchyLevel > 0;

        -----------------------------------------------------------------------
        -- 14. Excessive hierarchy depth
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'WARNING'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'EXCESSIVE_DEPTH'
            , CONCAT(
                  'Hierarchy depth exceeds 15 levels. Current level: ',
                  h.HierarchyLevel,
                  '.'
              )
        FROM #Hierarchy AS h
        WHERE h.HierarchyLevel > 15;

        -----------------------------------------------------------------------
        -- 15. Invalid or inactive parent status
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'INVALID_PARENT_STATUS'
            , CONCAT(
                  'Parent asset ',
                  h.ParentAsset,
                  ' has status ',
                  p.status,
                  '.'
              )
        FROM #Hierarchy AS h
        INNER JOIN dbo.asset AS p
            ON p.siteid = h.SiteID
           AND p.assetnum = h.ParentAsset
        WHERE p.status IN
        (
              'DECOMMISSIONED'
            , 'RETIRED'
            , 'REMOVED'
        );

        -----------------------------------------------------------------------
        -- 16. Validate the direct parent for first-level descendants
        --
        -- Level-one assets must point directly to the selected fleet root.
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.SerialNum
            , 'INVALID_ROOT_PARENT'
            , CONCAT(
                  'Level-one descendant has parent ',
                  COALESCE(NULLIF(h.ParentAsset, ''), '[NULL]'),
                  '; expected fleet root ',
                  h.VehicleAsset,
                  '.'
              )
        FROM #Hierarchy AS h
        WHERE h.HierarchyLevel = 1
          AND
          (
              h.ParentAsset IS NULL
              OR h.ParentAsset <> h.VehicleAsset
          );

        -----------------------------------------------------------------------
        -- 17. Confirm the selected fleet-root prefix
        -----------------------------------------------------------------------

        INSERT INTO #Findings
        (
              Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , SerialNum
            , IssueType
            , Details
        )
        SELECT
              'ERROR'
            , f.SiteID
            , f.VehicleType
            , f.VehicleAsset
            , f.VehicleAsset
            , f.VehicleSerial
            , 'INVALID_FLEET_PREFIX'
            , CONCAT(
                  'Fleet root does not begin with TRTRAIN, T1VEHICLE, ',
                  'or WORKCAR: ',
                  f.VehicleAsset,
                  '.'
              )
        FROM #Fleet AS f
        WHERE f.VehicleAsset NOT LIKE 'TRTRAIN%'
          AND f.VehicleAsset NOT LIKE 'T1VEHICLE%'
          AND f.VehicleAsset NOT LIKE 'WORKCAR%';

        -----------------------------------------------------------------------
        -- Supporting finding index
        -----------------------------------------------------------------------

        CREATE NONCLUSTERED INDEX IX_Findings_Vehicle_Issue
            ON #Findings
            (
                  SiteID
                , VehicleAsset
                , IssueType
            );

        -----------------------------------------------------------------------
        -- Calculate vehicle readiness once for reuse
        --
        -- ERROR findings carry greater weight than WARNING findings.
        -----------------------------------------------------------------------

        SELECT
              f.SiteID
            , f.VehicleType
            , f.VehicleTypeSortOrder
            , f.VehicleAsset
            , f.VehicleSerial
            , f.VehicleDescription
            , f.VehicleStatus
            , f.VehicleClassStructureID
            , COUNT(fd.FindingID) AS TotalIssues
            , SUM(
                  CASE
                      WHEN fd.Severity = 'ERROR' THEN 1
                      ELSE 0
                  END
              ) AS ErrorCount
            , SUM(
                  CASE
                      WHEN fd.Severity = 'WARNING' THEN 1
                      ELSE 0
                  END
              ) AS WarningCount
            , COUNT(DISTINCT h.AssetNum) AS HierarchyAssetCount
            , MAX(h.HierarchyLevel) AS MaximumHierarchyDepth
            , CASE
                  WHEN SUM(
                           CASE
                               WHEN fd.Severity = 'ERROR' THEN 1
                               ELSE 0
                           END
                       ) = 0
                   AND SUM(
                           CASE
                               WHEN fd.Severity = 'WARNING' THEN 1
                               ELSE 0
                           END
                       ) = 0
                      THEN 100

                  WHEN SUM(
                           CASE
                               WHEN fd.Severity = 'ERROR' THEN 1
                               ELSE 0
                           END
                       ) = 0
                   AND SUM(
                           CASE
                               WHEN fd.Severity = 'WARNING' THEN 1
                               ELSE 0
                           END
                       ) <= 3
                      THEN 85

                  WHEN SUM(
                           CASE
                               WHEN fd.Severity = 'ERROR' THEN 1
                               ELSE 0
                           END
                       ) <= 2
                      THEN 65

                  WHEN SUM(
                           CASE
                               WHEN fd.Severity = 'ERROR' THEN 1
                               ELSE 0
                           END
                       ) <= 5
                      THEN 40

                  ELSE 0
              END AS ReadinessScore
            , CASE
                  WHEN SUM(
                           CASE
                               WHEN fd.Severity = 'ERROR' THEN 1
                               ELSE 0
                           END
                       ) = 0
                   AND SUM(
                           CASE
                               WHEN fd.Severity = 'WARNING' THEN 1
                               ELSE 0
                           END
                       ) = 0
                      THEN 'PASS'

                  WHEN SUM(
                           CASE
                               WHEN fd.Severity = 'ERROR' THEN 1
                               ELSE 0
                           END
                       ) = 0
                      THEN 'WARN'

                  ELSE 'FAIL'
              END AS MigrationStatus
        INTO #VehicleStatus
        FROM #Fleet AS f
        LEFT JOIN #Findings AS fd
            ON fd.SiteID = f.SiteID
           AND fd.VehicleAsset = f.VehicleAsset
        LEFT JOIN #Hierarchy AS h
            ON h.SiteID = f.SiteID
           AND h.VehicleAsset = f.VehicleAsset
        GROUP BY
              f.SiteID
            , f.VehicleType
            , f.VehicleTypeSortOrder
            , f.VehicleAsset
            , f.VehicleSerial
            , f.VehicleDescription
            , f.VehicleStatus
            , f.VehicleClassStructureID;

        CREATE UNIQUE CLUSTERED INDEX IX_VehicleStatus
            ON #VehicleStatus
            (
                  SiteID
                , VehicleAsset
            );

        -----------------------------------------------------------------------
        -- Combined output table
        -----------------------------------------------------------------------

        CREATE TABLE #CombinedResults
        (
              SortOrder       INT            NOT NULL
            , ReportSection   VARCHAR(100)   NOT NULL
            , Severity        VARCHAR(20)    NULL
            , SiteID          VARCHAR(10)    NULL
            , VehicleType     VARCHAR(20)    NULL
            , VehicleAsset    VARCHAR(100)   NULL
            , AssetNum        VARCHAR(100)   NULL
            , ParentAsset     VARCHAR(100)   NULL
            , SerialNum       VARCHAR(100)   NULL
            , Classification  VARCHAR(100)   NULL
            , Category        VARCHAR(100)   NULL
            , Details         VARCHAR(2000)  NULL
            , MetricValue     DECIMAL(18,2)  NULL
            , Status          VARCHAR(50)    NULL
        );

        -----------------------------------------------------------------------
        -- Output section 1: Assessment scope
        -----------------------------------------------------------------------

        INSERT INTO #CombinedResults
        (
              SortOrder
            , ReportSection
            , Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , ParentAsset
            , SerialNum
            , Classification
            , Category
            , Details
            , MetricValue
            , Status
        )
        SELECT
              10
            , 'ASSESSMENT SCOPE'
            , 'INFORMATION'
            , @SiteID
            , ap.PrefixName
            , NULL
            , NULL
            , NULL
            , NULL
            , NULL
            , 'FLEET VEHICLE COUNT'
            , CONCAT(
                  'RCS parent assets beginning with ',
                  ap.PrefixName,
                  ': ',
                  COUNT(f.VehicleAsset)
              )
            , CAST(COUNT(f.VehicleAsset) AS DECIMAL(18,2))
            , CASE
                  WHEN COUNT(f.VehicleAsset) = 0 THEN 'NO MATCHES'
                  ELSE 'INCLUDED'
              END
        FROM #ApprovedPrefixes AS ap
        LEFT JOIN #Fleet AS f
            ON f.VehicleType = ap.PrefixName
        GROUP BY
              ap.PrefixName
            , ap.SortOrder;

        -----------------------------------------------------------------------
        -- Output section 2: Vehicle migration summary
        -----------------------------------------------------------------------

        INSERT INTO #CombinedResults
        (
              SortOrder
            , ReportSection
            , Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , ParentAsset
            , SerialNum
            , Classification
            , Category
            , Details
            , MetricValue
            , Status
        )
        SELECT
              20
            , 'VEHICLE MIGRATION SUMMARY'
            , CASE
                  WHEN vs.MigrationStatus = 'PASS' THEN 'INFORMATION'
                  WHEN vs.MigrationStatus = 'WARN' THEN 'WARNING'
                  ELSE 'ERROR'
              END
            , vs.SiteID
            , vs.VehicleType
            , vs.VehicleAsset
            , vs.VehicleAsset
            , NULL
            , vs.VehicleSerial
            , vs.VehicleClassStructureID
            , 'READINESS SCORE'
            , CONCAT(
                  'Hierarchy assets=',
                  vs.HierarchyAssetCount,
                  '; maximum depth=',
                  COALESCE(CONVERT(VARCHAR(20), vs.MaximumHierarchyDepth), '0'),
                  '; errors=',
                  vs.ErrorCount,
                  '; warnings=',
                  vs.WarningCount,
                  '; total issues=',
                  vs.TotalIssues
              )
            , CAST(vs.ReadinessScore AS DECIMAL(18,2))
            , vs.MigrationStatus
        FROM #VehicleStatus AS vs;

        -----------------------------------------------------------------------
        -- Output section 3: Findings
        -----------------------------------------------------------------------

        INSERT INTO #CombinedResults
        (
              SortOrder
            , ReportSection
            , Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , ParentAsset
            , SerialNum
            , Classification
            , Category
            , Details
            , MetricValue
            , Status
        )
        SELECT
              30
            , 'DATA QUALITY FINDING'
            , f.Severity
            , f.SiteID
            , f.VehicleType
            , f.VehicleAsset
            , f.AssetNum
            , h.ParentAsset
            , f.SerialNum
            , h.ClassStructureID
            , f.IssueType
            , f.Details
            , NULL
            , CASE
                  WHEN f.Severity = 'ERROR' THEN 'FAIL'
                  ELSE 'WARN'
              END
        FROM #Findings AS f
        LEFT JOIN #Hierarchy AS h
            ON h.SiteID = f.SiteID
           AND h.VehicleAsset = f.VehicleAsset
           AND h.AssetNum = f.AssetNum;

        -----------------------------------------------------------------------
        -- Output section 4: Issue summary by type
        -----------------------------------------------------------------------

        INSERT INTO #CombinedResults
        (
              SortOrder
            , ReportSection
            , Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , ParentAsset
            , SerialNum
            , Classification
            , Category
            , Details
            , MetricValue
            , Status
        )
        SELECT
              40
            , 'ISSUE SUMMARY'
            , f.Severity
            , f.SiteID
            , f.VehicleType
            , NULL
            , NULL
            , NULL
            , NULL
            , NULL
            , f.IssueType
            , CONCAT(
                  'Number of ',
                  LOWER(f.Severity),
                  ' findings: ',
                  COUNT(*)
              )
            , CAST(COUNT(*) AS DECIMAL(18,2))
            , CASE
                  WHEN f.Severity = 'ERROR' THEN 'FAIL'
                  ELSE 'WARN'
              END
        FROM #Findings AS f
        GROUP BY
              f.Severity
            , f.SiteID
            , f.VehicleType
            , f.IssueType;

        -----------------------------------------------------------------------
        -- Output section 5: Hierarchy details
        -----------------------------------------------------------------------

        INSERT INTO #CombinedResults
        (
              SortOrder
            , ReportSection
            , Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , ParentAsset
            , SerialNum
            , Classification
            , Category
            , Details
            , MetricValue
            , Status
        )
        SELECT
              50
            , 'HIERARCHY DETAIL'
            , 'INFORMATION'
            , h.SiteID
            , h.VehicleType
            , h.VehicleAsset
            , h.AssetNum
            , h.ParentAsset
            , h.SerialNum
            , h.ClassStructureID
            , 'HIERARCHY LEVEL'
            , CONCAT(
                  'Ancestor=',
                  COALESCE(NULLIF(h.AncestorAsset, ''), '[NULL]'),
                  '; description=',
                  COALESCE(NULLIF(h.AssetDescription, ''), '[NULL]')
              )
            , CAST(h.HierarchyLevel AS DECIMAL(18,2))
            , h.AssetStatus
        FROM #Hierarchy AS h;

        -----------------------------------------------------------------------
        -- Output section 6: Overall RCS assessment
        -----------------------------------------------------------------------

        INSERT INTO #CombinedResults
        (
              SortOrder
            , ReportSection
            , Severity
            , SiteID
            , VehicleType
            , VehicleAsset
            , AssetNum
            , ParentAsset
            , SerialNum
            , Classification
            , Category
            , Details
            , MetricValue
            , Status
        )
        SELECT
              60
            , 'OVERALL RCS ASSESSMENT'
            , CASE
                  WHEN COUNT(*) = 0 THEN 'WARNING'
                  WHEN SUM(CASE WHEN MigrationStatus = 'FAIL' THEN 1 ELSE 0 END) > 0
                      THEN 'ERROR'
                  WHEN SUM(CASE WHEN MigrationStatus = 'WARN' THEN 1 ELSE 0 END) > 0
                      THEN 'WARNING'
                  ELSE 'INFORMATION'
              END
            , @SiteID
            , 'ALL'
            , NULL
            , NULL
            , NULL
            , NULL
            , NULL
            , 'RCS MIGRATION READINESS'
            , CONCAT(
                  'Fleet vehicles=',
                  COUNT(*),
                  '; pass=',
                  SUM(CASE WHEN MigrationStatus = 'PASS' THEN 1 ELSE 0 END),
                  '; warn=',
                  SUM(CASE WHEN MigrationStatus = 'WARN' THEN 1 ELSE 0 END),
                  '; fail=',
                  SUM(CASE WHEN MigrationStatus = 'FAIL' THEN 1 ELSE 0 END)
              )
            , CAST(
                  CASE
                      WHEN COUNT(*) = 0 THEN 0
                      ELSE
                          100.0 *
                          SUM(
                              CASE
                                  WHEN MigrationStatus = 'PASS' THEN 1
                                  ELSE 0
                              END
                          ) / COUNT(*)
                  END
                  AS DECIMAL(18,2)
              )
            , CASE
                  WHEN COUNT(*) = 0
                      THEN 'NO ASSETS FOUND'

                  WHEN SUM(
                           CASE
                               WHEN MigrationStatus = 'FAIL' THEN 1
                               ELSE 0
                           END
                       ) > 0
                      THEN 'NOT READY'

                  WHEN SUM(
                           CASE
                               WHEN MigrationStatus = 'WARN' THEN 1
                               ELSE 0
                           END
                       ) > 0
                      THEN 'READY WITH REMEDIATION'

                  ELSE 'READY'
              END
        FROM #VehicleStatus;

        -----------------------------------------------------------------------
        -- Return one combined SSMS grid
        -----------------------------------------------------------------------

        SELECT
              cr.ReportSection
            , cr.Severity
            , cr.SiteID
            , cr.VehicleType
            , cr.VehicleAsset
            , cr.AssetNum
            , cr.ParentAsset
            , cr.SerialNum
            , cr.Classification
            , cr.Category
            , cr.Details
            , cr.MetricValue
            , cr.Status
        FROM #CombinedResults AS cr
        ORDER BY
              cr.SortOrder
            , CASE cr.Severity
                  WHEN 'ERROR' THEN 1
                  WHEN 'WARNING' THEN 2
                  ELSE 3
              END
            , cr.VehicleType
            , cr.VehicleAsset
            , cr.AssetNum
            , cr.Category;

    END TRY
    BEGIN CATCH

        DECLARE @ErrorMessage NVARCHAR(2048);
        DECLARE @ErrorNumber INT;
        DECLARE @ErrorLine INT;
        DECLARE @ErrorProcedure NVARCHAR(256);

        SELECT
              @ErrorMessage = ERROR_MESSAGE()
            , @ErrorNumber = ERROR_NUMBER()
            , @ErrorLine = ERROR_LINE()
            , @ErrorProcedure = ERROR_PROCEDURE();

        SET @ErrorMessage = CONCAT(
              'ACM fleet migration assessment failed. ',
              'Error number: ',
              @ErrorNumber,
              '; procedure: ',
              COALESCE(@ErrorProcedure, 'ad hoc'),
              '; line: ',
              @ErrorLine,
              '; message: ',
              @ErrorMessage
          );

        THROW 50999, @ErrorMessage, 1;

    END CATCH;
END;
GO



 
