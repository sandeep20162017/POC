create function [dbo].[CALC](@in_assetid bigint, @in_siteid varchar(20), @in_metername varchar(20), @in_asofdate datetime)
returns float
begin
	declare @return_value float = 0;
	declare @componentreading float;
 	declare @componentdate datetime;
 	declare @componenttype varchar(20);
 	declare @inheritedcount float = 0;
 	declare @parentassetid bigint;
 	declare @ontime datetime;
 	declare @offtime datetime;
 	declare @d3 datetime;
 	declare @d4 datetime;
 	declare @c3 float = 0;
 	declare @c4 float = 0;


	declare c_componentReading cursor for
		select * from dbo.COMPONENT_READING(@in_assetid, @in_siteid, @in_metername, @in_asofdate);
	
	--set @componentreading = dbo.COMPONENT_READING(@in_assetid, @in_siteid, @in_metername, @in_asofdate, @componentdate, @componenttype);
	
	open c_componentReading
	fetch next from c_componentReading into @componentreading, @componentdate, @componenttype
   	close c_componentReading;
   	deallocate c_componentReading;

	declare c_parentonoffs_pos cursor for
		select parentassetid, ontime, offtime
		from plusasaonoff
		where assetid = @in_assetid
		and siteid = @in_siteid
		and parentassetid is not null
		and ontime <= @in_asofdate
		and (offtime is null or offtime > @componentdate)
		and (offtime is null or offtime > ontime);  

	declare c_parentonoffs_neg cursor for
		select parentassetid, ontime, offtime
		from plusasaonoff
		where assetid = @in_assetid
		and siteid = @in_siteid
		and parentassetid is not null
		and ontime <= @componentdate
		and (offtime is null or offtime > @in_asofdate)
		and (offtime is null or offtime > ontime);
		
	if (@componentdate <= @in_asofdate)
	begin
		set @inheritedcount = 0;
   		open c_parentonoffs_pos
   		fetch next from c_parentonoffs_pos into @parentassetid, @d3, @d4;
   		
		while @@fetch_status = 0
   		begin
	   		if (@d3 < @componentdate) 
				set @d3 = @componentdate;
		   	if (@d4 is null or @d4 > @in_asofdate) 
				set @d4 = @in_asofdate;
		   	set @c3 = dbo.CALC(@parentassetid, @in_siteid, @in_metername, @d3);
			set @c4 = dbo.CALC(@parentassetid, @in_siteid, @in_metername, @d4);
		   	set @inheritedcount = @inheritedcount + (@c4 - @c3);

			fetch next from c_parentonoffs_pos into @parentassetid, @d3, @d4;
		end
   		
   		close c_parentonoffs_pos;
		deallocate c_parentonoffs_pos;

 		set @return_value = (@componentreading + (dbo.SUM_VALUES(@in_assetid, @in_siteid, @in_metername, @componentdate, @in_asofdate) + @inheritedcount));
 	end
 	else
 	begin
		set @inheritedcount = 0;
 		open c_parentonoffs_neg
		fetch next from c_parentonoffs_neg into @parentassetid, @d3, @d4;
   		
 		while @@fetch_status = 0
 		begin
   			if (@d3 < @in_asofdate) 
				set @d3 = @in_asofdate;
		   	if (@d4 is null or @d4 > @componentdate) 
				set @d4 = @componentdate;
		   	set @c3 = dbo.CALC(@parentassetid, @in_siteid, @in_metername, @d3);
			set @c4 = dbo.CALC(@parentassetid, @in_siteid, @in_metername, @d4);
	        set @inheritedcount = @inheritedcount + (@c4 - @c3);
			
			fetch next from c_parentonoffs_neg into @parentassetid, @d3, @d4;
   		end
   		close c_parentonoffs_neg;
		deallocate c_parentonoffs_neg;

   		set @return_value = (@componentreading - (dbo.SUM_VALUES(@in_assetid, @in_siteid, @in_metername, @in_asofdate, @componentdate) + @inheritedcount));
	end

	return @return_value;
end;

