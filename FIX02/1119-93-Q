BEGIN

    SET NOCOUNT ON;

    ------------------------------------------------------------------
    -- Fleet Inventory
    ------------------------------------------------------------------

    IF OBJECT_ID('tempdb..#Fleet') IS NOT NULL DROP TABLE #Fleet;

    SELECT
          a.assetnum      AS VehicleAsset
        , a.serialnum     AS VehicleSerial
        , a.description
        , a.siteid
    INTO #Fleet
    FROM asset a
    WHERE a.siteid = @SiteID
      AND a.assetnum LIKE @VehiclePattern;

    ------------------------------------------------------------------
    -- Hierarchy Inventory
    ------------------------------------------------------------------

    IF OBJECT_ID('tempdb..#Hierarchy') IS NOT NULL DROP TABLE #Hierarchy;

    SELECT
          f.VehicleAsset
        , aa.ancestor
        , aa.assetnum
        , aa.hierarchylevels
        , a.serialnum
        , a.parent
        , a.description
        , a.siteid
    INTO #Hierarchy
    FROM #Fleet f
    JOIN assetancestor aa
        ON aa.ancestor = f.VehicleAsset
       AND aa.siteid = f.siteid
    JOIN asset a
        ON a.assetnum = aa.assetnum
       AND a.siteid = aa.siteid;

    ------------------------------------------------------------------
    -- Discrepancy Collection
    ------------------------------------------------------------------

    IF OBJECT_ID('tempdb..#Findings') IS NOT NULL DROP TABLE #Findings;

    CREATE TABLE #Findings
    (
          VehicleAsset    VARCHAR(50)
        , AssetNum        VARCHAR(50)
        , SerialNum       VARCHAR(100)
        , IssueType       VARCHAR(100)
        , Details         VARCHAR(500)
    );

    ------------------------------------------------------------------
    -- Missing Serial Numbers
    ------------------------------------------------------------------

    INSERT INTO #Findings
    SELECT
          VehicleAsset
        , AssetNum
        , SerialNum
        , 'MISSING_SERIAL'
        , 'Asset has no serial number'
    FROM #Hierarchy
    WHERE ISNULL(SerialNum,'') = '';

    ------------------------------------------------------------------
    -- Duplicate Serials
    ------------------------------------------------------------------

    INSERT INTO #Findings
    SELECT
          h.VehicleAsset
        , h.AssetNum
        , h.SerialNum
        , 'DUPLICATE_SERIAL'
        , 'Serial number used more than once'
    FROM #Hierarchy h
    JOIN
    (
        SELECT
            serialnum
        FROM asset
        WHERE siteid = @SiteID
          AND serialnum IS NOT NULL
        GROUP BY serialnum
        HAVING COUNT(*) > 1
    ) d
        ON h.serialnum = d.serialnum;

    ------------------------------------------------------------------
    -- Assets Missing Parent
    ------------------------------------------------------------------

    INSERT INTO #Findings
    SELECT
          VehicleAsset
        , AssetNum
        , SerialNum
        , 'MISSING_PARENT'
        , 'Parent asset not found'
    FROM #Hierarchy h
    WHERE h.parent IS NOT NULL
      AND NOT EXISTS
      (
          SELECT 1
          FROM asset p
          WHERE p.assetnum = h.parent
            AND p.siteid = h.siteid
      );

    ------------------------------------------------------------------
    -- Self Referencing Assets
    ------------------------------------------------------------------

    INSERT INTO #Findings
    SELECT
          VehicleAsset
        , AssetNum
        , SerialNum
        , 'SELF_REFERENCE'
        , 'Asset references itself as parent'
    FROM #Hierarchy
    WHERE assetnum = parent;

    ------------------------------------------------------------------
    -- Vehicles Without Descendants
    ------------------------------------------------------------------

    INSERT INTO #Findings
    SELECT
          f.VehicleAsset
        , f.VehicleAsset
        , f.VehicleSerial
        , 'NO_HIERARCHY'
        , 'Vehicle has no ACM descendants'
    FROM #Fleet f
    WHERE NOT EXISTS
    (
        SELECT 1
        FROM #Hierarchy h
        WHERE h.VehicleAsset = f.VehicleAsset
          AND h.hierarchylevels > 0
    );

    ------------------------------------------------------------------
    -- Duplicate Child Assets
    ------------------------------------------------------------------

    INSERT INTO #Findings
    SELECT
          VehicleAsset
        , AssetNum
        , SerialNum
        , 'DUPLICATE_CHILD'
        , 'Asset appears multiple times in hierarchy'
    FROM #Hierarchy
    WHERE assetnum IN
    (
        SELECT assetnum
        FROM #Hierarchy
        GROUP BY assetnum
        HAVING COUNT(*) > 1
    );

    ------------------------------------------------------------------
    -- Final Report
    ------------------------------------------------------------------

    SELECT
          VehicleAsset
        , AssetNum
        , SerialNum
        , IssueType
        , Details
    FROM #Findings
    ORDER BY
          VehicleAsset
        , IssueType
        , AssetNum;

END;
GO
/****** Object:  StoredProcedure [dbo].[usp_ACM_FleetMigrationAssessment]    Script Date: 10/21/2026 3:05:21 PM ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
