create function [dbo].[LATEST_ACTUAL_READING] (@in_assetid bigint, @in_siteid varchar(20), @in_metername varchar(20), @in_asofdate datetime)
RETURNS @latestActualReadingValues TABLE 
(
    -- Columns returned by the function
    Out_LatestActualReading float, 
    Out_ComponentDate datetime, 
    Out_ComponentType varchar(20)
)
AS 
begin
	 DECLARE 
        @Out_LatestActualReading float, 
        @Out_ComponentDate datetime, 
        @Out_ComponentType varchar(20);
        
	declare c_readings cursor for
		select readingtype, readingdate, reading as total_reading
		from meterreading
		where assetid = @in_assetid
		and siteid = @in_siteid
		and metername = @in_metername
		and readingtype in (select value from synonymdomain where domainid = 'READINGTYPE' and maxvalue = 'ACTUAL')
		and readingdate <= @in_asofdate
		order by readingdate desc;
		
   	open c_readings
   	fetch next from c_readings into @Out_ComponentType, @Out_ComponentDate, @Out_LatestActualReading
   	close c_readings;
   	deallocate c_readings;
   	
   	INSERT @latestActualReadingValues
    SELECT @Out_LatestActualReading, @Out_ComponentDate, @Out_ComponentType;

	return ;
end;

