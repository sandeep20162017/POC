create function [dbo].[ANCHOR] (@in_assetid bigint, @in_siteid varchar(20), @in_metername varchar(20), @in_date datetime)
RETURNS @anchorReadingValues TABLE 
(
    -- Columns returned by the function
    Out_AnchorReading float, 
    Out_ComponentDate datetime, 
    Out_ComponentType varchar(20)
)
as
begin
	 DECLARE 
        @Out_AnchorReading float, 
        @Out_ComponentDate datetime, 
        @Out_ComponentType varchar(20);
        
	declare c_anchor cursor for
		select m.plusaanchorcount as anchorcount, m.plusaanchordate as anchordate, 'ANCHOR' as compType
		from asset a, assetmeter m
		where a.assetid = @in_assetid
		and a.siteid = @in_siteid
		and m.assetnum = a.assetnum
		and m.metername = @in_metername
		and m.siteid = @in_siteid
		and m.plusaanchordate <= @in_date;
		
	open c_anchor
   	fetch next from c_anchor into @Out_AnchorReading, @Out_ComponentDate, @Out_ComponentType
   	close c_anchor;
   	deallocate c_anchor;

   	INSERT @anchorReadingValues
    SELECT @Out_AnchorReading, @Out_ComponentDate, @Out_ComponentType;

	return;
end;

