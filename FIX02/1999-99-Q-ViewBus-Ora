--------------------------------------------------------
--  DDL for View VIEW_BUS_COST_ESTIMATE
--------------------------------------------------------

  CREATE OR REPLACE FORCE EDITIONABLE VIEW "CES"."VIEW_BUS_COST_ESTIMATE" ("VEHICLE_LIST_ID", "VEH_SERIES_CODE", "NUM_OF_VEHICLES", "PROJ_DESC", "DATE_ENTERED", "ENTERED_BY", "MODIFIED_LAST_BY", "MODIFIED_LAST_DATE", "MAKE", "MODEL", "YEAR", "ENGINE", "TRANSMISSION", "DIFFERENTIAL", "SOPNUMBER", "OVERHEAD", "TAX_RATE") AS 
  SELECT
VEHICLE_LIST.vehicle_list_id,
    substr(VEHICLE_LIST.veh_series_code,1,255),
    VEHICLE_LIST.num_of_vehicles,
    VEHICLE_LIST.proj_desc,
    VEHICLE_LIST.date_entered,
    VEHICLE_LIST.entered_by,
    VEHICLE_LIST.modified_last_by,
    VEHICLE_LIST.modified_last_date,
    VEHICLE_LIST.make,
    VEHICLE_LIST.model,
    VEHICLE_LIST.year,
    VEHICLE_LIST.engine,
    VEHICLE_LIST.transmission,
    VEHICLE_LIST.differential,
    VEHICLE_LIST.sopnumber,
    (SELECT REPLACE(CES_SETTINGS.value,',','.') AS OVERHEAD FROM CES_SETTINGS WHERE PARAMETER = 'OVERHEAD'),
    (SELECT REPLACE(CES_SETTINGS.value,',','.') AS TAX_RATE FROM CES_SETTINGS WHERE PARAMETER = 'TAX_RATE')
FROM VEHICLE_LIST
 
;
