          totalCost.TotalEffectiveHours = labourTasks.Sum(t => t.EffectiveHours);
          totalCost.TotalAdjustedHours = labourTasks.Sum(t => t.AdjustedHours);

          // Material Lines
          var materialLines = new List<MaterialLineItem>();
          foreach (var p in stockParts)
