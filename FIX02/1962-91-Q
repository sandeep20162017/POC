                  UnitCost = Convert.ToDecimal(p.UnitCost ?? 0),
                  PercentUsage = Convert.ToDecimal(p.PercentUsage ?? 0),
                  TotalCost = Convert.ToDecimal(p.TotalCost ?? 0),
