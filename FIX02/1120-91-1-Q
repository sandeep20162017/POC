DECLARE @Id VARCHAR(30) = 'MB143';
DECLARE @NPA DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'NON_PRODUCTIVE_ADJUSTMENT'), '1'), ',', '.') AS DECIMAL(18,6));
DECLARE @Overhead DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'OVERHEAD'), '0'), ',', '.') AS DECIMAL(18,6));
DECLARE @Fringe DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'FRINGE'), '0'), ',', '.') AS DECIMAL(18,6));
DECLARE @Benefit DECIMAL(18,6) = TRY_CAST(REPLACE(ISNULL((SELECT Value FROM SBCES.CESSETTINGS WHERE Parameter = 'BENEFIT'), '0'), ',', '.') AS DECIMAL(18,6));

WITH L AS (
    SELECT EL.Task, EL.LabourDefn, EL.Usage, EL.HrsReqd, EL.AdjHrs, EL.TimeAddition,
           CASE WHEN CHARINDEX(':', EL.HrsReqd) > 0
                THEN TRY_CAST(LEFT(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) - 1) AS DECIMAL(18,6))
                   + TRY_CAST(SUBSTRING(EL.HrsReqd, CHARINDEX(':', EL.HrsReqd) + 1, 10) AS DECIMAL(18,6)) / 60.0
                ELSE TRY_CAST(REPLACE(EL.HrsReqd, ',', '.') AS DECIMAL(18,6)) END AS ReqHrs,
           CASE WHEN CHARINDEX(':', EL.AdjHrs) > 0
                THEN TRY_CAST(LEFT(EL.AdjHrs, CHARINDEX(':', EL.AdjHrs) - 1) AS DECIMAL(18,6))
                   + TRY_CAST(SUBSTRING(EL.AdjHrs, CHARINDEX(':', EL.AdjHrs) + 1, 10) AS DECIMAL(18,6)) / 60.0
                ELSE TRY_CAST(REPLACE(EL.AdjHrs, ',', '.') AS DECIMAL(18,6)) END AS WrenchHrs,
           TRY_CAST(REPLACE(CAST(EL.TimeAddition AS VARCHAR(30)), ',', '.') AS DECIMAL(18,6)) AS TimeAddHrs,
           TRY_CAST(REPLACE(CAST(EL.Usage AS VARCHAR(30)), ',', '.') AS DECIMAL(18,6)) AS UsagePct,
           -- rate as the C# currently looks it up
           (SELECT TOP 1 ES.RatePerHour FROM CES.SBCES.EmployeeSalaries ES
             WHERE ES.WageGroup = (SELECT TOP 1 EC.WageGroup FROM CES.SBCES.EmplClass EC
                                   WHERE EC.LabourDefn LIKE '%' + EL.LabourDefn + '%')) AS RateLike,
           -- rate as Oracle looks it up (exact match)
           (SELECT TOP 1 ES.RatePerHour FROM CES.SBCES.EmployeeSalaries ES
             JOIN CES.SBCES.EmplClass EC ON ES.WageGroup = EC.WageGroup
             WHERE UPPER(EC.LabourDefn) = UPPER(EL.LabourDefn)) AS RateExact
    FROM SBCES.EmployeeLabour EL
    WHERE EL.LinkNumber = @Id AND EL.TypeId = 'MB'
)
SELECT Task, LabourDefn, UsagePct, HrsReqd, AdjHrs, TimeAddition, RateLike, RateExact,
       @NPA AS NonProductiveAdj, @Overhead AS OverheadSetting, @Fringe AS Fringe, @Benefit AS Benefit,
       ReqHrs * UsagePct / 100 * RateExact                AS A_HrsReqd,
       ReqHrs * UsagePct / 100 / @NPA * RateExact         AS B_HrsReqd_div_NPA,
       WrenchHrs * UsagePct / 100 * RateExact             AS C_WrenchTime,
       TimeAddHrs * UsagePct / 100 * RateExact            AS D_TimeAddition,
       101.04 * @Overhead                                 AS OverheadIf101_04
FROM L;
