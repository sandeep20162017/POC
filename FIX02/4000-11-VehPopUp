                ];

                textFields.forEach(function (name) {
                    var combo = container.find("[name='" + name + "']").data("kendoComboBox");
                    var txt = container.find("[name='" + name + "']").data("kendoTextBox");
                    var input = container.find("[name='" + name + "']");

