/* ---- Kendo pager: force numbered pages to show ---- */
#userGrid .k-pager-wrap,
#userGrid .k-grid-pager {
    display: flex !important;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
}

#userGrid .k-pager-numbers-wrap {
    display: inline-flex !important;
    align-items: center;
}

#userGrid .k-pager-numbers {
    display: inline-flex !important;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2px;
}

#userGrid .k-pager-numbers li {
    display: inline-block !important;
}

#userGrid .k-pager-numbers .k-link,
#userGrid .k-pager-numbers .k-state-selected,
#userGrid .k-pager-numbers .k-selected {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-width: 2em;
    height: 2em;
    padding: 0 .5em;
    visibility: visible !important;
    opacity: 1 !important;
    font-size: 14px;
    line-height: 1;
    color: #333;
    text-decoration: none;
}

/* current page highlight */
#userGrid .k-pager-numbers .k-state-selected,
#userGrid .k-pager-numbers .k-selected {
    background: #0d6efd;
    color: #fff;
    border-radius: 3px;
}

/* items-per-page / "1 - 10 of 65" text */
#userGrid .k-pager-info {
    display: inline-block !important;
    margin-left: auto;
}
