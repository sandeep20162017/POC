    // Populate Material Lines
    function populateMaterialLines(lines) {
        var tbody = $('#materialLinesBody');
        var badge = $('#materialLinesBadge');
        var totalItems = lines.length;
        badge.text(totalItems + ' items');

        if (totalItems === 0) {
            tbody.html('<tr><td colspan="8" style="text-align:center; color:#6c757d; padding:20px;">No material items found</td></tr>');
            return;
        }

        var html = '';
        var typeTotals = { Stock: 0, Rebuilt: 0, 'Non-Stock': 0 };
        var grandTotal = 0;

        lines.forEach(function(item) {
            var type = item.Type || 'Stock';
            var typeClass = type.toLowerCase().replace('-', '');
            var badgeClass = typeClass === 'nonstock' ? 'nonstock' : typeClass;
            var totalCost = getVal(item.TotalCost);

            if (typeTotals[type] !== undefined) {
                typeTotals[type] += totalCost;
            }
            grandTotal += totalCost;

            html += '<tr class="type-' + typeClass + '">' +
                '<td><span class="type-badge ' + badgeClass + '">' + type + '</span></td>' +
                '<td>' + (item.StockCode || '-') + '</td>' +
                '<td>' + (task.CC || '-') + '</td>' +
                '<td>' + (item.Description || 'N/A') + '</td>' +
                '<td style="text-align:right;">' + getVal(item.Quantity).toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + formatMoney(getVal(item.UnitCost)) + '</td>' +
                '<td style="text-align:right;">' + getVal(item.PercentUsage).toFixed(1) + '%</td>' +
                '<td style="text-align:right; font-weight:600;">' + formatMoney(totalCost) + '</td>' +
                '</tr>';
        });

        // Add type subtotals
        var typeOrder = ['Stock', 'Rebuilt', 'Non-Stock'];
        typeOrder.forEach(function(type) {
            if (typeTotals[type] > 0) {
                html += '<tr class="subtotal-row">' +
                    '<td colspan="6" style="text-align:right; font-weight:600;">Subtotal - ' + type + '</td>' +
                    '<td style="text-align:right; font-weight:600;">' + formatMoney(typeTotals[type]) + '</td>' +
                    '</tr>';
            }
        });

        // Add grand total
        html += '<tr class="total-row">' +
            '<td colspan="6" style="text-align:right; font-weight:800; font-size:1.05em;">GRAND TOTAL</td>' +
            '<td style="text-align:right; font-weight:800; font-size:1.05em;">' + formatMoney(grandTotal) + '</td>' +
            '</tr>';

        tbody.html(html);
    }

    // Populate Task Summary
    function populateTaskSummary(tasks) {
        var tbody = $('#taskSummaryBody');
        var badge = $('#taskCountBadge');
        badge.text(tasks.length + ' tasks');

        if (tasks.length === 0) {
            tbody.html('<tr><td colspan="9" style="text-align:center; color:#6c757d; padding:20px;">No labour tasks found</td></tr>');
            return;
        }

        var html = '';
        var totalHours = 0, totalEffective = 0, totalAdjusted = 0, totalCost = 0;

        tasks.forEach(function(task) {
            var hours = getVal(task.Hours);
            var effective = getVal(task.EffectiveHours);
            var adjusted = getVal(task.AdjustedHours);
            var cost = getVal(task.TotalCost);
            var count = getVal(task.Count);

            totalHours += hours;
            totalEffective += effective;
            totalAdjusted += adjusted;
            totalCost += cost;

            html += '<tr>' +
                '<td>' + (task.Task || 'Unnamed') + '</td>' +
                '<td>' + (task.LabourDefinition || 'N/A') + '</td>' +
                 '<td>' + (task.CC || '-') + '</td>' +
                '<td style="text-align:right;">' + hours.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + effective.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + adjusted.toFixed(2) + '</td>' +
                '<td style="text-align:right;">' + formatMoney(getVal(task.RatePerHour)) + '</td>' +
                '<td style="text-align:right; font-weight:600;">' + formatMoney(cost) + '</td>' +
                '<td style="text-align:center;">' + count + '</td>' +
                '</tr>';
        });

        // Total row
        html += '<tr class="total-row">' +
            '<td colspan="3"><strong>TOTAL</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalHours.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalEffective.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"><strong>' + totalAdjusted.toFixed(2) + '</strong></td>' +
            '<td style="text-align:right;"></td>' +
            '<td style="text-align:right;"><strong>' + formatMoney(totalCost) + '</strong></td>' +
            '<td style="text-align:center;"><strong>' + tasks.length + '</strong></td>' +
            '</tr>';

        tbody.html(html);
    }
