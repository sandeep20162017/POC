function resetNscSupplierFields(popup, model, clearSupplierName) {
var nameCombo = null;
if (clearSupplierName) {
nameCombo = popup.find("[data-role='combobox']")
.filter(function () {
var n = $(this).attr("name") || "";
var i = $(this).attr("id") || "";
return n.indexOf("OrigSupplierName") > -1 || i.indexOf("OrigSupplierName") > -1;
})
.data("kendoComboBox");
if (nameCombo) {
nameCombo.value("");
nameCombo.text("");
nameCombo.dataSource.data([]); // drop names cached for the previous supplier number
}
if (model) model.set("OrigSupplierName", "");
}
if (model) {
["KeyWord", "Description", "UnitCost", "Qty", "Percentage", "TotalCost"].forEach(function (f) {
model.set(f, "");
});
model.trigger("change");
}
return nameCombo;
}

function onSupplierNumChange(e) {
var supplierNumCombo = e.sender;
var popup = supplierNumCombo.wrapper.closest(".k-window-content");
var editable = popup.data("kendoEditable");
var model = (editable && editable.options && editable.options.model)
? editable.options.model : currentNscPartsModel;

// 1. Supplier Number must be an item of the list; typed text alone is not accepted
var typed = $.trim(supplierNumCombo.text() || "");
var item = supplierNumCombo.dataItem();
if (item && String(item.Text).toLowerCase() !== typed.toLowerCase()) item = null;
if (!item && typed) {
    var view = supplierNumCombo.dataSource.view();
    for (var i = 0; i < view.length; i++) {
        if (String(view[i].Text).toLowerCase() === typed.toLowerCase()) {
            supplierNumCombo.select(i);
            item = view[i];
            break;
        }
    }
}

// 4. A new Supplier Number clears Supplier Name (selection + cached list) and the dependent fields
var nameCombo = resetNscSupplierFields(popup, model, true);

if (!item) {
    supplierNumCombo.value("");
    supplierNumCombo.text("");
    if (model) model.set("OrigSuppNum", "");
    if (typed) kendo.alert("Select a Supplier Number from the list.");
    return;
}

if (model && model.get("OrigSuppNum") !== item.Text) model.set("OrigSuppNum", item.Text);

// 2. Re-fetch Supplier Names for the new number (getSupplierNameParams reads the number combo)
if (nameCombo) nameCombo.dataSource.read();

}

