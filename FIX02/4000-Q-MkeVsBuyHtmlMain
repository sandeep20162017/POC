        function disableDependentFields(popup, disable) {
                // Qty and Percentage must ALWAYS stay enabled
                const fields = ["KeyWord", "Description", "UnitCost", "TotalCost"];

                fields.forEach(function (f) {
                    var input = popup.find("[name*='" + f + "']");

                    if (input.length) {
                        var numeric = input.data("kendoNumericTextBox");
                        if (numeric) {
                            numeric.enable(!disable);
                            return;
                        }

                        var textbox = input.data("kendoTextBox");
                        if (textbox) {
                            textbox.enable(!disable);
                            return;
                        }

                        input.prop("disabled", disable);
                    }
                });
            }


            // AUTO-CALCULATE TOTAL COST WITH DEBUG
                        // AUTO-CALCULATE TOTAL COST WITH DEBUG
            $(document).on("change",
                "input[name='Qty'], input[name='UnitCost'], input[name='Percentage']",
                function () {

                console.warn("=== TOTAL COST CALCULATION TRIGGERED ===");

                // ACTIVE Telerik popup editor
                var popup = $(".k-edit-form-container:visible");

                console.warn("Popup found:", popup.length > 0);

                if (!popup.length) {
                    console.error("❌ No visible popup editor found.");
                    return;
                }

                // DEBUG INPUTS
                console.warn("Raw Qty input:", popup.find("input[name='Qty']")[0]);
                console.warn("Raw UnitCost input:", popup.find("input[name='UnitCost']")[0]);
                console.warn("Raw Percentage input:", popup.find("input[name='Percentage']")[0]);

                // WIDGETS
                var qtyWidget = popup.find("input[name='Qty']").data("kendoNumericTextBox");
                var unitCostWidget = popup.find("input[name='UnitCost']").data("kendoTextBox");
                var percentageWidget = popup.find("input[name='Percentage']").data("kendoNumericTextBox");

                console.warn("qtyWidget:", qtyWidget);
                console.warn("unitCostWidget:", unitCostWidget);
                console.warn("percentageWidget:", percentageWidget);

                if (!qtyWidget || !unitCostWidget || !percentageWidget) {
                    console.error("❌ One or more widgets NOT FOUND");
                    return;
                }

                // VALUES
                var qty = qtyWidget.value() || 0;
                var unitCost = unitCostWidget.value() || 0;

                var percentage = parseFloat(percentageWidget.element.val()) || 0;

                console.warn("Extracted values → qty:", qty,
                    "unitCost:", unitCost,
                    "percentage:", percentage
                );

                var total = qty * unitCost * (percentage / 100);

                console.warn("CALCULATION → qty:", qty,
                    "× unitCost:", unitCost,
                    "× (percentage/100):", (percentage / 100),
                    "= total:", total
                );

                //////////////////////////////////////////////////////
                // GET EDITABLE MODEL
                //////////////////////////////////////////////////////

                var popupWindow = popup.closest(".k-window-content");
                var editable = popupWindow.data("kendoEditable");
                var model = editable?.options?.model;

                            //////////////////////////////////////////////////////
            // Get Telerik popup editable model
            //////////////////////////////////////////////////////

            console.warn("=== DEBUG: GRID + MODEL INSPECTION ===");

            var popupWindow = popup.closest(".k-window-content");
            console.warn("popupWindow:", popupWindow);

            var editable = popupWindow.data("kendoEditable");
            console.warn("editable:", editable);

            // IMPORTANT: fallback-safe model access
            var model =
                editable?.options?.model ||
                editable?.model;

            console.warn("Detected model:", model);

            if (!model) {
                console.error("❌ No Telerik editable model found.");
                return;
            }

            console.warn("Model BEFORE update:", model.toJSON());

            //////////////////////////////////////////////////////
            // Sync values FIRST
            //////////////////////////////////////////////////////

            model.set("Qty", qty);
            model.set("UnitCost", unitCost);
            model.set("Percentage", percentage);
            model.set("LastModifiedBy", "");
            model.set("LastModifiedDate", "");


            //////////////////////////////////////////////////////
            // FIX 1: Force correct TotalCost assignment
            //////////////////////////////////////////////////////

            console.warn("Updating model.TotalCost →", total);

            model.set("TotalCost", total);

             console.warn("Updating model.LastModifiedBy → System");




            // CRITICAL: force Kendo dirty tracking
            model.dirty = true;

            // FORCE notify
            if (model.trigger) {
                model.trigger("change", { field: "TotalCost" });

            }

            console.warn("Model AFTER update:", model.toJSON());

            //////////////////////////////////////////////////////
            // FIX 2: UPDATE DATA SOURCE ITEM (THIS FIXES PARENT GRID)
            //////////////////////////////////////////////////////

            var gridName = $("#nscGridNameField").val();
            console.warn("Grid name:", gridName);

            if (gridName) {

                var parentGrid = $("#" + gridName).data("kendoGrid");

                if (parentGrid) {

                    // IMPORTANT FIX: use UID (NOT id, NOT custom field)
                    var dataItem = parentGrid.dataSource.getByUid(model.uid);

                    console.warn("Parent datasource item:", dataItem);

                    if (dataItem) {

                        dataItem.set("TotalCost", total);
                        dataItem.dirty = true;

                        // force sync so parent grid does NOT reset to 0
                        parentGrid.dataSource.sync();

                        console.warn("Parent datasource updated + synced.");
                    } else {
                        console.warn("❌ Could not locate datasource row by UID.");
                    }

                    parentGrid.refresh();
                }
            }

            //////////////////////////////////////////////////////
            // Update popup widget
            //////////////////////////////////////////////////////

            var totalCostWidget = popup.find("input[name='TotalCost']").data("kendoNumericTextBox");

            console.warn("totalCostWidget:", totalCostWidget);


            if (totalCostWidget) {

                console.warn("Updating TotalCost widget →", total);

                totalCostWidget.value(total);
                totalCostWidget.trigger("change");
            }

            //////////////////////////////////////////////////////
            // Refresh grid (final safety)
            //////////////////////////////////////////////////////

            if (gridName) {
                var parentGrid = $("#" + gridName).data("kendoGrid");
                if (parentGrid) {
                    parentGrid.refresh();
                }
            }

            console.warn("=== END TOTAL COST CALCULATION ===");
            });
