<script>
    let popupHasChanges = false; /* closing x */
    let originalData = {}; /* closing x */

     // ====== GLOBAL STATE ======
    window.pendingChanges = false;
    window.currentMbNumber = "0";   // always a string
    window.tabContentLoaded = [false, false, false, false, false, false, false, false, false];
    window.currentlyLoadingTab = null;

    // ====== READONLY HANDLER ======
    window.setPopupReadonly = function (ids) {
            console.warn('setPopupReadonly');
            ids.forEach(function (id) {
                var widget = getKendoWidget(id);
                console.warn('setPopupReadonly widget:');
                console.warn(widget);


                if (widget) {
                    widget.enable(false);
                } else {
                    $("#" + id).prop("readonly", true).addClass("k-state-disabled");
                }
            });
        };

    // ====== EDITABLE HANDLER ======
    window.setPopupEditable = function (ids) {
            console.warn('setPopupEditable');
            console.warn(ids);


            ids.forEach(function (id) {
                var widget = getKendoWidget(id);
                console.warn(id);
                console.warn('widget:');
                 console.warn(widget);

                if (widget) {
                    widget.enable(true);
                } else {
                    $("#" + id).prop("readonly", false).removeClass("k-state-disabled");
                }
            });
        };

    // ====== KENDO WIDGET DETECTOR ======
    window.getKendoWidget = function (id) {
        var element = $("#" + id);
        return element.data("kendoComboBox") ||
            element.data("kendoDropDownList") ||
            element.data("kendoNumericTextBox") ||
            element.data("kendoDatePicker") ||
            element.data("kendoTextBox") ||
            element.data("kendoMaskedTextBox");
    };

    // ====== FORM INITIALIZER ======
    window.initMakeVsBuyPopupForm = function () {
        var mode = $("#formMode").val();
        if (!mode) return;

        var ddl = $("#MbPrefix").data("kendoDropDownList");

        if (ddl) {
            ddl.bind("change", function () {
                $("#MbPrefixHidden").val(this.value());
            });
        }

        setTimeout(function () {

            if (mode === "Add") {
                if (ddl) {
                    ddl.enable(true);
                    ddl.value("MBD");
                    $("#MbPrefixHidden").val("MBD");
                }

                setPopupEditable(["MbPrefix"]);
                setPopupReadonly(["DateOpened", "MbNumber"]);
            }
            else {
                var prefix = $("#MbPrefixHidden").val();

                if (ddl) {
                    if (!prefix) {
                        ddl.value("");
                        setTimeout(() => ddl.text("Legacy Estimate"), 50);
                    } else {
                        ddl.value(prefix);
                    }
                    ddl.enable(false);
                }

                setPopupReadonly([
                    "DateOpened", "Keyword", "Description",
                    "BusType", "NumBusComp", "VendorPartNum",
                    "BuyCode", "RebuildCode", "CoreCode", "AnnualUsage",
                    "BenchNumber", "SampleProvided", "Recommendation",
                    "BuyNewCost", "InternalCost", "SopNumber",
                    "CoreCost", "JobNumber"
                ]);

                setPopupEditable([ "DateOpened", "Keyword", "Description",
                    "BusType", "NumBusComp", "VendorPartNum",
                    "BuyCode", "RebuildCode", "CoreCode", "AnnualUsage",
                    "BenchNumber", "SampleProvided", "Recommendation",
                    "BuyNewCost", "InternalCost", "SopNumber",
                    "CoreCost", "JobNumber"]);
            }

        }, 300);
    };

    // ====== MAIN LOADER (TABS FIXED HERE) ======
        window.loadMakeVsBuyForm = function (mbNumber, callback) {

        console.warn("=== loadMakeVsBuyForm START ===");
        console.warn("Incoming mbNumber:", mbNumber, " type:", typeof mbNumber);

        // Store globally
        window.currentMbNumber = mbNumber;

        $.get('/MakeVsBuy/GetMakeVsBuyById', { id: mbNumber }, function (html) {

            $("#makevsbuyTabContent").html(html);
            window.tabContentLoaded[0] = true;

            kendo.init($("#makevsbuyTabContent"));
            window.wireMakeVsBuyForm();

            setTimeout(() => window.initMakeVsBuyPopupForm(), 100);

            console.warn("=== TAB LOGIC START ===");

            var tabStrip = $("#estimateTabs").data("kendoTabStrip");

            console.warn("TabStrip found:", !!tabStrip);

            // Determine if tabs should be enabled
            var hasValue = mbNumber !== 0 && mbNumber !== "0" && mbNumber !== null;
    ``

            console.warn("mbNumber:", mbNumber);
            console.warn("typeof mbNumber:", typeof mbNumber);
            console.warn("hasValue (should tabs be enabled?):", hasValue);

            if (tabStrip) {
                for (var i = 1; i <= 8; i++) {
                    var tab = tabStrip.tabGroup.children().eq(i);
                    console.warn("Setting tab", i, "enabled =", hasValue);
                    tabStrip.enable(tab, hasValue);
                }
            } else {
                console.error("TabStrip NOT FOUND");
            }

            console.warn("=== TAB LOGIC END ===");

            if (typeof callback === "function") callback();
        });
    };




    // ── Wire up form submit and cancel actions
    window.wireMakeVsBuyForm = function () {
        $("#btnCancelMakeVsBuy").off("click").on("click", function () {
            console.warn('**** on cancel click - window.wireMakeVsBuyForm');
            if (pendingChanges) {
                showCloseConfirmation();
            } else {
                var win = $("#estimatePopup").data("kendoWindow");
                win.close();

                // Refresh and focus main grid
                var grid = $("#MakeVsBuyGrid").data("kendoGrid");
                if (grid) {
                    grid.dataSource.read();
                    grid.table.focus();
                }
            }
        });

        $("#btnSaveMakeVsBuy").off("click").on("click", function (e) {
            e.preventDefault();
            $("#makevsbuyForm").submit();
        });

        $("#makevsbuyForm").off("submit").on("submit", function (e) {
            e.preventDefault();

            // Validate form here if needed

            var vm = {
                MbNumber: $("#MbNumber").val(),
                MbPrefix: $("#MbPrefix").val() || $("#MbPrefixHidden").val(),
                Keyword: $("#Keyword").val(),
                Description: $("#Description").val(),
                BusType: $("#BusType").val(),
                NumBusComp: $("#NumBusComp").val(),
                VendorPartNum: $("#VendorPartNum").val(),
                BuyCode: $("#BuyCode").val(),
                RebuildCode: $("#RebuildCode").val(),
                CoreCode: $("#CoreCode").val(),
               
                BenchNumber: $("#BenchNumber").val(),
                SampleProvided: $("#SampleProvided").val(),
                CoreCost: $("#CoreCost").val(),
                 AnnualUsage: $("#AnnualUsage").val(),
                BenchNumber: $("#BenchNumber").val(),
                SopNumber: $("#SopNumber").val(),

                 JobNumber: $("#JobNumber").val(),
                InternalCost: $("#InternalCost").val(),
                RemanCost: $("#RemanCost").val(),
                BuyNewCost: $("#BuyNewCost").val(),

                Recommendation: $("#Recommendation").val()
            };
            console.warn("window.currentMbNumber", window.currentMbNumber);
            var url = !window.currentMbNumber || window.currentMbNumber === "0"
                ? '/MakeVsBuy/AddMakeVsBuyView'
                : '/MakeVsBuy/UpdateMakeVsBuyView';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: "application/json",
                data: JSON.stringify(vm),
                success: function (response) {
                    if (response && response.MbNumber) {
                        pendingChanges = false;
                        $("#estimatePopup").data("kendoWindow").unbind("close");
                        window.currentMbNumber = response.MbNumber;
                        $("#MakeVsBuyGrid").data("kendoGrid").dataSource.read();

                        // Update window title with new ID
                        var win = $("#estimatePopup").data("kendoWindow");
                       

                        win.title("Make Vs Buy Estimate #" + window.currentMbNumber);

                        

                        //kendo.alert(" Estimate #: " + response.VehicleListId + " Saved successfully!");
                       // $("#ScPartsPopupWindow").data("kendoWindow").close();
                       //Enable all the tabs
                        console.warn('calling alert');

                        var alertWindow = kendo.alert("Estimate #: " + response.MbNumber + " saved successfully!");

                        if (alertWindow && alertWindow.bind) {
                            alertWindow.bind("close", function () {
                                console.warn('calling enableAllTabs');
                                //enableAllTabs();
                                var ts = $("#estimateTabs").data("kendoTabStrip");
                                for (var i = 1; i <= 8; i++) {
                                    console.log('enabling tabs');
                                    ts.enable(ts.tabGroup.children().eq(i), true);
                                }
                                // Refresh main Vehicle grid
                                console.warn('loadMakeVsBuyForm - A');
                                console.warn('window.currentMbNumber :', window.currentMbNumber);
                                loadMakeVsBuyForm(window.currentMbNumber, function () {
                                    setPopupReadonly([
                                        "MbNumber", "Keyword", "Description",
                                        "BusType", "NumBusComp", "VendorPartNum",
                                        "BuyCode", "RebuildCode", "CoreCode", "AnnualUsage",
                                        "BenchNumber", "SampleProvided", "Recommendation", "BuyNewCost", 
                                        "InternalCost", "SopNumber", "CoreCost", "JobNumber"
                                    ]);

                                    setPopupEditable(["Keyword"]);
                                });

                                //////////////////////
                            });
                            
                        }
                    } else {
                        kendo.alert("Save succeeded.");
                      //  $("#estimatePopup").data("kendoWindow").close();
                    }
                },
                error: function () {
                    kendo.alert("Error saving estimate, verify required fields.");
           
                    }
                
            });
        });

        // Track form changes
        $("#makevsbuyForm input, #makevsbuyForm select").off("change input").on("input change", function () {
            pendingChanges = true;
        });
    }

    // ── Open vehicle popup and load form partial
    window.openEstimatePopup = function (mbNumber) {
        console.warn('inside window.openEstimatePopup');
        var win = $("#estimatePopup").data("kendoWindow");
        console.warn("mbNumber",mbNumber);
        window.currentMbNumber = mbNumber;
        pendingChanges = false; // Reset changes flag

        win.title(!mbNumber ? "Add New Estimate" : " Make vs Buy Estimate #" + mbNumber);
        win.center().open();

        // Load vehicle tab first
        $("#makevsbuyTabContent").load('/MakeVsBuy/GetMakeVsBuyById', { id: mbNumber }, function () {
            // Initialize Kendo UI widgets in the loaded content
            kendo.init($("#makevsbuyTabContent"));

            // Set values for Kendo widgets after initialization
            setTimeout(function () {
                // Set values for ComboBoxEditor fields
                setComboBoxValues();
                initMakeVsBuyPopupForm();
                wireMakeVsBuyForm();
            }, 300);

            if (mbNumber && mbNumber !== 0 && mbNumber !== "0")  {
                //enableAllTabs();
                
                var ts = $("#estimateTabs").data("kendoTabStrip");
                for (var i = 1; i <= 8; i++) {
                    console.log('enabling tabs');
                    ts.enable(ts.tabGroup.children().eq(i), true);
                }

            }
        });
    };

    // ── Delete handler
    window.showDeleteConfirmation = function (e) {
        e.preventDefault();
        var grid = this; // Kendo Grid instance
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));
        if (!dataItem) {
            console.error("No dataItem found for delete action");
            return;
        }

        var dlg = $("#deleteConfirmationDialog").data("kendoWindow");
        dlg.center().open();

        $("#confirmDeleteBtn").off("click").on("click", function () {
            $.post('/MakeVsBuy/DeleteMakeVsBuy', { MbNumber: dataItem.MbNumber }, function () {
                grid.dataSource.read();
                dlg.close();
            });
        });

        $("#cancelDeleteBtn").off("click").on("click", function () {
            dlg.close();
        });
    };

    // ── Copy estimate handler
    window.onCopyEstimate = function (e) {
        e.preventDefault();
        var grid = $("#MakeVsBuyGrid").data("kendoGrid");
        var item = grid.dataItem($(e.currentTarget).closest("tr"));
        var win = $("#copyEstimateDialog").kendoWindow({
            title: "Copy Estimate",
            modal: true,
            width: 400,
            visible: false
        }).data("kendoWindow");

        $("#oldMbNumber").val(item.MbNumber);
        $("#oldKeyword").val(item.Keyword);
        $("#oldRebuiltStockNum").val(item.RebuildCode);
       // $("#newVehSeriesCode, #newprojDesc").val("");

        win.center().open();

        // Wire up copy button
        $("#copyEstimateBtn").off("click").on("click", function () {
            var payload = {
                oldMbNumber: $("#oldMbNumber").val(),
                oldKeyword: $("#oldKeyword").val(),
                oldRebuiltStockNum: $("#oldRebuiltStockNum").val(),
                
                newMbNumber: $("#newMbNumber").val(),
                 newKeyword: $("#newKeyword").val(),
                newRebuiltStockNum: $("#newRebuiltStockNum").val()
            };
             if(!payload.newMbNumber || !payload.newKeyword) {
                return kendo.alert("Please fill required fields.")
               }

            $.ajax({
                url: '/MakeVsBuy/CopyEstimate',
                type: 'POST',
                contentType: "application/json",
