def main():
    oracle_conn = get_oracle_conn()
    sql_conn = get_sql_conn()

    delete_sql_table(sql_conn, "MbList")
    delete_sql_table(sql_conn, "ScPartsUsed")

    migrate_mblist(oracle_conn, sql_conn)
