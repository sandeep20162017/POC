SET SERVEROUTPUT ON
DECLARE
    rc  SYS_REFCURSOR;
    v_total NUMBER; v_rb VARCHAR2(30); v_desc VARCHAR2(250);
    v_ext VARCHAR2(25); v_active NUMBER; v_keyword VARCHAR2(250); v_var NUMBER;
BEGIN
    CES.CES_INQUIRY.RPT_COST_VARIANCE_2(rc);
    LOOP
        FETCH rc INTO v_total, v_rb, v_desc, v_ext, v_active, v_keyword, v_var;
        EXIT WHEN rc%NOTFOUND;
        DBMS_OUTPUT.PUT_LINE(v_rb||' | '||v_total||' | '||v_ext||' | '||v_var);
    END LOOP;
    CLOSE rc;
END;
/
