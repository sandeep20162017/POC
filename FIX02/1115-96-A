SET SERVEROUTPUT ON
DECLARE
    rc          CES_INQUIRY.query_cur;   -- use the package's cursor type
    v_total     NUMBER;
    v_rb        VARCHAR2(30);
    v_desc      VARCHAR2(250);
    v_ext       VARCHAR2(25);
    v_active    NUMBER;
    v_keyword   VARCHAR2(250);
    v_variance  NUMBER;
BEGIN
    CES_INQUIRY.RPT_COST_VARIANCE_2(rc);
    LOOP
        FETCH rc INTO v_total, v_rb, v_desc, v_ext, v_active, v_keyword, v_variance;
        EXIT WHEN rc%NOTFOUND;
        DBMS_OUTPUT.PUT_LINE(v_rb || ' | ' || v_total || ' | ' || v_ext || ' | ' || v_variance);
    END LOOP;
    CLOSE rc;
END;
/
