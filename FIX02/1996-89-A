@{
    ViewData["Title"] = "Vehicle Cost Summary";
}

<style>
    /* ===== BASE STYLES ===== */
    * {
        box-sizing: border-box;
    }

    .total-cost-body {
        font-family: 'Segoe UI', 'Roboto', Arial, sans-serif;
        background: #eef2f5;
        margin: 0;
        padding: 20px;
        overflow-y: auto;
    }

    .report-container {
        max-width: 1400px;
        margin: 0 auto;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        padding: 25px 30px 35px 30px;
        position: relative;
    }

    .report-header {
        text-align: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 3px solid #2c3e50;
    }

    .report-header h1 {
        margin: 0 0 8px 0;
        color: #1a5276;
        font-size: 28px;
        letter-spacing: 1px;
    }

    .report-header .subtitle {
        color: #5d6d7e;
        font-size: 13px;
        font-family: monospace;
    }

    /* ===== SECTION STYLES ===== */
    .detail-section {
        margin-bottom: 20px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        page-break-inside: avoid;
        break-inside: avoid;
    }

    .detail-header {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 10px 20px;
        font-weight: 700;
        font-size: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 40px;
    }

    .detail-header .badge {
        background: rgba(255,255,255,0.2);
        padding: 3px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 400;
    }

    .detail-body {
        padding: 12px 18px;
    }

    /* ===== VEHICLE INFO - UPDATED with Make, Model, Year, # Vehicles ===== */
    .vehicle-info {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .vehicle-info-item {
        display: flex;
        flex-direction: column;
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 6px;
        border-left: 4px solid #2c3e50;
        min-height: 55px;
    }

    .vehicle-info-item .label {
        font-size: 10px;
        color: #6c757d;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .vehicle-info-item .value {
        font-size: 15px;
        font-weight: 600;
        color: #1a5276;
        margin-top: 2px;
        word-break: break-word;
    }

    /* ===== SUMMARY CARDS - UPDATED labels ===== */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 10px;
    }

    .summary-card {
        background: #f8f9fa;
        padding: 10px 12px;
        border-radius: 6px;
        text-align: center;
        border: 1px solid #e9ecef;
        transition: all 0.2s;
        min-height: 65px;
    }

    .summary-card:hover {
        background: #e8f0fe;
        border-color: #1a5276;
    }

    .summary-card .value {
        font-size: 20px;
        font-weight: 700;
        color: #1a5276;
        display: block;
    }

    .summary-card .value.green { color: #27ae60; }
    .summary-card .value.blue { color: #2980b9; }
    .summary-card .value.orange { color: #e67e22; }
    .summary-card .value.purple { color: #8e44ad; }
    .summary-card .value.red { color: #c0392b; }

    .summary-card .label {
        font-size: 10px;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 4px;
        display: block;
    }

    /* ===== MATERIAL LINES TABLE ===== */
    .material-table-wrap {
        overflow-x: auto;
        margin-top: 5px;
        max-height: 500px;
        overflow-y: auto;
    }

    .material-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

    .material-table th {
        background: #2c3e50;
        color: white;
        padding: 8px 10px;
        text-align: left;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .material-table td {
        padding: 6px 10px;
        border-bottom: 1px solid #e0e4e8;
        height: 32px;
    }

    .material-table tr:hover td {
        background: #f8f9fa;
    }

    .material-table tr.type-stock td:first-child { border-left: 3px solid #27ae60; }
    .material-table tr.type-rebuilt td:first-child { border-left: 3px solid #e67e22; }
    .material-table tr.type-nonstock td:first-child { border-left: 3px solid #2980b9; }

    .material-table .type-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 600;
    }

    .type-badge.stock { background: #d5f5e3; color: #1a7a3a; }
    .type-badge.rebuilt { background: #fdebd0; color: #a04000; }
    .type-badge.nonstock { background: #d6eaf8; color: #1a5276; }

    .material-table .total-row td {
        background: #e8f0fe;
        font-weight: 700;
        border-top: 2px solid #2c3e50;
        padding-top: 10px;
    }

    .material-table .subtotal-row td {
        background: #f0f3f7;
        font-weight: 600;
        border-top: 1px solid #cbd5e1;
    }

    .material-table .subtotal-row td:first-child {
        padding-left: 20px;
    }

    /* ===== TASK TABLE ===== */
    .task-table-wrap {
        overflow-x: auto;
        margin-top: 5px;
        max-height: 400px;
        overflow-y: auto;
    }

    .task-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

    .task-table th {
        background: #2c3e50;
        color: white;
        padding: 8px 10px;
        text-align: left;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .task-table td {
        padding: 6px 10px;
        border-bottom: 1px solid #e0e4e8;
        height: 30px;
    }

    .task-table tr:hover td {
        background: #f8f9fa;
    }

    .task-table .total-row td {
        background: #e8f0fe;
        font-weight: 700;
        border-top: 2px solid #2c3e50;
        padding-top: 10px;
    }

    .task-table .text-right { text-align: right; }
    .task-table .text-center { text-align: center; }

    /* ===== SIDE BY SIDE ===== */
    .side-by-side {
        display: flex;
        gap: 25px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .material-section, .labour-section {
        flex: 1;
        min-width: 280px;
        background: #ffffff;
        border: 2px solid #2c3e50;
        border-radius: 8px;
        overflow: hidden;
        page-break-inside: avoid;
        break-inside: avoid;
    }

    .material-header, .labour-header {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 10px 20px;
        font-size: 15px;
        font-weight: 700;
        text-align: center;
        letter-spacing: 1px;
        min-height: 38px;
    }

    .material-body, .labour-body {
        padding: 12px 18px;
    }

    /* ===== INFO TABLE ===== */
    .info-table {
        width: 100%;
        border-collapse: collapse;
    }

    .info-table tr {
        border-bottom: 1px solid #e0e4e8;
    }

    .info-table tr:last-child {
        border-bottom: none;
    }

    .info-table td {
        padding: 8px 6px;
        vertical-align: middle;
        height: 32px;
    }

    .label-col {
        font-weight: 600;
        color: #2c3e50;
        width: 55%;
    }

    .value-col {
        font-weight: 500;
        color: #1a5276;
        text-align: right;
        width: 45%;
    }

    .total-row td {
        padding-top: 10px;
        border-top: 2px solid #cbd5e1;
    }

    .total-row .label-col {
        font-weight: 800;
        font-size: 1.05em;
        color: #0b3b5f;
    }

    .total-row .value-col {
        font-weight: 800;
        font-size: 1.05em;
        color: #0b3b5f;
    }

    .tax-row .label-col { color: #e67e22; }
    .tax-row .value-col { color: #e67e22; font-weight: 600; }

    /* ===== TOTALS ROW ===== */
    .totals-row {
        display: flex;
        gap: 25px;
        margin: 15px 0;
        flex-wrap: wrap;
    }

    .total-box {
        flex: 1;
        background: #e8f0fe;
        border: 2px solid #1a5276;
        border-radius: 8px;
        padding: 12px 18px;
        text-align: center;
        min-height: 60px;
    }

    .total-box-label {
        font-weight: 700;
        font-size: 13px;
        color: #2c3e50;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .total-box-value {
        font-weight: 800;
        font-size: 22px;
        color: #1a5276;
    }

    /* ===== GRAND TOTAL ===== */
    .grand-total-section {
        margin-top: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 2px solid #1a5276;
        page-break-inside: avoid;
        break-inside: avoid;
    }

    .grand-total-table {
        width: 100%;
        border-collapse: collapse;
    }

    .grand-total-table td {
        padding: 14px 25px;
        height: 50px;
    }

    .grand-total-label {
        font-weight: 800;
        font-size: 1.15em;
        color: #1a5276;
        background: #e8f0fe;
    }

    .grand-total-value {
        font-weight: 800;
        font-size: 1.3em;
        color: #1a5276;
        text-align: right;
        background: #e8f0fe;
    }

    /* ===== FOOTER - UPDATED with ModifiedBy and ModifiedDate ===== */
    .report-footer {
        margin-top: 20px;
        padding: 12px 15px;
        background: #f8f9fa;
        font-size: 11px;
        color: #5d6d7e;
        text-align: center;
        border-radius: 4px;
        border-top: 2px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        min-height: 40px;
    }

    .footer-left {
        text-align: left;
    }

    .footer-right {
        text-align: right;
    }

    .footer-label {
        font-weight: 600;
        color: #2c3e50;
    }

    .footer-value {
        color: #1a5276;
        font-weight: 500;
    }

    /* ===== TOOLBAR / BUTTONS ===== */
    .report-toolbar {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-bottom: 15px;
        flex-wrap: wrap;
    }

    .report-toolbar .btn {
        padding: 8px 18px;
        border: none;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-pdf {
        background: #c0392b;
        color: white;
    }

    .btn-pdf:hover {
        background: #a93226;
    }

    .btn-print {
        background: #2c3e50;
        color: white;
    }

    .btn-print:hover {
        background: #1a252f;
    }

    .btn-copy {
        background: #2980b9;
        color: white;
    }

    .btn-copy:hover {
        background: #1f6a8a;
    }

    .loading-spinner {
        text-align: center;
        padding: 60px;
        color: #5d6d7e;
        font-size: 16px;
    }

    .no-data-message {
        text-align: center;
        padding: 50px;
        background: #fef9e6;
        border-radius: 8px;
    }

    .no-data-message .warning-icon {
        font-size: 48px;
        margin-bottom: 10px;
    }

    .retry-btn {
        background-color: #2c3e50;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 4px;
        margin-top: 15px;
        cursor: pointer;
    }

    .retry-btn:hover {
        background-color: #1a5276;
    }

    .clearfix::after {
        content: "";
        clear: both;
        display: table;
    }

    /* ===== PRINT STYLES - Black & White Printer Friendly ===== */
    @media print {
        .no-print {
            display: none !important;
        }

        body {
            background: white !important;
            margin: 0;
            padding: 0.2in;
            color: #000 !important;
        }

        .report-container {
            box-shadow: none !important;
            padding: 0.1in !important;
            max-width: 100% !important;
            background: white !important;
            border-radius: 0 !important;
        }

        .report-header {
            border-bottom: 2px solid #000 !important;
        }

        .report-header h1 {
            color: #000 !important;
        }

        .detail-header {
            background: #333 !important;
            color: white !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .detail-header .badge {
            background: rgba(255,255,255,0.15) !important;
        }

        .material-table th, .task-table th {
            background: #333 !important;
            color: white !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .material-table .type-badge {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .type-badge.stock { background: #d5f5e3 !important; color: #1a7a3a !important; }
        .type-badge.rebuilt { background: #fdebd0 !important; color: #a04000 !important; }
        .type-badge.nonstock { background: #d6eaf8 !important; color: #1a5276 !important; }

        .material-table tr.type-stock td:first-child { border-left: 3px solid #555 !important; }
        .material-table tr.type-rebuilt td:first-child { border-left: 3px solid #888 !important; }
        .material-table tr.type-nonstock td:first-child { border-left: 3px solid #444 !important; }

        .material-table .total-row td,
        .task-table .total-row td {
            background: #e8e8e8 !important;
            border-top: 2px solid #000 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .material-table .subtotal-row td {
            background: #f0f0f0 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .side-by-side {
            display: flex !important;
            gap: 15px;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .material-section, .labour-section {
            border: 1px solid #000 !important;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .material-header, .labour-header {
            background: #333 !important;
            color: white !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .grand-total-section {
            border: 2px solid #000 !important;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .grand-total-label, .grand-total-value {
            background: #e8e8e8 !important;
            color: #000 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .detail-section {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .summary-card {
            border: 1px solid #ccc !important;
            background: #f8f8f8 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .summary-card .value { color: #000 !important; }
        .summary-card .value.green { color: #1a7a3a !important; }
        .summary-card .value.blue { color: #1a5276 !important; }
        .summary-card .value.orange { color: #a04000 !important; }

        .vehicle-info-item {
            background: #f8f8f8 !important;
            border-left: 4px solid #333 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .vehicle-info-item .value {
            color: #000 !important;
        }

        .total-box {
            background: #e8e8e8 !important;
            border: 1px solid #000 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .total-box-value {
            color: #000 !important;
        }

        .report-footer {
            border-top: 2px solid #000 !important;
            background: #f8f8f8 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .info-table tr {
            border-bottom: 1px solid #ccc !important;
        }

        .total-row td {
            border-top: 2px solid #000 !important;
        }

        .tax-row .label-col, .tax-row .value-col {
            color: #a04000 !important;
        }

        .material-table, .task-table {
            font-size: 9px !important;
        }

        .material-table th, .material-table td,
        .task-table th, .task-table td {
            padding: 3px 6px !important;
        }

        .vehicle-info-item .value {
            font-size: 12px !important;
        }

        .vehicle-info-item .label {
            font-size: 8px !important;
        }

        .detail-header {
            padding: 6px 14px !important;
            font-size: 12px !important;
            min-height: 30px !important;
        }

        .detail-body {
            padding: 8px 12px !important;
        }

        .grand-total-table td {
            padding: 10px 18px !important;
            height: 40px !important;
        }

        .grand-total-value {
            font-size: 1.1em !important;
        }

        .summary-card .value {
            font-size: 16px !important;
        }

        .total-box-value {
            font-size: 18px !important;
        }

        .report-header h1 {
            font-size: 20px !important;
        }

        .vehicle-info {
            grid-template-columns: repeat(4, 1fr) !important;
        }

        html, body {
            height: auto !important;
            overflow: visible !important;
        }
    }

    /* ===== RESPONSIVE ===== */
    @media screen and (max-width: 768px) {
        .vehicle-info {
            grid-template-columns: repeat(2, 1fr) !important;
        }

        .side-by-side {
            flex-direction: column;
        }

        .material-section, .labour-section {
            min-width: unset;
        }

        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .report-container {
            padding: 15px;
        }
    }

    @media screen and (max-width: 480px) {
        .vehicle-info {
            grid-template-columns: 1fr !important;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .totals-row {
            flex-direction: column;
        }

        .report-footer {
            flex-direction: column;
            text-align: center;
        }

        .footer-left, .footer-right {
            text-align: center;
        }

        .report-toolbar {
            justify-content: center;
        }

        .report-toolbar .btn {
            font-size: 11px;
            padding: 6px 12px;
        }
    }
</style>

<!-- ===== TOOLBAR - Print and PDF Buttons ===== -->
<div class="report-toolbar no-print">
    <button id="printReportBtn" class="btn btn-print" onclick="window.print()">
        🖨️ Print
    </button>
    <button id="savePdfBtn" class="btn btn-pdf">
        📄 Save as PDF
    </button>
    <button id="copyReportBtn" class="btn btn-copy">
        📋 Copy to Clipboard
    </button>
</div>

<!-- ===== REPORT CONTAINER ===== -->
<div class="report-container" id="reportContainer">

    <!-- HEADER -->
    <div class="report-header" id="reportHeader">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div style="text-align: left;">
                <div style="font-size: 13px; color: #5d6d7e; font-weight: 600;">Vehicle Estimate #: <span style="color: #1a5276; font-weight: 700;" id="estimateNumber">@ViewBag.PartNum</span></div>
            </div>
            <div style="text-align: center; flex: 1;">
                <h1 style="margin: 0 0 8px 0; color: #1a5276; font-size: 28px; letter-spacing: 1px;">VEHICLE COST SUMMARY REPORT</h1>
                <div class="subtitle" id="generatedDate">Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</div>
            </div>
            <div style="text-align: right; min-width: 120px;">
                <div style="font-size: 11px; color: #5d6d7e;">Status: <span style="color: #27ae60; font-weight: 600;">● Active</span></div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div id="loadingIndicator" class="loading-spinner">
        <span>⏳ Loading cost data...</span>
    </div>

    <!-- Content -->
    <div id="costSummaryContent" style="display: none;">

        <!-- ===== SECTION 1: VEHICLE DETAILS - UPDATED with Make, Model, Year, # Vehicles ===== -->
        <div class="detail-section">
            <div class="detail-header">
                <span>🚗 VEHICLE DETAILS</span>
                <span class="badge" id="vehicleIdBadge">ID: @ViewBag.PartNum</span>
            </div>
            <div class="detail-body">
                <div class="vehicle-info">
                    <div class="vehicle-info-item">
                        <span class="label">Make</span>
                        <span class="value" id="vehicleMake">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Model</span>
                        <span class="value" id="vehicleModel">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Year</span>
                        <span class="value" id="vehicleYear">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label"># of Vehicles</span>
                        <span class="value" id="vehicleCount">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Engine</span>
                        <span class="value" id="vehicleEngine">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Transmission</span>
                        <span class="value" id="vehicleTransmission">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Differential</span>
                        <span class="value" id="vehicleDifferential">-</span>
                    </div>
                    <div class="vehicle-info-item">
                        <span class="label">Project Description</span>
                        <span class="value" id="vehicleDescription">-</span>
