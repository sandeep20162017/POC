USE [CES]
GO
/*==========================================================================
  1. Rename SBCES.PriceNotTax -> SBCES.PriceNoTax (safe to re-run)
==========================================================================*/
IF OBJECT_ID('SBCES.PriceNoTax') IS NULL AND OBJECT_ID('SBCES.PriceNotTax') IS NOT NULL
BEGIN
    EXEC sp_rename 'SBCES.PriceNotTax', 'PriceNoTax';
    PRINT 'Renamed SBCES.PriceNotTax to SBCES.PriceNoTax';
END
ELSE
    PRINT 'Rename skipped (PriceNoTax already exists, or PriceNotTax not found)';
GO

/*==========================================================================
  2/3. Stored procedure (uses PriceNoTax; debug prints commented out)
==========================================================================*/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
ALTER PROCEDURE [SBCES].[IfsMmsSync]
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @Step NVARCHAR(200) = 'start';
    -- DEBUG: DECLARE @Rows INT, @Msg NVARCHAR(2000);
    -- DEBUG: SET @Msg = CONVERT(VARCHAR(23), GETDATE(), 121) + ' IfsMmsSync START';
    -- DEBUG: RAISERROR('%s', 0, 1, @Msg) WITH NOWAIT;

    BEGIN TRY
        BEGIN TRAN;

        --------------------------------------------------------------------
        -- Backup StockCodedParts
        --------------------------------------------------------------------
        SET @Step = '1 Backup StockCodedParts';
        TRUNCATE TABLE SBCES.StockCodedPartsBackup;

        INSERT INTO SBCES.StockCodedPartsBackup
        (
            MmsStockCode, CorePartNumber, PartType, JobNumber, DetailedDesc, DateEntered,
            ItemRefNumber, OverheadType, CoreCharge, PartCost, LastModifiedDate, LastModifiedBy,
            AddedBy, MmsNewCost, OemPartCost, MmsSyncDate, OrigSupplierNum, OrigSupplierName
        )
        SELECT
            RTRIM(ISNULL(MmsStockCode,'')),
            ISNULL(CorePartNumber,''),
            ISNULL(PartType,''),
            ISNULL(JobNumber,''),
            ISNULL(DetailedDesc,''),
            ISNULL(DateEntered,''),
            ISNULL(ItemRefNumber,''),
            ISNULL(OverheadType,0),
            ISNULL(CoreCharge,0),
            ISNULL(PartCost,0),
            LastModifiedDate,
            LastModifiedBy,
            ISNULL(AddedBy,''),
            ISNULL(MmsNewCost,0),
            ISNULL(OemPartCost,0),
            MmsSyncDate,
            ISNULL(OrigSupplierNum,''),
            ISNULL(OrigSupplierName,'')
        FROM SBCES.StockCodedParts;
        -- DEBUG: SET @Rows = @@ROWCOUNT; RAISERROR('Step %s done, rows=%d', 0, 1, @Step, @Rows) WITH NOWAIT;

        --------------------------------------------------------------------
        -- Clear tables
        --------------------------------------------------------------------
        SET @Step = '2 Clear tables';
        TRUNCATE TABLE SBCES.StockCodedParts;
        TRUNCATE TABLE SBCES.PriceNoTax;
        TRUNCATE TABLE SBCES.LastPriceNoTax;
        -- DEBUG: RAISERROR('Step %s done', 0, 1, @Step) WITH NOWAIT;

        --------------------------------------------------------------------
        -- Populate StockCodedParts
        --------------------------------------------------------------------
        SET @Step = '3 Populate StockCodedParts';
        INSERT INTO SBCES.StockCodedParts
        (
            MmsStockCode, PartType, MmsNewCost, DetailedDesc, MmsSyncDate, OrigSupplierName, OrigSupplierNum
        )
        SELECT DISTINCT
            RTRIM(a.PartNumber),
            LEFT(a.DescriptionPm,30),
            SBCES.GetNewCost(ISNULL(a.LevelTotalCostLaPm,0), a.LevelTotalCostWaPm),
            b.PartXdescEdLine,
            GETDATE(),
            ISNULL(RTRIM(b.BusinessName),''),
            ISNULL(b.VendorPartNumber,'')
        FROM SBCES.PartMaster a
        LEFT JOIN
        (
            SELECT A.PrintSeq, A.PartNumber, A.BusinessName, A.VendorPartNumber, A.PartXdescEdLine
            FROM SBCES.VendorPartDesc A
            INNER JOIN
            (
                SELECT PartNumber AS Pn, MAX(PrintSeq) AS Seq
                FROM SBCES.VendorPartDesc
                WHERE VendorPartNumber <> ' '
                  AND BusinessName NOT LIKE '%SUPERSEDED%'
                GROUP BY PartNumber
            ) B
            ON RTRIM(A.PartNumber)=RTRIM(B.Pn)
            AND A.PrintSeq=B.Seq
        ) b
        ON RTRIM(a.PartNumber)=RTRIM(b.PartNumber)
        WHERE a.ProductCodePm NOT LIKE '%PLUM%';
        -- DEBUG: SET @Rows = @@ROWCOUNT; RAISERROR('Step %s done, rows=%d', 0, 1, @Step, @Rows) WITH NOWAIT;

        --------------------------------------------------------------------
        -- MMS_COST_TEMP
        --------------------------------------------------------------------
        SET @Step = '4 MmsCostTemp';
        TRUNCATE TABLE SBCES.MmsCostTemp;

        INSERT INTO SBCES.MmsCostTemp (MmsNewCode, MmsNewCost)
        SELECT MmsStockCode, MmsNewCost
        FROM SBCES.StockCodedParts
        WHERE ISNULL(MmsNewCost,0)=0;
        -- DEBUG: SET @Rows = @@ROWCOUNT; RAISERROR('Step %s insert done, rows=%d', 0, 1, @Step, @Rows) WITH NOWAIT;

        UPDATE t
        SET t.MmsNewCost = b.MmsNewCost
        FROM SBCES.MmsCostTemp t
        INNER JOIN SBCES.StockCodedPartsBackup b
            ON RTRIM(t.MmsNewCode)=RTRIM(b.MmsStockCode);

        UPDATE s
        SET s.MmsNewCost = t.MmsNewCost
        FROM SBCES.StockCodedParts s
        INNER JOIN SBCES.MmsCostTemp t
            ON RTRIM(s.MmsStockCode)=RTRIM(t.MmsNewCode);
        -- DEBUG: RAISERROR('Step %s done', 0, 1, @Step) WITH NOWAIT;

        --------------------------------------------------------------------
        -- NON_STOCK_CODED_PARTS
        -- Fixed: previously cross-joined every distinct supplier number
        -- (72,759 of them). NOT EXISTS = "supplier number not already there".
        --------------------------------------------------------------------
        SET @Step = '5 NonStockCodedParts';
        INSERT INTO SBCES.NonStockCodedParts
        (
            OrigSupplierName, OrigSupplierNum, DetailedDesc, Keyword, DateEntered
        )
        SELECT
            RTRIM(a.BusinessName),
            a.VendorPartNumber,
            RTRIM(a.PartXdescEdLine),
            RTRIM(b.PartType),
            GETDATE()
        FROM SBCES.VendorPartDesc a
        INNER JOIN SBCES.StockCodedParts b
            ON RTRIM(a.PartNumber)=RTRIM(b.MmsStockCode)
        WHERE a.VendorPartNumber <> ''
          AND NOT EXISTS
          (
              SELECT 1
              FROM SBCES.NonStockCodedParts n
              WHERE RTRIM(n.OrigSupplierNum) = RTRIM(a.VendorPartNumber)
          );
        -- DEBUG: SET @Rows = @@ROWCOUNT; RAISERROR('Step %s done, rows=%d', 0, 1, @Step, @Rows) WITH NOWAIT;

        --------------------------------------------------------------------
        -- SC_OEMKITS_TEXT_DATA
        --------------------------------------------------------------------
        SET @Step = '6 ScOemkitsTextData';
        TRUNCATE TABLE SBCES.ScOemkitsTextData;

        INSERT INTO SBCES.ScOemkitsTextData (MmsNewCode, TextData)
        SELECT b.MmsStockCode, a.TextLineTx
        FROM SBCES.TextData a
        INNER JOIN SBCES.StockCodedParts b
            ON RTRIM(a.TextKey)=RTRIM(b.MmsStockCode)
        WHERE a.TextType='PM5P';
        -- DEBUG: SET @Rows = @@ROWCOUNT; RAISERROR('Step %s done, rows=%d', 0, 1, @Step, @Rows) WITH NOWAIT;

        --------------------------------------------------------------------
        -- Replace Oracle cursor with set-based update
        --------------------------------------------------------------------
        SET @Step = '7 Update ScPartsUsed';
        UPDATE spu
        SET spu.MmsCost = scp.MmsNewCost
        FROM SBCES.ScPartsUsed spu
        INNER JOIN SBCES.StockCodedParts scp
            ON RTRIM(spu.MmsStockCode)=RTRIM(scp.MmsStockCode)
        WHERE spu.RebuiltPart='N';
        -- DEBUG: SET @Rows = @@ROWCOUNT; RAISERROR('Step %s done, rows=%d', 0, 1, @Step, @Rows) WITH NOWAIT;

        --------------------------------------------------------------------
        -- KitsMasterlist
        --------------------------------------------------------------------
        SET @Step = '8 Update KitsMasterlist';
        UPDATE k
        SET k.EstimatedCost = s.MmsNewCost
        FROM SBCES.KitsMasterlist k
        INNER JOIN SBCES.StockCodedParts s
            ON RTRIM(k.PartNumber)=RTRIM(s.MmsStockCode);
        -- DEBUG: SET @Rows = @@ROWCOUNT; RAISERROR('Step %s done, rows=%d', 0, 1, @Step, @Rows) WITH NOWAIT;

        COMMIT TRAN;
        -- DEBUG: SET @Msg = CONVERT(VARCHAR(23), GETDATE(), 121) + ' IfsMmsSync SUCCESS';
        -- DEBUG: RAISERROR('%s', 0, 1, @Msg) WITH NOWAIT;
    END TRY

    BEGIN CATCH
        IF XACT_STATE() <> 0 ROLLBACK TRAN;

        -- Include the failing step in the message, then re-raise the original error.
        DECLARE @Err NVARCHAR(4000) =
            N'IfsMmsSync failed at step [' + @Step + N'] (Err ' + CAST(ERROR_NUMBER() AS NVARCHAR(20))
            + N', line ' + CAST(ERROR_LINE() AS NVARCHAR(20)) + N'): ' + ERROR_MESSAGE();
        -- DEBUG: RAISERROR('%s', 0, 1, @Err) WITH NOWAIT;

        THROW;   -- original error number/message preserved
    END CATCH
END
GO
