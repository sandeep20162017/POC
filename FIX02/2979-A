
@{
    ViewData["Title"] = "AI Assistance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .ai-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .ai-header {
        background: linear-gradient(135deg, #0078d4, #005a9e);
        color: white;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 30px;
        text-align: center;
    }

    .ai-header h1 {
        margin: 0;
        font-size: 28px;
    }

    .ai-header p {
        margin: 10px 0 0;
        opacity: 0.9;
    }

    .ai-chat {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 600px;
    }

    .ai-messages {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        background: #f8f9fa;
    }

    .ai-message {
        margin-bottom: 16px;
        padding: 12px 16px;
        border-radius: 8px;
        max-width: 85%;
        word-wrap: break-word;
        animation: fadeIn 0.3s ease;
    }

    .ai-message.user {
        background: #0078d4;
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 4px;
    }

    .ai-message.assistant {
        background: white;
        border: 1px solid #e0e0e0;
        margin-right: auto;
        border-bottom-left-radius: 4px;
    }

    .ai-message.error {
        background: #dc3545;
        color: white;
        margin-left: auto;
    }

    .ai-message .time {
        font-size: 0.75em;
        opacity: 0.7;
        margin-top: 4px;
        display: block;
    }

    .ai-message ul {
        margin: 8px 0;
        padding-left: 20px;
    }

    .ai-message li {
        margin: 4px 0;
    }

    .ai-message code {
        background: #f0f0f0;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: 'Consolas', 'Monaco', monospace;
    }

    .ai-message strong {
        font-weight: 600;
    }

    .ai-message h3 {
        margin: 12px 0 8px;
        color: #0078d4;
        font-size: 1.1em;
    }

    .ai-message h4 {
        margin: 10px 0 6px;
        color: #005a9e;
        font-size: 1em;
    }

    .ai-message blockquote {
        border-left: 3px solid #0078d4;
        margin: 8px 0;
        padding: 8px 16px;
        background: #f0f7ff;
    }

    .ai-input-container {
        padding: 16px 20px;
        background: white;
        border-top: 1px solid #e0e0e0;
        display: flex;
        gap: 12px;
        align-items: flex-end;
    }

    .ai-input-container textarea {
        flex: 1;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
        resize: vertical;
        min-height: 50px;
        max-height: 150px;
        font-size: 14px;
        font-family: inherit;
    }

    .ai-input-container textarea:focus {
        border-color: #0078d4;
        box-shadow: 0 0 0 2px rgba(0,120,212,0.1);
    }

    .ai-input-container .btn-send {
        padding: 12px 24px;
        background: #0078d4;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        height: 50px;
        min-width: 80px;
    }

    .ai-input-container .btn-send:hover:not(:disabled) {
        background: #005a9e;
    }

    .ai-input-container .btn-send:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .ai-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 12px 20px;
        background: #f8f9fa;
        border-top: 1px solid #e0e0e0;
    }

    .ai-suggestions .suggestion-btn {
        padding: 6px 14px;
        background: white;
        border: 1px solid #ddd;
        border-radius: 20px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        color: #333;
    }

    .ai-suggestions .suggestion-btn:hover {
        background: #0078d4;
        color: white;
        border-color: #0078d4;
    }

    .ai-typing {
        display: none;
        padding: 12px 16px;
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        margin-right: auto;
        max-width: 80px;
    }

    .ai-typing.active {
        display: block;
    }

    .ai-typing-dots {
        display: flex;
        gap: 4px;
        justify-content: center;
    }

    .ai-typing-dots span {
        width: 8px;
        height: 8px;
        background: #0078d4;
        border-radius: 50%;
        animation: typing 1.4s infinite both;
    }

    .ai-typing-dots span:nth-child(2) {
        animation-delay: 0.2s;
    }

    .ai-typing-dots span:nth-child(3) {
        animation-delay: 0.4s;
    }

    @@keyframes typing {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .ai-message pre {
        background: #f0f0f0;
        padding: 12px;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 13px;
        margin: 8px 0;
    }

    .ai-message pre code {
        background: none;
        padding: 0;
    }

    .ai-related-actions {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #e0e0e0;
    }

    .ai-related-actions .action-btn {
        padding: 4px 12px;
        margin: 4px 4px 0 0;
        background: #e8f0fe;
        border: 1px solid #d2e3fc;
        border-radius: 4px;
        color: #1a73e8;
        cursor: pointer;
        font-size: 0.85em;
    }

    .ai-related-actions .action-btn:hover {
        background: #d2e3fc;
    }

    @@media (max-width: 768px) {
        .ai-chat {
            height: calc(100vh - 200px);
        }

        .ai-messages {
            padding: 12px;
        }

        .ai-message {
            max-width: 95%;
        }

        .ai-input-container {
            padding: 12px;
            flex-direction: column;
        }

        .ai-input-container textarea {
            min-height: 40px;
        }

        .ai-input-container .btn-send {
            width: 100%;
            height: 44px;
        }
    }
</style>

<div class="ai-container">
    <div class="ai-header">
        <h1>
            <span class="k-icon k-i-robot" style="margin-right: 10px;"></span>
            AI Assistance
        </h1>
        <p>Ask me anything about the Cost Estimation System. I'm here to help!</p>
    </div>

    <!-- Debug Panel (Ctrl+Shift+D to toggle) -->
    <div id="debugPanel" style="background:#f0f0f0; border:1px solid #ccc; padding:10px; margin-bottom:10px; border-radius:4px; display:none; max-height:200px; overflow-y:auto; font-size:12px; font-family:Consolas, monospace;">
        <strong>Debug Log:</strong>
        <div id="debugLog"></div>
    </div>

    <div class="ai-chat">
        <div class="ai-messages" id="chatMessages">
            <div class="ai-message assistant">
                <strong>👋 Hello! I'm your AI Assistant for the Cost Estimation System.</strong>
                <p>I can help you with:</p>
                <ul>
                    <li>Creating and managing estimates</li>
                    <li>Adding stock, non-stock, and rebuilt parts</li>
                    <li>Understanding labour and cost calculations</li>
                    <li>Step-by-step workflows</li>
                    <li>Troubleshooting common issues</li>
                </ul>
                <p>Try asking me a question below!</p>
                <span class="time">Just now</span>
            </div>
        </div>

        <div class="ai-suggestions">
            <span style="color: #666; font-size: 13px; padding: 4px 0;">Suggested:</span>
            <button class="suggestion-btn" onclick="askSuggestion('How to create a Make vs Buy estimate?')">
                Create Make vs Buy
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('How to add a stock coded part?')">
                Add Stock Part
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('How to add labour to an estimate?')">
                Add Labour
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('How to convert Make vs Buy to Rebuilt Part?')">
                Convert MB to RB
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('What fields are required for a vehicle estimate?')">
                Required Fields
            </button>
            <button class="suggestion-btn" onclick="askSuggestion('How to add a user in User Management?')">
                Add User
            </button>
        </div>

        <div class="ai-input-container">
            <textarea id="userQuestion" 
                      placeholder="Type your question here... (e.g., 'How do I add a rebuilt part?')" 
                      rows="1"></textarea>
            <button class="btn-send" id="sendButton" onclick="sendQuestion()">
                <span class="k-icon k-i-send"></span> Send
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let isProcessing = false;
        let conversationHistory = [];
        let debugEnabled = false; // Set to true to show debug panel by default

        $(document).ready(function() {
            // Show debug panel if enabled
            if (debugEnabled) {
                $('#debugPanel').show();
                addDebug('Page loaded', 'info');
            }

            // Auto-resize textarea
            $('#userQuestion').on('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 150) + 'px';
            });

            // Enter key support (Shift+Enter for new line)
            $('#userQuestion').on('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendQuestion();
                }
            });

            // Focus input on load
            setTimeout(function() {
                $('#userQuestion').focus();
                if (debugEnabled) addDebug('Input focused', 'info');
            }, 500);

            if (debugEnabled) addDebug('Ready to accept questions', 'info');

            // Keyboard shortcut: Ctrl+Shift+D to toggle debug panel
            $(document).on('keydown', function(e) {
                if (e.ctrlKey && e.shiftKey && (e.key === 'D' || e.key === 'd')) {
                    e.preventDefault();
                    debugEnabled = !debugEnabled;
                    $('#debugPanel').toggle(debugEnabled);
                    if (debugEnabled) {
                        addDebug('Debug panel enabled', 'info');
                    }
                }
            });
        });

        function addDebug(message, type) {
            if (!debugEnabled) return;
            
            var log = $('#debugLog');
            if (!log.length) return;
            
            var timestamp = new Date().toLocaleTimeString();
            var colors = {
                'info': '#0066cc',
                'success': '#008800',
                'error': '#cc0000',
                'warning': '#cc8800'
            };
            var color = colors[type] || '#333';
            log.append('<div style="color:' + color + ';">[' + timestamp + '] ' + escapeHtml(message) + '</div>');
            log.parent().scrollTop(log.parent()[0].scrollHeight);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function askSuggestion(question) {
            if (debugEnabled) addDebug('Suggestion clicked: ' + question, 'info');
            $('#userQuestion').val(question);
            sendQuestion();
        }

        function sendQuestion() {
            var input = $('#userQuestion');
            var question = input.val().trim();

            if (!question) {
                if (debugEnabled) addDebug('Empty question, ignoring', 'warning');
                return;
            }

            if (isProcessing) {
                if (debugEnabled) addDebug('Already processing, please wait', 'warning');
                return;
            }

            if (debugEnabled) addDebug('Sending question: ' + question, 'info');

            // Add user message
            addMessage(question, 'user');
            input.val('');
            input.css('height', 'auto');

            // Show typing indicator
            showTypingIndicator(true);

            isProcessing = true;
            $('#sendButton').prop('disabled', true);

            if (debugEnabled) addDebug('Making AJAX call to /AIHelp/AskQuestion', 'info');

            // Send to server
            $.ajax({
                url: '/AIHelp/AskQuestion',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    text: question,
                    pageContext: {
                        url: window.location.href,
                        pageName: 'AIAssistance',
                        module: 'AI Help',
                        view: 'AIAssistance',
                        hasGrid: false,
                        visibleFields: []
                    },
                    conversationHistory: conversationHistory.slice(-5)
                }),
                beforeSend: function() {
                    if (debugEnabled) addDebug('AJAX request sent', 'info');
                },
                success: function(response) {
                    if (debugEnabled) {
                        addDebug('AJAX success - response received', 'success');
                        addDebug('Response type: ' + typeof response, 'info');
                    }
                    
                    showTypingIndicator(false);
                    
                    // Check if response has answer
                    if (response && typeof response === 'object' && response.answer) {
                        if (debugEnabled) {
                            addDebug('Answer preview: ' + response.answer.substring(0, 100) + '...', 'success');
                        }
                        addMessage(response.answer, 'assistant');

                        // Show related actions if any
                        if (response.relatedActions && response.relatedActions.length > 0) {
                            if (debugEnabled) addDebug('Related actions: ' + response.relatedActions.length, 'info');
                            addRelatedActions(response.relatedActions);
                        }

                        conversationHistory.push(
                            { role: 'user', content: question },
                            { role: 'assistant', content: response.answer }
                        );
                    } else if (response && typeof response === 'string') {
                        // If response is just a string
                        if (debugEnabled) addDebug('Response is a string', 'info');
                        addMessage(response, 'assistant');
                    } else {
                        // Response is invalid
                        if (debugEnabled) {
                            addDebug('Invalid response format', 'error');
                            addDebug('Response: ' + JSON.stringify(response), 'error');
                        }
                        addMessage('❌ Sorry, I received an invalid response. Please try again.', 'error');
                    }
                },
                error: function(xhr, status, error) {
                    if (debugEnabled) {
                        addDebug('AJAX error: ' + status + ' - ' + error, 'error');
                        addDebug('Status code: ' + xhr.status, 'error');
                        addDebug('Response: ' + (xhr.responseText || 'No response text'), 'error');
                    }
                    
                    showTypingIndicator(false);
                    
                    var errorMsg = 'An error occurred. Please try again.';
                    try {
                        if (xhr.responseJSON && xhr.responseJSON.error) {
                            errorMsg = xhr.responseJSON.error;
                        } else if (xhr.responseText) {
                            var parsed = JSON.parse(xhr.responseText);
                            if (parsed && parsed.error) {
                                errorMsg = parsed.error;
                            }
                        }
                    } catch (e) {
                        // If can't parse JSON, use status text
                        errorMsg = status + ' - ' + error;
                    }
                    
                    if (debugEnabled) addDebug('Error message: ' + errorMsg, 'error');
                    addMessage('❌ ' + errorMsg, 'error');
                },
                complete: function() {
                    if (debugEnabled) addDebug('AJAX request completed', 'info');
                    isProcessing = false;
                    $('#sendButton').prop('disabled', false);
                    $('#userQuestion').focus();
                }
            });
        }

        function addMessage(content, type) {
            // SAFETY: Check if content is valid
            if (!content) {
                content = 'Sorry, I received an empty response. Please try again.';
                type = 'error';
            }

            // Ensure content is a string
            if (typeof content !== 'string') {
                try {
                    content = JSON.stringify(content);
                } catch (e) {
                    content = 'Invalid response format. Please try again.';
                }
                type = 'error';
            }

            var container = $('#chatMessages');
            if (!container.length) return;

            var messageDiv = $('<div>').addClass('ai-message ' + type);

            if (type === 'assistant') {
                try {
                    // Convert markdown-like formatting to HTML
                    var html = content
                        // Headers
                        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
                        .replace(/^## (.*$)/gim, '<h4>$1</h4>')
                        .replace(/^# (.*$)/gim, '<h3>$1</h3>')
                        // Bold
                        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                        // Italic
                        .replace(/\*(.*?)\*/g, '<em>$1</em>')
                        // Code blocks
                        .replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
                        // Inline code
                        .replace(/`(.*?)`/g, '<code>$1</code>')
                        // Blockquotes
                        .replace(/^> (.*$)/gim, '<blockquote>$1</blockquote>')
                        // Line breaks
                        .replace(/\n/g, '<br />')
                        // Lists - handle both * and -
                        .replace(/^[*-] (.*$)/gim, '<li>$1</li>')
                        .replace(/(<li>.*?<\/li>)/gs, function(match) {
                            return '<ul>' + match + '</ul>';
                        });

                    // Clean up multiple <br> tags
                    html = html.replace(/(<br \/>){2,}/g, '<br />');
                    // Clean up empty ul tags
                    html = html.replace(/<ul><\/ul>/g, '');

                    messageDiv.html(html);
                } catch (e) {
                    // If formatting fails, just display plain text
                    if (debugEnabled) addDebug('Error formatting message: ' + e.message, 'error');
                    messageDiv.text(content);
                }
            } else {
                messageDiv.text(content);
            }

            // Add timestamp
            var time = new Date().toLocaleTimeString();
            messageDiv.append('<span class="time">' + time + '</span>');

            container.append(messageDiv);
            container.scrollTop(container[0].scrollHeight);
            
            if (debugEnabled) addDebug('Message added to chat: ' + type + ' - length: ' + content.length, 'info');
        }

        function addRelatedActions(actions) {
            if (!actions || actions.length === 0) return;

            var container = $('#chatMessages');
            if (!container.length) return;

            var div = $('<div class="ai-message assistant">');
            div.append('<div class="ai-related-actions"><strong>Related Actions:</strong><br>');

            $.each(actions, function(index, action) {
                if (action && action.label) {
                    var btn = $('<button class="action-btn" onclick="performAction(\'' + (action.id || '') + '\', \'' + (action.type || 'navigate') + '\', \'' + (action.target || '') + '\')">' + escapeHtml(action.label) + '</button>');
                    div.find('.ai-related-actions').append(btn);
                }
            });

            div.append('</div>');
            container.append(div);
            container.scrollTop(container[0].scrollHeight);
        }

        function performAction(id, type, target) {
            if (debugEnabled) addDebug('Performing action: ' + id + ' (' + type + ' -> ' + target + ')', 'info');
            
            if (!target) {
                if (debugEnabled) addDebug('No target specified for action', 'warning');
                return;
            }

            switch(type) {
                case 'navigate':
                    if (debugEnabled) addDebug('Navigating to: ' + target, 'info');
                    window.location.href = target;
                    break;
                case 'open':
                    // Try to open a Kendo window
                    try {
                        var win = $('#' + target + 'PopupWindow').data('kendoWindow');
                        if (win) {
                            if (debugEnabled) addDebug('Opening Kendo window: ' + target, 'info');
                            win.open();
                        } else {
                            if (debugEnabled) addDebug('Kendo window not found, navigating to: ' + target, 'warning');
                            window.location.href = target;
                        }
                    } catch (e) {
                        if (debugEnabled) addDebug('Error opening window: ' + e.message, 'error');
                        window.location.href = target;
                    }
                    break;
                default:
                    if (debugEnabled) addDebug('Unknown action type: ' + type, 'error');
                    console.log('Action:', id, type, target);
            }
        }

        function showTypingIndicator(show) {
            var container = $('#chatMessages');
            if (!container.length) return;

            var indicator = $('.ai-typing');

            if (show) {
                if (indicator.length === 0) {
                    indicator = $(
                        '<div class="ai-typing active">' +
                            '<div class="ai-typing-dots">' +
                                '<span></span>' +
                                '<span></span>' +
                                '<span></span>' +
                            '</div>' +
                        '</div>'
                    );
                    container.append(indicator);
                    if (debugEnabled) addDebug('Typing indicator shown', 'info');
                }
                indicator.addClass('active');
                container.scrollTop(container[0].scrollHeight);
            } else {
                indicator.removeClass('active');
                setTimeout(function() {
                    indicator.remove();
                }, 300);
                if (debugEnabled) addDebug('Typing indicator hidden', 'info');
            }
        }

        // Auto-send on paste of long questions
        $('#userQuestion').on('paste', function() {
            var self = this;
            setTimeout(function() {
                var text = $(self).val();
                if (text && text.length > 50) {
                    if (debugEnabled) addDebug('Paste detected (length: ' + text.length + '), auto-sending', 'info');
                    sendQuestion();
                }
            }, 100);
        });
    </script>
}
