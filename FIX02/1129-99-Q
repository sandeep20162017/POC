<script type="text/javascript">
    // Configuration
    var partNum = '@ViewBag.PartNum';
    var gridType = '@ViewBag.GridType';
    var totalCostDataUrl = '@Url.Action("GetTotalCostInEstimates", "TotalCost")' +
                           '?id=' + encodeURIComponent(partNum) +
                           '&gridType=' + encodeURIComponent(gridType);
    var viewReportUrl = '@Url.Action("ViewReport", "TotalCost")';

    // Document ready
    $(document).ready(function() {
        console.log("TotalCostTab initialized");
        fetchTotalCostData();

        $("#retryButton").on('click', function() {
            $("#noDataMessage").hide();
            $("#loadingIndicator").show();
            $("#costSummaryContent").hide();
            fetchTotalCostData();
        });

        // Initialize menu
        initializeMenu();
    });

    // ===== MENU INITIALIZATION =====
    function initializeMenu() {
        var dropdown = document.getElementById('reportMenuDropdown');
        var actionsButton = document.getElementById('reportActions');

        if (!actionsButton || !dropdown) {
            console.error('Menu elements not found');
            return;
        }

        // Toggle dropdown on button click
        actionsButton.addEventListener('click', function(e) {
            e.stopPropagation();
            dropdown.classList.toggle('show');

            // Position the dropdown
            var rect = actionsButton.getBoundingClientRect();
            dropdown.style.top = (rect.bottom + 4) + 'px';
            dropdown.style.right = '20px';
        });

        // Close on outside click
        document.addEventListener('click', function(e) {
            if (!dropdown.contains(e.target) && e.target !== actionsButton) {
                dropdown.classList.remove('show');
            }
        });

        // Handle menu item clicks
        dropdown.querySelectorAll('.menu-item').forEach(function(item) {
            item.addEventListener('click', function() {
                var action = this.dataset.action;
                dropdown.classList.remove('show');
                handleMenuAction(action);
            });
        });
    }

    // ===== MENU ACTION HANDLER =====
    function handleMenuAction(action) {
        console.log('Menu action:', action);

        switch(action) {
            // View Actions
            case 'viewFullReport':
            case 'viewVehicleEstimate':
            case 'viewLabourDetails':
            case 'viewMaterialsEstimate':
                openReportView(action.replace('view', '').toLowerCase());
                break;

            // Copy Actions
            case 'copyFullReport':
            case 'copyVehicleEstimate':
            case 'copyLabourDetails':
            case 'copyMaterialsEstimate':
                copyReportToClipboard(action.replace('copy', '').toLowerCase());
                break;

            // PDF Actions
            case 'saveFullReportPdf':
            case 'saveVehicleEstimatePdf':
            case 'saveLabourDetailsPdf':
            case 'saveMaterialsEstimatePdf':
                saveReportAsPdf(action.replace('save', '').replace('Pdf', '').toLowerCase());
                break;

            default:
                console.warn('Unknown action:', action);
        }
    }

    // ===== OPEN REPORT VIEW =====
    function openReportView(reportType) {
        var url = viewReportUrl + '?reportType=' + encodeURIComponent(reportType) +
                  '&id=' + encodeURIComponent(partNum) +
                  '&gridType=VehicleGrid' ;
        console.log('Opening URL:', url);
        window.open(url, '_blank');
    }

    // ===== SAVE AS PDF =====
    function saveReportAsPdf(reportType) {
        var container = document.getElementById('reportContainer');
        if (!container) {
            alert('Unable to find the estimate report.');
            return;
        }

        if (typeof kendo === 'undefined' || !kendo.drawing) {
            alert('Kendo UI is not available. Please ensure Kendo UI is loaded.');
            return;
        }

        var wrapper = createExportWrapper(container, reportType);
        if (!wrapper) return;

        kendo.drawing.drawDOM(wrapper, {
            paperSize: 'Letter',
            landscape: true,
            margin: { top: '0.35in', bottom: '0.35in', left: '0.35in', right: '0.35in' },
            scale: 0.78,
            multiPage: true
        }).then(function(group) {
            return kendo.drawing.exportPDF(group, {
                paperSize: 'Letter',
                landscape: true,
                margin: { top: '0.35in', bottom: '0.35in', left: '0.35in', right: '0.35in' }
            });
        }).done(function(dataUri) {
            if (wrapper.parentNode) document.body.removeChild(wrapper);
            var fileName = getReportFileName(reportType) + '.pdf';
            kendo.saveAs({ dataURI: dataUri, fileName: fileName });
            console.log('PDF saved:', fileName);
        }).fail(function(err) {
            if (wrapper.parentNode) document.body.removeChild(wrapper);
            console.error('PDF export error:', err);
            alert('Error generating PDF: ' + (err && err.message ? err.message : 'Unknown error.'));
        });
    }

    // ===== COPY TO CLIPBOARD =====
    function copyReportToClipboard(reportType) {
        var container = document.getElementById('reportContainer');
        if (!container) {
            alert('Unable to find the estimate report.');
            return;
        }

        if (typeof kendo === 'undefined' || !kendo.drawing) {
            alert('Kendo UI is not available. Please ensure Kendo UI is loaded.');
            return;
        }

        if (!navigator.clipboard) {
            alert('Clipboard API is not available.');
            return;
        }

        var wrapper = createExportWrapper(container, reportType);
        if (!wrapper) return;

        kendo.drawing.drawDOM(wrapper, {
            paperSize: 'auto',
            margin: '1cm',
            scale: 1
        }).then(function(group) {
            return kendo.drawing.exportImage(group);
        }).done(function(data) {
            if (wrapper.parentNode) document.body.removeChild(wrapper);

            fetch(data)
                .then(function(res) { return res.blob(); })
                .then(function(blob) {
                    navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
                    var typeNames = {
                        'full': 'Full Vehicle Estimate Report',
                        'vehicle': 'Vehicle Estimate Report',
                        'labour': 'Labour Details Report',
                        'materials': 'Materials Estimate Report'
                    };
                    alert((typeNames[reportType] || 'Report') + ' copied to clipboard.');
                })
                .catch(function(err) {
                    console.error('Clipboard error:', err);
                    alert('Error copying to clipboard: ' + err.message);
                });
        }).fail(function(err) {
            if (wrapper.parentNode) document.body.removeChild(wrapper);
            console.error('Export image error:', err);
            alert('Error generating image: ' + (err && err.message ? err.message : 'Unknown error.'));
        });
    }

