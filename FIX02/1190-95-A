using System;
using System.Globalization;

namespace BCES.Models.Reports
{
    // One row of [SBCES].[RptCostVariance2]. The Active column is not mapped (not displayed).
    // Values arrive as varchar/high-scale numbers, so raw values are strings and parsed for display.
    public class CostVarianceReportRow
    {
        // Mapped by Dapper from the result set
        public string RbNumber { get; set; }
        public string Keyword { get; set; }
        public string DetailedDesc { get; set; }
        public string TotalCost { get; set; }
        public string ExternalCost { get; set; }
        public string CostVariance { get; set; }

        // Display values (read-only, not mapped by Dapper), rounded to 2 digits
        public decimal? Cost => ParseMoney(TotalCost);

        public decimal? ExtCost => ParseMoney(ExternalCost);

        // Variance comes from the stored procedure, only parsed and rounded here
        public decimal? VariancePct => ParseMoney(CostVariance);

        private static decimal? ParseMoney(string s)
        {
            if (string.IsNullOrWhiteSpace(s)) return null;
            return decimal.TryParse(s.Trim(),
                NumberStyles.Number | NumberStyles.AllowCurrencySymbol,
                CultureInfo.InvariantCulture, out var d)
                ? Math.Round(d, 2, MidpointRounding.AwayFromZero)
                : (decimal?)null;
        }
    }
}
