    // POST: Upload documents
    [HttpPost]
    [AllowAnonymous]
    public async Task<IActionResult> UploadDocuments(string mbNumber, List<IFormFile> files)
    {
        if (string.IsNullOrEmpty(mbNumber))
            return BadRequest(new { error = "MbNumber is required" });
        
        if (files == null || files.Count == 0)
            return BadRequest(new { error = "No files to upload" });
        
        try
        {
            var uploadedDocuments = new List<MBDocumentViewModel>();
            
            // Create folder path based on MbNumber
            string folderPath = $"Documents/MB-{mbNumber}";
            
            foreach (var file in files)
            {
                if (file.Length == 0)
                    continue;
                
                using (var stream = file.OpenReadStream())
                {
                    // Upload to SharePoint
                    var driveItem = await UploadFileToSharePoint(stream, file.FileName, folderPath);
                    
                    if (driveItem == null)
                        throw new Exception($"Failed to upload file: {file.FileName}");
                    
                    // Get the web URL
                    string webUrl = driveItem.WebUrl ?? 
                        $"https://ttcportal.sharepoint.com/sites/ces-dev/_layouts/15/Doc.aspx?sourcedoc={driveItem.Id}";
                    
                    // Save document record to database using Dapper directly
                    const string insertSql = @"
                        INSERT INTO SBCES.MBDocument 
                            (MbNumber, FileName, FileSize, ContentType, SharePointUrl, 
                             DriveItemId, UploadedBy, UploadedDate, IsDeleted)
                        VALUES 
                            (@MbNumber, @FileName, @FileSize, @ContentType, @SharePointUrl, 
                             @DriveItemId, @UploadedBy, GETDATE(), 0);
                        
                        SELECT CAST(SCOPE_IDENTITY() as int)";
                    
                    var documentId = await _dbConnection.ExecuteScalarAsync<int>(insertSql, new
                    {
                        MbNumber = mbNumber,
                        FileName = file.FileName,
                        FileSize = file.Length,
                        ContentType = file.ContentType,
                        SharePointUrl = webUrl,
                        DriveItemId = driveItem.Id,
                        UploadedBy = User.Identity?.Name ?? "System"
                    });
                    
                    // Get the inserted document
                    const string selectSql = @"
                        SELECT 
                            DocumentId,
                            MbNumber,
                            FileName,
                            FileSize,
                            ContentType,
                            SharePointUrl,
                            DriveItemId,
                            UploadedBy,
                            UploadedDate,
                            IsDeleted,
                            DeletedDate
                        FROM SBCES.MBDocument
                        WHERE DocumentId = @DocumentId";
                    
                    var document = await _dbConnection.QueryFirstOrDefaultAsync<MBDocumentViewModel>(selectSql, new { DocumentId = documentId });
                    uploadedDocuments.Add(document);
                }
            }
            
            return Json(new 
            { 
                success = true, 
                message = $"Successfully uploaded {uploadedDocuments.Count} document(s)",
                documents = uploadedDocuments
            });
        }
        catch (Exception ex)
        {
            return BadRequest(new { error = ex.Message });
        }
    }
    
    // POST: Delete document
    [HttpPost]
    [AllowAnonymous]
    public async Task<IActionResult> DeleteDocument(int documentId)
    {
        try
        {
            // Get document details first using Dapper
            const string selectSql = @"
                SELECT 
                    DocumentId,
                    MbNumber,
                    FileName,
                    DriveItemId,
                    SharePointUrl
                FROM SBCES.MBDocument
                WHERE DocumentId = @DocumentId AND IsDeleted = 0";
            
            var document = await _dbConnection.QueryFirstOrDefaultAsync<dynamic>(selectSql, new { DocumentId = documentId });
            
            if (document == null)
                return NotFound(new { error = "Document not found" });
            
            // Delete from SharePoint
            try
            {
                await DeleteFileFromSharePoint(document.DriveItemId);
            }
            catch (Exception ex)
            {
                // Log the error but continue with database deletion
                Console.WriteLine($"Failed to delete file from SharePoint: {ex.Message}");
                // You might want to log this error
            }
            
            // Mark as deleted in database using Dapper
            const string updateSql = @"
                UPDATE SBCES.MBDocument
                SET IsDeleted = 1, DeletedDate = GETDATE()
                WHERE DocumentId = @DocumentId";
            
            await _dbConnection.ExecuteAsync(updateSql, new { DocumentId = documentId });
            
            return Json(new { success = true, message = "Document deleted successfully" });
        }
        catch (Exception ex)
        {
            return BadRequest(new { error = ex.Message });
        }
    }
    
