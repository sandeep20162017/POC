    {
        try
        {
            // Get document details using Dapper
            const string selectSql = @"
                SELECT 
                    DocumentId,
                    MbNumber,
                    FileName,
                    DriveItemId
                FROM SBCES.MBDocument
                WHERE DocumentId = @DocumentId AND IsDeleted = 0";
            
            var document = await _dbConnection.QueryFirstOrDefaultAsync<dynamic>(selectSql, new { DocumentId = documentId });
            
            if (document == null)
                return NotFound(new { error = "Document not found" });
            
            // Get file from SharePoint
            var graphClient = CreateGraphClient();
            var driveItem = await graphClient.Sites[_spSiteUrl]
                .Drives[_spDriveId]
                .Items[document.DriveItemId]
                .GetAsync();
            
            if (driveItem == null)
                return NotFound(new { error = "File not found in SharePoint" });
            
            // Get file content
            var fileStream = await graphClient.Sites[_spSiteUrl]
                .Drives[_spDriveId]
                .Items[document.DriveItemId]
                .Content
                .GetAsync();
            
            // Create a memory stream for download
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            
            return File(memoryStream, "application/octet-stream", document.FileName);
        }
        catch (Exception ex)
        {
            return BadRequest(new { error = ex.Message });
        }
    }
