    public class MBDocumentViewModel
    {
        public int DocumentId { get; set; }
        public string MbNumber { get; set; }
        public string FileName { get; set; }
        public long? FileSize { get; set; }
        public string ContentType { get; set; }
        public string SharePointUrl { get; set; }
        public string DriveItemId { get; set; }
        public string UploadedBy { get; set; }
        public DateTime UploadedDate { get; set; }
        public bool IsDeleted { get; set; }
        public DateTime? DeletedDate { get; set; }
        
        // Display properties
        public string FileSizeDisplay => FileSize.HasValue ? FormatFileSize(FileSize.Value) : "N/A";
        public string UploadedDateDisplay => UploadedDate.ToString("MM/dd/yyyy HH:mm");
        
        private string FormatFileSize(long bytes)
        {
            string[] sizes = { "B", "KB", "MB", "GB", "TB" };
            double len = bytes;
            int order = 0;
            while (len >= 1024 && order < sizes.Length - 1)
            {
                order++;
                len = len / 1024;
            }
            return $"{len:0.##} {sizes[order]}";
        }
    }
}
