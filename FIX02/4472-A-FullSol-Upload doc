    // Direct SharePoint folder creation
    private async Task<string> EnsureFolderExists(GraphServiceClient graphClient, string folderPath)
    {
        try
        {
            // Get the drive
            var drive = await graphClient.Sites[_spSiteUrl].Drive.GetAsync();
            
            if (drive == null)
                throw new Exception("Drive not found");
            
            // Create folder if it doesn't exist
            var pathParts = folderPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            string currentPath = "";
            
            foreach (var part in pathParts)
            {
                currentPath += part;
                
                // Check if folder exists
                try
                {
                    var existingFolder = await graphClient.Sites[_spSiteUrl]
                        .Drives[_spDriveId]
                        .Root
                        .ItemWithPath(currentPath)
                        .GetAsync();
                    
                    if (existingFolder != null)
                    {
                        currentPath += "/";
                        continue;
                    }
                }
                catch
                {
                    // Folder doesn't exist, create it
                }
                
                // Create folder
                var driveItem = new DriveItem
                {
                    Name = part,
                    Folder = new Folder(),
                    AdditionalData = new Dictionary<string, object>
                    {
                        { "@microsoft.graph.conflictBehavior", "rename" }
                    }
                };
                
                string parentPath = currentPath.Substring(0, currentPath.Length - part.Length);
                if (string.IsNullOrEmpty(parentPath))
                {
                    // Create at root level
                    await graphClient.Sites[_spSiteUrl]
                        .Drives[_spDriveId]
                        .Root
                        .Children
                        .PostAsync(driveItem);
                }
                else
                {
                    // Get parent folder
                    var parentFolder = await graphClient.Sites[_spSiteUrl]
                        .Drives[_spDriveId]
                        .Root
                        .ItemWithPath(parentPath.TrimEnd('/'))
                        .GetAsync();
                    
                    if (parentFolder != null)
                    {
                        await graphClient.Sites[_spSiteUrl]
                            .Drives[_spDriveId]
                            .Items[parentFolder.Id]
                            .Children
                            .PostAsync(driveItem);
                    }
                }
                
                currentPath += "/";
            }
            
            return folderPath;
        }
        catch (Exception ex)
        {
            throw new Exception($"Failed to ensure folder exists: {ex.Message}", ex);
        }
    }
    
    // Direct file upload to SharePoint
    private async Task<DriveItem> UploadFileToSharePoint(Stream fileStream, string fileName, string folderPath)
    {
        try
        {
            var graphClient = CreateGraphClient();
            
            // Ensure folder exists
            await EnsureFolderExists(graphClient, folderPath);
            
            // Upload file
            string filePath = $"{folderPath}/{fileName}";
            
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            
            // For files > 4MB, use upload session
            if (memoryStream.Length > 4 * 1024 * 1024)
            {
                var uploadSession = await graphClient.Sites[_spSiteUrl]
                    .Drives[_spDriveId]
                    .Root
                    .ItemWithPath(filePath)
                    .CreateUploadSession()
                    .PostAsync();
                
                // For production, implement chunked upload
                // Simple approach for demo - use direct upload
                var result = await graphClient.Sites[_spSiteUrl]
                    .Drives[_spDriveId]
                    .Root
                    .ItemWithPath(filePath)
                    .Content
                    .PutAsync(memoryStream);
                
                return result;
            }
            else
            {
                // Direct upload for small files
                var result = await graphClient.Sites[_spSiteUrl]
                    .Drives[_spDriveId]
                    .Root
                    .ItemWithPath(filePath)
                    .Content
                    .PutAsync(memoryStream);
                
                return result;
            }
        }
        catch (Exception ex)
        {
            throw new Exception($"Failed to upload file: {ex.Message}", ex);
        }
    }
    
    // Direct file deletion from SharePoint
