-- Run with "Run Script" (F5). Edit the three DEFINE lines below first.
-- The output folder MUST already exist. Use forward slashes.

DEFINE p_owner  = 'MYSCHEMA'
DEFINE p_pkg    = 'MY_PACKAGE'
DEFINE p_folder = 'C:/temp'

SET ECHO OFF
SET FEEDBACK OFF
SET HEADING OFF
SET VERIFY OFF
SET PAGESIZE 0
SET LINESIZE 4000
SET LONG 1000000
SET TRIMSPOOL ON
SET SQLBLANKLINES ON

SPOOL &p_folder./&p_pkg._body.sql

SELECT src
FROM (
    SELECT line AS ord,
           CASE WHEN line = 1 THEN 'CREATE OR REPLACE ' END
           || RTRIM(text, CHR(10) || CHR(13)) AS src
    FROM   all_source
    WHERE  owner = UPPER('&p_owner')
    AND    name  = UPPER('&p_pkg')
    AND    type  = 'PACKAGE BODY'
    UNION ALL
    SELECT MAX(line) + 1, '/'
    FROM   all_source
    WHERE  owner = UPPER('&p_owner')
    AND    name  = UPPER('&p_pkg')
    AND    type  = 'PACKAGE BODY'
    HAVING COUNT(*) > 0
)
ORDER BY ord;

SPOOL OFF
PROMPT Done: &p_folder./&p_pkg._body.sql
