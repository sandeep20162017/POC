-- Run in SQL Developer with "Run Script" (F5), NOT "Run Statement" (Ctrl+Enter)
-- Dumps one package body to a text file. Prompts for owner, package name, folder.

SET ECHO OFF
SET FEEDBACK OFF
SET HEADING OFF
SET VERIFY OFF
SET PAGESIZE 0
SET LINESIZE 4000
SET LONG 1000000
SET TRIMSPOOL ON

ACCEPT p_owner  CHAR PROMPT 'Schema owner (Enter = current user): '
ACCEPT p_pkg    CHAR PROMPT 'Package name: '
ACCEPT p_folder CHAR DEFAULT 'C:\temp' PROMPT 'Output folder on your PC [C:\temp]: '

COLUMN v_owner NEW_VALUE v_owner NOPRINT
SELECT NVL(UPPER('&p_owner'), USER) AS v_owner FROM dual;

SPOOL &p_folder\&p_pkg._body.sql

SELECT src
FROM (
    SELECT line AS ord,
           CASE WHEN line = 1 THEN 'CREATE OR REPLACE ' END
           || RTRIM(text, CHR(10) || CHR(13)) AS src
    FROM   all_source
    WHERE  owner = '&v_owner'
    AND    name  = UPPER('&p_pkg')
    AND    type  = 'PACKAGE BODY'
    UNION ALL
    SELECT MAX(line) + 1, '/'
    FROM   all_source
    WHERE  owner = '&v_owner'
    AND    name  = UPPER('&p_pkg')
    AND    type  = 'PACKAGE BODY'
    HAVING COUNT(*) > 0
)
ORDER BY ord;

SPOOL OFF
